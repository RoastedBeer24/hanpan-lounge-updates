/* 황제와 노예 (ecard) — 황제·시민·노예 다섯 장으로 하는 2인 심리전. 3명 이상이면 1:1 토너먼트.
   규칙 요약: 한 판(세트)마다 한쪽은 황제 1 + 시민 4, 다른 쪽은 노예 1 + 시민 4. 한 수마다 둘이 동시에 한 장씩 엎어 내고 공개.
   황제 > 시민 > 노예 > 황제. 시민끼리는 버리고 다음 수. 3판마다 측을 바꾼다. 노예 측이 이기면 판돈 5배.
   웃돈(선택): 매 수 카드를 내기 전에 0·1·2를 동시에 걸고 공개 — 이번 수에서 이기면 받고, 지거나 시민끼리 비기면 상대에게 넘어간다.
   상태는 JSON. 숨김 정보는 이번 수에 고른 카드(pc)·걸 값(pb)뿐 — 손패 구성은 공개 정보다. */
(function () {
  const L = window.Lounge, U = L.util;
  const ID = 'ecard';
  const HAND = 5, SWAP = 3, START = 30, STEP_SETS = 6, OT_MAX = 6;
  const LEN = { s: 6, m: 12, l: 18 };
  const SAY = ['이번 수에 건다.', '아직이다.', '지금이다.', '손이 떨리는군.', '읽혔다.', '믿든 말든.', '후회할 거다.', '……'];

  /* ---------- 작은 도우미 ---------- */
  function hash() {   // 결정적 0~1 (AI 의도를 상태에 저장하지 않고 다시 만들기 위해)
    let h = 2166136261 >>> 0;
    for (let i = 0; i < arguments.length; i++) {
      let x = (arguments[i] | 0) >>> 0;
      for (let j = 0; j < 4; j++) { h ^= x & 255; h = Math.imul(h, 16777619) >>> 0; x >>>= 8; }
    }
    h ^= h >>> 13; h = Math.imul(h, 0x5bd1e995) >>> 0; h ^= h >>> 15;
    return (h >>> 0) / 4294967296;
  }
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  const other = (m, seat) => (m.p[0] === seat ? m.p[1] : m.p[0]);
  const ix = (m, seat) => (m.p[0] === seat ? 0 : 1);

  /* 지금 판의 황제 측 자리 */
  function empOf(s) {
    const m = s.m;
    if (m.set <= s.len) return Math.floor((m.set - 1) / SWAP) % 2 === 0 ? m.e0 : other(m, m.e0);
    return (m.set - s.len) % 2 === 1 ? m.e0 : other(m, m.e0);
  }
  /* 판돈: 6판마다 1씩 오름(연장은 마지막 판돈) */
  const stakeOf = (s, set) => 1 + Math.floor((Math.min(set, s.len) - 1) / STEP_SETS);

  /* ---------- 대진표 ---------- */
  const SLOTS = { 4: [1, 4, 2, 3], 8: [1, 8, 4, 5, 2, 7, 3, 6] };
  function buildCup(n) {
    const seeds = U.shuffle(Array.from({ length: n }, (_, i) => i));
    const P = n <= 4 ? 4 : 8;
    const sl = SLOTS[P].map((k) => (k <= n ? seeds[k - 1] : -1));
    const r0 = [];
    for (let i = 0; i < sl.length; i += 2) r0.push([sl[i], sl[i + 1], -1]);
    return { R: [r0], ri: 0, mi: 0, nr: Math.log2(P) };
  }
  const RNAME = (nr, ri) => { const left = nr - ri; return left === 1 ? '결승' : left === 2 ? '4강' : '8강'; };

  /* ---------- 시작 ---------- */
  function init(players, opts) {
    opts = opts || {};
    const n = players.length;
    const s = {
      v: 1, n, len: LEN[opts.len] || 12, bt: opts.bets === 'off' ? 0 : 1, tm: +opts.timer || 0,
      sd: (Math.random() * 1e9) | 0, eid: 0, mno: 0, m: null, cup: null,
      ph: 'bet', pb: {}, pc: {}, bets: null, last: null,
      hist: [], sets: [], chat: [],
      acc: { sw: Array(n).fill(0), slw: Array(n).fill(0), bn: Array(n).fill(0), big: Array(n).fill(0), mw: Array(n).fill(0) },
      out: Array(n).fill(-1), champ: -1, win: -1,
      nm: players.map((p, i) => String((p && p.name) || ('자리 ' + (i + 1))).slice(0, 14)),
    };
    if (n <= 2) startMatch(s, 0, 1);
    else { s.cup = buildCup(n); nextCupMatch(s); }
    return s;
  }

  function startMatch(s, a, b) {
    s.mno++;
    const e0 = Math.random() < 0.5 ? a : b;
    s.m = { no: s.mno, p: [a, b], ch: [START, START], set: 1, k: HAND, e0, sw: [0, 0], slw: [0, 0] };
    s.m.B = stakeOf(s, 1);
    s.m.emp = empOf(s);
    s.ph = s.bt ? 'bet' : 'card'; s.pb = {}; s.pc = {}; s.bets = null;
  }

  /* 토너먼트: 다음 경기(부전승은 바로 올림) */
  function nextCupMatch(s) {
    const c = s.cup;
    for (;;) {
      const R = c.R[c.ri];
      const i = R.findIndex((x) => x[2] < 0);
      if (i < 0) {
        const W = R.map((x) => x[2]);
        if (W.length === 1) { s.champ = W[0]; s.out[W[0]] = c.nr; s.ph = 'over'; s.m = s.m || null; return; }
        const nx = [];
        for (let j = 0; j < W.length; j += 2) nx.push([W[j], W[j + 1], -1]);
        c.R.push(nx); c.ri++; continue;
      }
      const x = R[i];
      if (x[0] < 0 || x[1] < 0) { x[2] = x[0] < 0 ? x[1] : x[0]; continue; }
      c.mi = i;
      startMatch(s, x[0], x[1]);
      return;
    }
  }

  /* ---------- 차례 ---------- */
  function actor(s) {
    if (s.ph === 'over' || !s.m) return null;
    const box = s.ph === 'bet' ? s.pb : s.pc;
    const l = s.m.p.filter((x) => box[x] == null);
    return l.length ? l : null;
  }

  function offTurn(s, seat, a) { return !!a && a.t === 'say'; }

  function pushSay(s, seat, k) {
    if (!(k >= 0 && k < SAY.length) || seat < 0 || seat >= s.n) return false;
    const now = Date.now();
    const lastMine = s.chat.filter((c) => c.s === seat).pop();
    if (lastMine && now - lastMine.at < 1200) return false;
    s.eid++;
    s.chat.push({ i: s.eid, s: seat, k, at: now });
    if (s.chat.length > 8) s.chat.shift();
    return true;
  }

  function apply(s, seat, a) {
    if (!a || typeof a !== 'object') throw new Error('bad action');
    if (a.t === 'say') { if (!pushSay(s, seat, a.k | 0)) throw new Error('say rejected'); return s; }
    const act = actor(s);
    if (!act || !act.includes(seat)) throw new Error('not your turn');
    const m = s.m, me = ix(m, seat);
    if (a.say != null) pushSay(s, seat, a.say | 0);
    if (a.t === 'bet') {
      if (s.ph !== 'bet') throw new Error('not betting');
      const v = clamp(a.v | 0, 0, Math.min(2, m.ch[me]));
      s.pb[seat] = v;
      if (m.p.every((x) => s.pb[x] != null)) {
        s.bets = [s.pb[m.p[0]], s.pb[m.p[1]]];
        s.pb = {}; s.ph = 'card'; s.eid++;
        s.last = { id: s.eid, t: 'bets', b: s.bets.slice(), mno: m.no };
      }
      return s;
    }
    if (a.t === 'card') {
      if (s.ph !== 'card') throw new Error('not card phase');
      if (a.c !== 'K' && a.c !== 'C') throw new Error('bad card');
      if (a.c === 'C' && m.k <= 1) throw new Error('no citizen left');
      s.pc[seat] = a.c;
      if (m.p.every((x) => s.pc[x] != null)) resolve(s);
      return s;
    }
    throw new Error('unknown action');
  }

  /* 칩 옮기기(가진 만큼만) → 실제 옮긴 양 */
  function pay(m, from, to, amt) {
    const fi = ix(m, from), ti = ix(m, to);
    const v = Math.max(0, Math.min(amt, m.ch[fi]));
    m.ch[fi] -= v; m.ch[ti] += v;
    return v;
  }

  function resolve(s) {
    const m = s.m, e = m.emp, sl = other(m, e);
    const bets = s.bets || [0, 0];
    const be = bets[ix(m, e)], bs = bets[ix(m, sl)];
    const ke = s.pc[e] === 'K', ks = s.pc[sl] === 'K';
    const B = m.B, setNo = m.set;
    const ch0 = m.ch.slice();
    const duels = [];
    s.hist.push([m.no, setNo, m.k, e, sl, ke ? 1 : 0, ks ? 1 : 0, be, bs]);
    duels.push({ k: m.k, ce: ke ? 'E' : 'C', cs: ks ? 'S' : 'C' });
    let w = -1, payAmt = 0;
    if (ke && ks) { w = sl; payAmt = pay(m, e, sl, 5 * B + be + bs); }
    else if (ke || ks) { w = e; payAmt = pay(m, sl, e, B + be + bs); }
    else {
      // 시민끼리: 걸었던 웃돈은 상대에게
      const ne = pay(m, e, sl, be); const ns = pay(m, sl, e, bs);
      s.acc.bn[e] += ns - ne; s.acc.bn[sl] += ne - ns;
      m.k--;
      if (m.k === 1 && m.ch[0] > 0 && m.ch[1] > 0) {
        // 마지막 한 장씩 — 황제와 노예가 마주친다
        s.hist.push([m.no, setNo, 1, e, sl, 1, 1, 0, 0]);
        duels.push({ k: 1, ce: 'E', cs: 'S', forced: 1 });
        w = sl; payAmt = pay(m, e, sl, 5 * B);
      }
    }
    if (w >= 0 && (be || bs)) {
      const l = w === e ? sl : e;
      s.acc.bn[w] += be + bs; s.acc.bn[l] -= be + bs;
    }
    s.eid++;
    const last = { id: s.eid, t: 'duel', mno: m.no, set: setNo, e, sl, B, be, bs, d: duels, w, pay: payAmt, ch0, ch: m.ch.slice(), p: m.p.slice() };
    s.pc = {}; s.pb = {}; s.bets = null;
    const bust = m.ch[0] <= 0 || m.ch[1] <= 0;
    if (w >= 0) {
      m.sw[ix(m, w)]++;
      s.acc.sw[w]++;
      if (w === sl) { m.slw[ix(m, w)]++; s.acc.slw[w]++; }
      s.acc.big[w] = Math.max(s.acc.big[w], payAmt);
      s.sets.push([m.no, setNo, e, sl, w, HAND - duels[duels.length - 1].k + 1, payAmt]);
      if (s.sets.length > 160) s.sets.shift();
      const endLen = setNo >= s.len && m.ch[0] !== m.ch[1];
      const otOver = setNo >= s.len + OT_MAX;
      if (bust || endLen || otOver) finishMatch(s, last);
      else { m.set++; m.k = HAND; m.B = stakeOf(s, m.set); m.emp = empOf(s); s.ph = s.bt ? 'bet' : 'card'; }
    } else if (bust) {
      finishMatch(s, last);   // 웃돈으로 칩이 바닥난 경우
    } else {
      s.ph = s.bt ? 'bet' : 'card';
    }
    if (s.hist.length > 900) s.hist.splice(0, s.hist.length - 900);
    s.last = last;
  }

  function finishMatch(s, last) {
    const m = s.m;
    let wi;
    if (m.ch[0] !== m.ch[1]) wi = m.ch[0] > m.ch[1] ? 0 : 1;
    else if (m.sw[0] !== m.sw[1]) wi = m.sw[0] > m.sw[1] ? 0 : 1;
    else wi = Math.random() < 0.5 ? 0 : 1;
    const w = m.p[wi], l = m.p[1 - wi];
    s.acc.mw[w]++;
    last.mt = { w, l, ch: m.ch.slice(), sw: m.sw.slice() };
    if (!s.cup) { s.win = w; s.out[l] = 0; s.out[w] = 1; s.ph = 'over'; return; }
    const c = s.cup;
    last.mt.rn = RNAME(c.nr, c.ri);
    c.R[c.ri][c.mi][2] = w;
    s.out[l] = c.ri;
    nextCupMatch(s);
    if (s.ph !== 'over') last.mt.next = s.m.p.slice();
  }

  /* ---------- 결과 ---------- */
  const PLACE = (s, i) => {
    if (!s.cup) return i === s.win ? '승리' : '패배';
    const nr = s.cup.nr, o = s.out[i];
    if (o >= nr) return '우승';
    const left = nr - o;
    return left === 1 ? '준우승' : left === 2 ? '4강' : '8강';
  };
  function result(s) {
    if (s.ph !== 'over') return null;
    const w = s.cup ? s.champ : s.win;
    if (w < 0) return null;
    const m = s.m;
    const stats = [];
    if (!s.cup && m) stats.push({ label: '남은 칩', values: Array.from({ length: s.n }, (_, i) => String(m.p.includes(i) ? m.ch[ix(m, i)] : '-')) });
    if (s.cup) stats.push({ label: '성적', values: Array.from({ length: s.n }, (_, i) => PLACE(s, i)), best: false });
    stats.push({ label: '이긴 판', values: s.acc.sw.slice() });
    stats.push({ label: '노예로 이긴 판', values: s.acc.slw.slice() });
    if (s.bt) stats.push({ label: '웃돈 손익', values: s.acc.bn.map((v) => (v > 0 ? '+' + v : String(v))), best: false });
    stats.push({ label: '가장 큰 한 판', values: s.acc.big.slice(), unit: '칩' });
    const hl = [];
    const topSl = s.acc.slw.indexOf(Math.max(...s.acc.slw));
    const nmOf = (i) => (s.nm && s.nm[i]) || ('자리 ' + (i + 1));
    if (s.acc.slw[topSl] > 0) hl.push(nmOf(topSl) + ' — 노예로 황제를 꺾은 판 ' + s.acc.slw[topSl]);
    const big = Math.max(...s.acc.big), bigI = s.acc.big.indexOf(big);
    if (big >= 5) hl.push('가장 큰 한 판: ' + nmOf(bigI) + ' ' + big + '칩');
    if (s.bt) { const bb = s.acc.bn.indexOf(Math.max(...s.acc.bn)); if (s.acc.bn[bb] > 0) hl.push('웃돈 수익 최고: ' + nmOf(bb) + ' +' + s.acc.bn[bb]); }
    return {
      winners: [w],
      title: (s.cup ? '토너먼트 우승 — ' : '승리 — ') + nmOf(w),
      text: s.cup ? '' : (m ? '칩 ' + m.ch[0] + ' : ' + m.ch[1] : ''),
      stats, highlights: hl, _w: w,
    };
  }

  /* ---------- AI ---------- */
  /* 황제 측 시점의 한 수 보수표. 행 = 황제 측(E/C), 열 = 노예 측(S/C) */
  function matrix(k, B, be, bs) {
    const X = B + be + bs;
    const V = k - 1 >= 1 ? B * (k - 1 - 6) / (k - 1) : 0;   // 시민끼리 비긴 뒤 이어지는 판의 값(무작위 섞기 기준)
    return { a: -(5 * B + be + bs), b: X, c: X, d: (bs - be) + V };
  }
  function eqMix(M) {
    const den = M.a - M.b - M.c + M.d;
    if (Math.abs(den) < 1e-9) return { p: 0.5, q: 0.5 };
    return { p: clamp((M.d - M.c) / den, 0.02, 0.98), q: clamp((M.d - M.b) / den, 0.02, 0.98) };
  }
  function habits(s, seat) {
    return {
      early: hash(s.sd, seat, 11) * 2 - 1,   // 핵심 카드를 일찍(+) / 늦게(−) 내는 버릇
      bluff: hash(s.sd, seat, 12),           // 허세 웃돈
      betty: hash(s.sd, seat, 13),           // 웃돈 크기
      talk: hash(s.sd, seat, 14),            // 말 걸기
      liar: hash(s.sd, seat, 15),            // 말과 다르게 내기
    };
  }
  const styleOf = (seat) => { try { return (L.aiStyle && L.aiStyle(seat)) || 'bal'; } catch (e) { return 'bal'; } };

  /* 상대 모형: 지난 수들에서 그 자리가 이 측일 때 핵심 카드를 언제 냈는지 + 웃돈과의 관계 */
  function model(s, o, side, k, obet) {
    const q0 = 1 / k;
    let nk = 0, kk = 0, N = 0, res = 0, kb = 0, kn = 0, nb = 0, nn = 0;
    for (const r of s.hist) {
      if (r[2] < 2) continue;
      const isE = r[3] === o, isS = r[4] === o;
      if (!(side === 'E' ? isE : isS)) continue;
      const key = side === 'E' ? r[5] : r[6], bet = side === 'E' ? r[7] : r[8];
      N++; res += key - 1 / r[2];
      if (r[2] === k) { nk++; kk += key; }
      if (key) { kn++; if (bet > 0) kb++; } else { nn++; if (bet > 0) nb++; }
    }
    const tilt = N ? clamp(res / (N + 4), -0.35, 0.35) * Math.min(1, (6 - k) / 2 + 0.4) : 0;
    const pri = clamp(q0 + tilt, 0.02, 0.98);
    let q = (kk + 2 * pri) / (nk + 2);
    if (obet != null && s.bt) {
      const pbk = (kb + 1) / (kn + 2), pbn = (nb + 1) / (nn + 2);
      const lk = obet > 0 ? pbk : 1 - pbk, ln = obet > 0 ? pbn : 1 - pbn;
      q = q * lk / (q * lk + (1 - q) * ln);
    }
    return { q: clamp(q, 0.01, 0.99), conf: Math.min(1, N / 14) };
  }

  /* 이 자리가 지금 핵심 카드(황제/노예)를 낼 확률. withBets: 카드 단계(웃돈 공개 뒤) */
  function keyProb(s, seat, lv, withBets) {
    const m = s.m, k = m.k, B = m.B, isE = m.emp === seat, o = other(m, seat);
    const bets = withBets && s.bets ? s.bets : [0, 0];
    const be = bets[ix(m, m.emp)], bs = bets[ix(m, other(m, m.emp))];
    const M = matrix(k, B, be, bs);
    const eq = eqMix(M);
    const myEq = isE ? eq.p : eq.q;
    const ob = withBets && s.bets ? bets[ix(m, o)] : null;
    const mo = model(s, o, isE ? 'S' : 'E', k, ob);
    const qo = mo.q;
    let evK, evC;
    if (isE) { evK = qo * M.a + (1 - qo) * M.b; evC = qo * M.c + (1 - qo) * M.d; }
    else { evK = -(qo * M.a + (1 - qo) * M.c); evC = -(qo * M.b + (1 - qo) * M.d); }
    const T = B * (lv >= 3 ? 0.4 : 0.9);
    const br = 1 / (1 + Math.exp(-(evK - evC) / T));
    const hb = habits(s, seat);
    const st = styleOf(seat);
    const hw = lv <= 1 ? 1 : lv === 2 ? 0.6 : 0.15;
    let early = hb.early * hw + (st === 'agg' ? 0.25 : st === 'def' ? -0.2 : 0);
    const qh = clamp(myEq * Math.exp(early * 0.5 * (k - 3)), 0.03, 0.95);
    let P;
    if (lv <= 1) P = 0.8 * qh + 0.2 * (0.25 + 0.5 * hash(s.sd, seat, m.no, m.set, k, 3));
    else {
      // 상대가 균형 섞기에서 얼마나 벗어났나 — 벗어난 만큼만 파고든다(근거가 약하면 균형 섞기 유지)
      const dev = Math.abs(qo - (isE ? eq.q : eq.p));
      const w = lv === 2 ? 0.7 * Math.min(1, mo.conf * 1.3) * clamp(dev / 0.14, 0, 1) : 0.9 * Math.min(1, mo.conf * 1.6 + 0.15) * clamp(dev / 0.1, 0, 1);
      P = (1 - w) * qh + w * br;
    }
    return clamp(P, 0.02, 0.98);
  }
  /* 웃돈 단계에서 마음속으로 정해 둔 카드(상태에 저장하지 않고 같은 값으로 다시 만든다) */
  function intent(s, seat, lv) { return hash(s.sd, seat, s.m.no, s.m.set, s.m.k, 7) < keyProb(s, seat, lv, false); }

  function aiSay(s, seat, lv, key) {
    const hb = habits(s, seat);
    if (Math.random() > 0.08 + hb.talk * 0.22) return undefined;
    const lie = Math.random() < (lv >= 3 ? 0.5 : lv === 2 ? 0.35 : 0.15) + hb.liar * 0.15;
    const truth = key ? [0, 2, 5] : [1, 3, 7];
    const fake = key ? [1, 3, 7] : [0, 2, 6];
    const pool = lie ? fake : truth;
    return pool[(Math.random() * pool.length) | 0];
  }

  function ai(s, seat, lv) {
    lv = lv || 2;
    const m = s.m;
    if (!m) return null;
    const isE = m.emp === seat, me = ix(m, seat), k = m.k;
    if (s.ph === 'bet') {
      const key = intent(s, seat, lv);
      const hb = habits(s, seat), st = styleOf(seat);
      let pb;
      if (isE) pb = key ? [0.85, 0.66, 0.46][lv - 1] : [0.05, 0.1 + hb.bluff * 0.14, 0.34 + hb.bluff * 0.1][lv - 1];
