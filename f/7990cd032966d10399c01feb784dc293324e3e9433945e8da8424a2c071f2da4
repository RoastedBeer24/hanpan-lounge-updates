  /* ======================= 뷰 ======================= */
  function mount(root, api) {
    const h = L.h;
    if (!document.getElementById('ec-css')) document.head.append(h('style', { id: 'ec-css', text: CSS }));
    const wrap = h('div', { class: 'ec' });
    const lamp = h('div', { class: 'ec-lamp' }), vig = h('div', { class: 'ec-vig' });
    const topP = h('div', { class: 'ec-pl top ec-top' });
    const oh = h('div', { class: 'ec-oh' });
    const mid = h('div', { class: 'ec-mid' });
    const felt = h('div', { class: 'ec-felt' });
    const meP = h('div', { class: 'ec-pl me ec-mep' });
    const hand = h('div', { class: 'ec-hand' });
    const tip = h('div', { class: 'ec-tip', role: 'status' });
    const tbar = h('div', { class: 'ec-tbar', hidden: true }, h('div', { class: 'tr' }, h('i')), h('b', { text: '' }));
    const act = h('div', { class: 'ec-act' });
    mid.append(felt);
    function paintFelt() {
      let f = null; try { f = L.ui.felt && L.ui.felt(); } catch (e) { f = null; }
      const c = f && f.c ? f.c : ['#24806a', '#1c6650', '#0c3528'];
      felt.style.background = 'radial-gradient(ellipse 70% 62% at 50% 46%,' + c[0] + ' 0%,' + c[1] + ' 42%,' + c[2] + ' 100%)';
    }
    paintFelt();
    window.addEventListener('lounge-felt', paintFelt);
    wrap.append(lamp, vig, topP, oh, mid, meP, hand, tip, tbar, act);
    root.append(wrap);

    let st = null, shownId = 0, chatSeen = 0, sel = -1, revealed = -1, sentAt = 0, dead = false;
    let animating = false, skipping = false, curRes = null, sheet = null, cur = null;
    const Q = [];
    let tKey = '', tStart = 0, tTimer = 0;
    const busyK = new Set();
    function busy(k, on) {
      const was = busyK.size > 0;
      if (on) busyK.add(k); else busyK.delete(k);
      const now = busyK.size > 0;
      if (was !== now) api.setBusy(now);
    }
    const NM = (i) => (api.players[i] && api.players[i].name) || ('자리 ' + (i + 1));
    const COL = (i) => (api.players[i] && api.players[i].color) || '#d4ad5c';
    const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const SP = () => Math.max(0.2, (L.debug.speed || 1) * (L.speed ? L.speed() : 1) * (E.isFast() ? 2.6 : 1));
    const wait = (ms) => (skipping || dead ? Promise.resolve() : new Promise((r) => { const t = setTimeout(() => { curRes = null; r(); }, ms / SP()); curRes = () => { clearTimeout(t); curRes = null; r(); }; }));
    const skipNow = () => { skipping = true; if (curRes) curRes(); };
    const multi = () => api.mySeats().length > 1;
    const actorsNow = (s) => L.actorsOf({ actor: E.actor }, s);

    /* 이 화면에서 비밀(이번 수에 고른 카드)을 볼 수 있는 자리 */
    function looker(s) {
      s = s || st;
      if (!s) return -1;
      if (!multi()) return api.viewer();
      if (cur && cur.solo) return -1;
      const list = actorsNow(s);
      if (list.length > 1) return list.includes(revealed) ? revealed : -1;
      return api.viewer();
    }
    function bottomSeat(s) {
      const m = s.m; if (!m) return 0;
      const lk = looker(s);
      if (m.p.includes(lk)) return lk;
      const mine = m.p.filter((x) => api.canAct(x));
      if (mine.length === 1) return mine[0];
      if (mine.length > 1 && m.p.includes(revealed)) return revealed;
      return mine.length ? mine[0] : m.p[0];
    }
    const canSee = (s, seat) => seat === looker(s);
    const keyT = (s, seat) => (s.m.emp === seat ? 'E' : 'S');

    function layout() {
      const W = wrap.clientWidth || 360, H = wrap.clientHeight || 640;
      const hw = Math.round(Math.max(44, Math.min(78, (W - 40) / 5.3, (H - 420) / 1.4 + 40)));
      const ow = Math.round(Math.max(26, Math.min(40, W / 11, H / 22)));
      wrap.style.setProperty('--hw', hw + 'px');
      wrap.style.setProperty('--ow', ow + 'px');
      const mh = mid.clientHeight || 260;
      const sw = Math.round(Math.max(44, Math.min(86, (mh - 44) / 2 / 1.4, W * 0.2)));
      wrap.style.setProperty('--sw', sw + 'px');
      const cw = Math.round(Math.max(70, Math.min(150, W * 0.36, (H - 230) / 2 / 1.4)));
      wrap.style.setProperty('--cw', cw + 'px');
    }

    function cardEl(t, down, extra) {
      const c = h('div', { class: 'ec-card' + (down ? ' down' : '') + (extra ? ' ' + extra : '') });
      const inn = h('div', { class: 'in' });
      inn.append(h('div', { class: 'f fr', html: t ? faceSVG(t) : '' }), h('div', { class: 'f bk', html: BACK }));
      c.append(inn);
      return c;
    }

    /* 심박: 이번 판에서 이 자리가 잃을 수 있는 몫과 위험 확률로 정하는 연출 값 */
    function bpmOf(s, seat) {
      const m = s.m;
      if (!m || !m.p.includes(seat) || s.ph === 'over') return 62;
      const isE = m.emp === seat, i = E.ix(m, seat);
      const b = s.bets ? s.bets[0] + s.bets[1] : 0;
      const loss = isE ? 5 * m.B + b : m.B + b;
      const pl = isE ? 1 / m.k : (m.k - 1) / m.k;
      const ten = clamp(pl * loss / Math.max(4, m.ch[i]) * 2.2, 0, 1);
      return Math.round(64 + ten * 82 + (5 - m.k) * 4);
    }

    function panel(el, s, seat, isTop) {
      el.innerHTML = '';
      const m = s.m;
      if (!m) return;
      const i = E.ix(m, seat), side = keyT(s, seat);
      const av = h('span', { class: 'ec-av', style: { '--c': COL(seat) }, html: '<svg viewBox="-8 -8 16 16">' + pip(side, 'currentColor') + '</svg>' });
      const sub = h('div', { class: 'ec-sub' }, h('span', { class: 'ec-sd ' + side, text: side === 'E' ? '황제 측' : '노예 측' }));
      if (s.ph === 'bet' || s.ph === 'card') {
        const box = s.ph === 'bet' ? s.pb : s.pc;
        sub.append(h('span', { class: box[seat] != null ? 'ec-ok' : 'ec-wait', text: box[seat] != null ? (s.ph === 'bet' ? '웃돈 결정' : '카드 결정') : (api.players[seat] && api.players[seat].ai ? '생각 중' : '고르는 중') }));
      }
      const bpm = bpmOf(s, seat);
      const hr = h('span', { class: 'ec-hr', title: '심박 — 이번 판에 걸린 몫이 클수록 빨라집니다', style: { '--beat': (60 / bpm).toFixed(2) + 's' } });
      hr.innerHTML = '<svg viewBox="0 0 56 24"><g><path d="' + ECG_D + '" fill="none" stroke="#c8483a" stroke-width="1.6" stroke-linejoin="round"/></g></svg><b>' + bpm + ' bpm</b>';
      const ch = h('span', { class: 'ec-chips' }, h('b', { text: String(m.ch[i]) }), h('span', { text: '칩 · 판 ' + m.sw[i] }));
      el.append(av, h('div', { class: 'ec-who' }, h('span', { class: 'ec-nm', text: NM(seat) }), sub), hr, ch);
    }
    function handRow(el, s, seat, small) {
      el.innerHTML = '';
      const m = s.m; if (!m) return;
      const k = m.k, t = keyT(s, seat);
      const box = s.ph === 'card' ? s.pc : null;
      const pend = box && box[seat] != null;
      const see = canSee(s, seat);
      const n = pend ? k - 1 : k;
      let faces;
      if (pend && !see) faces = Array(n).fill(null);
      else {
        const keyIn = pend ? s.pc[seat] !== 'K' : true;
        faces = Array(n).fill('C');
        if (keyIn) faces[Math.floor((n - 1) / 2)] = t;
      }
      const mineNow = !small && api.canAct(seat) && see && s.ph === 'card' && actorsNow(s).includes(seat) && !animating;
      el.classList.toggle('lock', !mineNow);
      if (!small) handLive = mineNow;
      faces.forEach((f, j) => {
        const c = cardEl(f || 'C', !f, (mineNow && sel === j ? 'sel' : '') + (mineNow && sel >= 0 && sel !== j ? ' dim' : ''));
        if (small) c.style.setProperty('--w', 'var(--ow)');
        else if (f) c.append(h('span', { class: 'nmL ' + f, text: FACE[f].name }));
        c.dataset.i = j; c.dataset.t = f || '';
        el.append(c);
      });
      const cnt = t === 'E' ? '황제 1 · 시민 ' + (k - 1) : '노예 1 · 시민 ' + (k - 1);
      el.append(h('span', { class: 'cnt', text: small ? cnt + (pend ? ' · 한 장 엎음' : '') : '' }));
    }

    /* 카드 고르기: 손패 줄에 한 번만 건 pointerdown(다시 그려져도 눌림이 사라지지 않음) */
    let handLive = false, selAt = 0;
    hand.addEventListener('pointerdown', (e) => {
      if (!handLive || animating || (e.pointerType === 'mouse' && e.button !== 0)) return;
      const c = e.target.closest ? e.target.closest('.ec-card') : null;
      if (!c || !hand.contains(c)) return;
      const j = +c.dataset.i;
      if (!(j >= 0)) return;
      e.preventDefault();
      if (sel === j) { if (Date.now() - selAt > 250 && Date.now() - sentAt > 300) playSel(); return; }
      sel = j; selAt = Date.now(); api.buzz(6, 'ui'); api.sfx('click', { vol: 0.5 }); renderLower();
    });

    function renderMid(s) {
      mid.querySelectorAll(':scope > :not(.ec-felt)').forEach((e) => e.remove());
      const m = s.m; if (!m) return;
      const bot = bottomSeat(s), top = E.other(m, bot);
      const info = h('div', { class: 'ec-info' });
      if (s.cup) info.append(h('span', { class: 'cup', text: E.RNAME(s.cup.nr, s.cup.ri) + ' · ' + (s.cup.mi + 1) + '경기' }));
      info.append(h('span', { class: 'rd', text: (m.set > s.len ? '연장 ' : '') + m.set + (m.set > s.len ? '판' : ' / ' + s.len + '판') }));
      info.append(h('span', { text: (E.HAND - m.k + 1) + '번째 수' }));
      info.append(h('span', { class: 'stk', html: m.B + '<small>판돈</small>' }));
      info.append(h('span', { class: 'x5', text: '노예 승 ×5 = ' + 5 * m.B }));
      mid.append(info);
      // 자리(엎어 둔 카드)
      [[top, 't'], [bot, 'b']].forEach(([seat, pos]) => {
        const sl = h('div', { class: 'ec-slot ' + pos });
        if (s.ph === 'card' && s.pc[seat] != null) {
          const see = canSee(s, seat);
          const t = s.pc[seat] === 'K' ? keyT(s, seat) : 'C';
          sl.append(cardEl(t, !see));
          if (see) sl.append(h('span', { class: 'lk', text: '공개 전' }));
        }
        mid.append(sl);
        if (s.bt && s.ph === 'card' && s.bets) {
          const v = s.bets[E.ix(m, seat)];
          const b = h('div', { class: 'ec-bet ' + pos + (v ? '' : ' z') + (s.last && s.last.t === 'bets' && s.last.id > betShown ? ' pulse' : '') });
          if (v) { for (let q = 0; q < v; q++) b.append(h('i')); b.append(h('span', { text: '+' + v })); } else b.append(h('span', { text: '웃돈 없음' }));
          mid.append(b);
        }
      });
      if (s.last && s.last.t === 'bets') betShown = Math.max(betShown, s.last.id);
      // 도구
      if (E.isFast() && m.p.some((x) => api.canAct(x))) E.setFast(false);   // 내 경기에서는 빨리 보기 끔
      const tools = h('div', { class: 'ec-tools' });
      tools.append(h('button', { class: 'ec-tool', type: 'button', 'aria-label': '수 읽기 기록', title: '기록 (R)', 'data-action': 'log', html: TOOL.log, onclick: () => openLog() }));
      if (sayer() >= 0) tools.append(h('button', { class: 'ec-tool', type: 'button', 'aria-label': '한마디', title: '한마디', html: TOOL.say, onclick: () => openSay() }));
      if (s.cup) tools.append(h('button', { class: 'ec-tool', type: 'button', 'aria-label': '대진표', title: '대진표', html: TOOL.cup, onclick: () => openBracket() }));
      if (api.isHost && !m.p.some((x) => api.canAct(x))) tools.append(h('button', { class: 'ec-tool' + (E.isFast() ? ' on' : ''), type: 'button', 'aria-label': '관전 빨리 보기', title: '관전 빨리 보기', html: TOOL.fast, onclick: (e) => { E.setFast(!E.isFast()); e.currentTarget.classList.toggle('on', E.isFast()); api.sfx('click'); } }));
      mid.append(tools);
    }
    let betShown = 0;

    function renderLower() {
      const s = st; if (!s) return;
      const m = s.m;
      act.innerHTML = '';
      tip.innerHTML = '';
      if (!m) return;
      const bot = bottomSeat(s);
      handRow(hand, s, bot, false);
      if (s.ph === 'over') { tip.textContent = '승부가 끝났습니다.'; return; }
      const list = actorsNow(s);
      const mine = api.canAct(bot) && list.includes(bot) && canSee(s, bot) && !animating;
      const isE = m.emp === bot;
      if (!m.p.some((x) => api.canAct(x))) {
        tip.textContent = '관전 — ' + NM(m.p[0]) + ' 대 ' + NM(m.p[1]);
        act.append(h('div', { class: 'ec-wait', text: s.ph === 'bet' ? '웃돈을 정하는 중' : '카드를 고르는 중' }));
        return;
      }
      if (!mine) {
        const myPend = list.includes(bot);
        act.append(h('div', { class: 'ec-wait', text: animating ? '공개 중' : myPend ? '차례를 기다리는 중' : (s.ph === 'bet' ? '상대가 웃돈을 정하는 중' : '상대가 카드를 고르는 중') }));
        return;
      }
      const i = E.ix(m, bot);
      if (s.ph === 'bet') {
        tip.innerHTML = '웃돈 — 이기면 받고, <b>지거나 비기면</b> 넘겨줍니다.';
        [0, 1, 2].forEach((v) => {
          act.append(h('button', { class: 'ec-btn' + (v ? '' : ''), type: 'button', disabled: v > m.ch[i], 'data-action': 'b' + v,
            html: v ? '+' + v + '<small>' + v + '칩을 건다</small>' : '걸지 않음<small>0칩</small>',
            onclick: () => send({ t: 'bet', v }) }));
        });
        return;
      }
      // 카드
      const kt = keyT(s, bot);
      const faces = Array(m.k).fill('C'); faces[Math.floor((m.k - 1) / 2)] = kt;
      const pick = sel >= 0 ? faces[sel] : null;
      const ob = s.bets ? s.bets[1 - i] : 0;
      tip.innerHTML = ob ? '상대 웃돈 <b>+' + ob + '</b>. 핵심 카드인가, 허세인가.' : (isE ? '황제는 시민을 누르지만, 노예에게 찔립니다.' : '노예는 황제를 찌르지만, 시민에게 눌립니다.');
      act.append(h('button', { class: 'ec-btn pri', type: 'button', disabled: !pick, 'data-action': 'play',
        html: pick ? ({ E: '황제를', C: '시민을', S: '노예를' }[pick] + ' 낸다') + '<small>한 번 더 눌러도 냅니다</small>' : '카드를 고르세요<small>' + (isE ? '황제 1 · 시민 ' + (m.k - 1) : '노예 1 · 시민 ' + (m.k - 1)) + '</small>',
        onclick: () => playSel() }));
    }

    function playSel() {
      const s = st; if (!s || !s.m || sel < 0) return;
      const m = s.m, bot = bottomSeat(s);
      const faces = Array(m.k).fill('C'); faces[Math.floor((m.k - 1) / 2)] = keyT(s, bot);
      const f = faces[sel]; if (!f) return;
      send({ t: 'card', c: f === 'C' ? 'C' : 'K' });
    }
    function send(a) {
      const s = st; if (!s || !s.m) return;
      if (Date.now() - sentAt < 300) return;
      const bot = bottomSeat(s);
      if (!api.canAct(bot) || !actorsNow(s).includes(bot)) return;
      sentAt = Date.now();
      sel = -1;
      if (multi()) revealed = -1;
      api.buzz(a.t === 'card' ? 16 : 10); api.sfx(a.t === 'card' ? 'card' : 'chip', { vol: 0.8 });
      api.actAs(bot, a);
    }

    /* 한마디: 판에 있는 내 자리(관전 중이면 내 첫 자리) */
    function sayer() {
      const s = st; if (!s) return -1;
      const lk = looker(s);
      if (lk >= 0) return lk;
      const mine = api.mySeats();
      if (s.m) { const inM = s.m.p.filter((x) => mine.includes(x)); if (inM.length === 1) return inM[0]; if (inM.length > 1) return -1; }
      return mine.length === 1 ? mine[0] : -1;
    }

    /* 가림막(한 폰 여럿 — 동시에 고를 사람이 둘 이상 남았을 때. 한 명 남으면 core 가림막) */
    /* holder: 지금 폰을 들고 있는(마지막으로 비밀 화면을 본) 사람.
       한 명만 남았는데 core가 그 자리를 이미 보여 준 적이 있어 core 가림막이 안 뜨는 경우(앞 수에서 그 사람이 마지막이었음)
       — 앞 사람이 고른 뒤 폰을 넘기라는 가림막을 게임이 직접 띄운다. */
    let holder = -1, lastViewer = -2;
    function curtainCheck() {
      const s = st;
      const v = api.viewer();
      if (v !== lastViewer) { lastViewer = v; if (v >= 0) holder = v; }
      const done = () => { hideCur(); const lk = looker(s); if (lk >= 0) holder = lk; };
      if (!s || !multi() || !(s.ph === 'bet' || s.ph === 'card') || animating) { done(); return; }
      const list = actorsNow(s);
      if (list.length < 2) {
        const one = list[0];
        if (one != null && api.canAct(one) && v === one && holder >= 0 && holder !== one) { showCur(one, true); return; }
        done(); return;
      }
      if (list.includes(revealed)) { done(); return; }
      const pend = list.filter((x) => api.canAct(x));
      if (!pend.length) { done(); return; }
      showCur(pend[0]);
    }
    function showCur(seat, solo) {
      if (cur && cur.seat === seat && !!cur.solo === !!solo) return;
      hideCur();
      const el = h('div', { class: 'ec-cur' },
        h('div', { html: '<svg viewBox="0 0 100 140" width="70" height="98">' + BACK.replace(/^<svg[^>]*>|<\/svg>$/g, '') + '</svg>' }),
        h('div', { class: 'big', text: NM(seat) }),
        h('p', { text: (st.ph === 'bet' ? '웃돈을 정할 차례입니다.' : '카드를 고를 차례입니다.') + ' 화면은 본인만 봅니다.' }),
        h('button', { class: 'btn primary', type: 'button', text: '내 차례 보기', onclick: () => { if (solo) holder = seat; else revealed = seat; hideCur(); api.sfx('click'); render(); } }));
      cur = { seat, el, solo: !!solo };
      wrap.append(el);
    }
    function hideCur() { if (cur) { cur.el.remove(); cur = null; } }

    /* 제한 시간(이 기기에서 조작하는 사람 자리만) */
    function timerCheck() {
      const s = st;
      if (!s || !s.tm || !s.m || animating || s.ph === 'over') { tbar.hidden = true; tKey = ''; return; }
      const bot = bottomSeat(s);
      const mine = api.canAct(bot) && actorsNow(s).includes(bot) && canSee(s, bot);
      if (!mine) { tbar.hidden = true; tKey = ''; return; }
      const k = [s.m.no, s.m.set, s.m.k, s.ph, bot].join('.');
      if (k !== tKey) { tKey = k; tStart = performance.now(); }
      tbar.hidden = false;
    }
    function timerTick() {
      if (dead) return;
      const s = st;
      if (s && tKey && !tbar.hidden) {
        const left = s.tm - (performance.now() - tStart) / 1000;
        const i = tbar.querySelector('i'), sec = tbar.querySelector('b');
        i.style.width = clamp(left / s.tm * 100, 0, 100) + '%';
        i.classList.toggle('low', left < 4);
        sec.textContent = Math.max(0, Math.ceil(left)) + '초'; sec.classList.toggle('low', left < 4);
        if (left <= 0) {
          const bot = bottomSeat(s), m = s.m;
          tKey = 'x';
          if (s.ph === 'bet') send({ t: 'bet', v: 0 });
          else send({ t: 'card', c: Math.random() < 1 / m.k ? 'K' : 'C' });
          if (bot >= 0) api.toast('시간 초과 — 자동으로 냈습니다', 1200);
        }
      }
      tTimer = setTimeout(timerTick, 200);
    }

    function render() {
      if (!st || dead) return;
      layout();
      const s = st, m = s.m;
      if (!m) return;
      curtainCheck();   // 먼저: 가림막이 뜨면 그 아래에는 비밀 화면을 그리지 않음
      const bot = bottomSeat(s), top = E.other(m, bot);
      if (sel >= m.k) sel = -1;
      panel(topP, s, top, true);
      panel(meP, s, bot, false);
      handRow(oh, s, top, true);
      renderMid(s);
      renderLower();
      timerCheck();
    }

    /* 말풍선 */
    function bubbles(s) {
      for (const c of s.chat) {
        if (c.i <= chatSeen) continue;
        chatSeen = c.i;
        const m = s.m; let at = 'mid';
        if (m && m.p.includes(c.s)) at = c.s === bottomSeat(s) ? 'b' : 't';
        const b = h('div', { class: 'ec-bub', style: { '--c': COL(c.s) } }, h('span', { class: 'n', text: NM(c.s) }), E.SAY[c.k] || '');
        if (at === 't') { b.style.top = (topP.offsetTop + topP.offsetHeight + 2) + 'px'; b.style.left = '52px'; }
        else if (at === 'b') { b.style.top = (meP.offsetTop - 30) + 'px'; b.style.left = '52px'; }
        else { b.style.top = (mid.offsetTop + 6) + 'px'; b.style.left = '50%'; b.style.transform = 'translateX(-50%)'; }
        wrap.append(b);
        setTimeout(() => b.remove(), 1700);
      }
    }

    /* ---------- 공개 연출 ---------- */
    const VD = {
      CC: ['시민과 시민', '둘 다 버리고 다음 수로 넘어갑니다.', 'n'],
      EC: ['황제가 시민을 누릅니다', '황제 측이 판을 가져갑니다.', ''],
      CS: ['시민이 노예를 누릅니다', '황제 측이 판을 가져갑니다.', ''],
      ES: ['노예가 황제를 찌릅니다', '노예 측 승리 — 판돈 다섯 배.', 'r'],
    };
    async function playDuel(last, prevS) {
      const viewS = prevS || st;
      const bot = viewS.m && viewS.m.p.includes(bottomSeat(viewS)) ? bottomSeat(viewS) : last.p[0];
      const top = last.p[0] === bot ? last.p[1] : last.p[0];
      const myView = canSee(viewS, bot) || api.canAct(bot) && !multi();
      const cu = h('div', { class: 'ec-cu' });
      const pz = h('div', { class: 'pz' });
      const whoT = h('div', { class: 'who' }, h('span', { class: 'dot', style: { '--c': COL(top) } }), NM(top) + ' · ' + (top === last.e ? '황제 측' : '노예 측'));
      const whoB = h('div', { class: 'who' }, h('span', { class: 'dot', style: { '--c': COL(bot) } }), NM(bot) + ' · ' + (bot === last.e ? '황제 측' : '노예 측'));
      const midBox = h('div', { class: 'mid' });
      const meta = h('div', { class: 'meta' });
      const skip = h('div', { class: 'skip', text: '누르면 넘김' });
      let slotT = h('div'), slotB = h('div');
      cu.append(pz, whoT, slotT, midBox, slotB, whoB, meta, skip);
      wrap.append(cu);
      skipping = false;
      cu.addEventListener('click', () => skipNow());
      const bpm = Math.max(bpmOf(viewS, bot), 90);
      const beatMs = 60000 / bpm;
      for (let j = 0; j < last.d.length; j++) {
        const d = last.d[j];
        const cT = top === last.e ? d.ce : d.cs, cB = bot === last.e ? d.ce : d.cs;
        const nT = cardEl(cT, true), nB = cardEl(cB, !myView || d.forced);
        slotT.replaceWith(nT); slotB.replaceWith(nB); slotT = nT; slotB = nB;
        midBox.innerHTML = '';
        midBox.append(h('div', { class: 'ec-vs', text: d.forced ? '남은 한 장 — 황제와 노예' : (E.HAND - d.k + 1) + '번째 수' }));
        meta.textContent = '판돈 ' + last.B + (last.be || last.bs ? ' · 웃돈 ' + (last.be + last.bs) : '');
        const decisive = d.ce !== 'C' || d.cs !== 'C';
        const beats = decisive ? 3 : 2;
        if (decisive) Snd.drone((beats * beatMs) / 1000 / SP());
        for (let b = 0; b < beats; b++) {
          pz.classList.add('on'); Snd.beat(0.7 + b * 0.15); api.buzz(18, 'hit');
          await wait(140); pz.classList.remove('on');
          await wait(Math.max(160, beatMs - 140));
          if (dead) return;
        }
        const fd = (decisive ? 0.75 : 0.45) / SP();
        [nT, nB].forEach((c) => c.style.setProperty('--fd', fd + 's'));
        if (!(myView && !d.forced)) { nB.classList.remove('down'); }
        await wait(decisive ? 260 : 80);
        nT.classList.remove('down');
        api.sfx('card');
        await wait(fd * 1000 * SP() + 60);
        if (skipping) { nT.classList.remove('down'); nB.classList.remove('down'); }
        const key = (d.ce === 'E' ? 'E' : 'C') + (d.cs === 'S' ? 'S' : 'C');
        const v = VD[key];
        midBox.innerHTML = '';
        midBox.append(h('div', { class: 'ec-vd ' + v[2], text: v[0] }), h('div', { class: 'ec-vs', text: v[1] }));
        if (key === 'ES') { api.sfx('hit'); api.buzz(60, 'hit'); }
        else if (key === 'CC') api.sfx('whoosh', { vol: 0.6 });
        else api.sfx('thud');
        await wait(decisive ? 1250 : 700);
        if (dead) return;
      }
      if (last.w >= 0) {
        midBox.innerHTML = '';
        const winE = last.w === last.e;
        midBox.append(h('div', { class: 'ec-vd' + (winE ? '' : ' r'), text: NM(last.w) + ' +' + last.pay }),
          h('div', { class: 'ec-vs', text: (winE ? '황제 측' : '노예 측') + ' 승리 · 판돈 ' + last.B + (winE ? '' : ' ×5') + (last.be + last.bs ? ' + 웃돈 ' + (last.be + last.bs) : '') }));
        const me = api.mySeats();
        if (me.includes(last.w)) { api.sfx('win'); L.haptic && L.haptic('win', 40); }
        else if (last.p.some((x) => me.includes(x))) api.sfx('lose');
        else api.sfx('result');
        await wait(1100);
      } else if (last.be || last.bs) {
        midBox.append(h('div', { class: 'ec-vs', text: '웃돈은 서로에게 넘어갑니다.' }));
        await wait(500);
      }
      if (last.mt && !dead) {
        cu.innerHTML = '';
        const mt = last.mt;
        const box = h('div', { class: 'ec-mo' }, h('h3', { text: NM(mt.w) + ' 승리' }),
          h('div', { class: 'sc', text: NM(last.p[0]) + ' ' + mt.ch[0] + ' : ' + mt.ch[1] + ' ' + NM(last.p[1]) }),
          h('p', { text: mt.rn ? (mt.rn === '결승' ? '토너먼트 우승' : mt.rn + ' 통과') : '이긴 판 ' + Math.max(mt.sw[0], mt.sw[1]) + ' · 진 판 ' + Math.min(mt.sw[0], mt.sw[1]) }),
          mt.next ? h('p', { text: '다음 경기 — ' + NM(mt.next[0]) + ' 대 ' + NM(mt.next[1]) }) : null);
        cu.append(pz, box);
        await wait(1700);
      }
      cu.remove();
    }

    async function pump() {
      if (animating) return;
      animating = true; busy('anim', true);
      try {
        while (Q.length && !dead) {
          const it = Q.shift();
          if (it.last.t === 'duel') {
            render();
            await playDuel(it.last, it.prev);
            if (it.last.w >= 0) floatDelta(it.last);
          }
        }
      } catch (e) { console.error(e); }
      skipping = false; curRes = null;
      animating = false; busy('anim', false);
      if (!dead) { render(); bubbles(st); }
    }
    function floatDelta(last) {
      const s = st; if (!s.m) return;
      last.p.forEach((seat, j) => {
        const dv = last.ch[j] - last.ch0[j]; if (!dv) return;
        const pnl = s.m.p.includes(seat) ? (seat === bottomSeat(s) ? meP : topP) : null;
        if (!pnl) return;
        const chips = pnl.querySelector('.ec-chips'); if (!chips) return;
        chips.style.position = 'relative';
        const d = h('span', { class: 'dl ' + (dv > 0 ? 'p' : 'm'), text: (dv > 0 ? '+' : '−') + Math.abs(dv) });
        chips.append(d); setTimeout(() => d.remove(), 1500);
      });
    }

    /* ---------- 시트: 기록 · 한마디 · 대진표 ---------- */
    function openSheet(title, body) {
      closeSheet();
      const bg = h('div', { class: 'ec-shb', onclick: () => closeSheet() });
      const sh = h('div', { class: 'ec-sh', role: 'dialog', 'aria-label': title },
        h('h3', {}, h('span', { text: title }), h('button', { class: 'ec-x', type: 'button', 'aria-label': '닫기', text: '×', onclick: () => closeSheet() })), body);
      wrap.append(bg, sh);
      sheet = { bg, sh };
    }
    function closeSheet() { if (sheet) { sheet.bg.remove(); sheet.sh.remove(); sheet = null; return true; } return false; }

    function readStats(s, seat, side) {
      const by = [0, 0, 0, 0, 0];
      let kb = 0, nbk = 0, k0 = 0, nk0 = 0;
      for (const r of s.hist) {
        const isMe = side === 'E' ? r[3] === seat : r[4] === seat;
        if (!isMe || r[2] < 2) continue;
        const key = side === 'E' ? r[5] : r[6], bet = side === 'E' ? r[7] : r[8];
        if (key) by[E.HAND - r[2]]++;
        if (bet > 0) { nbk++; if (key) kb++; } else { nk0++; if (key) k0++; }
      }
      return { by, kb, nbk, k0, nk0 };
    }
    function openLog() {
      const s = st; if (!s || !s.m) return;
      const body = h('div');
      const m = s.m;
      body.append(h('p', { class: 'muted', style: { margin: '0 0 6px', fontSize: '12px' }, text: '핵심 카드(황제·노예)를 몇 번째 수에 냈는지. 상대의 버릇을 읽는 데 씁니다. 마지막 한 장에서 강제로 낸 경우는 빼고 셉니다.' }));
      m.p.forEach((seat) => {
        body.append(h('h4', {}, h('span', { style: { color: COL(seat) }, text: '● ' }), NM(seat)));
        const row = h('div', { class: 'ec-rdrow' });
        ['E', 'S'].forEach((side) => {
          const r = readStats(s, seat, side);
