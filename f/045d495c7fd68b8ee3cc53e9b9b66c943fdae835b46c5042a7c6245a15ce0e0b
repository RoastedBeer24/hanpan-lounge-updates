  }
  function usedOf(rack0, cnt) { let u = ''; for (let k = 0; k < 53; k++) for (let i = cnt[k]; i < rack0[k]; i++) u += kc(k); return u; }
  const cloneTb = (t) => t.map((a) => a.slice());

  function planOpened(s, seat, deadline, noJ) {
    const rack0 = cntOf(s.r[seat]);
    if (noJ) rack0[JK] = 0; // keep the rack's jokers out of this plan
    const W = { tb: s.tb.map(strK), cnt: rack0.slice() };
    const legal = (tb, cnt) => tb.every((a) => analyze(a).ok) && jokerRule(s.tb, tb.map(kStr), usedOf(rack0, cnt));
    const rackN = () => W.cnt.reduce((a, b) => a + b, 0);
    function addMelds(dl) {
      const m = bestMelds(W.cnt, 0, Math.min(deadline, dl));
      if (!m) return false;
      for (const st of m.sets) { W.tb.push(st); for (const k of st) W.cnt[k]--; }
      return true;
    }
    function attach(tb, k, skip) { // put tile k onto some set; returns new tb or null (no legality of jokers checked here)
      for (let i = 0; i < tb.length; i++) {
        if (i === skip) continue;
        const pref = jokerReps(tb[i]).flat();
        for (const cand of [tb[i].concat([k]), [k].concat(tb[i])]) {
          const arr = arrange(cand, pref);
          if (arr) { const t2 = cloneTb(tb); t2[i] = arr; return t2; }
        }
      }
      return null;
    }
    function extend(allowJ) {
      for (let k = 0; k < 53; k++) {
        if (!W.cnt[k] || (isJ(k) && !allowJ)) continue;
        for (let i = 0; i < W.tb.length; i++) {
          const pref = jokerReps(W.tb[i]).flat();
          for (const cand of [W.tb[i].concat([k]), [k].concat(W.tb[i])]) {
            const arr = arrange(cand, pref);
            if (!arr) continue;
            const t2 = cloneTb(W.tb); t2[i] = arr;
            const c2 = W.cnt.slice(); c2[k]--;
            if (legal(t2, c2)) { W.tb = t2; W.cnt = c2; return true; }
