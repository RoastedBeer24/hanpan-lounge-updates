/* 숫자 타일 — 1–13 숫자 타일 4색 ×2 + 조커 2 (106개). 같은 숫자 다른 색 묶음(그룹)과 같은 색 연속 숫자(런)로
   손패를 모두 내려놓으면 승리. 첫 등록 30점, 이후 판 위 타일 자유 재배치, 조커 회수.
   타일 = 한 글자(ALPH, 같은 종류 2장은 같은 글자), 판 = 세트 문자열 배열. 온라인: 차례인 사람은 판을 로컬에서
   고치다가 {type:'play', table, used}로 새 판 전체를 보내고, 호스트가 검증한다. 편집 중인 판은 api.net.publish로 미리보기. */
(function () {
  const L = window.Lounge, U = L.util;

  /* ---------- tiles ---------- */
  const ALPH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz*';
  const JK = 52;
  const ki = (ch) => ALPH.indexOf(ch);
  const kc = (k) => ALPH[k];
  const isJ = (k) => k === JK;
  const colOf = (k) => (k / 13) | 0;
  const numOf = (k) => (k % 13) + 1;
  const kindOf = (c, n) => c * 13 + n - 1;
  const tileVal = (k) => (isJ(k) ? 30 : numOf(k));
  const COL_NAME = ['빨강', '파랑', '노랑', '검정'];
  const NEED = 30;
  const tName = (k) => (isJ(k) ? '조커' : COL_NAME[colOf(k)] + ' ' + numOf(k));
  const strK = (s) => s.split('').map(ki);
  const kStr = (a) => a.map(kc).join('');
  function cntOf(str) { const c = new Array(53).fill(0); for (const ch of str) { const k = ki(ch); if (k >= 0) c[k]++; } return c; }
  const sortStr = (s) => s.split('').sort((a, b) => ki(a) - ki(b)).join('');

  /* ---------- sets ---------- */
  /* analyze(kinds in table order) -> {ok, run:{c,b}|null, grp:{n,m}|null, pts, why} */
  function analyze(a) {
    const n = a.length;
    const r = { ok: false, run: null, grp: null, pts: 0, why: '' };
    let nj = 0;
    for (const k of a) if (isJ(k)) nj++;
    const nn = n - nj;
    if (n < 3) { r.why = '3장 이상이어야 해요'; return r; }
    if (nn === 0) { r.why = '숫자 타일이 있어야 해요'; return r; }
    let col = -1, base = 0, runOk = n <= 13;
    for (let i = 0; i < n && runOk; i++) {
      const k = a[i]; if (isJ(k)) continue;
      const c = colOf(k), b = numOf(k) - i;
      if (col < 0) { col = c; base = b; } else if (c !== col || b !== base) runOk = false;
    }
    if (runOk && base >= 1 && base + n - 1 <= 13) r.run = { c: col, b: base };
    let num = -1, mask = 0, g = n <= 4, sameNum = true, sameCol = true, c0 = -1, dupCol = false;
    for (const k of a) {
      if (isJ(k)) continue;
      const nk = numOf(k), ck = colOf(k);
      if (num < 0) num = nk; else if (nk !== num) { sameNum = false; g = false; }
      if (c0 < 0) c0 = ck; else if (ck !== c0) sameCol = false;
      if (mask & (1 << ck)) { dupCol = true; g = false; }
      mask |= 1 << ck;
    }
    if (g) r.grp = { n: num, m: mask };
    if (r.run || r.grp) {
      r.ok = true;
      const pr = r.run ? n * r.run.b + (n * (n - 1)) / 2 : 0;
      const pg = r.grp ? r.grp.n * n : 0;
      r.pts = Math.max(pr, pg);
      return r;
    }
    if (sameNum && sameCol && nn > 1) r.why = '같은 타일이 겹쳐요';
    else if (sameNum) r.why = n > 4 ? '같은 숫자는 4장까지예요' : dupCol ? '같은 숫자는 색이 모두 달라야 해요' : '같은 숫자는 색이 달라야 해요';
    else if (sameCol) r.why = n > 13 ? '13장을 넘을 수 없어요' : (runOk ? '1부터 13 사이여야 해요' : '숫자가 차례로 이어져야 해요');
    else r.why = '같은 숫자 묶음도, 같은 색 연속도 아니에요';
    return r;
  }
  /* for each joker in the set (in order): the tile kinds it may stand for */
  function jokerReps(a, r) {
    r = r || analyze(a);
    const out = [];
    if (!r.ok) return out;
    a.forEach((k, i) => {
      if (!isJ(k)) return;
      const s = [];
      if (r.run) s.push(kindOf(r.run.c, r.run.b + i));
      if (r.grp) for (let c = 0; c < 4; c++) if (!(r.grp.m & (1 << c))) s.push(kindOf(c, r.grp.n));
      out.push(s);
    });
    return out;
  }
  /* a valid ordering of the multiset a (runs ascending, jokers filling gaps), or null. pref: kinds jokers should keep */
  function arrange(a, pref) {
    if (analyze(a).ok) return a.slice();
    const n = a.length;
    const real = a.filter((k) => !isJ(k));
    if (n < 3 || !real.length) return null;
    const c = colOf(real[0]);
    if (n <= 13 && real.every((k) => colOf(k) === c)) {
      const nums = real.map(numOf).sort((x, y) => x - y);
      if (nums.every((v, i) => i === 0 || v !== nums[i - 1])) {
        const lo = nums[0], hi = nums[nums.length - 1];
        let best = null, bs = -1e9;
        for (let s = Math.max(1, hi - n + 1); s <= Math.min(lo, 14 - n); s++) {
          const arr = []; let sc = -Math.abs(s - lo) * 0.01;
          for (let v = s; v < s + n; v++) {
            if (nums.includes(v)) arr.push(kindOf(c, v));
            else { arr.push(JK); if (pref && pref.includes(kindOf(c, v))) sc += 10; }
          }
          if (sc > bs) { bs = sc; best = arr; }
        }
        if (best) return best;
      }
    }
    const nm = numOf(real[0]);
    if (n <= 4 && real.every((k) => numOf(k) === nm)) {
      const cs = real.map(colOf);
      if (new Set(cs).size === cs.length) return real.slice().sort((x, y) => x - y).concat(new Array(n - real.length).fill(JK));
    }
    return null;
  }

  /* joker rule: every joker that was on the table either still stands for (one of) the same tile(s), or that tile
     was put down from the rack this turn (one replacement tile per retrieved joker). */
  function jokerRule(startTb, endTb, used) {
    const S = [], E = [];
    for (const s of startTb) if (s.indexOf('*') >= 0) jokerReps(strK(s)).forEach((x) => S.push(x));
    if (!S.length) return true;
    for (const s of endTb) if (s.indexOf('*') >= 0) jokerReps(strK(s)).forEach((x) => E.push(x));
    const A = cntOf(used), takenE = E.map(() => false);
    function rec(i) {
      if (i >= S.length) return true;
      const reps = S[i];
      for (let j = 0; j < E.length; j++) {
        if (takenE[j] || !E[j].some((k) => reps.includes(k))) continue;
        takenE[j] = true; if (rec(i + 1)) return true; takenE[j] = false;
      }
      for (const k of reps) if (A[k] > 0) { A[k]--; if (rec(i + 1)) return true; A[k]++; }
      return false;
    }
    return rec(0);
  }

  /* full check of a submitted table. -> {ok, msg, pts (new-set points before the first meld), bad:[set idx]} */
  function checkPlay(s, seat, table, used) {
    const res = { ok: false, msg: '', pts: 0, bad: [] };
    if (!Array.isArray(table) || typeof used !== 'string' || table.length > 60) { res.msg = '잘못된 판이에요'; return res; }
    const cnt = new Array(53).fill(0);
    for (const t of table) {
      if (typeof t !== 'string' || !t.length || t.length > 20) { res.msg = '잘못된 판이에요'; return res; }
      for (const ch of t) { const k = ki(ch); if (k < 0) { res.msg = '잘못된 타일이에요'; return res; } cnt[k]++; }
    }
    const rk = cntOf(s.r[seat]), uc = cntOf(used);
    for (let k = 0; k < 53; k++) if (uc[k] > rk[k]) { res.msg = '내 패에 없는 타일이에요'; return res; }
    if (used.length !== [...used].filter((ch) => ki(ch) >= 0).length) { res.msg = '잘못된 타일이에요'; return res; }
    const want = cntOf(s.tb.join('') + used);
    for (let k = 0; k < 53; k++) if (want[k] !== cnt[k]) { res.msg = '판의 타일은 내 패로 가져올 수 없어요'; return res; }
    const an = table.map((t) => analyze(strK(t)));
    an.forEach((a, i) => { if (!a.ok) res.bad.push(i); });
    // before the first meld: old sets untouched, new sets only from the rack
    const opened = !!s.op[seat];
    let intact = true;
    if (!opened) {
      const pool = table.slice(), isNew = table.map(() => true);
      for (const o of s.tb) {
        const i = pool.findIndex((t, j) => t === o && isNew[j]);
        if (i < 0) { intact = false; break; }
        isNew[i] = false;
      }
      table.forEach((t, i) => { if (isNew[i] && an[i].ok) res.pts += an[i].pts; });
    }
    if (res.bad.length) { res.msg = an[res.bad[0]].why; return res; }
    if (!opened && !intact) { res.msg = '처음 등록 전에는 판의 타일을 옮길 수 없어요'; return res; }
    if (!used.length) { res.msg = '내 타일을 1장 이상 놓아야 해요'; return res; }
    if (!opened && res.pts < NEED) { res.msg = '처음 등록은 ' + NEED + '점 이상이어야 해요 (지금 ' + res.pts + '점)'; return res; }
    if (opened && !jokerRule(s.tb, table, used)) { res.msg = '조커를 빼려면 그 자리 타일을 내 패에서 놓아야 해요'; return res; }
    res.ok = true;
    return res;
  }

  /* ---------- state ----------
     n, nm, ai, o:{tm (turn seconds, 0 = off), rd (rounds)}, p: pool, r: racks (sorted strings), tb: table sets,
     op: opened (first meld done), t: turn, st0: round's first seat, ps: passes in a row with an empty pool,
     tc: turns this round, end: 0 playing / 1 round over / 2 match over, rn: rounds finished, sc: running scores,
     rr: last round {w, pen, d, why}, last: latest event, seq */
  function deal(s) {
    const pool = [];
    for (let k = 0; k < 52; k++) pool.push(k, k);
    pool.push(JK, JK);
    U.shuffle(pool);
    s.r = [];
    for (let i = 0; i < s.n; i++) s.r.push(sortStr(kStr(pool.splice(0, 14))));
    s.p = kStr(pool);
    s.tb = []; s.op = new Array(s.n).fill(0); s.ps = 0; s.tc = 0; s.end = 0;
    s.t = s.st0;
  }
  function init(players, opts) {
    opts = opts || {};
    const n = players.length;
    const s = {
      n, nm: players.map((p) => p.name), ai: players.map((p) => (p.ai ? 1 : 0)),
      o: { tm: [60, 120].includes(opts.timer) ? opts.timer : 0, rd: [3, 5].includes(opts.rounds) ? opts.rounds : 1 },
      st0: U.rand(n), rn: 0, sc: new Array(n).fill(0), rr: null, seq: 0,
    };
    deal(s);
    s.last = { id: 0, k: 's', s: s.t };
    return s;
  }
  function actor(s) {
    if (s.end === 2) return null;
    if (s.end === 1) return Array.from({ length: s.n }, (_, i) => i);
    return s.t;
  }
  const LIMIT = 1200;
  function endRound(s, why, w) {
    const pen = s.r.map((r) => [...r].reduce((a, ch) => a + tileVal(ki(ch)), 0));
    let win;
    if (why === 'out') win = [w];
    else { const m = Math.min(...pen); win = pen.map((p, i) => (p === m ? i : -1)).filter((i) => i >= 0); }
    const base = pen[win[0]];
    const d = pen.map((p, i) => (win.includes(i) ? 0 : -(p - base)));
    const pot = -d.reduce((a, b) => a + b, 0);
    win.forEach((i, k) => { d[i] = Math.floor(pot / win.length) + (k < pot % win.length ? 1 : 0); });
    d.forEach((x, i) => { s.sc[i] += x; });
    // per-seat result stats: [rounds won, tiles left at the last round end]
    if (!s.ks) s.ks = s.sc.map(() => [0, 0]);
    win.forEach((i) => s.ks[i][0]++); s.r.forEach((r, i) => { s.ks[i][1] = r.length; });
    s.rn++;
    s.rr = { w: win, pen, d, why };
    s.end = s.rn >= s.o.rd ? 2 : 1;
  }
  function nextTurn(s) {
    s.t = (s.t + 1) % s.n;
    s.tc++;
    if (s.tc >= LIMIT) endRound(s, 'lim');
  }
  function apply(s, seat, a) {
    if (!a || typeof a.type !== 'string') throw new Error('bad action');
    if (s.end === 2) throw new Error('game over');
    if (s.end === 1) {
      if (a.type !== 'next') throw new Error('round over');
      s.st0 = (s.st0 + 1) % s.n;
      deal(s);
      s.seq++; s.last = { id: s.seq, k: 'r', s: s.t };
      return s;
    }
    if (seat !== s.t) throw new Error('not your turn');
    if (a.type === 'draw') {
      s.seq++;
      if (s.p.length) {
        const ch = s.p[0];
        s.p = s.p.slice(1);
        s.r[seat] = sortStr(s.r[seat] + ch);
        s.ps = 0;
        s.last = { id: s.seq, k: 'd', s: seat, to: a.to ? 1 : 0 };
      } else {
        s.ps++;
        s.last = { id: s.seq, k: 'x', s: seat, to: a.to ? 1 : 0 };
        if (s.ps >= s.n) { endRound(s, 'pool'); return s; }
      }
      nextTurn(s);
      return s;
    }
    if (a.type !== 'play') throw new Error('bad action');
    const table = Array.isArray(a.table) ? a.table.map(String) : null;
    const used = String(a.used || '');
    const chk = checkPlay(s, seat, table, used);
    if (!chk.ok) throw new Error('illegal play: ' + chk.msg);
    const wasOpen = s.op[seat];
    s.tb = table;
    const rc = cntOf(s.r[seat]);
    for (const ch of used) rc[ki(ch)]--;
    let rs = ''; rc.forEach((c, k) => { for (let i = 0; i < c; i++) rs += kc(k); });
    s.r[seat] = rs;
    s.op[seat] = 1;
    s.ps = 0;
    s.seq++;
    s.last = { id: s.seq, k: 'p', s: seat, n: used.length, op: wasOpen ? 0 : 1 };
    if (!rs.length) { endRound(s, 'out', seat); return s; }
    nextTurn(s);
    return s;
  }
  function result(s) {
    if (s.end !== 2) return null;
    const rr = s.rr, nm = s.nm;
    const sg = (x) => (x > 0 ? '+' + x : x < 0 ? '−' + -x : '0');
    let head = rr.why === 'out' ? nm[rr.w[0]] + '이(가) 타일을 모두 내려놓았어요.' : rr.why === 'pool' ? '더미가 떨어지고 더 낼 사람이 없어, 남은 타일 합이 가장 적은 쪽이 이겼어요.' : '판이 너무 길어져서 남은 타일 합이 가장 적은 쪽이 이겼어요.';
    const lines = ['벌점 (남은 타일 합, 조커 30)'];
    for (let i = 0; i < s.n; i++) lines.push(nm[i] + ' · ' + rr.pen[i] + '점 → ' + sg(rr.d[i]));
    let winners = rr.w.slice();
    if (s.o.rd > 1) {
      const best = Math.max(...s.sc);
      winners = s.sc.map((v, i) => (v === best ? i : -1)).filter((i) => i >= 0);
      const order = s.sc.map((v, i) => i).sort((x, y) => s.sc[y] - s.sc[x]);
      lines.push('', s.o.rd + '판 누적');
      order.forEach((i, k) => lines.push((k + 1) + '위 ' + nm[i] + ' · ' + sg(s.sc[i])));
      head = '마지막 판: ' + head;
    }
    const ks = s.ks || s.sc.map(() => [0, 0]);
    const stats = [{ label: '남은 타일', values: ks.map((k) => k[1] + '개') }, { label: '남은 벌점', values: rr.pen.map(String) }];
    if (s.o.rd > 1) stats.unshift({ label: '이긴 판', values: ks.map((k) => String(k[0])) });
    return { winners, stats, text: head + '\n\n' + lines.join('\n') };
  }

  /* ---------- AI ---------- */
  const AI = { budget: 260, hard: 280, easyPeek: 0.2 };
  const nowMs = () => Date.now();
  function genCands(cnt) {
    const J = Math.min(2, cnt[JK]), out = [];
    for (let n = 1; n <= 13; n++) {
      const av = [];
      for (let c = 0; c < 4; c++) if (cnt[kindOf(c, n)] > 0) av.push(c);
      for (let m = 1; m < (1 << av.length); m++) {
        const cs = av.filter((_, i) => m & (1 << i));
        for (let size = Math.max(3, cs.length); size <= 4; size++) {
          const j = size - cs.length;
          if (j > J || (j && size === 4 && cs.length < 2)) continue;
          out.push(cs.map((c) => kindOf(c, n)).concat(new Array(j).fill(JK)));
        }
      }
    }
    for (let c = 0; c < 4; c++) for (let a = 1; a <= 11; a++) {
      let j = 0, real = 0;
      const arr = [];
      for (let b = a; b <= 13; b++) {
        const k = kindOf(c, b);
        if (cnt[k] > 0) { arr.push(k); real++; } else { j++; if (j > J) break; arr.push(JK); }
        if (arr.length >= 3 && real >= 1 && !isJ(arr[0])) out.push(arr.slice());
        else if (arr.length === 3 && isJ(arr[0]) && real >= 2) out.push(arr.slice()); // J x y (joker below)
      }
    }
    return out;
  }
  /* best combination of sets from the rack alone: most tiles, then most points; requires pts >= need */
  function bestMelds(cnt0, need, deadline) {
    const cnt = cnt0.slice();
    const cands = genCands(cnt);
    if (!cands.length) return null;
    const pts = cands.map((c) => analyze(c).pts);
    const by = Array.from({ length: 53 }, () => []);
    cands.forEach((c, i) => { const seen = new Set(); for (const k of c) if (!isJ(k) && !seen.has(k)) { seen.add(k); by[k].push(i); } });
    let best = null, bT = 0, bP = 0, nodes = 0, stop = false;
    const cur = [];
    function take(c) { let ok = true; for (const k of c) if (--cnt[k] < 0) ok = false; if (!ok) for (const k of c) cnt[k]++; return ok; }
    function give(c) { for (const k of c) cnt[k]++; }
    function rec(tiles, p) {
      if ((++nodes & 127) === 0 && nowMs() > deadline) { stop = true; return; }
      if (p >= need && tiles > 0 && (tiles > bT || (tiles === bT && p > bP))) { bT = tiles; bP = p; best = cur.slice(); }
      let rem = 0, k = -1;
      for (let i = 0; i < 53; i++) if (cnt[i] > 0 && (i === JK || by[i].length)) { rem += cnt[i]; if (k < 0 && i !== JK) k = i; }
      if (k < 0 || (best && tiles + rem <= bT && p >= need)) return;
      for (const ci of by[k]) {
        const c = cands[ci];
        if (!take(c)) continue;
        cur.push(c); rec(tiles + c.length, p + pts[ci]); cur.pop(); give(c);
        if (stop) return;
