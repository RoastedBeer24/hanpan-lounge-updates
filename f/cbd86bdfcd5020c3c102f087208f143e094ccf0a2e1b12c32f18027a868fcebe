    let flashes = [], doneFx = 0, qn = null, lp = null, rafOn = true, cdShown = -9, wasBad = 0;

    const sp = () => L.debug.speed || 1;
    const seat = () => {
      if (!st) return -1;
      if (st.md === 't') return st.ph === 'g' && api.canAct(st.cur) ? st.cur : -1;
      const m = api.mySeats(); return m.length ? m[0] : -1;
    };
    const el = () => (performance.now() - localStart) * sp() - CD;   // local race clock (ms)
    function newBoard() { return { v: toArr(st.pz), n: new Uint16Array(81), un: [], re: [], sel: -1, sent: '' }; }
    const onCancelEv = (e) => { const b = B(); if (b && b.sel >= 0) { b.sel = -1; render(); e.preventDefault(); } };
    window.addEventListener('lounge-cancel', onCancelEv);
    function B() { const s = seat(); if (s < 0) return null; if (!boards[s]) boards[s] = newBoard(); return boards[s]; }
    const given = (i) => st && st.pz[i] !== '0';
    const filledCount = (b) => { let n = 0; for (let i = 0; i < 81; i++) if (!given(i) && b.v[i]) n++; return n; };
    const locked = () => { const s = seat(); return s < 0 || !st || st.ph !== 'g' || st.tm[s] >= 0 || st.gv[s] || el() < 0 || pending; };

    /* ---------- sizing ---------- */
    function fit() {
      const r = gbox.getBoundingClientRect();
      const sz = Math.max(120, Math.floor(Math.min(r.width, r.height)));
