    if (seat === driverSeat(s) && s.end === 'f' && s.ft >= 0) dl = Math.min(dl, s.ft + GRACE - el);
    return isFinite(dl) ? Math.max(0, dl) : -1;
  }
  function ai(s, seat) {
    if (s.ph !== 'g' || s.md !== 'r') return null;
    if (s.hu[seat]) return doneSeat(s, seat) ? null : { type: 'gv' };
    const el = hostEl(s);
    if (!doneSeat(s, seat)) {
      const pl = aiPlan(s, seat), k = Math.min(s.wr[seat], pl.sub.length - 1);
