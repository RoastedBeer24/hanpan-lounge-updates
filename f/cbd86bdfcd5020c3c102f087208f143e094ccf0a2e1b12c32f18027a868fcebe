      snap(b);
      if (b.v[i] === d) { b.v[i] = 0; api.sfx('tick'); changed(b, null); return; }
      b.v[i] = d; b.n[i] = 0;
      const bit = ~(1 << (d - 1));
      if (cfg.clr) for (const p of PEERS[i]) b.n[p] &= bit;
      api.sfx('click'); api.buzz(10);
      changed(b, i);
    }
    function toggleNote(i, d) {
      const b = B(); if (!b || locked() || given(i)) return;
      if (b.v[i]) { api.toast('숫자가 있는 칸이에요'); return; }
      snap(b);
      b.n[i] ^= 1 << (d - 1);
      api.sfx('pop'); api.buzz(6);
      changed(b, null);
    }
    function erase() {
      const b = B(); if (!b || locked() || b.sel < 0 || given(b.sel)) return;
      if (!b.v[b.sel] && !b.n[b.sel]) return;
      snap(b); b.v[b.sel] = 0; b.n[b.sel] = 0; api.sfx('tick'); changed(b, null);
