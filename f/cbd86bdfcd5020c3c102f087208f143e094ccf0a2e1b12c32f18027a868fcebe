      if (x > 0.85) k *= 0.55;                                   // last cells fall quickly (full houses)
      w.push(k * (0.35 - Math.log(1 - r() * 0.98) * 0.65));       // human-ish jitter
    }
    w[0] += 0.06 * w.reduce((a, b) => a + b, 0);                  // first scan of the board
    const sum = w.reduce((a, b) => a + b, 0);
    const cum = new Float64Array(s.bl + 1);
    for (let i = 0; i < s.bl; i++) cum[i + 1] = cum[i] + (w[i] / sum) * T;
    const sub = [Math.round(T)];
    if (r() < WRONG[lv - 1]) sub.push(Math.round(T + (8000 + r() * 30000) * LVM[lv - 1]));
    const pl = { cum, sub, T };
    if (planCache.size > 200) planCache.clear();
    planCache.set(key, pl);
    return pl;
  }
  function aiFilled(s, seat, el) {           // cells filled by an AI at race-clock `el`
    const pl = aiPlan(s, seat);
