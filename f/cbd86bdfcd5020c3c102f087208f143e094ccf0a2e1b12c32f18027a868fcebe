      return s;
    }
    if (t === 'gv') {
      s.gv[seat] = 1;
      ev(s, seat, 'gv');
      if (s.md === 't') nextTurn(s); else checkEnd(s);
      return s;
    }
    if (t === 'ai') {
      if (s.hu[seat] || s.md !== 'r') throw new Error('not an AI');
      const pl = aiPlan(s, seat), k = s.wr[seat];
      if (k >= pl.sub.length) throw new Error('no plan');
      if (k < pl.sub.length - 1) { s.wr[seat]++; s.f[seat] = s.bl; if (s.mm) loseHeart(s, seat); else ev(s, seat, 'bad'); return s; }
      if (s.end === 'f' && s.ft >= 0 && pl.sub[k] > s.ft + GRACE) { settleAI(s, s.ft + GRACE); s.ph = 'e'; return s; }
      finish(s, seat, pl.sub[k]);
      return s;
    }
    throw new Error('bad action');
  }

  function fmtT(ms) {
    if (ms == null || ms < 0) return '–';
    const t = Math.floor(ms / 100), m = Math.floor(t / 600), sec = Math.floor(t / 10) % 60;
    return m + ':' + String(sec).padStart(2, '0') + '.' + (t % 10);
  }
  /* finishers ranked by time + penalties. Turn mode with 'first finish +30 s': a finish slower than the best + 30 s is
     listed as over time (the race-mode equivalent of the game ending 30 s after the first finisher). */
  function standings(s) {
    let fin = [], rest = [];
    for (let i = 0; i < s.n; i++) (s.tm[i] >= 0 ? fin : rest).push(i);
    fin.sort((a, b) => adj(s, a) - adj(s, b) || a - b);
    const over = [];
    if (s.md === 't' && s.end === 'f' && fin.length) { const cut = adj(s, fin[0]) + GRACE; fin = fin.filter((i) => (adj(s, i) <= cut ? true : (over.push(i), false))); }
    rest.sort((a, b) => s.gv[a] - s.gv[b] || s.f[b] - s.f[a] || a - b);
    return { fin, rest, over };
  }
  function result(s) {
    if (s.ph !== 'e') return null;
    const { fin, rest, over } = standings(s);
    const best = fin.length ? adj(s, fin[0]) : -1;
    const winners = fin.filter((i) => adj(s, i) === best);
    const extra = (i) => {
      const p = []; if (s.wr[i] && s.pen) p.push('오답 ' + s.wr[i] + '회 +' + s.wr[i] * s.pen + '초'); if (s.hn[i]) p.push('힌트 ' + s.hn[i] + '회 +' + s.hn[i] * 30 + '초');
      return p.length ? ' (' + p.join(', ') + ')' : '';
    };
    const lines = fin.map((i, k) => (k + 1) + '. ' + s.nm[i] + '  ' + fmtT(adj(s, i)) + extra(i))
      .concat(over.map((i) => '–  ' + s.nm[i] + '  시간 초과 ' + fmtT(adj(s, i))))
      .concat(rest.map((i) => '–  ' + s.nm[i] + '  ' + (s.gv[i] === 3 ? '탈락 (실수 3번) ' + s.f[i] + '/' + s.bl : s.gv[i] === 2 ? '시간 초과' : s.gv[i] ? '포기' : '미완주 ' + s.f[i] + '/' + s.bl)));
    const head = DIFF[s.d] + ' · 빈칸 ' + s.bl + '개' + (s.mm ? ' · 실수 3번 제한' : '');
    const all = Array.from({ length: s.n }, (_, i) => i);
    const stats = [{ label: '채운 칸', values: all.map((i) => s.f[i]) }, { label: '기록(초)', values: all.map((i) => (s.tm[i] >= 0 ? Math.round(adj(s, i) / 1000) : '–')) },
      s.mm ? { label: '실수', values: all.map((i) => (s.mi[i] || 0) + '/3') } : { label: '오답', values: all.map((i) => s.wr[i]) }, { label: '힌트', values: all.map((i) => s.hn[i]) }];
    if (s.n === 1) {
      return fin.length
        ? { winners: [0], stats, title: '완성! ' + fmtT(adj(s, 0)), text: head + (extra(0) ? '\n기록' + extra(0) : '') }
        : { winners: [], stats, title: s.gv[0] === 3 ? '탈락 · 실수 3번' : '포기했어요', text: head + ' · ' + s.f[0] + '/' + s.bl + '칸 채움' };
    }
    return { winners, stats, title: winners.length ? null : '완주한 사람이 없어요', text: head + '\n' + lines.join('\n') };
  }

  /* ---------- AI: simulated solving schedule ---------- */
  const SPC = [6, 8.5, 12, 17];               // seconds per blank at 보통, by difficulty
  const LVM = [1.65, 1, 0.62];               // 쉬움 · 보통 · 어려움
  const WRONG = [0.28, 0.12, 0.04];          // chance of one wrong submission
  const planCache = new Map();
  function gauss(r) { return Math.sqrt(-2 * Math.log(1 - r())) * Math.cos(2 * Math.PI * r()); }
  function aiPlan(s, seat) {
    const lv = U.clamp(s.lv[seat] || 2, 1, 3);
    const key = s.g + ':' + seat + ':' + lv + ':' + s.bl + ':' + s.gl;
    const c = planCache.get(key);
    if (c) return c;
    const r = prng(hash(s.g, seat, lv, 911));
    const tech = s.gl >= 4 ? 1.25 : s.gl === 3 ? 1.1 : 1;
    let T = s.bl * SPC[s.d] * tech * LVM[lv - 1] * Math.exp(gauss(r) * 0.14) * 1000;
    const stuck = r() < [0.35, 0.2, 0.1][lv - 1] * (s.gl >= 2 ? 1.4 : 0.7);
    if (stuck) T *= 1.15 + r() * 0.25;
    const stallAt = 0.3 + r() * 0.35, stallAmp = (s.gl >= 2 ? 1.2 : 0.4) * (stuck ? 2.2 : 1);
