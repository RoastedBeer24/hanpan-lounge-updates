    const ro = new ResizeObserver(fit); ro.observe(gbox);
    const geo = () => { const pad0 = Math.max(3, gsz * 0.012); const cs = (gsz - pad0 * 2) / 9; return { p: pad0, cs }; };

    /* ---------- editing ---------- */
    function snap(b) { b.un.push({ v: toStr(b.v), n: Array.from(b.n) }); if (b.un.length > 300) b.un.shift(); b.re = []; }
    function restore(b, s) { b.v = toArr(s.v); b.n = Uint16Array.from(s.n); }
    function changed(b, cells) {
      // flash units that just became full
      if (cells != null) {
        UNITS_OF[cells].forEach((u) => { if (UNITS[u].every((i) => b.v[i])) flashes.push({ c: UNITS[u], t: performance.now() }); });
      }
      publish(); render(); maybeSubmit();
    }
    function setDigit(d) {
      const b = B(); if (!b || locked()) return;
      const i = b.sel;
      if (i < 0) { api.toast('먼저 칸을 골라 주세요'); return; }
