    const gbox = L.h('div', { class: 'sdk-gbox' }, cv, cdEl);
    const tb = (ic, lab, fn) => L.h('button', { class: 'sdk-tool', 'aria-label': lab, onclick: fn }, L.h('i', { text: ic }), lab);
    const undoBtn = tb('↶', '되돌리기', () => undo());
    const redoBtn = tb('↷', '다시하기', () => redo());
    const eraseBtn = tb('⌫', '지우기', () => erase());
    const notesBtn = tb('✎', '메모', () => { notesMode = !notesMode; U.store.set('sudoku.notes', notesMode); api.sfx('click'); api.buzz(8); render(); });
    const notesBadge = L.h('span', { class: 'badge' }); notesBtn.append(notesBadge);
    const tools = L.h('div', { class: 'sdk-tools' }, undoBtn, redoBtn, eraseBtn, notesBtn);
    const keys = [];
    const pad = L.h('div', { class: 'sdk-pad' });
    for (let d = 1; d <= 9; d++) { const k = L.h('button', { class: 'sdk-key', 'aria-label': String(d) }, String(d), L.h('small')); keys.push(k); pad.append(k); }
