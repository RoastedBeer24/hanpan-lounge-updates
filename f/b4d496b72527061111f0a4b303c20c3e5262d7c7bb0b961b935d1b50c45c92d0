      h('div', { style: { fontSize: '13px', opacity: '.75' }, text: '전장을 준비하는 중' }));
    root.append(box);
    loadAll().then(() => {
      if (dead) return;
      view = CS.VIEW.mount(root, api);
      box.remove();
      if (last) view.update(last, lastPrev);
    }).catch((e) => { box.lastChild.textContent = '파일을 불러오지 못했습니다. (' + (e && e.message || e) + ')'; });
    return {
      update(s, p) { last = s; lastPrev = p; if (view) view.update(s, p); },
      destroy() { dead = true; if (view) view.destroy(); box.remove(); },
    };
  }

