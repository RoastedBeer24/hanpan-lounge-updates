      const el = document.createElement('script'); el.src = src; el.async = true;
      el.onload = () => ok(); el.onerror = () => { delete scripts[src]; no(new Error(src)); };
      document.head.appendChild(el);
    });
    return scripts[src];
  }
  const loadAll = () => (CS.SIM ? Promise.resolve() : loadScript('assets/covershot/sim.js')).then(() => (CS.DRAW ? null : loadScript('assets/covershot/art.js'))).then(() => (CS.VIEW ? null : loadScript('assets/covershot/view.js')));

