    show(h('div', { class: 'screen' }, topbarSimple('온라인'),
      h('div', { class: 'scroll', style: { display: 'flex', flexDirection: 'column', gap: '14px', paddingTop: '24px' } },
        h('p', { text: msg }), h('button', { class: 'btn', text: '처음으로', onclick: homeScreen }))));
  }

  /* ---------- boot ---------- */
  L.boot = function () {
    homeScreen();
    document.addEventListener('gesturestart', (e) => e.preventDefault());
    // mouse side buttons (4/5 = back/forward) do nothing: they used to fire history back → the leave-game pause
    let sideBtnT = -1e9;   // when a side button was last used: a history 'back' right after it is ignored
    ['pointerdown', 'pointerup', 'mousedown', 'mouseup', 'auxclick'].forEach((t) => window.addEventListener(t, (e) => {
      if (e.button === 3 || e.button === 4) { sideBtnT = performance.now(); e.preventDefault(); e.stopPropagation(); }
    }, true));
    if (L.STANDALONE) {
      // phone back button inside a game asks before leaving instead of closing the app
      window.addEventListener('popstate', () => {
        if (!S) return;
        try { history.pushState({ lounge: 'game' }, ''); } catch (e) {}
        // PC: only Esc leaves — the back event there comes from mouse side buttons
        if (window.LOUNGE_DESKTOP || performance.now() - sideBtnT < 1500) return;
        if (!document.querySelector('.overlay:not(.result)')) leaveGame();
      });
    }
  };
  /* test hook: start a local game directly */
  L.debug.local = function (id, seats, opts) {   // opts: {optionId: value}, missing ones use defaults
    const g = L.games[id];
    seats = seats || Array.from({ length: g.defaultPlayers || g.minPlayers }, (_, i) => ({ name: 'AI ' + (i + 1), ai: true }));
    startSession('local', id, seats.map((s, i) => ({ name: s.name, ai: !!s.ai, local: !s.ai, color: COLORS[i], lv: s.lv || 2 })), null, optDefaults(g, opts));
    return S;
  };
  L.debug.home = () => homeScreen();
})();
