/* 한탕 뒤 대치 — 4~8명 블러핑 파티 게임. 한탕을 마친 일당이 창고에서 전리품을 두고 서로 겨눠요.
   라운드마다: ① 몰래 카드(실탄/공포탄)를 고르고 한 명을 겨눔(동시) ② 겨눈 방향 공개 → 버티기/빠지기(동시)
   ③ 발사: 실탄은 상처 1(3개면 탈락), 빠진 사람은 안전하지만 몫 없음(내 총도 안 쏨) ④ 다치지 않고 버틴 사람끼리
   대장 패 순서로 전리품을 한 장씩 나눠 가짐. 8라운드 뒤 가장 부자가 승리. 각자 실탄 3 · 공포탄 5(라운드마다 1장 씀). */
(function () {
  const L = window.Lounge, U = L.util;

  /* ---------- data ---------- */
  const ROUNDS = 8, LIVE0 = 3, BLANK0 = 5, MAXW = 3;
  // 전리품(천 원 단위). c5/c10/c20 현금, gem 보석, art 그림, bond 채권, med 치료 상자
  const LOOT = {
    c5: { n: '현금', s: '5천', v: 5, k: 'cash' },
    c10: { n: '현금', s: '1만', v: 10, k: 'cash' },
    c20: { n: '현금', s: '2만', v: 20, k: 'cash' },
    gem: { n: '보석', s: '보석', v: 5, k: 'gem' },
    art: { n: '그림', s: '그림', v: 0, k: 'art' },
    bond: { n: '채권', s: '채권', v: 0, k: 'bond' },
    med: { n: '치료 상자', s: '치료', v: 5, k: 'med' },
  };
  const DECK = { c5: 12, c10: 12, c20: 8, gem: 10, art: 10, bond: 6, med: 6 };   // 64장 = 8명 × 8라운드
  const ART_SET = [0, 4, 12, 30, 60, 100];
  const GEM_BONUS = 50, BOND_CLEAN = 30, BOND_HURT = 10;
  const won = (v) => (v >= 10 ? (v % 10 ? (v / 10).toFixed(1) : String(v / 10)) + '만' : v ? v + '천' : '0');

  const ICON = '<circle cx="28" cy="28" r="19" fill="none" stroke="currentColor" stroke-width="2.6"/>' +
    '<circle cx="28" cy="28" r="4" fill="currentColor"/>' +
    '<circle cx="28" cy="15" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="39.3" cy="21.5" r="4.2" fill="currentColor"/>' +
    '<circle cx="39.3" cy="34.5" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="28" cy="41" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2"/>' +
    '<circle cx="16.7" cy="34.5" r="4.2" fill="currentColor"/><circle cx="16.7" cy="21.5" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2"/>';

  /* ---------- helpers ---------- */
  function shuffle(a) { for (let i = a.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; const t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function hash(n) { n = (n ^ 61) ^ (n >>> 16); n = (n + (n << 3)) | 0; n ^= n >>> 4; n = Math.imul(n, 0x27d4eb2d); n ^= n >>> 15; return (n >>> 0) / 4294967296; }
  const alive = (s) => s.wd.map((w, i) => (s.out[i] ? -1 : i)).filter((i) => i >= 0);
  function nextAlive(s, from) { for (let k = 1; k <= s.n; k++) { const j = (from + k) % s.n; if (!s.out[j]) return j; } return from; }

  function moneyOf(s, p, final) {
    const g = s.got[p];
    let v = 0, gems = 0, art = 0;
    for (const c of g) {
      const d = LOOT[c];
      if (d.k === 'cash' || d.k === 'med') v += d.v;
      else if (d.k === 'gem') { v += d.v; gems++; }
      else if (d.k === 'art') art++;
      else if (d.k === 'bond') v += s.wd[p] === 0 ? BOND_CLEAN : BOND_HURT;
    }
    v += ART_SET[Math.min(art, ART_SET.length - 1)];
    if (final !== false) {
      let mx = 0;
      for (let i = 0; i < s.n; i++) mx = Math.max(mx, s.got[i].filter((c) => c === 'gem').length);
      if (mx > 0 && gems === mx) v += GEM_BONUS;
    }
    return v;
  }

  /* ---------- init ---------- */
  function init(players) {
    const n = players.length;
    const deck = [];
    for (const k in DECK) for (let i = 0; i < DECK[k]; i++) deck.push(k);
    shuffle(deck);
    const s = {
      n, rd: 1, ph: 'pick', lead: 0, nm: players.map((p, i) => String((p && p.name) || (i + 1) + '번')).map((t) => t.slice(0, 16)),
      live: new Array(n).fill(LIVE0), blank: new Array(n).fill(BLANK0),
      wd: new Array(n).fill(0), out: new Array(n).fill(false),
      pk: new Array(n).fill(null), hd: new Array(n).fill(null),
      deck, loot: [], got: Array.from({ length: n }, () => []), lq: [],
      res: null, ev: [], eid: 0, seed: (Math.random() * 1e9) | 0,
      // 공개 기록(AI가 읽음): 실탄을 쏜 수·공포탄 수·버틴 수·빠진 수·겨눔 당한 수
      mem: Array.from({ length: n }, () => ({ L: 0, B: 0, h: 0, f: 0, hit: 0, by: [] })),
      st: { hits: new Array(n).fill(0), folds: new Array(n).fill(0), held: new Array(n).fill(0) },
    };
    s.loot = s.deck.splice(0, n);
    pushEv(s, { k: 'round', rd: 1 });
    return s;
  }
  function pushEv(s, e) { e.id = ++s.eid; s.ev.push(e); if (s.ev.length > 6) s.ev.shift(); }

  function actor(s) {
    if (s.ph === 'over') return null;
    if (s.ph === 'pick') return alive(s).filter((i) => !s.pk[i]);
    if (s.ph === 'hold') return alive(s).filter((i) => s.hd[i] == null);
    if (s.ph === 'loot') return s.lq.length ? s.lq[0] : null;
    return null;
  }

  function apply(s, seat, a) {
    if (!a || typeof a !== 'object') throw new Error('bad');
    if (s.ph === 'pick') {
      if (s.out[seat] || s.pk[seat] || a.t !== 'pk') throw new Error('no pick');
      const c = a.c === 'L' ? 'L' : a.c === 'B' ? 'B' : null;
      const to = a.to | 0;
      if (!c || to === seat || to < 0 || to >= s.n || s.out[to]) throw new Error('bad target');
      if (c === 'L' && s.live[seat] <= 0) throw new Error('no live');
      if (c === 'B' && s.blank[seat] <= 0) throw new Error('no blank');
      s.pk[seat] = { c, to };
      if (alive(s).every((i) => s.pk[i])) {
        s.ph = 'hold';
        const aims = s.pk.map((p) => (p ? p.to : -1));
        pushEv(s, { k: 'aim', aims });
      }
      return s;
    }
    if (s.ph === 'hold') {
      if (s.out[seat] || s.hd[seat] != null || a.t !== 'hd') throw new Error('no hold');
      s.hd[seat] = a.v ? 1 : 0;
      if (alive(s).every((i) => s.hd[i] != null)) resolve(s);
      return s;
    }
    if (s.ph === 'loot') {
      if (s.lq[0] !== seat || a.t !== 'tk') throw new Error('not your pick');
      const i = a.i | 0;
      if (i < 0 || i >= s.loot.length) throw new Error('bad card');
      take(s, seat, i);
      s.lq.push(s.lq.shift());
      if (!s.loot.length) nextRound(s);
      return s;
    }
    throw new Error('over');
  }

  function take(s, seat, i) {
    const c = s.loot.splice(i, 1)[0];
    let healed = false;
    if (c === 'med' && s.wd[seat] > 0) { s.wd[seat]--; healed = true; }
    else s.got[seat].push(c);
    pushEv(s, { k: 'take', p: seat, c, healed });
  }

  function resolve(s) {
    const al = alive(s), hits = new Array(s.n).fill(0), cards = new Array(s.n).fill(null);
    for (const i of al) {
      const p = s.pk[i];
      cards[i] = p.c;
      if (p.c === 'L') s.live[i]--; else s.blank[i]--;
      const m = s.mem[i];
      if (p.c === 'L') m.L++; else m.B++;
      if (s.hd[i]) m.h++; else m.f++;
      s.mem[p.to].by.push(i); if (s.mem[p.to].by.length > 6) s.mem[p.to].by.shift();
    }
    for (const i of al) {
      const p = s.pk[i];
      if (s.hd[i] === 1 && p.c === 'L' && s.hd[p.to] === 1) { hits[p.to]++; s.st.hits[i]++; s.mem[i].hit++; }
    }
    const newOut = [];
    for (const i of al) {
      if (s.hd[i] === 0) s.st.folds[i]++; else s.st.held[i]++;
      if (hits[i]) { s.wd[i] = Math.min(MAXW, s.wd[i] + hits[i]); if (s.wd[i] >= MAXW) { s.out[i] = true; newOut.push(i); } }
    }
    const elig = al.filter((i) => s.hd[i] === 1 && !hits[i] && !s.out[i]);
    s.res = { rd: s.rd, cards, aims: s.pk.map((p) => (p ? p.to : -1)), hd: s.hd.slice(), hits, out: newOut, elig };
    pushEv(s, { k: 'shot', rd: s.rd });
    // 대장 패 순서(대장부터 시계 방향)로 줄 세우기
    const order = [];
    for (let k = 0; k < s.n; k++) { const j = (s.lead + k) % s.n; if (elig.includes(j)) order.push(j); }
    s.lq = order;
    if (!order.length) { pushEv(s, { k: 'carry', n: s.loot.length }); nextRound(s); return; }
    if (order.length === 1) { while (s.loot.length) take(s, order[0], bestIdx(s, order[0])); nextRound(s); return; }
    s.ph = 'loot';
  }

  function nextRound(s) {
    s.lq = [];
    s.pk = new Array(s.n).fill(null);
    s.hd = new Array(s.n).fill(null);
    const al = alive(s);
    if (s.rd >= ROUNDS || al.length <= 1) { s.ph = 'over'; pushEv(s, { k: 'over' }); return; }
    s.rd++;
    s.lead = nextAlive(s, s.lead);
    s.loot = s.loot.concat(s.deck.splice(0, s.n));
    s.ph = 'pick';
    pushEv(s, { k: 'round', rd: s.rd });
  }

  /* 한 사람의 전리품 내역(끝 계산 기준) — 합계는 moneyOf와 같아요 */
  function parts(s, p, final) {
    const r = { cash: 0, gemN: 0, artN: 0, bondN: 0, medN: 0 };
    for (const c of s.got[p]) {
      const k = LOOT[c].k;
      if (k === 'cash') r.cash += LOOT[c].v; else if (k === 'gem') r.gemN++; else if (k === 'art') r.artN++; else if (k === 'bond') r.bondN++; else r.medN++;
    }
    let mx = 0;
    for (let i = 0; i < s.n; i++) mx = Math.max(mx, s.got[i].filter((c) => c === 'gem').length);
    r.gemMax = mx;
    r.gem = r.gemN * LOOT.gem.v; r.bonus = final !== false && mx > 0 && r.gemN === mx ? GEM_BONUS : 0;
    r.art = ART_SET[Math.min(r.artN, ART_SET.length - 1)];
    r.bond = r.bondN * (s.wd[p] === 0 ? BOND_CLEAN : BOND_HURT);
    r.med = r.medN * LOOT.med.v;
    r.total = r.cash + r.gem + r.bonus + r.art + r.bond + r.med;
    return r;
  }
  const nmOf = (s, i) => (s.nm && s.nm[i]) || (i + 1) + '번';

  function result(s) {
    if (s.ph !== 'over') return null;
    const m = s.got.map((_, i) => moneyOf(s, i));
    const al = alive(s);
    const pool = al.length ? al : s.got.map((_, i) => i);
    let best = -1;
    for (const i of pool) best = Math.max(best, m[i]);
    const winners = pool.filter((i) => m[i] === best);
    const P = s.got.map((_, i) => parts(s, i));
    const hl = [];
    // 왜 이겼나: 2위와의 차이 + 가장 큰 몫
    let second = -1;
    for (const i of pool) if (!winners.includes(i)) second = Math.max(second, m[i]);
    const W = P[winners[0]];
    const big = [['현금', W.cash], ['보석' + (W.bonus ? '(최다 보너스 포함)' : ''), W.gem + W.bonus], ['그림 ' + W.artN + '장 세트', W.art], ['채권 ' + W.bondN + '장', W.bond], ['치료 상자', W.med]]
      .sort((a, b) => b[1] - a[1])[0];
    let text = '전리품 ' + won(best) + '으로 가장 부자!';
    if (second >= 0) text += '\n2위보다 ' + won(best - second) + ' 더 · 가장 큰 몫은 ' + big[0] + ' ' + won(big[1]);
    else if (winners.length > 1) text += '\n똑같이 ' + won(best) + ' — 공동 승리';
    const richOut = s.got.map((_, i) => i).filter((i) => s.out[i] && m[i] > best);
    if (richOut.length) hl.push(richOut.map((i) => nmOf(s, i)).join(', ') + ' — 더 많이 모았지만 상처 3개로 쓰러져 우승 불가');
    else if (s.out.some((x) => x)) hl.push('상처 3개로 쓰러진 사람: ' + s.out.map((x, i) => (x ? nmOf(s, i) : null)).filter(Boolean).join(', '));
    const gmax = P.length ? P[0].gemMax : 0;
    if (gmax > 0) hl.push('보석 최다(' + gmax + '개) +' + won(GEM_BONUS) + ': ' + P.map((r, i) => (r.bonus ? nmOf(s, i) : null)).filter(Boolean).join(', '));
    const artBest = Math.max(...P.map((r) => r.artN));
    if (artBest >= 3) hl.push('그림 ' + artBest + '장 세트(' + won(ART_SET[Math.min(artBest, 5)]) + '): ' + P.map((r, i) => (r.artN === artBest ? nmOf(s, i) : null)).filter(Boolean).join(', '));
    return {
      winners, text,
      highlights: hl,
      stats: [
        { label: '상처', values: s.wd.map((w, i) => (s.out[i] ? '탈락' : w)) },
        { label: '명중시킨 수', values: s.st.hits.slice() },
        { label: '빠진 수', values: s.st.folds.slice() },
      ],
      tables: [{
        title: '누가 무엇을 가져갔나',
        head: ['', '합계', '현금', '보석', '그림', '채권', '치료'],
        rows: P.map((r, i) => [nmOf(s, i) + (s.out[i] ? ' ✕' : ''), { t: won(r.total), v: s.out[i] ? -1 : r.total, tip: s.out[i] ? '탈락 — 우승 불가' : '' }, won(r.cash),
          r.gemN + (r.bonus ? '+5만' : ''), r.artN ? r.artN + '장 ' + won(r.art) : '0', r.bondN ? won(r.bond) : '0', r.medN ? won(r.med) : '0']),
        best: [1],
      }],
    };
  }

  /* ---------- AI ---------- */
  function habit(s, seat) {
    const r = (k) => hash(s.seed * 17 + seat * 131 + k);
    return { bold: r(1) * 2 - 1, trig: r(2) * 2 - 1, grudge: r(3), greed: r(4) * 2 - 1, bluff: r(5) };
  }
  const styleOf = (seat) => (L.aiStyle && L.aiStyle(seat)) || 'bal';
  function liveProb(s, a, lv) {
    // a가 이번에 실탄을 냈을 확률(공개된 남은 장수 + 버릇 읽기)
    const L0 = s.live[a], B0 = s.blank[a];
    if (L0 <= 0) return 0;
    if (B0 <= 0) return 1;
    const left = ROUNDS - s.rd + 1;
    if (lv <= 1) return 0.38;
    let p = L0 / (L0 + B0);
    if (L0 >= left) p = 1;
    return p;
  }
  function lootValueFor(s, seat, c) {
    const d = LOOT[c];
    if (d.k === 'cash') return d.v;
    if (d.k === 'gem') { const mine = s.got[seat].filter((x) => x === 'gem').length; let mx = 0; for (let i = 0; i < s.n; i++) if (i !== seat) mx = Math.max(mx, s.got[i].filter((x) => x === 'gem').length); return 5 + (mine + 1 >= mx ? 14 : 5); }
    if (d.k === 'art') { const a = s.got[seat].filter((x) => x === 'art').length; return ART_SET[Math.min(a + 1, 5)] - ART_SET[Math.min(a, 5)] + (a >= 1 ? 4 : 2); }
    if (d.k === 'bond') return s.wd[seat] === 0 ? 22 : BOND_HURT;
    if (d.k === 'med') return s.wd[seat] === 2 ? 45 : s.wd[seat] === 1 ? 20 : 5;
    return 0;
  }
  function bestIdx(s, seat) {
    let bi = 0, bv = -1e9;
    s.loot.forEach((c, i) => { const v = lootValueFor(s, seat, c); if (v > bv) { bv = v; bi = i; } });
    return bi;
  }
  function potValue(s, seat) { let v = 0; for (const c of s.loot) v += lootValueFor(s, seat, c); return v; }

  function ai(s, seat, lv) {
    lv = lv || 2;
    const hb = habit(s, seat), sty = styleOf(seat);
    const noise = lv === 1 ? 1 : lv === 2 ? 0.45 : 0.2;
    const rnd = () => (Math.random() - 0.5) * 2;
    if (s.ph === 'pick') {
      const al = alive(s).filter((i) => i !== seat);
      if (!al.length) return null;
      const money = s.got.map((_, i) => moneyOf(s, i, false));
      const maxM = Math.max(1, ...money);
      if (lv >= 3) {
        // 어려움: 실탄은 버틸 사람에게(맞히면 몫 경쟁자가 줄어듦), 공포탄은 겁 많은 사람에게(겁주면 빠져서 몫이 늘어남)
        const left = ROUNDS - s.rd + 1;
        const ev = al.map((j) => {
          const m = s.mem[j], tot = m.h + m.f;
          let hr = tot ? (m.h + 1.4) / (tot + 2) : 0.7;
          if (s.wd[j] === MAXW - 1) hr *= 0.6;
          const worth = 8 + (money[j] / maxM) * 6 + (j === s.lead ? 3 : 0) + (s.wd[j] === MAXW - 1 ? 14 : 0) + s.mem[seat].by.filter((x) => x === j).length * hb.grudge * 3;
          return { j, L: hr * worth + rnd() * 1.2, B: (1 - hr) * 7 + rnd() * 1.2 };
        });
        const bl = ev.slice().sort((a, b) => b.L - a.L)[0], bb = ev.slice().sort((a, b) => b.B - a.B)[0];
        let c;
        if (s.live[seat] <= 0) c = 'B';
        else if (s.blank[seat] <= 0 || s.live[seat] >= left) c = 'L';
        else {
          let p = s.live[seat] / left + (bl.L - 8) * 0.03 + hb.trig * 0.08 + (sty === 'agg' ? 0.06 : sty === 'def' ? -0.05 : 0);
          c = Math.random() < Math.max(0.08, Math.min(0.92, p)) ? 'L' : 'B';
        }
        return { t: 'pk', c, to: c === 'L' ? bl.j : bb.j };
      }
      // 겨눌 사람 점수: 부자·대장(먼저 고름)·곧 쓰러질 사람·나를 겨눴던 사람·잘 버티는 사람
      const scored = al.map((j) => {
        let v = 0;
        if (lv >= 2) {
          v += (money[j] / maxM) * 1.4;
          if (j === s.lead) v += 0.6;
          if (s.wd[j] === MAXW - 1) v += 0.8 + (lv >= 3 ? 0.4 : 0);
          const grudge = s.mem[seat].by.filter((x) => x === j).length;
          v += grudge * (0.35 + hb.grudge * 0.5);
          const m = s.mem[j], tot = m.h + m.f;
          if (tot) v += (m.h / tot - 0.5) * 0.8;   // 잘 버티는 사람에게 실탄이 잘 박힘
          if (lv >= 3 && s.live[j] > 0) v += s.live[j] * 0.12;   // 실탄 많이 남은 위협
        }
        v += rnd() * noise * 1.6;
        return { j, v };
      }).sort((a, b) => b.v - a.v);
      const to = scored[0].j;
      // 실탄을 낼까: 남은 비율 + 남은 라운드 + 상대가 버틸 공산 + 버릇
      const left = ROUNDS - s.rd + 1;
      let c;
      if (s.live[seat] <= 0) c = 'B';
      else if (s.blank[seat] <= 0 || s.live[seat] >= left) c = 'L';
      else {
        let p = s.live[seat] / (s.live[seat] + s.blank[seat]);
        if (lv >= 2) {
          const m = s.mem[to], tot = m.h + m.f;
          const holdRate = tot ? (m.h + 1) / (tot + 2) : 0.6;
          p += (holdRate - 0.6) * 0.5;
          if (s.wd[to] === MAXW - 1) p += 0.15;
          if (scored[0].v - (scored[1] ? scored[1].v : 0) > 0.8) p += 0.1;
