  function lootDesc(c) {
    const d = LOOT[c];
    if (d.k === 'cash') return '현금 ' + d.s;
    if (d.k === 'gem') return '보석: 1개 5천 · 끝에 가장 많이 가진 사람(같으면 모두) +5만';
    if (d.k === 'art') return '그림: 모을수록 비싸요 1장 4천 · 2장 1.2만 · 3장 3만 · 4장 6만 · 5장 10만';
    if (d.k === 'bond') return '채권: 끝날 때 상처가 없으면 3만, 있으면 1만';
    return '치료 상자: 가져가면 바로 상처 1개를 지워요(상처가 없으면 5천)';
  }
  /* 이 사람에게 이 전리품이 지금 얼마짜리인지(값 힌트 — 정해진 규칙대로 셈) */
  function valueHint(s, seat, c) {
    const d = LOOT[c];
    if (seat < 0) return d.k === 'cash' ? d.s : d.k === 'gem' ? '5천+' : d.k === 'art' ? '모으기' : d.k === 'bond' ? '3만/1만' : '상처−1';
    if (d.k === 'cash') return d.s;
    if (d.k === 'gem') { const P = parts(s, seat, false); return '내 ' + P.gemN + '→' + (P.gemN + 1) + '개'; }
    if (d.k === 'art') { const a = parts(s, seat, false).artN; return '+' + won(ART_SET[Math.min(a + 1, 5)] - ART_SET[Math.min(a, 5)]); }
    if (d.k === 'bond') return s.wd[seat] ? '1만' : '끝에 3만';
    return s.wd[seat] ? '상처 −1' : '5천';
  }

  function mount(root, api) {
