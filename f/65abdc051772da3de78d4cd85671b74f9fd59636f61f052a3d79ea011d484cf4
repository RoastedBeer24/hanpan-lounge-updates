  function freeAct(s, a, ev) {   // 전투 밖에서 언제나 할 수 있는 정리(자리 · 기술 · 장신구)
    if (a.t === 'sw') { const i = a.a, j = a.b; if (!s.pt[i] || !s.pt[j] || i === j) throw new Error('bad swap'); const t = s.pt[i]; s.pt[i] = s.pt[j]; s.pt[j] = t; ev.push({ k: 'pos', h: s.pt.map((x) => x.u), e: [] }); return true; }
    if (a.t === 'sks') {
      const h = s.pt[a.h]; if (!h || !Array.isArray(a.sk) || a.sk.length !== 4) throw new Error('bad skills');
      const set = new Set(a.sk); if (set.size !== 4 || a.sk.some((x) => !(x >= 0 && x < CL[h.c].sk.length))) throw new Error('bad skills');
