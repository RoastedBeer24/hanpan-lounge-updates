      if (fed.includes(h)) { healHero(s, h, Math.round(hStats(s, h).mh * 0.1 * (h.q.includes('insom') ? 0.5 : 1)), ev, h); addSt(s, h, -5, ev); }
      else { addSt(s, h, 15, ev); if (s.pt.includes(h)) { hurtHero(s, h, Math.max(1, Math.round(hStats(s, h).mh * 0.1)), ev, '굶주림', true); } }
    }
