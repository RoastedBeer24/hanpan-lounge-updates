      s.pt.forEach((h, i) => { h.o = i % s.np; if (a.sk && a.sk[i]) { const sk = a.sk[i].map(Number); if (sk.length === 4 && new Set(sk).size === 4 && sk.every((x) => x >= 0 && x < CL[h.c].sk.length)) h.sk = sk; } });
