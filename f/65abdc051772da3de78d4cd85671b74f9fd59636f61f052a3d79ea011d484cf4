      if (e.st) addSt(s, t, e.st < 0 ? Math.round(e.st * (t.q.includes('night2') ? 0.5 : 1)) : e.st, ev);
      if (e.cure) { const n0 = t.fx.length; t.fx = t.fx.filter((x) => x.k !== 'bl' && x.k !== 'bg'); if (n0 !== t.fx.length) ev.push({ k: 'cure', u: t.u }); }
      if (e.buf) { t.cb.push({ s: e.buf.s, v: e.buf.v }); ev.push({ k: 'fx', u: t.u, f: 'bf', s: e.buf.s, v: e.buf.v }); }
