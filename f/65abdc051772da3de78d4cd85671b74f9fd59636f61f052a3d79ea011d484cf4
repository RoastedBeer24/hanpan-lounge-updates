    if (it === 'band') { s.inv.band--; const n0 = h.fx.length; h.fx = h.fx.filter((f) => f.k !== 'bl'); if (n0 !== h.fx.length) ev.push({ k: 'cure', u: h.u }); healHero(s, h, 2, ev, h); return; }
    if (it === 'anti') { s.inv.anti--; const n0 = h.fx.length; h.fx = h.fx.filter((f) => f.k !== 'bg'); if (n0 !== h.fx.length) ev.push({ k: 'cure', u: h.u }); return; }
    if (it === 'laud') { s.inv.laud--; addSt(s, h, -20, ev); return; }
