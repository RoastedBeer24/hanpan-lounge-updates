  /* ---------- 층 넘어가기 · 야영 · 역참 ---------- */
  function descend(s, ev) {
    const R = s.mp.r[s.mp.at.r];
    if (s.mp.at.c != null || !R || R.k !== 'x') throw new Error('not at exit');
    for (const h of s.pt) { h.cb = []; h.fx = h.fx.filter((f) => f.k !== 'ddr'); }   // 이번 층 강화·문턱 후유증은 층이 끝나면 사라짐
