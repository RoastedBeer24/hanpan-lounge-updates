  /* ---------- view ---------- */
  const CSS = `
.au{position:absolute;inset:0;display:flex;flex-direction:column;background:radial-gradient(ellipse at 50% 38%,#43213a 0%,#24172c 55%,#140f1a 100%);overflow:hidden}
.au-top{display:grid;gap:5px;padding:6px 8px 0;flex:none}
.au-p{appearance:none;font:inherit;color:var(--ink);text-align:left;border:1px solid var(--line);background:rgba(34,28,46,.88);border-radius:12px;padding:5px 7px;min-height:48px;display:flex;flex-direction:column;gap:2px;min-width:0;cursor:pointer;transition:border-color .2s,box-shadow .2s}
.au-p .r1{display:flex;align-items:center;gap:4px;font-size:11.5px;font-weight:700;min-width:0}
.au-p .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1 1 auto;min-width:0}
.au-p .r2{display:flex;align-items:center;justify-content:space-between;gap:4px}
.au-p .co{font-family:var(--f-mono);font-weight:600;font-size:13px;color:var(--brass);display:flex;align-items:center;gap:3px}
.au-p .pt{font-family:var(--f-mono);font-size:11px;color:var(--muted)}
.au-p .pips{display:flex;gap:2px;flex-wrap:wrap;min-height:6px}
.au-p .pips i{width:7px;height:7px;border-radius:2px;display:block}
.au-p .st{font-size:12px;font-weight:800;flex:none;width:12px;text-align:center}
.au-coin{width:10px;height:10px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#ffe7a3,#e3ae45 55%,#9a6a14);display:inline-block;flex:none;box-shadow:0 0 0 1px rgba(0,0,0,.25)}
.au-mid{flex:1 1 auto;min-height:0;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:4px 10px}
.au-head{display:flex;align-items:center;gap:6px;width:100%;justify-content:space-between;font-size:12px;color:var(--muted);font-weight:700}
.au-head .rd{font-family:var(--f-mono);color:var(--ink)}
.au-head .btn{min-height:34px;padding:4px 10px;font-size:12px}
.au-table{position:relative;flex:1 1 auto;min-height:0;width:100%;display:flex;align-items:center;justify-content:center}
.au-table:before{content:"";position:absolute;left:6%;right:6%;bottom:2%;height:30%;border-radius:50%;background:radial-gradient(ellipse at 50% 40%,#7a2b3a 0%,#4a1c2a 60%,transparent 72%);opacity:.85}
.au-spot{position:absolute;left:50%;top:-30%;width:120%;height:140%;transform:translateX(-50%);background:radial-gradient(ellipse at 50% 30%,rgba(255,236,190,.16),rgba(255,236,190,0) 60%);pointer-events:none}
.au-lot{position:relative;display:flex;gap:8px;align-items:flex-end;justify-content:center;max-height:100%}
.au-card{position:relative;background:linear-gradient(#f6eedc,#e9dcc0);color:#2a1d05;border-radius:12px;padding:6px 6px 7px;box-shadow:0 12px 28px rgba(0,0,0,.5),0 0 0 1px rgba(0,0,0,.2);display:flex;flex-direction:column;gap:4px;animation:auIn .45s cubic-bezier(.2,.9,.3,1.2)}
