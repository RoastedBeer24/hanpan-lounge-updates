        const r = st.res;
        const main = r.w.filter((w) => w[2]).map((w) => st.nm[w[0]]);
        const txt = (main.length ? main.join(', ') : st.nm[r.w[0][0]]) + ' 승' + (r.sd && r.hn ? ' · ' + r.hn : ' · 모두 폴드');
        ctx.font = '400 17px "Black Han Sans", "IBM Plex Sans KR", sans-serif';
        const tw = Math.min(G.W - 40, ctx.measureText(txt).width + 30);
        const by = potPos().y + 2;
        ctx.fillStyle = 'rgba(10,8,15,.78)'; rr(ctx, G.cx - tw / 2, by - 17, tw, 34, 17); ctx.fill();
        ctx.strokeStyle = '#e3ae45'; ctx.lineWidth = 1.5; ctx.stroke();
        ctx.fillStyle = '#e3ae45'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(clip(txt, tw - 20), G.cx, by + 1);
      }
    }
    function drawSeatPlate(s, cur, end, showEnd) {
