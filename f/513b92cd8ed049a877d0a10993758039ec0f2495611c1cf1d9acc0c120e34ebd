      helpEl.style.background = txtOn ? 'rgba(16,12,22,.82)' : 'transparent';
      helpEl.style.borderColor = txtOn ? 'rgba(227,174,69,.35)' : 'transparent';
      helpEl.style.justifyContent = txtOn ? '' : 'flex-end';
