    function draw(now) {
      cv.clear();
      if (bg) ctx.drawImage(bg, 0, 0, G.W, G.H);
      if (!st) return;
      const out = specs();
      const end = st.ph === 'end' && st.res;
      const showEnd = end && cardsSettled(now) && !flies.some((f) => f.toPot);
      const [sbA, bbA] = blinds(st);
      // header info
