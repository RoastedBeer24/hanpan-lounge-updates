        const drawHead = () => {
          head.replaceChildren(
            L.h('span', null, g.toCall > 0 ? ['콜 ', em(g.callAmt), ' / ' + (raiseTo >= g.maxTo ? '올인 ' : '레이즈 '), em(raiseTo), '까지'] : [verb() + ' ', em(raiseTo)]),
            L.h('span', { class: 'muted' }, ['내는 칩 ', em(raiseTo - st.cb[a]), ' · 남음 ', em(st.ch[a] - (raiseTo - st.cb[a]))]));
        };
        drawHead();
        const confirm = btn(lab(verb(), raiseTo), 'primary', sb(() => {
          api.sfx('chip'); api.buzz(15);
          send(raiseTo >= g.maxTo ? { type: 'allin' } : { type: 'raise', to: raiseTo });
        }), off);
        tag(confirm, 'ok');
        const slider = L.h('input', { type: 'range', min: g.minTo, max: g.maxTo, step: 1, value: raiseTo, 'aria-label': '금액', style: { width: '100%', accentColor: '#e3ae45', height: '32px', margin: 0, minWidth: 0 } });
        const set = (v) => { raiseTo = U.clamp(Math.round(v), g.minTo, g.maxTo); api.sfx('tick'); api.buzz(6); renderHud(); };
        slider.addEventListener('input', () => { raiseTo = +slider.value; drawHead(); confirm.replaceChildren(...lab(verb(), raiseTo)); });
        const chip = (t, v) => { const b = btn(lab(t), raiseTo === v ? 'primary' : '', () => set(v), v < g.minTo); b.style.padding = '6px 2px'; b.style.fontSize = '13px'; return b; };
        wrap.append(head,
          grid([chip('최소', g.minTo), chip('½팟', potTo(0.5)), chip('¾팟', potTo(0.75)), chip('팟', potTo(1)), chip('올인', g.maxTo)], 'repeat(5,minmax(0,1fr))'),
          L.h('div', { style: { display: 'grid', gridTemplateColumns: '44px minmax(0,1fr) 44px 64px 96px', alignItems: 'center', gap: '6px' } },
            tag(btn(lab('−'), '', () => set(raiseTo - bb), raiseTo <= g.minTo), 'less'), slider, tag(btn(lab('+'), '', () => set(raiseTo + bb), raiseTo >= g.maxTo), 'more'),
            btn(lab('취소'), 'ghost', () => { raiseOpen = false; api.sfx('click'); renderHud(); }), confirm));
        return;
      }
      // what will happen: amount to call, pot odds
      if (g.check) wrap.append(hint(['체크는 무료예요', g.raise ? ' · ' + (st.bt === 0 ? '벳' : '레이즈') + ' 최소 ' : '', g.raise ? em(g.minTo) : '', ' · 팟 ', em(g.pot)]));
      else {
