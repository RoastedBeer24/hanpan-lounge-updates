        potNeed = need;
        const line = potOn ? (potEl = hint([])) : hint(['콜 ', em(g.callAmt), ' → 팟 ', em(g.pot + g.callAmt), ' · 팟 오즈 ', em(need + '%'), ' 이상 이기면 이득']);
        wrap.append(line);
        if (potOn) potShow();
      }
      const foldBtn = btn(lab(foldArm ? '정말 폴드?' : '폴드'), foldArm ? 'danger' : '', sb(() => {
        if (g.check && !foldArm) { // checking costs nothing: ask once before giving up the hand
          foldArm = 1; allArm = 0; api.buzz(20); api.sfx('click'); api.toast('체크가 무료예요. 한 번 더 누르면 폴드');
          clearTimeout(foldTimer); foldTimer = setTimeout(() => { foldArm = 0; renderHud(); }, 2500);
          renderHud(); return;
        }
        clearTimeout(foldTimer); api.sfx('whoosh'); api.buzz(12); send({ type: 'fold' });
      }), off);
      const kids = [tag(foldBtn, 'fold')];
