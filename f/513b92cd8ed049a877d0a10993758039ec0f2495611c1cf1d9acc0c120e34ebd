      const bb = blinds(st)[1];
      if (raiseOpen && g.raise) {
        raiseTo = U.clamp(raiseTo || g.minTo, g.minTo, g.maxTo);
        const potTo = (f) => U.clamp(st.bt + Math.round((f * (g.pot + g.toCall)) / 10) * 10, g.minTo, g.maxTo); // pot-sized raise = call + fraction of the pot after calling
