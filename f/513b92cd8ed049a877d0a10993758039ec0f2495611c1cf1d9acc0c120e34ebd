      flies = flies.filter((f) => now < f.t0 + f.dur);
      if (flies.length) active = true;
      if (!active && busy && now >= holdUntil) { setBusy(false); renderHud(); dirty = true; }
      if (refreshHelp(now)) dirty = true;
      if (active || dirty || busy) { draw(now); dirty = active; }
    }

    /* hand helper: only my hole cards + board cards that have visibly landed */
    function refreshHelp(now) {
      const v = st ? api.viewer() : -1;
      let hole = '', board = '';
      if (v >= 0 && st.h[v] && st.st[v] !== 'o') {
        hole = st.h[v];
        if (Object.keys(anims).some((k) => k.startsWith('h' + st.hn + '_' + v + '_'))) hole = ''; // my cards still being dealt
        split2(st.bd).forEach((c, i) => { const a = anims['b' + st.hn + '_' + i]; if (!a || now >= a.t0 + a.dur * 0.6) board += c; });
        if (board.length < 6) board = ''; // flop still landing: keep the preflop read until all 3 are down
      }
      const cover = G.tight && raiseOpen; // on short screens the open raise panel takes the helper's strip
      let opp = 0;
      if (st && v >= 0) for (let i = 0; i < st.n; i++) if (i !== v && (st.st[i] === 'a' || st.st[i] === 'x')) opp++;
      const key = (G.help ? 1 : 0) + '|' + cover + '|' + helpOn + '|' + meterOn + '|' + potOn + '|' + opp + '|' + v + '|' + hole + '|' + board + '|' + (st ? st.st[v] : '');
      if (key === helpKey) return false;
      const folded = !st || v < 0 || st.st[v] === 'f' || st.st[v] === 'o';
      meterBtn.style.display = hole && !folded && opp > 0 ? '' : 'none';
      potBtn.style.display = meterBtn.style.display;
      meterKick((meterOn || potOn) && !folded ? hole : '', board, opp);
      helpKey = key;
      helpA = hole && G.help ? analyze(hole, board) : null;
      hlSet = new Set(helpOn && helpA && st.st[v] !== 'f' ? helpA.keys : []);
      helpEl.style.display = G.help && v >= 0 && hole && !cover ? 'flex' : 'none';
      helpEl.style.top = (G.plateY + 41) + 'px'; helpEl.style.height = (G.help - 6) + 'px';
      helpTxt.innerHTML = '';
      helpBtn.textContent = helpOn ? '숨김' : '족보 보기';
      helpBtn.setAttribute('aria-label', helpOn ? '족보 도우미 숨기기' : '족보 도우미 보기');
