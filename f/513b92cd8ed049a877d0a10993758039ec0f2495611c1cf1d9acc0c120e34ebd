      ctx.textAlign = 'right';
      L.ui.strokeText(ctx, '블라인드 ' + sbA + '/' + bbA, G.W - 16, 18);
      // deck
      for (let i = 0; i < 4; i++) drawCard(ctx, G.deck.x - 17 + i * 0.8, G.deck.y - i * 0.8, 34, null, false);
      // pot
      const pp = potPos();
      const collected = st.tc.reduce((a, b) => a + b, 0) - st.cb.reduce((a, b) => a + b, 0);
      const flyingToPot = flies.some((f) => f.toPot);
      if (!end && (collected > 0 || flyingToPot)) {
        drawChips(ctx, pp.x - 34, pp.y + 4, Math.max(collected, 1), 13, false);
        pill(pp.x - 14, pp.y, '팟 ' + collected, 'rgba(10,8,15,.6)', '#e3ae45', '600 13px "IBM Plex Mono", ui-monospace, monospace', 'left');
      }
      // seats
      const cur = actor(st);
      for (let s = 0; s < st.n; s++) drawSeatPlate(s, cur, end, showEnd);
      // cards
      for (const sp of out) { if (sp.key[0] === 'h') drawSpec(sp, now); }
      for (const sp of out) { if (sp.key[0] === 'b') drawSpec(sp, now); }
      for (let s = 0; s < st.n; s++) drawSeatTags(s, end, showEnd);
      // bets
