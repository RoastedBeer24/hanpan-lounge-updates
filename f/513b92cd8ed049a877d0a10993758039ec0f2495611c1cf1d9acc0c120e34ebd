        L.h('span', { text: helpA.made }), helpA.tag ? L.h('span', { style: { fontSize: '11px', fontWeight: 600, color: 'var(--muted)', marginLeft: '6px' }, text: helpA.tag === '보드' ? '보드에 깔린 패' : helpA.tag }) : null,
        fold ? L.h('span', { style: { fontSize: '11px', marginLeft: '6px' }, text: '· 폴드함' }) : null]));
