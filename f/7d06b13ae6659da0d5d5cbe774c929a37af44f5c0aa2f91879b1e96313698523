  function yrSnap(P) { return ['in', 'ma', 'gr', 'fa', 'ar', 'bz', 'vi', 'fm'].map((k) => Math.round(P.st[k])).concat([P.hs]); }
  function resolveContest(s, ck) {
    const C = CONTESTS[ck], yf = s.t / s.T;
