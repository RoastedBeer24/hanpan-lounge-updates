      if (t === K.pl[1]) P.q.push({ k: 'plagueEnd' });
      if (t === K.war[0]) { P.q.push({ k: 'war' }); lg(P, ['k', t, 'war']); }
      if (t === K.war[1]) {
        P.q.push({ k: 'warEnd' });
