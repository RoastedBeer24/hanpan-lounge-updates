  /* ---------------- 결과 · 도움말 ---------------- */
  const GR = (g) => '◆'.repeat(g) + '◇'.repeat(5 - g);
  function endName(P) { const E = ENDK[P.end]; return E ? (P.sex === 'f' && E.nf ? E.nf : E.n) : ''; }
  function result(s) {
