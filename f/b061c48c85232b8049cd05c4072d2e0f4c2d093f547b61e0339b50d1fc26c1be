        const a = Math.min(1, T * 6) * Math.min(1, (1.4 - T) * 4), sc = 0.85 + 0.15 * Math.min(1, T * 5);
        ctx.save(); ctx.globalAlpha = a; ctx.translate(B.x + B.size / 2, B.y + B.size / 2); ctx.scale(sc, sc);
