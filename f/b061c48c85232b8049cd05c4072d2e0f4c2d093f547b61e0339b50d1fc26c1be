      const path = [cellXY(last.from, B), ...cells.map((c) => cellXY(c, B))];
      let slide = null;
      if (last.via === 'ladder') slide = [cellXY(last.land, B), cellXY(last.to, B)];
      else if (last.via === 'snake') slide = snakePts(last.land, last.to);
