        bottom = line(cur, me ? (mine > 1 ? api.players[cur].name + ' 차례 · ' : '내 차례 · ') + '굴리기 또는 판을 톡' : api.players[cur].name + ' 차례',
          { fontSize: '13px', color: me ? 'var(--brass)' : 'var(--muted)' });
      }
      const col = L.h('div', { style: { display: 'flex', flexDirection: 'column', gap: '2px', minWidth: 0, flex: '1 1 auto', fontSize: bottom ? '13px' : '15px' } }, top, bottom);
      if (bottom && top) { top.style.color = 'var(--ink)'; top.style.opacity = '0.85'; }
