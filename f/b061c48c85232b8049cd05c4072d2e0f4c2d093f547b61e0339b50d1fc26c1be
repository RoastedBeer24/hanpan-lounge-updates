      ctx.fillStyle = 'rgba(0,0,0,' + (0.38 * ls) + ')'; ctx.beginPath(); ctx.ellipse(x + 1.5, y + r * 0.72, r * ls * 1.05, r * 0.42 * ls, 0, 0, 7); ctx.fill();
