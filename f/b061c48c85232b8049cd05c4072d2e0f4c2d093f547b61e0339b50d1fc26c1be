/* 뱀 사다리 — reference implementation of the Lounge game interface. */
(function () {
  const L = window.Lounge, U = L.util;
  const SPD = () => ((L.debug && L.debug.speed) || 1) * (L.speed ? (L.speed() || 1) : 1);
  const LADDERS = { 1: 38, 4: 14, 9: 31, 21: 42, 28: 84, 36: 44, 51: 67, 71: 91, 80: 100 };
  const SNAKES = { 16: 6, 47: 26, 49: 11, 56: 53, 62: 19, 64: 60, 87: 24, 93: 73, 95: 75, 98: 78 };

  const pairs = (o) => Object.keys(o).map((k) => [+k, o[k]]);
  const CLASSIC = { L: pairs(LADDERS), S: pairs(SNAKES) };

  /* 기대 굴림 수(한 사람 기준, 마르코프 사슬): 판 공정성 검사와 미리보기에 쓴다 */
  function expRolls(lad, sn) {
    const jump = new Array(101).fill(0).map((_, i) => i);
    lad.forEach(([a, b]) => { jump[a] = b; }); sn.forEach(([a, b]) => { jump[a] = b; });
    const E = new Array(101).fill(0);
    for (let it = 0; it < 400; it++) {
      let d = 0;
      for (let k = 99; k >= 0; k--) {
        let v = 1;
        for (let r = 1; r <= 6; r++) v += E[jump[Math.min(100, k + r)]] / 6;
        d = Math.max(d, Math.abs(v - E[k])); E[k] = v;
      }
      if (d < 1e-4) break;
    }
    return E[0];
  }
  const rowOf = (k) => Math.floor((k - 1) / 10);
  /* 무작위 판: 사다리 8~9개·뱀 9~10개. 끝점이 서로 겹치지 않아 연쇄·고리가 없고, 100번엔 뱀이 없다.
     오르는 칸 합과 내려가는 칸 합이 비슷하고(±12%), 기대 굴림 수가 고전 판(약 36번) 근처(25~38번)일 때만 쓴다. */
  function genBoard(rand) {
    for (let tries = 0; tries < 400; tries++) {
      const used = new Set([1, 100]);
      const nl = 8 + Math.floor(rand() * 2), ns = 9 + Math.floor(rand() * 2);
      const lad = [], sn = [];
      const pick = (lo, hi) => lo + Math.floor(rand() * (hi - lo + 1));
      let bad = false;
      for (let i = 0; i < nl && !bad; i++) {
        let ok = false;
        for (let t = 0; t < 60 && !ok; t++) {
          const a = pick(2, 80), len = pick(10, Math.min(48, 99 - a)), b = a + len;
          if (b > 99 || used.has(a) || used.has(b) || rowOf(a) === rowOf(b)) continue;
          used.add(a); used.add(b); lad.push([a, b]); ok = true;
        }
        if (!ok) bad = true;
      }
      for (let i = 0; i < ns && !bad; i++) {
        let ok = false;
        for (let t = 0; t < 60 && !ok; t++) {
          const a = pick(18, 99), len = pick(10, Math.min(48, a - 2)), b = a - len;
          if (b < 2 || used.has(a) || used.has(b) || rowOf(a) === rowOf(b)) continue;
          if (a > 90 && sn.filter((x) => x[0] > 90).length >= 2) continue; // 마지막 줄 뱀은 2마리까지
          used.add(a); used.add(b); sn.push([a, b]); ok = true;
        }
        if (!ok) bad = true;
      }
      if (bad) continue;
      const up = lad.reduce((t, x) => t + x[1] - x[0], 0), dn = sn.reduce((t, x) => t + x[0] - x[1], 0);
      if (Math.abs(up - dn) > 0.12 * Math.max(up, dn)) continue;
      const er = expRolls(lad, sn);
      if (er < 25 || er > 38) continue;
      lad.sort((x, y) => x[0] - y[0]); sn.sort((x, y) => x[0] - y[0]);
      return { L: lad, S: sn, er: Math.round(er) };
    }
    return { L: CLASSIC.L, S: CLASSIC.S, er: Math.round(expRolls(CLASSIC.L, CLASSIC.S)) };
  }
  const CLASSIC_ER = Math.round(expRolls(CLASSIC.L, CLASSIC.S));

  function init(players, opts) {
    const bd = opts && opts.bd === 'c' ? { L: CLASSIC.L, S: CLASSIC.S, er: CLASSIC_ER } : genBoard(Math.random);
    return { n: players.length, names: players.map((p) => p.name), pos: players.map(() => 0), turn: 0, last: null, seq: 0, winner: null, g: Math.floor(Math.random() * 1e6),
      bk: opts && opts.bd === 'c' ? 'c' : 'r', L: bd.L, S: bd.S, er: bd.er };
  }
  const boardOf = (s) => (s && s.L ? s : CLASSIC);
  const findTo = (list, k) => { for (const x of list) if (x[0] === k) return x[1]; return 0; };
  function actor(s) { return s.winner == null ? s.turn : null; }
  function apply(s, seat, a) {
    if (!a || a.type !== 'roll') throw new Error('bad action');
    const roll = 1 + Math.floor(Math.random() * 6);
    const from = s.pos[seat];
    const land = Math.min(100, from + roll); // reaching or passing 100 wins
    let to = land, via = null;
    const bd = boardOf(s), lt = findTo(bd.L, land), sv = findTo(bd.S, land);
    if (lt) { to = lt; via = 'ladder'; }
    else if (sv) { to = sv; via = 'snake'; }
    s.pos[seat] = to;
    // per-seat result stats: [rolls, ladders, snakes]
    if (!s.ks) s.ks = s.pos.map(() => [0, 0, 0]);
    s.ks[seat][0]++; if (via === 'ladder') s.ks[seat][1]++; else if (via === 'snake') s.ks[seat][2]++;
    s.seq++;
    s.last = { seat, from, roll, land, to, via, id: s.seq };
    if (to === 100) { s.winner = seat; return s; }
    s.turn = (s.turn + 1) % s.n;
    return s;
  }
  function result(s) {
    if (s.winner == null) return null;
    const ks = s.ks || s.pos.map(() => [0, 0, 0]);
    const stats = [{ label: '굴린 횟수', values: ks.map((k) => String(k[0])) }, { label: '사다리 ↑', values: ks.map((k) => String(k[1])) },
      { label: '뱀 ↓', values: ks.map((k) => String(k[2])) }, { label: '마지막 칸', values: s.pos.map(String) }];
    return { winners: [s.winner], stats, text: '100번 칸에 먼저 도착했어요.' };
  }

  /* board geometry: cell k (1..100) → column/row (row 0 at bottom) */
  function cellXY(k, B) {
    if (k <= 0) return { x: B.x + B.c * 0.5, y: B.y + B.size + B.c * 0.55 };
    const r = Math.floor((k - 1) / 10), c0 = (k - 1) % 10;
    const c = r % 2 === 0 ? c0 : 9 - c0;
    return { x: B.x + c * B.c + B.c / 2, y: B.y + B.size - (r + 1) * B.c + B.c / 2 };
  }

  function mount(root, api) {
    const cv = U.canvas(root);
    const ctx = cv.ctx;
    let st = null, B = null;
    const disp = []; // displayed positions per seat (cell number, float path handled by anims)
    let anim = null; // {seat, path:[{x,y}], t, speed}
    let die = { v: 1, rolling: 0 };
    let shownSeq = 0;

    const hud = L.h('div', { class: 'hud bottom sn-hud' });
    const info = L.h('div', { class: 'panel sn-info', style: { display: 'flex', alignItems: 'center', gap: '10px', fontWeight: 700, minWidth: 0, maxWidth: '100%', boxSizing: 'border-box' } });
    const rollBtn = L.h('button', { 'data-action': 'roll', class: 'btn primary sn-roll', text: '주사위 굴리기', onclick() { api.sfx('roll'); api.act({ type: 'roll' }); } });
    hud.append(info, rollBtn);
    const top = L.h('div', { class: 'hud top sn-top', style: { gap: '6px' } });
    // 판 미리보기: 첫 굴림 전까지 판 위에 이번 판 정보(탭하면 닫힘)
    const intro = L.h('div', { class: 'panel sn-intro', style: { position: 'absolute', left: '50%', top: '58px', transform: 'translateX(-50%)', width: 'max-content', maxWidth: 'calc(100% - 24px)', padding: '6px 12px', textAlign: 'center', display: 'none', zIndex: 3, boxShadow: '0 8px 24px rgba(0,0,0,.5)', cursor: 'pointer' }, onclick() { introOff = true; intro.style.display = 'none'; } });
    let introOff = false;
    root.append(hud, top, intro);
    function renderIntro() {
      const show = st && !introOff && st.seq === 0 && st.winner == null;
      intro.style.display = show ? '' : 'none';
      if (!show) return;
      intro.style.top = (top.offsetTop + top.offsetHeight + 6) + 'px';
      const bd = boardOf(st);
      const up = bd.L.reduce((t, x) => t + x[1] - x[0], 0), dn = bd.S.reduce((t, x) => t + x[0] - x[1], 0);
      intro.innerHTML = '';
      intro.append(L.h('div', { style: { fontWeight: 800, fontSize: '14px' }, text: st.bk === 'c' ? '이번 판 · 고전 판' : '이번 판 · 무작위 판 (새로 만듦)' }),
        L.h('div', { style: { fontSize: '13px' }, text: '사다리 ' + bd.L.length + '개(↑' + up + '칸) · 뱀 ' + bd.S.length + '마리(↓' + dn + '칸)' }),
        L.h('div', { class: 'muted', style: { fontSize: '12px', marginTop: '2px' }, text: '한 사람이 100번까지 평균 약 ' + (st.er || CLASSIC_ER) + '번 굴려요' }));
    }
    function renderTop() {
      top.innerHTML = '';
      if (!st) return;
      const cur = actor(st);
      for (let i = 0; i < st.n; i++) {
        const p = api.players[i];
        top.append(L.h('span', { class: 'turn', style: { opacity: cur === i || cur == null ? 1 : 0.6, borderColor: cur === i ? p.color : '' } },
          L.h('span', { class: 'dot', style: { '--c': p.color } }), p.name + ' ', L.h('b', { class: 'mono', text: String(disp[i] != null ? disp[i] : st.pos[i]) })));
      }
    }

    function layout() {
      const pad = 16, bottom = 76, topH = 56;
      const size = Math.min(cv.w - pad * 2 - 14, cv.h - bottom - topH - pad);
      const c = size / 10;
      B = { x: (cv.w - size) / 2 + 7, y: topH + Math.max(0, (cv.h - bottom - topH - pad - size) / 2), size, c };
    }
    cv.onresize = () => { layout(); draw(); };
    layout();

    function tokenXY(seat, cellOrXY) {
      const p = typeof cellOrXY === 'number' ? cellXY(cellOrXY, B) : cellOrXY;
      const n = st ? st.n : 1;
      const ang = (seat / n) * Math.PI * 2 - Math.PI / 2;
      const off = n > 1 ? B.c * 0.2 : 0;
      return { x: p.x + Math.cos(ang) * off, y: p.y + Math.sin(ang) * off };
    }
    function shade(hex, amt) {
      const n = parseInt(hex.slice(1), 16);
      const r = U.clamp((n >> 16) + amt, 0, 255), g = U.clamp(((n >> 8) & 255) + amt, 0, 255), b = U.clamp((n & 255) + amt, 0, 255);
      return 'rgb(' + r + ',' + g + ',' + b + ')';
    }
    function rrp(c, x, y, w, hh, r) { c.beginPath(); c.roundRect ? c.roundRect(x, y, w, hh, r) : c.rect(x, y, w, hh); }
    const rng = (seed) => () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };

    /* 뱀 몸통 곡선: 머리→꼬리 (그리기와 미끄럼 애니메이션이 같은 길을 쓴다) */
    function snakePts(head, tail) {
      const H = cellXY(head, B), T = cellXY(tail, B);
      const dx = T.x - H.x, dy = T.y - H.y, len = Math.hypot(dx, dy);
      const nx = -dy / len, ny = dx / len;
      const waves = Math.max(1.5, len / (B.c * 1.6)), amp = B.c * 0.32, pts = [], N = 48;
      for (let i = 0; i <= N; i++) {
        const t = i / N, s = Math.sin(t * Math.PI * waves) * amp * (0.4 + 0.6 * Math.sin(t * Math.PI));
        pts.push({ x: H.x + dx * t + nx * s, y: H.y + dy * t + ny * s, t });
      }
      return pts;
    }
    const SNAKE_COL = [['#4f8a3c', '#2c5424', '#d9c46a'], ['#a8452f', '#5e2216', '#e8b25a'], ['#5d5196', '#2f2858', '#c9b8e8'], ['#a7792a', '#5c3f12', '#efd08a'], ['#2f7f86', '#17454a', '#bfe3d0']];

    function drawLadder(b, a, z) {
      const A = cellXY(a, B), Z = cellXY(z, B);
      const dx = Z.x - A.x, dy = Z.y - A.y, len = Math.hypot(dx, dy);
      const nx = -dy / len, ny = dx / len, w = B.c * 0.19, rw = Math.max(2.5, B.c * 0.085);
      b.lineCap = 'round';
      b.strokeStyle = 'rgba(30,15,0,.32)'; b.lineWidth = rw * 1.6;
      for (const s of [-1, 1]) { b.beginPath(); b.moveTo(A.x + nx * w * s + 3, A.y + ny * w * s + 5); b.lineTo(Z.x + nx * w * s + 3, Z.y + ny * w * s + 5); b.stroke(); }
      const rungs = Math.max(2, Math.round(len / (B.c * 0.4)));
      for (let i = 1; i < rungs; i++) {
        const t = i / rungs, x = A.x + dx * t, y = A.y + dy * t;
        b.strokeStyle = '#5a3818'; b.lineWidth = rw * 0.95; b.beginPath(); b.moveTo(x + nx * w + 1, y + ny * w + 1.5); b.lineTo(x - nx * w + 1, y - ny * w + 1.5); b.stroke();
        b.strokeStyle = '#a8743c'; b.lineWidth = rw * 0.8; b.beginPath(); b.moveTo(x + nx * w, y + ny * w); b.lineTo(x - nx * w, y - ny * w); b.stroke();
        b.strokeStyle = 'rgba(255,225,170,.45)'; b.lineWidth = rw * 0.25; b.beginPath(); b.moveTo(x + nx * w, y + ny * w - rw * 0.2); b.lineTo(x - nx * w, y - ny * w - rw * 0.2); b.stroke();
      }
      for (const s of [-1, 1]) {
        const x0 = A.x + nx * w * s, y0 = A.y + ny * w * s, x1 = Z.x + nx * w * s, y1 = Z.y + ny * w * s;
        b.strokeStyle = '#4a2d12'; b.lineWidth = rw * 1.35; b.beginPath(); b.moveTo(x0, y0); b.lineTo(x1, y1); b.stroke();
        b.strokeStyle = '#b07a40'; b.lineWidth = rw; b.beginPath(); b.moveTo(x0, y0); b.lineTo(x1, y1); b.stroke();
        b.strokeStyle = 'rgba(255,230,180,.55)'; b.lineWidth = rw * 0.3; b.beginPath(); b.moveTo(x0 - nx * rw * 0.2, y0 - ny * rw * 0.2); b.lineTo(x1 - nx * rw * 0.2, y1 - ny * rw * 0.2); b.stroke();
        for (let i = 1; i < rungs; i++) { const t = i / rungs; b.fillStyle = '#3a2410'; b.beginPath(); b.arc(x0 + dx * t, y0 + dy * t, rw * 0.18, 0, 7); b.fill(); }
      }
    }
    function drawSnake(b, head, tail, idx) {
      const pts = snakePts(head, tail), N = pts.length - 1;
      const [col, dark, belly] = SNAKE_COL[idx % SNAKE_COL.length];
      const W = (t) => B.c * (0.27 - 0.2 * t);
      b.lineCap = 'round'; b.lineJoin = 'round';
      for (let i = 0; i < N; i++) { const p = pts[i], q = pts[i + 1]; b.strokeStyle = 'rgba(25,15,0,.3)'; b.lineWidth = W(p.t) + 2; b.beginPath(); b.moveTo(p.x + 3, p.y + 5); b.lineTo(q.x + 3, q.y + 5); b.stroke(); }
      for (let i = 0; i < N; i++) { const p = pts[i], q = pts[i + 1]; b.strokeStyle = dark; b.lineWidth = W(p.t) + 2; b.beginPath(); b.moveTo(p.x, p.y); b.lineTo(q.x, q.y); b.stroke(); }
      for (let i = 0; i < N; i++) { const p = pts[i], q = pts[i + 1]; b.strokeStyle = col; b.lineWidth = W(p.t); b.beginPath(); b.moveTo(p.x, p.y); b.lineTo(q.x, q.y); b.stroke(); }
