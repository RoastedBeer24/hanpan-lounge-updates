    }
    function drawFx(dt) {
      for (let k = fx.length - 1; k >= 0; k--) {
        const p = fx[k]; p.t += dt; if (p.t >= p.life) { fx.splice(k, 1); continue; }
        p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 260 * dt; p.vx *= 0.98;
        ctx.globalAlpha = 1 - p.t / p.life; ctx.fillStyle = p.c; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 7); ctx.fill();
      }
