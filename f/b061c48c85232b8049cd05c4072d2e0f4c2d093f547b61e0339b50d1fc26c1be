    }

    function draw(dt) {
      cv.clear();
      if (!B) return;
      buildBoard();
      ctx.drawImage(boardImg, 0, 0, cv.w, cv.h);
      if (st) {
        const cur = !anim && die.rolling <= 0 && st.winner == null ? actor(st) : null;
        const order = [];
        for (let i = 0; i < st.n; i++) if (i !== cur && !(anim && anim.seat === i)) order.push(i);
        if (anim) order.push(anim.seat); else if (cur != null) order.push(cur);
