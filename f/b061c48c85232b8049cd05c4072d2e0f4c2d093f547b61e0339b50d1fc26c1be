        ctx.font = '400 ' + fs + 'px "Black Han Sans", "IBM Plex Sans KR", sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        const w = Math.min(B.size * 0.95, ctx.measureText(banner.text).width + fs * 1.2);
        ctx.fillStyle = 'rgba(16,10,20,.55)'; rrp(ctx, -w / 2, -fs * 0.8, w, fs * 1.6, fs * 0.4); ctx.fill();
        ctx.strokeStyle = banner.col; ctx.lineWidth = 2; ctx.stroke();
