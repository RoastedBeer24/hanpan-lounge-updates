      ctx.fillStyle = shade(col, -60); ctx.beginPath(); ctx.ellipse(x, yy + r * 0.5, r * 0.95, r * 0.4, 0, 0, 7); ctx.fill();
      ctx.fillStyle = shade(col, -25); ctx.beginPath(); ctx.ellipse(x, yy + r * 0.38, r * 0.95, r * 0.4, 0, 0, 7); ctx.fill();
