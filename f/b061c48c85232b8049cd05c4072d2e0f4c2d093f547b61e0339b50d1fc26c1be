          if (die.rolling <= 0) { die.rolling = 0; die.v = last.roll; renderInfo(); api.sfx('thud'); anim.ph = anim.hops > 0 ? 'hop' : slide ? 'slide' : 'end'; if (anim.ph === 'end') anim.land = 0.12; }
          draw(dt); return;
        }
