      const H = pts[0], a = Math.atan2(pts[0].y - pts[3].y, pts[0].x - pts[3].x), hr = B.c * 0.22;
      b.save(); b.translate(H.x, H.y); b.rotate(a);
      b.strokeStyle = '#b2322a'; b.lineWidth = Math.max(1, B.c * 0.025);
      b.beginPath(); b.moveTo(hr * 0.9, 0); b.lineTo(hr * 1.45, 0); b.lineTo(hr * 1.65, -hr * 0.18); b.moveTo(hr * 1.45, 0); b.lineTo(hr * 1.65, hr * 0.18); b.stroke();
      b.fillStyle = 'rgba(25,15,0,.3)'; b.beginPath(); b.ellipse(2, 4, hr * 1.05, hr * 0.8, 0, 0, 7); b.fill();
      const hg = b.createRadialGradient(-hr * 0.2, -hr * 0.35, hr * 0.1, 0, 0, hr * 1.1);
      hg.addColorStop(0, shade(col, 40)); hg.addColorStop(0.7, col); hg.addColorStop(1, dark);
      b.fillStyle = hg; b.strokeStyle = dark; b.lineWidth = 1.2;
      b.beginPath(); b.ellipse(0, 0, hr * 1.05, hr * 0.8, 0, 0, 7); b.fill(); b.stroke();
      for (const s of [-1, 1]) {
        b.fillStyle = '#f2d36b'; b.beginPath(); b.ellipse(hr * 0.35, s * hr * 0.4, hr * 0.22, hr * 0.17, 0, 0, 7); b.fill();
        b.fillStyle = '#120c06'; b.beginPath(); b.ellipse(hr * 0.37, s * hr * 0.4, hr * 0.06, hr * 0.15, 0, 0, 7); b.fill();
      }
      b.restore();
    }

    /* 판 그림은 미리 한 장에 그려 둔다(크기·판이 바뀔 때만 다시) */
    let boardImg = null, boardKey = '';
    function buildBoard() {
      const bd = boardOf(st), key = [cv.w, cv.h, cv.dpr, B.x, B.y, B.size, JSON.stringify(bd.L), JSON.stringify(bd.S)].join('|');
      if (boardImg && key === boardKey) return;
      boardKey = key;
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(cv.w * cv.dpr)); c.height = Math.max(1, Math.round(cv.h * cv.dpr));
      const b = c.getContext('2d'); b.setTransform(cv.dpr, 0, 0, cv.dpr, 0, 0);
      const fr = Math.max(5, B.c * 0.16), X = B.x, Y = B.y, S = B.size;
      b.fillStyle = 'rgba(0,0,0,.5)'; rrp(b, X - fr + 3, Y - fr + 8, S + fr * 2, S + fr * 2, 12); b.fill();
      const fg = b.createLinearGradient(X - fr, Y - fr, X + S + fr, Y + S + fr);
      fg.addColorStop(0, '#6b4220'); fg.addColorStop(0.5, '#4d2d14'); fg.addColorStop(1, '#3a210d');
      b.fillStyle = fg; rrp(b, X - fr, Y - fr, S + fr * 2, S + fr * 2, 12); b.fill();
      b.strokeStyle = 'rgba(255,215,160,.25)'; b.lineWidth = 1; rrp(b, X - fr + 1, Y - fr + 1, S + fr * 2 - 2, S + fr * 2 - 2, 11); b.stroke();
      const R = rng(11);
      b.save(); rrp(b, X - fr, Y - fr, S + fr * 2, S + fr * 2, 12); b.clip();
      for (let i = 0; i < 60; i++) { b.strokeStyle = 'rgba(20,8,0,.18)'; b.lineWidth = 0.7; const yy = Y - fr + R() * (S + fr * 2); b.beginPath(); b.moveTo(X - fr, yy); b.bezierCurveTo(X + S * 0.3, yy + (R() - 0.5) * 6, X + S * 0.7, yy + (R() - 0.5) * 6, X + S + fr, yy); b.stroke(); }
      b.restore();
      b.save(); rrp(b, X, Y, S, S, 5); b.clip();
      const tones = [['#f3e6c4', '#e9d6a6'], ['#e6cf98', '#d9bd7d']];
      for (let k = 1; k <= 100; k++) {
        const p = cellXY(k, B), r = Math.floor((k - 1) / 10), t = tones[(k + r) % 2];
        const x0 = p.x - B.c / 2, y0 = p.y - B.c / 2;
        const g = b.createLinearGradient(x0, y0, x0 + B.c, y0 + B.c);
        g.addColorStop(0, k === 100 ? '#f6cf6a' : t[0]); g.addColorStop(1, k === 100 ? '#c98d28' : t[1]);
        b.fillStyle = g; b.fillRect(x0, y0, B.c + 0.5, B.c + 0.5);
        b.lineWidth = 1;
        b.strokeStyle = 'rgba(255,250,235,.5)'; b.beginPath(); b.moveTo(x0 + 0.5, y0 + B.c); b.lineTo(x0 + 0.5, y0 + 0.5); b.lineTo(x0 + B.c, y0 + 0.5); b.stroke();
        b.strokeStyle = 'rgba(90,60,20,.22)'; b.beginPath(); b.moveTo(x0 + B.c - 0.5, y0); b.lineTo(x0 + B.c - 0.5, y0 + B.c - 0.5); b.lineTo(x0, y0 + B.c - 0.5); b.stroke();
      }
      for (let i = 0; i < 1400; i++) { b.fillStyle = R() < 0.5 ? 'rgba(90,60,20,.08)' : 'rgba(255,255,255,.1)'; b.fillRect(X + R() * S, Y + R() * S, 1.2, 1.2); }
      const P = cellXY(100, B);
