        if (e.k === 'bump' && (mine || e.o === me)) { playBuf('i_metal' + (1 + Math.floor(Math.random() * 3)), clamp(e.v / 10, 0.15, 0.8), 0.8 + Math.random() * 0.3); api.buzz(Math.round(clamp(e.v * 3, 10, 50))); }
        if (e.k === 'reset' && mine) note('트랙으로 복귀');
