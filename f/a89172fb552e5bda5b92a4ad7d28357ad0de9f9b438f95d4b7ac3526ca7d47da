        const q = ivS[c.seat] || (ivS[c.seat] = {});
        q.on = controlledHere(c.seat); if (!q.on) continue;
        q.x = c.x; q.y = c.y; q.h = c.h; q.idx = c.idx; q.lat = c.lat; q.along = c.along; q.zA = c.zA;
