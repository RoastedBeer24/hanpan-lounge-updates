        if (e.k === 'lap' && mine) { const c = W.cars[me]; const lt = c.laps[c.laps.length - 1]; note((c.lap === W.laps ? '마지막 바퀴! ' : (c.lap) + '바퀴째 · ') + H.fmtT(lt) + (lt <= c.best + 1e-6 && c.laps.length > 1 ? ' 최고 랩' : '')); api.sfx('tick'); }
