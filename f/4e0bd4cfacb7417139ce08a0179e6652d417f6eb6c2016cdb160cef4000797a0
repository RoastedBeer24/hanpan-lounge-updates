    }
    function playSel() {
      const me = bottomSeat();
      if (!myTurn(me) || sel < 0) return;
      const hand = cur.h[me];
      if (sel >= hand.length) return;
      const a = { t: 'play', c: hand[sel] };
      if (upOn) a.up = 1;
      sel = -1; upOn = false;
      if (api.online && !api.isHost) { sent = true; rerender(); }
      api.buzz(12, 'ui');
      api.actAs(me, a);
    }

    function finish() {
      clearTimers();
      el.classList.remove('shake');
      if (animating) { animating = false; api.setBusy(false); }
    }

    function animate(s) {
      const a = s.last;
      animating = true; api.setBusy(true);
      const A = stageVM(s, a);
      render(A, { drop: true, lock: true });
      api.sfx('card'); Snd.step(a.t1);
      if (a.up) { Snd.raise(); note(NM(a.s) + ' — 판돈 올림 · 이제 ' + a.stake); }
      let t = 430;
      if (a.b) {
        later(t, () => {
          A.reveal = true; A.loser = a.b.l;
          render(A, { lock: true });
          try { el.style.setProperty('--fx', String(L.fx ? L.fx() : 1)); } catch (e) {}
          el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake');
          Snd.bust(); api.sfx(api.canAct(a.b.l) ? 'lose' : 'thud'); api.buzz(60, 'hit');
          note(NM(a.b.l) + ' 넘김 — 칩 −' + a.b.pay + (a.b.el ? ' · 탈락' : ''), true);
        });
        t += 1500;
        later(t, () => { A.ch = s.scores; render(A, { lock: true }); api.sfx('chip'); });
        t += s.ph === 'over' ? 300 : 450;
