        const w = h('div', { class: 'nz-pc' + (isNew ? ' new' : '') + (isNew && fxo.drop ? ' drop' : ''), style: { '--c': COL(pc[0]), '--dy': pc[0] === me ? '46px' : '-46px' }, title: NM(pc[0]) }, cardEl(pc[1]));
