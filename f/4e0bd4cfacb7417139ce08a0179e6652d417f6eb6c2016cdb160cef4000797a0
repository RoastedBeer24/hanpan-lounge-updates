          else { const c = hand[sel], nt = vm.tot + c; if (nt > LIMIT) { tip.classList.add('r'); tip.append(String(c) + ' → 합계 ', h('b', { text: String(nt) }), ' · 9를 넘깁니다'); } else tip.append(String(c) + ' → 합계 ', h('b', { text: String(nt) }), nt === LIMIT ? ' · 다음은 0만 가능' : ''); }
