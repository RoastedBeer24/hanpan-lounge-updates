/* 님 타입 제로 (nimzero) — 0·1·2·3 카드를 번갈아 내어 합계를 쌓는 심리전. 합계가 9를 넘게 만든 사람이 진다.
   한 벌 40장(0~3 각 10장), 각자 4장. 손패가 다 떨어지면 합계는 그대로 두고 남은 더미에서 다시 4장씩.
   판돈: 한 판 1에서 시작, 손패를 다시 받을 때마다 +1, 카드를 내며 「올림」을 걸면 +1(한 판에 한 사람 한 번).
   넘긴 사람이 판돈만큼 칩을 잃고, 칩이 다 떨어지면 탈락. 마지막까지 칩이 남은 사람이 승리.
   상태는 JSON. 숨김 정보는 손패(h)와 더미 순서(deck)뿐 — 나온 카드 수(seen)는 공개 정보다. */
(function () {
  const L = window.Lounge;
  const ID = 'nimzero';
  const LIMIT = 9, HAND = 4, EACH = 10;

  /* ---------- 작은 도우미 ---------- */
  function hash() {   // 결정적 0~1 (판 시드 버릇)
    let h = 2166136261 >>> 0;
    for (let i = 0; i < arguments.length; i++) {
      let x = (arguments[i] | 0) >>> 0;
      for (let j = 0; j < 4; j++) { h ^= x & 255; h = Math.imul(h, 16777619) >>> 0; x >>>= 8; }
    }
    h ^= h >>> 13; h = Math.imul(h, 0x5bd1e995) >>> 0; h ^= h >>> 15;
    return (h >>> 0) / 4294967296;
  }
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  function shuffle(a) { for (let i = a.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; const t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function freshDeck() { const d = []; for (let v = 0; v < 4; v++) for (let i = 0; i < EACH; i++) d.push(v); return shuffle(d); }
  const aliveOf = (s) => { const a = []; for (let i = 0; i < s.n; i++) if (s.scores[i] > 0) a.push(i); return a; };
  function nextAlive(s, seat) { for (let k = 1; k <= s.n; k++) { const j = (seat + k) % s.n; if (s.scores[j] > 0) return j; } return seat; }
  const countsOf = (hand) => { const c = [0, 0, 0, 0]; for (const v of hand) c[v]++; return c; };

  /* ---------- 시작 · 나누기 ---------- */
  function init(players, opts) {
    opts = opts || {};
    const n = players.length;
    const chips = clamp(+opts.chips || 8, 1, 20) | 0;
    const s = {
      v: 1, n, c0: chips, up: opts.raise === 'off' ? 0 : 1,
      sd: (Math.random() * 1e9) | 0, eid: 0,
      scores: Array(n).fill(chips),          // 칩(core 정보판이 자동으로 보여 준다)
      deck: [], seen: [0, 0, 0, 0], h: Array.from({ length: n }, () => []),
      rd: 0, dl: 0, tot: 0, stake: 1, turn: 0, pile: [], rs: Array(n).fill(0),
      out: [], ph: 'play', win: -1, last: null, lg: [],
      st: { b: Array(n).fill(0), u: Array(n).fill(0), z: Array(n).fill(0), mx: Array(n).fill(0) },
      nm: players.map((p, i) => String((p && p.name) || ('자리 ' + (i + 1))).slice(0, 14)),
    };
    newRound(s, 0);
    return s;
  }
  /* 살아 있는 자리마다 4장. 더미가 모자라면 40장을 모두 모아 새로 섞는다 → 섞었으면 1 */
  function deal(s) {
    const al = aliveOf(s);
    let shuf = 0;
    if (s.deck.length < al.length * HAND) { s.deck = freshDeck(); s.seen = [0, 0, 0, 0]; shuf = 1; }
    for (let i = 0; i < s.n; i++) s.h[i] = [];
    for (const i of al) s.h[i] = s.deck.splice(s.deck.length - HAND, HAND).sort((a, b) => a - b);
    return shuf;
  }
  function newRound(s, first) {
    s.rd++; s.dl = 1; s.tot = 0; s.stake = 1; s.pile = []; s.rs = Array(s.n).fill(0);
    const shuf = deal(s);
    s.turn = first;
    return shuf;
  }

  /* ---------- 차례 · 행동 ---------- */
  function actor(s) { return s.ph === 'over' ? null : s.turn; }

  function apply(s, seat, a) {
    if (!a || typeof a !== 'object' || a.t !== 'play') throw new Error('bad action');
    if (s.ph === 'over' || s.turn !== seat) throw new Error('not your turn');
    const c = a.c | 0;
    const hand = s.h[seat];
    const ix = hand.indexOf(c);
    if (ix < 0) throw new Error('card not in hand');
    const bust = s.tot + c > LIMIT;
    let up = 0;
    if (a.up && s.up && !s.rs[seat] && !bust) { up = 1; s.rs[seat] = 1; s.stake++; s.st.u[seat]++; }
    hand.splice(ix, 1);
    s.seen[c]++;
    if (c === 0) s.st.z[seat]++;
    const t0 = s.tot;
    s.tot += c;
    s.pile.push([seat, c]);
    s.eid++;
    const last = { id: s.eid, s: seat, c, t0, t1: s.tot, up, stake: s.stake, rd: s.rd, hc: s.h.map((x) => x.length), seen: s.seen.slice(), dk: s.deck.length, rs: s.rs.slice() };
    if (bust) {
      const pay = Math.min(s.stake, s.scores[seat]);
      last.b = { l: seat, pay, h: s.h.map((x) => x.slice()), ch0: s.scores.slice(), pile: s.pile.slice(), el: 0 };
      s.scores[seat] -= pay;
      s.st.b[seat]++; s.st.mx[seat] = Math.max(s.st.mx[seat], pay);
      s.lg.push([s.rd, seat, pay, s.tot]); if (s.lg.length > 12) s.lg.shift();
      // 남은 손패는 공개하고 버린다(나온 카드로 센다)
      for (let i = 0; i < s.n; i++) { for (const v of s.h[i]) s.seen[v]++; s.h[i] = []; }
      if (s.scores[seat] <= 0) { s.out.push(seat); last.b.el = 1; }
      const al = aliveOf(s);
      if (al.length <= 1) { s.ph = 'over'; s.win = al.length ? al[0] : seat; s.turn = -1; s.last = last; return s; }
      const first = s.scores[seat] > 0 ? seat : nextAlive(s, seat);
      const shuf = newRound(s, first);
      last.d = { re: 0, shuf, first, rd: s.rd };
    } else if (s.h.every((x) => x.length === 0)) {
      // 손패 소진: 합계는 그대로, 다시 4장씩. 판돈 +1
      s.dl++; s.stake++;
      const shuf = deal(s);
      s.turn = nextAlive(s, seat);
      last.d = { re: 1, shuf, first: s.turn, rd: s.rd, stake: s.stake };
    } else {
      s.turn = nextAlive(s, seat);
    }
    s.last = last;
    return s;
  }

  /* ---------- 결과 ---------- */
  function result(s) {
    if (s.ph !== 'over' || s.win < 0) return null;
    const nmOf = (i) => (s.nm && s.nm[i]) || ('자리 ' + (i + 1));
    const stats = [
      { label: '남은 칩', values: s.scores.slice() },
      { label: '넘긴 판', values: s.st.b.slice(), low: true },
      { label: '낸 0 카드', values: s.st.z.slice(), best: false },
    ];
    if (s.up) stats.push({ label: '판돈 올림', values: s.st.u.slice(), best: false });
    stats.push({ label: '한 판 최대 손실', values: s.st.mx.slice(), unit: '칩', best: false });
    const hl = [];
    if (s.n > 2 && s.out.length) hl.push('탈락 순서: ' + s.out.map(nmOf).join(' → '));
    const big = Math.max.apply(null, s.st.mx), bi = s.st.mx.indexOf(big);
    if (big >= 3) hl.push('가장 큰 한 판: ' + nmOf(bi) + ' −' + big + '칩');
    return {
      winners: [s.win],
      title: nmOf(s.win) + ' 승리',
      text: s.rd + '판 · 남은 칩 ' + s.scores[s.win],
      stats, highlights: hl,
    };
  }

  /* ======================= AI ======================= */
  /* 이 자리에서 아직 못 본 카드(남의 손 + 더미) 종류별 수 */
  function unseenOf(s, seat) {
    const u = [0, 0, 0, 0];
    for (let v = 0; v < 4; v++) u[v] = EACH - s.seen[v];
    for (const c of s.h[seat]) u[c]--;
    return u;
  }
  /* N장 중 쓸 수 있는 카드가 g장일 때, k장 손에 쓸 카드가 한 장도 없을 확률 */
  function pNone(N, g, k) {
    if (k <= 0) return 0;
    let p = 1;
    for (let i = 0; i < k; i++) { const d = N - i; if (d <= 0) break; p *= Math.max(0, N - g - i) / d; }
    return p;
  }
  function habits(s, seat) {
    return {
      push: hash(s.sd, seat, 21),    // 합계를 밀어 올리는 버릇
      hoard: hash(s.sd, seat, 22),   // 0을 끝까지 쥐는 버릇
      bold: hash(s.sd, seat, 23),    // 판돈을 쉽게 올리는 버릇
      bluff: hash(s.sd, seat, 24),   // 근거 없이 올리는 버릇
    };
  }
  const styleOf = (seat) => { try { return (L.aiStyle && L.aiStyle(seat)) || 'bal'; } catch (e) { return 'bal'; } };

  /* 어려움: 못 본 카드를 상대 손에 여러 번 나눠 보고(올린 자리는 0을 더 쥐었다고 봄),
     그때마다 이번 손패가 끝날 때까지 서로 최선으로 두는 수를 따져 「내가 넘길 확률」을 카드별로 구한다 */
  function think(s, seat, samples) {
    const order = [seat];
    for (let j = nextAlive(s, seat); j !== seat; j = nextAlive(s, j)) order.push(j);
    const k = order.length;
    const u = unseenOf(s, seat);
    const pool = [];
    for (let v = 0; v < 4; v++) for (let i = 0; i < u[v]; i++) pool.push(v);
    const mine = countsOf(s.h[seat]);
    const cands = [0, 1, 2, 3].filter((v) => mine[v] > 0);
    const acc = [0, 0, 0, 0];
    let W = 0;
    const sizes = order.map((o) => s.h[o].length);
    const need = sizes.reduce((a, b) => a + b, 0) - sizes[0];
    const hs = order.map(() => [0, 0, 0, 0]);
    let deckC = [0, 0, 0, 0], deckN = 0, memo = null;
    const evenLeaf = Array(k).fill(1 / k);

    function leaf(tot, ti) {
      // 손패를 다시 받은 직후: 차례인 사람부터 「낼 카드가 없을」 확률을 차례로 매긴다
      const slack = LIMIT - tot;
      if (slack >= 3) return evenLeaf;
      let g = 0, N = deckN;
      if (N < k * HAND) { N = 40; g = (slack + 1) * EACH; } else for (let v = 0; v <= slack; v++) g += deckC[v];
      const stuck = pNone(N, g, HAND);
      const vec = Array(k).fill(0);
      let live = 1;
      for (let i = 0; i < k; i++) { const m = (ti + i) % k; vec[m] = live * stuck; live *= 1 - stuck; }
      for (let i = 0; i < k; i++) vec[i] += live / k;
      return vec;
    }
    function solve(tot, ti) {
      const h = hs[ti];
      if (h[0] + h[1] + h[2] + h[3] === 0) return leaf(tot, ti);
      let key = tot * 4 + ti;
      for (let i = 0; i < k; i++) { const x = hs[i]; key = key * 625 + x[0] + 5 * x[1] + 25 * x[2] + 125 * x[3]; }
      const got = memo.get(key);
      if (got) return got;
      let best = 2, sum = null, cnt = 0;
      const nt = (ti + 1) % k;
      for (let v = 0; v < 4; v++) {
        if (!h[v]) continue;
        let vec;
        if (tot + v > LIMIT) { vec = Array(k).fill(0); vec[ti] = 1; }
        else { h[v]--; vec = solve(tot + v, nt); h[v]++; }
        const mv = vec[ti];
        if (mv < best - 1e-9) { best = mv; sum = vec.slice(); cnt = 1; }
        else if (mv < best + 1e-9) { for (let i = 0; i < k; i++) sum[i] += vec[i]; cnt++; }
      }
      if (cnt > 1) for (let i = 0; i < k; i++) sum[i] /= cnt;
      memo.set(key, sum);
      return sum;
    }

    for (let it = 0; it < samples; it++) {
      // 필요한 만큼만 섞어 뽑는다
      for (let i = 0; i < need && i < pool.length - 1; i++) { const j = i + ((Math.random() * (pool.length - i)) | 0); const t = pool[i]; pool[i] = pool[j]; pool[j] = t; }
      let p = 0, w = 1;
      for (let i = 0; i < 4; i++) hs[0][i] = mine[i];
      for (let oi = 1; oi < k; oi++) {
        const hh = hs[oi]; hh[0] = hh[1] = hh[2] = hh[3] = 0;
        for (let c = 0; c < sizes[oi]; c++) hh[pool[p++]]++;
        if (s.rs[order[oi]] && sizes[oi] > 0) w *= [0.6, 1, 1.45, 1.8, 2][hh[0]];
      }
      deckC = u.slice(); deckN = 0;
      for (let oi = 1; oi < k; oi++) for (let v = 0; v < 4; v++) deckC[v] -= hs[oi][v];
      for (let v = 0; v < 4; v++) deckN += deckC[v];
      memo = new Map();
      for (const c of cands) {
        let loss;
        if (s.tot + c > LIMIT) loss = 1;
        else { hs[0][c]--; loss = solve(s.tot + c, 1 % k)[0]; hs[0][c]++; }
        acc[c] += w * loss;
      }
      W += w;
    }
    return cands.map((c) => ({ c, loss: acc[c] / (W || 1) }));
  }

  /* 보통: 한 수 앞만 본다 — 다음 사람이 막힐 확률, 그 합계가 내게 돌아왔을 때 내가 낼 카드가 있는지 */
  function glance(s, seat) {
    const u = unseenOf(s, seat);
    const N = u[0] + u[1] + u[2] + u[3];
    const nx = nextAlive(s, seat);
    const mine = countsOf(s.h[seat]);
    const out = [];
    for (let c = 0; c < 4; c++) {
      if (!mine[c]) continue;
      const t = s.tot + c;
      if (t > LIMIT) { out.push({ c, loss: 1 }); continue; }
      const slack = LIMIT - t;
      let g = 0; for (let v = 0; v <= Math.min(3, slack); v++) g += u[v];
      const kNext = s.h[nx].length || HAND;
      const stuck = pNone(N, g, kNext);
      const rest = mine.slice(); rest[c]--;
      const left = rest[0] + rest[1] + rest[2] + rest[3];
      let mySafe = 0.5;
      if (left > 0) { mySafe = 0; for (let v = 0; v <= Math.min(3, slack); v++) if (rest[v]) mySafe = 1; }
      // 여유가 넉넉할 때는 큰 수부터 털고, 0은 아낀다
      const dump = slack >= 3 ? 0.04 * c : 0;
      const keep0 = c === 0 && left > 0 && mine[1] + mine[2] + mine[3] > 0 && s.tot + Math.min.apply(null, [1, 2, 3].filter((v) => mine[v])) <= LIMIT ? 0.18 : 0;
      const sc = stuck * 0.9 + mySafe * 0.55 + dump - keep0;
      out.push({ c, loss: clamp(0.6 - sc * 0.5, 0.02, 0.98) });
    }
    return out;
  }

  function ai(s, seat, lv) {
    lv = lv || 2;
    if (s.ph === 'over' || s.turn !== seat) return null;
    const hand = s.h[seat];
    if (!hand.length) return null;
    const hb = habits(s, seat), st = styleOf(seat);
    const mine = countsOf(hand);
    const safe = [0, 1, 2, 3].filter((v) => mine[v] > 0 && s.tot + v <= LIMIT);
    if (!safe.length) return { t: 'play', c: hand[0] };            // 낼 수 있는 카드가 없다 — 가장 작은 수
    const al = aliveOf(s).length;
    const slack = LIMIT - s.tot;
    let pick, myLoss = 1 / al;

    if (lv <= 1) {
      // 쉬움: 넘기지만 않게, 나머지는 버릇대로. 0을 일찍 써 버리곤 한다
      const w = safe.map((v) => (v === 0 ? 0.9 + (1 - hb.hoard) * 0.9 : 1 + hb.push * v * 0.5) * (0.6 + Math.random() * 0.8));
      let bi = 0; for (let i = 1; i < w.length; i++) if (w[i] > w[bi]) bi = i;
      pick = safe[bi];
    } else {
      const ev = lv >= 3 ? think(s, seat, al <= 2 ? 90 : al === 3 ? 60 : 40) : glance(s, seat);
      const T = lv >= 3 ? 0.02 : 0.1;
      let best = -1e9;
      for (const e of ev) {
        if (e.loss >= 1) continue;
        // 버릇 · 성향은 비슷한 수 사이에서만 저울을 기울인다
        let sc = -e.loss;
        const lean = lv >= 3 ? 0.012 : 0.05;
        sc += lean * (hb.push - 0.5) * e.c + lean * (hb.hoard - 0.5) * (e.c === 0 ? -1.5 : 0);
        if (st === 'agg') sc += lean * 0.5 * e.c; else if (st === 'def') sc -= lean * 0.5 * e.c;
        sc += (Math.random() - 0.5) * 2 * T;
        if (sc > best) { best = sc; pick = e.c; myLoss = e.loss; }
      }
      if (pick == null) pick = safe[0];
    }

    /* 판돈 올림: 내가 넘길 확률이 고르게 나눈 몫보다 얼마나 낮은가 + 칩 사정 + 버릇 */
    let up = 0;
    if (s.up && !s.rs[seat]) {
      const zeros = mine[0] - (pick === 0 ? 1 : 0);
      if (lv <= 1) {
        up = Math.random() < (zeros >= 2 ? 0.22 : 0.04 + hb.bluff * 0.05) ? 1 : 0;
      } else {
        const base = 1 / al;
        let edge;
        if (lv >= 3) edge = base - myLoss;
        else edge = (zeros >= 2 ? 0.14 : zeros === 1 ? 0.02 : -0.12) + (slack <= 4 ? 0.05 : -0.04);
        let margin = 0.16 - hb.bold * 0.1;
        if (st === 'gamble' || st === 'agg') margin -= 0.03; else if (st === 'def') margin += 0.04;
        const me = s.scores[seat];
        if (me <= s.stake + 1) margin += 0.07;                       // 지면 끝나는 판은 조심
        const lead = Math.max.apply(null, s.scores.filter((_, i) => i !== seat));
        if (me < lead) margin -= 0.03;                               // 뒤지고 있으면 승부를 건다
        if (hand.length <= 1) margin += 0.05;                        // 곧 다시 받는다 — 근거가 옅다
        if (edge > margin + (Math.random() - 0.5) * 0.06) up = 1;
        else if (Math.random() < hb.bluff * (lv >= 3 ? 0.035 : 0.05) && myLoss < 0.6 && slack >= 2) up = 1;   // 드문 허세
      }
    }
    return up ? { t: 'play', c: pick, up: 1 } : { t: 'play', c: pick };
  }

  function aiDelayFor(s, seat, lv) {
    if (s.ph === 'over') return -1;
    const slack = LIMIT - s.tot;
    return 720 + Math.random() * 480 + (slack <= 2 ? 380 : 0) + (lv <= 1 ? 120 : 0);
  }

  /* ---------- 상황 도움말 ---------- */
  function hint(s, seat) {
    if (s.ph === 'over') return null;
    const out = [];
    const slack = LIMIT - s.tot;
    out.push(s.rd + '판 · 합계 ' + s.tot + ' · 판돈 ' + s.stake);
    out.push(slack > 0 ? '지금 낼 수 있는 수는 ' + Math.min(3, slack) + ' 이하입니다.' : '합계가 9입니다. 0만 낼 수 있습니다.');
    if (seat >= 0 && s.h[seat] && s.h[seat].length) {
      const u = unseenOf(s, seat);
      out.push('내 패를 빼고 아직 안 나온 카드 — 0: ' + u[0] + '장 · 1: ' + u[1] + '장 · 2: ' + u[2] + '장 · 3: ' + u[3] + '장');
      const safe = s.h[seat].filter((c) => c <= slack);
      if (!safe.length) out.push('낼 수 있는 카드가 없습니다. 어느 것을 내도 넘깁니다.');
      else if (s.h[seat].indexOf(0) >= 0) out.push('0은 합계를 올리지 않습니다. 합계가 9에 닿은 뒤를 위해 아껴 두는 편이 좋습니다.');
    }
    out.push('손패가 모두 떨어지면 합계는 그대로 두고 4장씩 다시 받습니다. 그때 판돈이 1 오릅니다.');
    if (s.up) out.push('카드를 내며 판돈을 1 올릴 수 있습니다(한 판에 한 번).');
    return out.slice(0, 6);
  }

  /* ======================= 소리(WebAudio 합성) ======================= */
  const Snd = {
    ac: null,
    ctx() {
      if (!this.ac) { try { this.ac = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { this.ac = null; } }
      if (this.ac && this.ac.state === 'suspended') { try { this.ac.resume(); } catch (e) {} }
      return this.ac;
    },
