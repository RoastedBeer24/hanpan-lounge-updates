      }
    }

    /* PC 단축키 · 오른쪽 클릭 취소 */
    let offIn = null;
    try {
      if (api.input && api.input.on) offIn = api.input.on((type, id) => {
        if (type !== 'down' || !cur) return;
        const me = bottomSeat();
        if (!myTurn(me)) return;
        const m = /^c([1-4])$/.exec(id);
        if (m) { const i = +m[1] - 1; if (i < cur.h[me].length) { if (sel !== i) { sel = i; api.sfx('tick'); rerender(); } } }
        else if (id === 'play') playSel();
