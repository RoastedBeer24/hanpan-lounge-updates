          else note(a.d.rd + '판 — ' + NM(a.d.first) + ' 선' + (a.d.shuf ? ' · 새 벌을 섞었습니다' : ''));
        });
        t += 520;
      }
      later(t, () => { animating = false; el.classList.remove('shake'); render(finalVM(cur)); api.setBusy(false); });
    }

    function update(s, prev) {
      if (!s) return;
      cur = s; sent = false;
      fit();
      const fresh = !!(s.last && s.last.id !== seenId);
      if (seenId >= 0 && fresh && prev && prev !== s) {
        if (animating) finish();
        seenId = s.last.id; sel = -1; upOn = false;
        animate(s);
        return;
      }
      if (animating && !fresh) return;                      // 연출 중 다시 그리기 요청은 건너뜀
      if (animating) finish();
      const first = seenId < 0;
      seenId = s.last ? s.last.id : 0;
      render(finalVM(s));
      if (first && !s.last && s.ph !== 'over') note('1판 — ' + NM(s.turn) + ' 선');
      else if (prev === s && s.last && sumId !== s.last.id && api.mySeats().length > 1 && s.ph !== 'over') {
        // 한 폰 돌려하기: 가림막을 걷은 사람에게 직전에 있었던 일을 짧게 알린다
        const a = s.last; sumId = a.id;
