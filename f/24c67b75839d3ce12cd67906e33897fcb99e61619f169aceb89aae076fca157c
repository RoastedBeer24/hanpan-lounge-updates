    const zOut = h('button', { 'data-action': 'zout', class: 'btn', type: 'button', 'aria-label': '작게', title: '작게 (−)', text: '−', onclick: () => zoomBy(1 / 1.6) });
    const zoomEl = h('div', { class: 'bg-zm' }, zIn, zOut);
    const revBtn = h('button', { 'data-action': 'done', class: 'btn primary', type: 'button', text: '', onclick: () => pressRev() });
    const skipBtn = h('button', { 'data-action': 'skip', class: 'btn ghost', type: 'button', text: '⏭ 결과로', title: '남은 시험 모두 건너뛰기 (N)', onclick: () => skipAll() });
    const revMsg = h('div', { class: 'muted', text: '' });
    const revBar = h('div', { class: 'bg-rev bg-hid' }, revBtn, skipBtn, revMsg);
    root.append(brief, spotView, zoomEl, bot, revBar);

    /* ---- 상태 ---- */
    let roundKey = '', active = -1, curMode = '', work = {}, tStart = {}, tPause = {}, sent = {}, readySent = {};
    let armedT = 0, handEl = null, handKey = '', pickEl = null, sheetEl = null, lastTick = -1, clock = 0, drawErr = 0;
    let mat = 'R', delMode = false, mirror = false;
    let settle = null, setKey = '', test = null, testRes = null, ghost = null;
    const cam = { sc: 20, ox: 0, oy: 0, fit: 20, key: '', top: 0, bot: 0 };
    let drag = null;
    const ptrs = new Map();
    let pinch = null;
    let rv = null, revId = -1, autoT = -1;
    const parts = [];
    let shake = 0;
    let skyC = null, skyKey = '';

    const rKey = () => (st ? st.r + ':' + st.si + ':' + st.ph : '');
    function pendingLocal() {
      if (!st || st.ph !== 'b') return [];
      const out = [];
      for (let i = 0; i < st.n; i++) if (api.canAct(i) && st.d[i] == null && sent[i] !== roundKey) out.push(i);
      return out;
    }
    function editSeat() { const p = pendingLocal(); if (!p.length) return -1; if (multi()) return p.includes(active) ? active : -1; return p[0]; }
    function mode() {
      if (!st) return 'none';
      if (st.ph === 'pick') return 'pick';
      if (st.ph === 'b') { if (editSeat() >= 0) return 'edit'; if (multi() && pendingLocal().length) return 'hand'; return 'wait'; }
      return st.last ? 'rev' : 'wait';
    }
    const site = () => (st && st.si >= 0 ? SITE(st, st.si) : SITES[0]);
    function W(seat) { if (!work[seat]) work[seat] = { D: parse(site(), ''), undo: [], sel: -1 }; return work[seat]; }
    function paused() { return !!document.querySelector('.tut-layer') || (!api.online && !!document.querySelector('.overlay.rules-ov')); }
    function elapsed(seat) { if (tStart[seat] == null) return 0; return ((clock - tStart[seat] - (tPause[seat] || 0)) * spd()) / 1000; }
    function mySeatShown() { const m = api.mySeats(); if (!m.length) return -1; if (multi()) return active >= 0 ? active : -1; return m[0]; }
    function curD() { const s = editSeat(); return s >= 0 ? W(s).D : null; }

    /* ---- 카메라 ---- */
    function bounds(sv) { return [-3.2, sv.L + 3.2, -sv.D - 0.7, sv.top <= 2 ? Math.max(topY(sv) + 1.3, Math.max(0, sv.r) + 3.3) : topY(sv) + 1.3]; }
    function viewSite() { return curMode === 'rev' && rv ? SITE(st, rv.si) : site(); }
    function layoutView() {
      const Wd = cv.w, Hh = cv.h, m = curMode, sv = viewSite();
      const bTop = brief.classList.contains('bg-hid') ? 0 : brief.offsetTop + brief.offsetHeight;
      const top = m === 'rev' ? 54 : Math.max(8, bTop + 6);
      const bottom = !bot.classList.contains('bg-hid') ? Hh - bot.offsetHeight : !revBar.classList.contains('bg-hid') ? Hh - revBar.offsetHeight : Hh;
      cam.top = top; cam.bot = bottom;
      const [x0, x1, y0, y1] = bounds(sv);
      const vh = Math.max(60, bottom - top);
      cam.fit = Math.min((Wd - 8) / (x1 - x0), vh / (y1 - y0));
      cam.sc = cam.fit;
      cam.ox = Wd / 2 - (x0 + x1) / 2 * cam.sc;
      cam.oy = (top + bottom) / 2 + (y0 + y1) / 2 * cam.sc;
      cam.key = Wd + 'x' + Hh + ':' + m + ':' + bTop + ':' + bot.offsetHeight + ':' + sv.n;
      spotView.style.left = '4px'; spotView.style.top = top + 'px'; spotView.style.width = (Wd - 8) + 'px'; spotView.style.height = Math.max(20, bottom - top) + 'px';
      zoomEl.style.top = (top + 6) + 'px';
      skyKey = '';
      clampCam();
    }
    function clampCam() {
      const sv = viewSite(), [x0, x1, y0, y1] = bounds(sv), Wd = cv.w;
      cam.sc = U.clamp(cam.sc, cam.fit, cam.fit * 4.5);
      const cw = (x1 - x0) * cam.sc, ch = (y1 - y0) * cam.sc, vh = cam.bot - cam.top;
      if (cw <= Wd) cam.ox = Wd / 2 - (x0 + x1) / 2 * cam.sc; else cam.ox = U.clamp(cam.ox, Wd - x1 * cam.sc, -x0 * cam.sc);
      if (ch <= vh) cam.oy = (cam.top + cam.bot) / 2 + (y0 + y1) / 2 * cam.sc; else cam.oy = U.clamp(cam.oy, cam.bot + y0 * cam.sc, cam.top + y1 * cam.sc);
    }
    const X = (x) => cam.ox + x * cam.sc, Y = (y) => cam.oy - y * cam.sc;
    const WX = (px) => (px - cam.ox) / cam.sc, WY = (py) => (cam.oy - py) / cam.sc;
    function zoomAt(px, py, f) {
      const wx = WX(px), wy = WY(py);
      cam.sc = U.clamp(cam.sc * f, cam.fit, cam.fit * 4.5);
      cam.ox = px - wx * cam.sc; cam.oy = py + wy * cam.sc;
      clampCam();
    }
    function zoomBy(f) {
      const d = curD(), s = editSeat();
      let px = cv.w / 2, py = (cam.top + cam.bot) / 2;
      if (d && s >= 0 && W(s).sel >= 0) { const j = W(s).sel; px = X(d.x[j]); py = Y(d.y[j]); }
      zoomAt(px, py, f); sfx('click');
    }
    cv.onresize = () => { cam.key = ''; };

    /* ---- 설계 편집 ---- */
    function jIdx(D, x, y) { for (let i = 0; i < D.x.length; i++) if (D.x[i] === x && D.y[i] === y) return i; return -1; }
    function mIdx(D, a, b) { for (let k = 0; k < D.m.length; k++) { const m = D.m[k]; if ((m[0] === a && m[1] === b) || (m[0] === b && m[1] === a)) return k; } return -1; }
    function snap(D) { return serialize(D); }
    function pushUndo(w) { w.undo.push(snap(w.D)); if (w.undo.length > 80) w.undo.shift(); }
    function placeErr(D, x1, y1, x2, y2, mt) {
      const sv = site();
      if (x1 === x2 && y1 === y2) return '같은 점이에요';
      if (jIdx(D, x1, y1) < 0) { const e = jointErr(sv, x1, y1); if (e) return e; }
      if (jIdx(D, x2, y2) < 0) { const e = jointErr(sv, x2, y2); if (e) return e; }
      return memberErr(sv, x1, y1, x2, y2, mt);
    }
    function placeOne(D, x1, y1, x2, y2, mt) {
      let a = jIdx(D, x1, y1), b = jIdx(D, x2, y2);
      if (a < 0) { D.x.push(x1); D.y.push(y1); a = D.x.length - 1; }
      if (b < 0) { D.x.push(x2); D.y.push(y2); b = D.x.length - 1; }
      const k = mIdx(D, a, b);
      if (k >= 0) { if (D.m[k][2] === mt) return 0; D.m[k][2] = mt; return 2; }
      D.m.push([a, b, mt]); return 1;
    }
    const canMirror = () => site().r === 0;
    function place(x1, y1, x2, y2) {
      const s = editSeat(); if (s < 0) return false;
      const w = W(s), D = w.D, sv = site();
      const e = placeErr(D, x1, y1, x2, y2, mat);
      if (e) { api.toast(e); sfx('thud'); api.buzz(20); return false; }
      const before = snap(D);
      const r = placeOne(D, x1, y1, x2, y2, mat);
      if (r === 0) { api.toast('이미 같은 ' + MAT[mat].n + '가 있어요'); return false; }
      let mr = 0;
      if (mirror && canMirror()) {
        const mx1 = sv.L - x1, mx2 = sv.L - x2;
        if (!((mx1 === x1 && mx2 === x2) || (mx1 === x2 && mx2 === x1 && y1 === y2)) && !placeErr(D, mx1, y1, mx2, y2, mat)) mr = placeOne(D, mx1, y1, mx2, y2, mat);
      }
      if (D.x.length > MAXJ || serialize(D).length > MAXD) { w.D = parse(sv, before); api.toast('더는 못 지어요 (설계가 너무 커요)'); return false; }
      w.undo.push(before); if (w.undo.length > 80) w.undo.shift();
      w.sel = jIdx(w.D, x2, y2);
      sfx(r === 2 ? 'chip' : 'pop'); api.buzz(8);
      if (r === 2) api.toast(MAT[mat].n + '(으)로 바꿨어요');
      changed();
      return true;
    }
    function delMember(k) {
      const s = editSeat(); if (s < 0) return;
      const w = W(s), D = w.D, sv = site();
      pushUndo(w);
      const m = D.m[k], ax = D.x[m[0]], ay = D.y[m[0]], bx = D.x[m[1]], by = D.y[m[1]];
      D.m.splice(k, 1);
      if (mirror && canMirror()) { const a = jIdx(D, sv.L - ax, ay), b = jIdx(D, sv.L - bx, by); const k2 = a >= 0 && b >= 0 ? mIdx(D, a, b) : -1; if (k2 >= 0) D.m.splice(k2, 1); }
      w.D = compact(D); w.sel = -1; sfx('thud'); api.buzz(10); changed();
    }
    function delJoint(j) {
      const s = editSeat(); if (s < 0) return;
      const w = W(s), D = w.D, sv = site();
      if (j < D.na) { api.toast('고정점은 못 지워요'); return; }
      pushUndo(w);
      const x0 = D.x[j], y0 = D.y[j];
      D.m = D.m.filter((m) => m[0] !== j && m[1] !== j);
      if (mirror && canMirror()) { const j2 = jIdx(D, sv.L - x0, y0); if (j2 >= D.na && j2 !== j) D.m = D.m.filter((m) => m[0] !== j2 && m[1] !== j2); }
      w.D = compact(D); w.sel = -1; sfx('thud'); api.buzz(10); changed();
    }
    function undo() {
      const s = editSeat(); if (s < 0 || test) return;
      const w = W(s); if (!w.undo.length) return;
      w.D = parse(site(), w.undo.pop()); w.sel = -1; sfx('click'); changed();
    }
    function setMat(c) {
      if (curMode !== 'edit') return;
      mat = c; if (delMode) toggleDel(); sfx('click');
      MATS.split('').forEach((k) => matBtns[k].classList.toggle('on', k === c));
      syncInfo();
    }
    function toggleDel() { if (test) return; delMode = !delMode; delBtn.classList.toggle('on', delMode); const s = editSeat(); if (s >= 0) W(s).sel = -1; sfx('click'); syncInfo(); }
    function toggleMir() {
      if (test) return;
      if (!canMirror()) { api.toast('높이가 다른 현장이라 대칭을 못 써요'); return; }
      mirror = !mirror; mirBtn.classList.toggle('on', mirror); sfx('click');
      api.toast(mirror ? '좌우 대칭 켬: 반대쪽에도 똑같이 지어요' : '좌우 대칭 끔');
    }
    function changed() { settle = null; setKey = ''; testRes = null; syncStat(); syncInfo(); }

    /* ---- 자기 무게 미리 보기 + 시험 운행 ---- */
    function ensureSettle() {
      const D = curD(); if (!D) return null;
      const key = serialize(D) + '|' + st.si;
      if (setKey === key && settle) return settle;
      const S = makeSim(site(), -1, D);
      for (let i = 0; i < 80; i++) S.step();
      let pk = 0, nb = 0; for (let k = 0; k < S.nM; k++) { if (S.br[k] >= 0) nb++; else if (S.ra[k] > pk) pk = S.ra[k]; }
      settle = { S, pk, nb, cost: costOf(site(), D) }; setKey = key;
      return settle;
    }
    function toggleTest() {
      if (curMode !== 'edit') return;
      if (test) { stopTest(); return; }
      const D = curD(); if (!D) return;
      if (!D.m.some((m) => m[2] === 'R')) { api.toast('먼저 나무 길을 놓아 주세요'); return; }
      const s = editSeat(); W(s).sel = -1; ghost = null;
      parts.length = 0;
      test = { S: makeSim(site(), st.vh, D), acc: 0, end: -1, fall: null, nb: 0, hold: 0 };
      testBtn.textContent = '■ 멈춤'; testBtn.classList.add('on');
      [undoBtn, delBtn, mirBtn, doneBtn].forEach((b) => { b.disabled = true; });
