    const spotView = h('div', { class: 'bg-spot bg-view' });
    const info = h('div', { class: 'bg-info' });
    const matsEl = h('div', { class: 'bg-mats' });
    const matBtns = {};
    MATS.split('').forEach((c, i) => {
      const M = MAT[c];
      const sw = h('i', { style: { height: (c === 'P' || c === 'C' ? 3 : c === 'K' ? 9 : c === 'R' ? 7 : 5) + 'px', background: M.col } });
