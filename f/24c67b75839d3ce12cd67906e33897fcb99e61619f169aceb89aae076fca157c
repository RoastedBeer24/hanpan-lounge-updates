    const testBtn = h('button', { 'data-action': 'test', class: 'btn bg-test', type: 'button', text: '▶ 시험', title: '시험 운행 (T)', onclick: () => toggleTest() });
    const doneBtn = h('button', { 'data-action': 'done', class: 'btn primary bg-done', type: 'button', text: '완성!', title: '제출 (Enter 두 번)', onclick: () => pressDone() });
