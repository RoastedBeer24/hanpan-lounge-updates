    let st = null, dead = false;
    const nm = (i) => (api.players[i] ? api.players[i].name : (st && st.nm[i]) || i + 1 + '번');
    const col = (i) => (api.players[i] ? api.players[i].color : '#e3ae45');
    const multi = () => !api.online && api.mySeats().length >= 2;
    const sfx = (n) => { try { api.sfx(n); } catch (e) {} };

    /* ---- DOM ---- */
    const bName = h('span', { class: 'nm' }), bRound = h('span', { class: 'rd' }), bTime = h('span', { class: 'tm' });
    const budTxt = h('span', { class: 'bg-bud' }), budBar = h('i'), budWrap = h('span', { class: 'bg-budbar' }, budBar), runTxt = h('span', { class: 'bg-run' });
    const brief = h('div', { class: 'bg-brief', role: 'button', 'data-action': 'brief', 'aria-label': '현장 자세히', onclick: () => openBrief() },
