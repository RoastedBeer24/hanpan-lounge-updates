  function previewArt(cv, ims) {
    /* 표지 캔버스를 2배로 키워 그림(그림이 뭉개지지 않게) — 좌표는 640×360 그대로 */
    const w = 640, h = 360, bg = ims[0], bo = ims[1], he = ims[2]; cv.width = w * 2; cv.height = h * 2;
    const g = cv.getContext('2d'); g.setTransform(2, 0, 0, 2, 0, 0); g.imageSmoothingQuality = 'high';
    const k = Math.max(w / bg.width, h / bg.height); g.drawImage(bg, (w - bg.width * k) / 2, (h - bg.height * k) / 2, bg.width * k, bg.height * k);
    g.fillStyle = 'rgba(12,10,20,.2)'; g.fillRect(0, 0, w, h);
    /* 파수: 가장자리를 둥글게 지워 배경에 녹임 */
    const bw = 300, bh = bw * bo.height / bo.width, c = document.createElement('canvas'); c.width = bw * 2; c.height = Math.round(bh * 2);
    const q = c.getContext('2d'); q.scale(2, 2); q.imageSmoothingQuality = 'high'; q.drawImage(bo, 0, 0, bw, bh); q.globalCompositeOperation = 'destination-in';
    q.translate(bw / 2, bh * 0.4); q.scale(1, 1.3); const m = q.createRadialGradient(0, 0, bw * 0.24, 0, 0, bw * 0.5); m.addColorStop(0, '#000'); m.addColorStop(1, 'rgba(0,0,0,0)'); q.fillStyle = m; q.fillRect(-bw, -bh, bw * 2, bh * 2);
    g.drawImage(c, w - bw - 6, -22, bw, bh);
    /* 사수 */
    const hh = 430, hw = hh * he.width / he.height; g.drawImage(he, 136 - hw / 2, 18, hw, hh);
    const dots = [[330, 190, 0], [286, 232, 1], [352, 252, 0], [308, 150, 0]];
    for (const d of dots) { g.fillStyle = d[2] ? '#62e8dc' : '#ff7a5a'; g.beginPath(); if (d[2]) { g.moveTo(d[0], d[1] - 11); g.lineTo(d[0] + 11, d[1]); g.lineTo(d[0], d[1] + 11); g.lineTo(d[0] - 11, d[1]); } else g.arc(d[0], d[1], 8, 0, 7); g.fill(); }
