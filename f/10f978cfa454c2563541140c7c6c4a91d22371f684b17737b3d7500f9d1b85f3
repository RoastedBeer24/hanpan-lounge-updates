      { id: 'floe', label: '유빙', tip: '떠다니는 얼음 조각이 나타나요.', def: 'on', choices: [{ v: 'on', label: '켬' }, { v: 'off', label: '끔' }] },
      { id: 'sea', label: '바다 생물', tip: '바다 생물이 나와 펭귄을 건드려요.', def: 'on', choices: [{ v: 'on', label: '켬' }, { v: 'off', label: '끔' }] },
