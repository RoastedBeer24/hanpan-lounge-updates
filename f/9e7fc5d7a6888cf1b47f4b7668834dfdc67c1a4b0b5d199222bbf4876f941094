  }
  const snap = (s) => ({ st: Object.assign({}, s.st), mo: s.mo, fa: s.fa });
  const actor = (s) => (s.over ? null : 0);

  function addSt(s, k, v, scale) {
    const d = v > 0 ? Math.max(1, Math.round(v * (scale ? KF(s).g : 1))) : v;
    const b = s.st[k]; s.st[k] = clamp(b + d, 0, STMAX); return s.st[k] - b;
  }
