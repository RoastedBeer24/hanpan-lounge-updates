  const ri = (n) => Math.floor(rnd() * n);
  const LEN = { full: { T: 36, g: 1, a: 1, b: 1, ev: 0.42, sick: 4 }, short: { T: 12, g: 2.7, a: 2.1, b: 1.7, ev: 0.6, sick: 2 } };
  const KF = (s) => LEN[s.len] || LEN.full;
  const calM = (s) => ((s.t + 2) % 12) + 1;                       // 3월에 시작
