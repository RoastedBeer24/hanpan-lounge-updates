    const b = C.af; C.af = clamp(b + d, 0, 100); return C.af - b;
  }
  function addBm(s, c, v) { const C = s.C[c]; if (!C) return 0; const b = C.bm; C.bm = clamp(b + v, 0, 120); return C.bm - b; }
  /* 효과 묶음 적용 → 화면에 보일 조각 글 */
