    const s = {
      v: 1, len, T: LEN[len].T, t: 0, ph: 'run', st, fa: 10, mo: 12, C: {}, cnt: {}, mc: { call: 0, cl: [], met: [], gift: [] },
      plan: null, lp: null, q: [{ k: 'sc', sc: { k: 'intro' } }, { k: 'sc', sc: { k: 'meet', c: 'nbr' } }, { k: 'plan' }], sc: null, rep: [], prev: null, ms: null,
