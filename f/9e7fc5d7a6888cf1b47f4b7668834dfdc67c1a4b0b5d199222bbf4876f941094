  const SLOTN = ['초순', '첫 주말', '중순', '하순', '끝 주말'];
  const metList = (s) => CH.filter((c) => s.C[c.id]);
  const sgn = (v) => (v > 0 ? '+' + v : '−' + Math.abs(v));
  const hash = (seed, k) => { let x = (seed ^ (k * 0x9e3779b1)) >>> 0; x ^= x >>> 16; x = Math.imul(x, 0x7feb352d); x ^= x >>> 15; x = Math.imul(x, 0x846ca68b); x ^= x >>> 16; return (x >>> 0) / 4294967296; };
  const gpa = (s) => (s.ex.length ? s.ex.reduce((a, b) => a + b, 0) / s.ex.length : 3);
  const GRN = ['A+', 'A', 'B', 'C', 'D', 'F'], GRP = [4.5, 4, 3, 2, 1, 0];

  function init(players, opts) {
    const len = opts && opts.len === 'short' ? 'short' : 'full';
    const seed = (Math.random() * 0x7fffffff) | 0;
