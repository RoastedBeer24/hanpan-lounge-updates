  /* ----- 평일 일과 ----- */
  function doWork(s, i) {
    let a = ACTI[s.plan.a[i]]; const e = { k: 'a', i, a: a.id, d: {}, fa: 0, mo: 0 };
    if (s.fs) { s.fs = 0; a = ACTI.rest; e.a = 'rest'; e.nt = '몸살로 누워 지냈다.'; }
