        if (pickBar) try { pickBar.destroy(); } catch (e) {}
        clearStage();
        try { R.dispose(); R.forceContextLoss(); } catch (e) {}
        wrap.remove();
      },
    };
  };
  const perfNow = () => performance.now();
  window.IS_VIEW = V;
})();
