        try { if (R.compileAsync && R.extensions.has('KHR_parallel_shader_compile')) R.compileAsync(scene, cam).then(done, done); else { R.compile(scene, cam); done(); } } catch (e) { done(); }
      }).catch((e) => { console.warn(e); hooks.progress(1, '모델을 불러오지 못했어요. (' + (e && e.message || e) + ')'); });
    }
    raf = requestAnimationFrame(frame);
    DBG.pick = (i) => doPick(i);
    DBG.state = () => st;
    DBG.rp = (s) => { const r = rpos(W.pl[s]); return [r.x, r.y, r.z]; };
    DBG.view = () => ({ W, cy, cp, ready });
    DBG.wrot = (x, y, z) => { WROT[0] = x; WROT[1] = y; WROT[2] = z; for (const o of pv) if (o && o.m.wpn) o.m.wpn.rotation.set(x, y, z); };
    DBG.cam = (d, pitch, yaw) => { cd = d; if (pitch != null) cp = pitch; if (yaw != null) cy = yaw; };

    return {
      update(s) {
        if (!s) return;
        st = s;
        if (!ready) { start(); return; }
