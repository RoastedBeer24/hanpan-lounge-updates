          scene.remove(wg);
          for (const m of relLater) { (pools[m.key] || (pools[m.key] = [])).push(m); } relLater.length = 0;
          DBG.tm = { compile: Math.round(perfNow() - t0), progs: R.info.programs.length };
          if (st.ph !== 'play') { W = null; wkey = ''; clearStage(); }
          ready = true; hooks.ready();
