      { h: '전투', p: ['적과 부딪히면 알아서 싸워요. 용사는 0.25초마다, 적은 0.3초마다 한 번씩 때려요. 무작위는 없어요.', '적 이름표의 색이 어림이에요: 초록 = 쉽게 이김, 노랑 = 이기지만 체력이 많이 닳음, 붉음 = 짐.', '레벨 차이가 크면 닿는 순간 끝나요. 멈추지 않고 지나가요.', '지면 여신상 마을에서 깨어나요. 체력은 절반, 가진 돈의 30%를 치료비로 내요. 시간은 돌아오지 않아요.', '「물러나기」: 한 대 맞고 싸움에서 빠져요. 싸우지 않는 동안 체력은 초마다 2%씩 돌아와요.', '약점이 있는 적은 맞는 무기로 피해가 2.5배예요. 「필요」가 붙은 적은 그 무기(또는 동료) 없이는 피해가 1이에요.'] },
      { h: '돌진', p: ['돌진 단추(PC: Shift · Space)를 누르는 동안 이동이 1.5배 빨라지고, 싸울 때는 0.15초마다 때려요.', '대신 초마다 최대 체력의 4%가 닳아요. 체력이 20% 아래면 쓸 수 없어요.'] },
      { h: '마을', p: ['여신상: 되감기. 여관: 체력을 모두 회복. 상점: 무기 · 갑옷 · 장신구 · 도구. 사람들: 길을 여는 일을 맡아 줘요. 「들은 이야기」에 그 스테이지의 실마리가 있어요.', '무기는 여러 자루를 가질 수 있고, 적마다 가장 센 것을 알아서 써요.', '여신상과 상점이 서로 다른 마을에 있는 스테이지도 있어요.'] },
      { h: '길을 막는 것', p: ['끊긴 다리(목수) · 얕은 물(배) · 덤불(도끼) · 바위(곡괭이) · 어두운 굴(횃불) · 잠긴 문(열쇠) · 봉인(마법사나 봉화).', '늪 · 깊은 눈: 걸음이 절반. 용암 · 독 웅덩이: 느려지고 초마다 체력 40%가 닳아요(두꺼운 장화로 막음).', '밤이 있는 스테이지는 15초가 지나면 밤이에요. 밤에만 나오는 적, 낮에만 건너는 갯벌, 밤에만 어는 호수가 있어요.', '막힌 곳에 부딪히면 무엇이 필요한지 알려 줘요.'] },
      { h: '지도와 기록', p: ['스테이지는 36곳이고 갈림길이 있어요. 성이 둘인 스테이지는 어느 마왕을 잡느냐에 따라 다른 길이 열려요.', '스테이지마다 가장 좋은 기록(시간 · 되감은 횟수 · 쓴 돈)과 칭호가 이 기기에 남아요. 칭호 등급은 되감은 횟수로 정해져요.', '「원정 마치기」를 누르면 이번에 잡은 마왕 수로 판이 끝나요. 열린 길과 기록은 남아요.'] },
      { h: '조작', p: ['폰: 지도에서 가고 싶은 곳을 누르면 길을 찾아 걸어가요. 누른 채 끌면 따라와요. 용사를 누르면 멈춰요. 오른쪽 아래 「돌진」은 누르는 동안만.', 'PC: WASD/방향키 이동(마우스로 눌러도 돼요) · Shift/Space 돌진 · E/Enter 확인 · 마을에서 R 되감기, H 회복 · 싸울 때 Q 물러나기.', '화면 위: 남은 시간(크게), 레벨과 체력, 돈과 다음 되감기 값, 마왕과 지금 싸우면 어떻게 되는지.'] },
      { h: 'AI', p: ['AI 자리로 두면 AI가 스테이지를 운영해요(두 곳을 깨면 원정을 마쳐요). 난이도는 쉬움 · 보통 · 어려움. 어려움은 시간을 빠듯하게 쓰고 돌진을 써요. 판마다 조심성과 씀씀이가 조금씩 달라요.'] },
      { h: '만든 것', p: ['지도 · 적 · 마왕 · 타일은 모두 코드로 그린 도트예요(외부 그림 · 소리 파일 없음).', '「30초 뒤 끝나는 세상, 돈으로 시간을 되감는다」는 틀은 「용자 30」(마벨러스)을 참고했고, 이름 · 그림 · 문구 · 스테이지는 모두 새로 만들었어요.'] },
    ],
    tutorial: [
      { text: '세상은 30초 뒤에 끝납니다. 지도에서 스테이지를 고르고 「출발」을 누르세요.' },
      { text: '들에서는 가고 싶은 곳을 누르면 걸어갑니다(PC: WASD). 적과 부딪히면 알아서 싸웁니다. 이름표가 초록인 적부터.' },
      { text: '시간이 다 되어 가면 마을로 돌아가 여신상에 돈을 내고 되감으세요. 충분히 강해지면 마왕성으로.' },
    ],
    hint: (s) => {
      if (!s.st || s.ph === 'hub') return ['지도에서 스테이지를 고르고 「출발」을 누르세요.', '금테 = 열린 곳, 금 · 은 · 동 = 깬 곳과 칭호 등급.'];
      const ST = stage(s.st), H = hstat(s), c = rwCost(s, ST);
      const o = [ST.D.obj, '남은 시간 ' + (s.t / TPS).toFixed(1) + '초 · 돈 ' + s.g + COIN + ' · 다음 되감기 ' + c + COIN + (s.g < c ? ' (' + (c - s.g) + COIN + ' 모자람)' : '')];
      ST.bosses.forEach((B) => { const E = bstat(B, s), r = simB(s, ST, E, true); o.push(B.n + ' Lv' + E.lv + ': ' + (bossOpen(s, ST, B) || (r.dmg <= 1 && E.need.length ? '지금 무기로는 피해를 줄 수 없습니다.' : r.win ? '지금 싸우면 이깁니다(' + r.t.toFixed(1) + '초).' : '지금 싸우면 집니다. 마왕 체력 ' + Math.round(r.ep * 100) + '% 남음.'))); });
      ST.towns.forEach((T) => T.tips.slice(0, 1).forEach((t) => o.push(t)));
      return o.slice(0, 6);
    },
    panelInfo: (s) => { if (!s.st || s.ph === 'hub') return [{ label: '열린 스테이지', value: s.op.length + '/' + ORDER.length }, { label: '이번 원정', value: s.ses.n + '곳' }]; const ST = stage(s.st), H = hstat(s); return [{ label: '스테이지', value: ST.D.n }, { label: '남은 시간', value: (s.t / TPS).toFixed(1) + '초' }, { label: '레벨', value: s.lv }, { label: '체력', value: Math.ceil(s.hp) + '/' + H.mhp }, { label: '돈', value: s.g + COIN }, { label: '다음 되감기', value: rwCost(s, ST) + COIN }, { label: '되감은 횟수', value: s.rw + '번' }, { label: '동료', value: s.co.map((c) => COMP[c].n).join(', ') || '없음' }]; },
    codex: codexData(),
    init, actor, apply, ai, result, mount,
  });
})();
