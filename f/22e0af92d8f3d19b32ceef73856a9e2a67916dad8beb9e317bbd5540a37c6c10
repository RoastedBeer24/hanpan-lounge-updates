      }
      for (const k in wells) drainEv(wells[k]);
    }

    /* ----- feedback for my well ----- */
    function drainEv(w) {
      if (!w.ev.length) return;
      const mine = w.seat === mySeat();
      const evs = w.ev; w.ev = [];
      if (!mine) return;
      for (const e of evs) {
        if (e.k === 'hard') { shake = Math.min(4, 1.5 + e.d * 0.12); api.sfx('thud'); }
        else if (e.k === 'lock') {
          if (e.n > 0) {
            const tm = now;
            flash.push({ rows: e.rows, t: tm });
            const nm = e.ts ? (e.ts === 1 ? '미니 ' : '') + 'T 스핀' + ['', ' 싱글', ' 더블', ' 트리플'][e.n] : ['', '싱글', '더블', '트리플', '쿼드!'][e.n];
            const sub = [];
            if (e.b2b) sub.push('연속 보너스');
            if (e.combo > 0) sub.push('콤보 ' + e.combo);
            if (e.pc) sub.push('퍼펙트 클리어!');
            if (e.atk > 0) sub.push('공격 +' + e.atk);
            else if (e.cancel > 0) sub.push('상쇄 ' + e.cancel);
            floats.push({ text: nm, sub: sub.join(' · '), t: 1.1, big: e.n >= 4 || e.ts === 2 || e.pc });
            api.sfx(e.n >= 4 || e.ts === 2 || e.pc ? 'win' : 'pop');
            api.buzz(e.n >= 4 || e.ts === 2 ? 35 : 18);
            if (e.atk > 0) setTimeout(() => api.sfx('whoosh'), 90);
          } else { api.buzz(8); if (e.ts) floats.push({ text: (e.ts === 1 ? '미니 ' : '') + 'T 스핀', sub: '', t: 0.8 }); }
        } else if (e.k === 'garbage') { shake = 4; api.buzz(30); }
        else if (e.k === 'die') { api.sfx('lose'); api.buzz(90); }
