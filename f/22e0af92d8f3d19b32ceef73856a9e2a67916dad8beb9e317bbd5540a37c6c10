    if (!w.cur || w.dead || w.fin) return;
    if (a.pc !== w.pieces || a.t !== w.cur.t && !a.ops) {
      a.pc = w.pieces; a.t = w.cur.t; a.ops = null;
      a.cd = (1 / cfg.pps) * (0.7 + rnd() * 0.45) * 0.55;
    }
    if (!a.ops) {
      a.cd -= dt;
      if (a.cd > 0) return;
      let plan = aiPlan(w, cfg, rnd);
      if (!plan) { hardDrop(w, env); return; }
      if (cfg.slip && rnd() < cfg.slip) plan = { hold: false, rs: [], dx: plan.dx + (rnd() < 0.5 ? -1 : 1) };
      a.ops = [];
      if (plan.hold) a.ops.push('h');
      plan.rs.forEach((d) => a.ops.push(d > 0 ? 'c' : 'w'));
      for (let k = 0; k < Math.abs(plan.dx); k++) a.ops.push(plan.dx > 0 ? 'r' : 'l');
      a.ops.push('d');
      a.gap = (1 / cfg.pps) * 0.45 / a.ops.length; a.it = 0;
    }
    a.it -= dt;
    while (a.ops && a.ops.length && a.it <= 0 && w.cur) {
      a.it += a.gap;
      const op = a.ops.shift();
      if (op === 'h') { holdPiece(w); a.pc = w.pieces; a.t = w.cur && w.cur.t; }
      else if (op === 'c') rotate(w, 1);
      else if (op === 'w') rotate(w, -1);
      else if (op === 'r') tryMove(w, 1, 0);
