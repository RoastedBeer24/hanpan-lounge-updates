  function result(s) {
    const r = result0(s); if (r) { try { r.stats = statRows(s); } catch (e) {} } return r;
  }
  function result0(s) {
    if (!s || s.ph !== 'done' || !Array.isArray(s.res) || !s.res.length) return null;
    const nm = (i) => (s.nm && s.nm[i]) || ((i + 1) + '번');
    const r0 = s.res[0];
    if (s.n === 1) {
      if (s.md === 'sp') {
        if (r0[1] === 'f') return { winners: [0], title: SPRINT + '줄 완료!', text: '기록 ' + fmtT(r0[2]) };
        return { winners: [], title: '쌓여서 끝났어요', text: r0[3] + ' / ' + SPRINT + '줄 · ' + fmtS(r0[2]) };
      }
      return { winners: [0], title: '게임 오버', text: '점수 ' + (r0[5] || 0).toLocaleString() + '\n' + r0[3] + '줄 · ' + fmtS(r0[2]) };
    }
    const lines = s.res.map((r, k) => {
      let tail;
      if (s.md === 'sp') tail = r[1] === 'f' ? fmtT(r[2]) : '탈락 · ' + r[3] + '줄';
      else tail = '공격 ' + (r[4] || 0) + ' · ' + r[3] + '줄' + (r[1] === 'x' ? ' · ' + fmtS(r[2]) + ' 탈락' : '');
      return (k + 1) + '위  ' + nm(r[0]) + '  ' + tail;
    });
    const ok = r0[1] === 'w' || r0[1] === 'f' || s.md === 'vs'; // simultaneous KO: the later one ranks first
    return { winners: ok ? [r0[0]] : [], title: ok ? nm(r0[0]) + (s.md === 'sp' ? ' 1위!' : ' 승리!') : '모두 탈락', text: lines.join('\n') };
  }

  /* ======================= view ======================= */
  const COL = ['#000', '#4fc4d6', '#5b86e6', '#f0974e', '#e8c04e', '#5fd3a0', '#b48cf0', '#ee6a55', '#6a6175'];
  const FONT = '"IBM Plex Sans KR","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif';
  const MONO = '"IBM Plex Mono",ui-monospace,Menlo,monospace';
  const DISP = '"Black Han Sans","Apple SD Gothic Neo","Malgun Gothic",sans-serif';

  function mount(root, api) {
    const cv = U.canvas(root), ctx = cv.ctx;
    const SPD = () => (L.debug && L.debug.speed) || 1;
    const STEP = 1 / 60;
    let st = null, key = null, phase = 'wait', cd = 0, goT = 0, acc = 0, pubT = 0, hostT = 0;
    let wells = {}, blobs = {}, decs = {}, outSeen = 0;
    let ctl = 'g', ctlSet = false, lay = null, bg = null, now = 0;
    let flash = [], floats = [], shake = 0, hitT = 0, dangerT = 0;
    const tiles = {};
    const P = (seat) => api.players[seat] || { name: '?', color: '#888', ai: true };
    const N = () => (st ? st.n : api.players.length);
    function controlledHere(seat) {
      const p = api.players[seat];
