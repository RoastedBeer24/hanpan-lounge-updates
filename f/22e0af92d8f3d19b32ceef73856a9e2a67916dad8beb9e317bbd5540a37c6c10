  /* compact snapshot for presence (~250 B): board rows from the first non-empty row down */
  function packWell(w) {
    let first = ROWS;
    for (let i = 0; i < COLS * ROWS; i++) if (w.m[i]) { first = Math.floor(i / COLS); break; }
    let b = '';
    for (let i = first * COLS; i < COLS * ROWS; i++) b += CH[w.m[i]];
    const r1 = (v) => Math.round(v * 10) / 10;
    return {
      b, p: w.cur ? [TI[w.cur.t], w.cur.r, w.cur.x, w.cur.y] : 0, h: w.hold, n: w.q.slice(0, 5).join(''),
      l: w.lines, a: w.cum, q: w.gen.n - w.q.length, g: pendSum(w), tg: w.tg, at: w.sent,
      d: w.dead ? r1(w.deadT) || 0.1 : 0, f: w.fin ? Math.round(w.fin * 100) / 100 : 0, lv: w.lv, t: r1(w.t), sc: w.score,
