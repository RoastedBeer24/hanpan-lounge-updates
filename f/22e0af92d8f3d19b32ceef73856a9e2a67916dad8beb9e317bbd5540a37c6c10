    }
    cv.onresize = layout;

    /* ----- input: gestures ----- */
    const ptrs = new Map();
    let das = null, softBtn = null;
    const pressed = new Set();
    function act(kind) {
      const w = myW();
      if (!w || !w.cur || w.dead || w.fin) return false;
      let ok = false;
      if (kind === 'L') ok = tryMove(w, -1, 0);
      else if (kind === 'R') ok = tryMove(w, 1, 0);
      else if (kind === 'cw') ok = rotate(w, 1);
      else if (kind === 'ccw') ok = rotate(w, -1);
      else if (kind === 'sd') ok = softStep(w);
      else if (kind === 'hd') ok = hardDrop(w, env);
      else if (kind === 'hold') { ok = holdPiece(w); if (ok) { api.sfx('card'); api.buzz(10); } else api.buzz(4); }
      if (ok && (kind === 'L' || kind === 'R')) api.sfx('tick');
      if (ok && (kind === 'cw' || kind === 'ccw')) { api.sfx('click'); api.buzz(6); }
