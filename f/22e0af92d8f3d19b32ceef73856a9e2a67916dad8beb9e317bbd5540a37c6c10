        if (api.isHost) { if (nm) api.net.publish({ k: key, w: mine }); if (na) api.net.hostSend({ k: key, w: ai }); }
        else if (nm) api.net.publish({ k: key, w: mine });
      } catch (e) {}
    }
    /* host / local: eliminations, sprint finishes and the end of the match */
    function infoOf(s) {
      const w = wells[s];
      if (w) return { d: w.dead ? w.deadT || 0.1 : 0, f: w.fin || 0, l: w.lines, at: w.sent, sc: w.score, t: w.t };
      const b = blobs[s];
