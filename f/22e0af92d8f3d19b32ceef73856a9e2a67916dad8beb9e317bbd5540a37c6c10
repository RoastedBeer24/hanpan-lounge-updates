    }
    const mySeat = () => { const m = api.mySeats(); return m.length ? m[0] : -1; };
    const mainSeat = () => { const s = mySeat(); return s >= 0 ? s : 0; };
    const myW = () => { const s = mySeat(); return s >= 0 && phase === 'play' ? wells[s] || null : null; };
    const isOut = (s) => !!st && (st.out || []).some((o) => o[0] === s);
    function aliveSeat(s) {
      if (isOut(s)) return false;
