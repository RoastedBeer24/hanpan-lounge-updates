        if (!alive.length) return -1;
        if (st && st.tg === 'a' && w.lastAtk >= 0 && alive.indexOf(w.lastAtk) >= 0) return w.lastAtk;
        return alive[Math.floor(Math.random() * alive.length)];
      },
    };

    /* ----- wells ----- */
    function makeLocal(seat) {
      const w = newWell(st.sd, { seat, md: st.md, solo: st.n === 1 });
      if (P(seat).ai) w.ai = { pc: -1, cfg: AICFG[P(seat).lv] || AICFG[2] };
      return w;
    }
    function fromBlob(seat, b) {
