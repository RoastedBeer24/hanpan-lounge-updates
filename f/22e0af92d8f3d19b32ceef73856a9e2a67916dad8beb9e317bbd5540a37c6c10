        if (i.d > 0 && !out.some((o) => o[0] === s)) fresh.push([s, r1(i.d), i.l, i.at, i.sc]);
        if (i.f > 0 && !fn.some((o) => o[0] === s)) { fn.push([s, Math.round(i.f * 100) / 100, i.l]); changed = true; }
      }
