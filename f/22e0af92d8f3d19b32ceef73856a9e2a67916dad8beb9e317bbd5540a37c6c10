    for (let i = 0; i < b.length && s + i < m.length; i++) { const v = CH.indexOf(b[i]); m[s + i] = v > 0 ? v : 0; }
    return m;
  }

  /* ======================= pure game interface ======================= */
  function init(players, opts) {
    opts = opts || {};
    return {
      rid: 1 + U.rand(999999), sd: 1 + U.rand(2147483646), n: players.length,
      nm: players.map((p) => String(p.name || '').slice(0, 10)),
      md: opts.md === 'sp' ? 'sp' : 'vs',
