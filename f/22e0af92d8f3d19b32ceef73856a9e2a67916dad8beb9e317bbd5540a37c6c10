        for (const s in o.w) { const sv = +s; if (sv >= 0 && sv < N() && !wells[sv] && o.w[s] && typeof o.w[s] === 'object') blobs[sv] = o.w[s]; }
      };
      let rem = null;
      try { rem = api.net.remote(); } catch (e) { rem = null; }
      if (rem && typeof rem === 'object') for (const k in rem) take(rem[k]);
