      return ok;
    }
    function hitRect(r, p, pad) { pad = pad || 0; return r && p.x >= r.x - pad && p.x <= r.x + r.w + pad && p.y >= r.y - pad && p.y <= r.y + r.h + pad; }
    function btnAt(p) {
      let best = null, bd = 1e9;
