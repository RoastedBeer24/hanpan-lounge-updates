          const x = out.filter((o) => !inFn(o[0])).sort((a, b) => b[2] - a[2] || b[1] - a[1]).map((o) => [o[0], 'x', o[1], o[2], o[3], o[4]]);
          res = f.concat(x);
        }
      } else {
        const alive = [...Array(st.n).keys()].filter((s) => !inOut(s));
