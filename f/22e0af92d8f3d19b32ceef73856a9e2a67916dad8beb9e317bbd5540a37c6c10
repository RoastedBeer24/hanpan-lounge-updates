        w.lines = b.l | 0; w.sent = b.at | 0; w.score = b.sc | 0; w.t = +b.t || 0;
        w.cum = {}; if (b.a && typeof b.a === 'object') for (const k in b.a) w.cum[k] = b.a[k] | 0;
        w.gen = makeGen(st.sd); for (let i = 0; i < (b.q | 0); i++) w.gen.next();
