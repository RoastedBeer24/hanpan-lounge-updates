          const i = infoOf(0) || { l: 0, at: 0, sc: 0, t: 0 };
          res = inFn(0) ? [[0, 'f', fn[0][1], i.l, 0, i.sc]] : [[0, 'x', r1(out[0][1]), i.l, i.at, i.sc]];
        }
      } else if (st.md === 'sp') {
        const all = [...Array(st.n).keys()];
        if (all.every((s) => inOut(s) || inFn(s))) {
          done = true;
