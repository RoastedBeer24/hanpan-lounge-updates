  }
  const fmtT = (s) => { s = Math.max(0, s || 0); const m = Math.floor(s / 60), r = s - m * 60; return m + ':' + (r < 10 ? '0' : '') + r.toFixed(2); };
  const fmtS = (s) => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
  function statRows(s) { // per-seat table from res rows [seat, kind, time, lines, attack, score]
    const by = []; s.res.forEach((r) => { if (Array.isArray(r) && r[0] >= 0 && r[0] < s.n) by[r[0]] = r; });
    const col = (f) => Array.from({ length: s.n }, (_, i) => (by[i] ? f(by[i]) : '-'));
    const rows = [{ label: '지운 줄', values: col((r) => (r[3] | 0) + '줄') }];
    if (s.md === 'vs') { if (s.n > 1) rows.push({ label: '보낸 공격', values: col((r) => (r[4] | 0) + '줄') }); rows.push({ label: '점수', values: col((r) => (r[5] | 0).toLocaleString()) }); }
    rows.push({ label: s.md === 'sp' ? '기록' : '버틴 시간', values: col((r) => (s.md === 'sp' && r[1] === 'f' ? fmtT(r[2]) : fmtS(r[2]))) });
