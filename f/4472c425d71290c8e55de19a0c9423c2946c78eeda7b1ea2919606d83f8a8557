      return '<div class="sp-sb"><div class="sp-hp' + (lo ? ' low' : '') + '"><span>체력</span><div class="sp-bar"><i style="width:' + (100 * s.hp / s.mhp) + '%"></i></div><b class="mono">' + s.hp + '/' + s.mhp + '</b></div><div class="sp-coin">' + glyph('coin', '#e3ae45', 18) + '<b class="mono">' + s.coin + '</b></div></div>'
