  const face = (name, col) => { const a = art(name); return '<span class="sp-fc" style="--c:' + (col || '#5a4e6c') + '">' + (a.ok > 0 ? '<img src="' + a.src + '" alt="" draggable="false">' : '') + '</span>'; };
  const EVBG = ['bg_shop', 'bg_river', 'bg_stage', 'bg_room', 'bg_night', 'bg_river', 'bg_river', 'bg_river', 'bg_wait', 'bg_night', 'bg_room', 'bg_room', 'bg_shop', 'bg_room', 'bg_river', 'bg_stage', 'bg_shop', 'bg_wait', 'bg_night', 'bg_night'];   // 외출 사건별 배경(EV와 같은 순서)
  const bgSt = (name) => { const a = art(name); return a.ok > 0 ? 'background-image:url(' + a.src + ');' : ''; };
