    if (HK) for (const fn of HK.at.x) fn(s, P, X, 0);
    const r = spinCore(P.b, X, rng(hsh(s.seed, 1, P.sp)), true);
    P.c += r.tot; P.tot += r.tot; P.best = Math.max(P.best, r.tot); P.rm += r.tok.rm; P.sp++; P.due--;
    P.last = { id: P.sp, pl: r.pl, ev: r.ev, pay: r.pay, tot: r.tot, fin: r.fin, bo: r.bonus, rent: null, tw };
    if (HK) for (const fn of HK.at.after) fn(s, P, r);
    if (P.due <= 0) {
      const amt = rentAmt(s, P);
      if (P.c >= amt) {
        P.c -= amt; P.ri++;
        let int = 0; if (M.interest) { int = Math.min(60, Math.floor(P.c * M.interest)); P.c += int; }
        P.rm += 1 + M.rm; P.rr += M.rr;
        P.last.rent = [amt, 1, int, P.ri];
        if (HK) for (const fn of HK.at.rent) fn(s, P);
        if (P.ri >= s.len) { P.ph = 'won'; return; }
        P.due = spinsFor(s, P, P.ri); P.pi = 1;
      } else { P.last.rent = [amt, 0, 0, P.ri]; P.ph = 'dead'; return; }
    }
    P.ph = 'pick'; P.rrn = 0; P.of = genOffer(s, P);
  }
  function afterPick(s, P) {
    P.of = null;
    if (P.pi) { P.pi = 0; P.io = genItems(s, P); P.ph = P.io.length ? 'item' : 'spin'; if (!P.io.length) P.io = null; }
    else P.ph = 'spin';
  }
  function apply(s, seat, a) {
    usePool(s);
    const P = s.P[seat];
    if (!P || !a) throw new Error('bad');
    if (a.t === 'rm') {
      if (!ACT[P.ph] || P.rm <= 0 || !(a.b >= 0 && a.b < P.b.length)) throw new Error('bad rm');
      P.b.splice(a.b, 1); P.rm--; return s;
    }
    if (a.t === 'spin') { if (P.ph !== 'spin') throw new Error('not spin'); doSpin(s, P); return s; }
    if (a.t === 'reroll') { if (P.ph !== 'pick' || P.rr <= 0) throw new Error('no reroll'); P.rr--; P.rrn++; P.of = genOffer(s, P); return s; }
    if (a.t === 'pick') {
      if (P.ph !== 'pick') throw new Error('not pick');
      P.got = 0;
      if (a.i >= 0) {
        const k = P.of[a.i]; if (k == null) throw new Error('bad pick');
        if (P.b.length < BAGMAX) { P.b.push(newSlot(k)); P.got = 1; }
        const M = mods(P);
        if (M.twin && P.b.length < BAGMAX && rng(hsh(s.seed, 5, P.sp))() < M.twin) { P.b.push(newSlot(k)); P.got = 2; }
      }
