  }
  function standing(s) {   // 순위 점수: 끝까지 버팀 > 낸 집세 수 > 총 수입
    return s.P.map((P, i) => ({ i, sc: (P.ph === 'won' ? 1e9 : 0) + P.ri * 1e6 + Math.min(999999, P.tot) }));
  }
  function result(s) {
    if (!s || !s.P || s.P.some((P) => ACT[P.ph])) return null;
    usePool(s);
    const st = standing(s), top = Math.max(...st.map((x) => x.sc));
    const n = s.P.length, won = s.P.filter((P) => P.ph === 'won').length;
    const stats = [
      { label: '낸 집세', values: s.P.map((P) => P.ri + '/' + s.len) },
      { label: '총 수입', values: s.P.map((P) => P.tot) },
      { label: '한 번 최고', values: s.P.map((P) => P.best) },
      { label: '돌린 횟수', values: s.P.map((P) => P.sp) },
      { label: '가방 기호', values: s.P.map((P) => P.b.length) },
      { label: '유물', values: s.P.map((P) => P.it.length) },
    ];
    if (n === 1) {
      const P = s.P[0];
      return P.ph === 'won'
        ? { winners: [0], title: '계약 만료', text: '집세 ' + s.len + '번을 모두 냈어요. 총 수입 ' + P.tot + '.', stats }
        : { winners: [], title: '집세 체납', text: (P.ri + 1) + '번째 집세를 내지 못했어요' + (P.last && P.last.rent ? '(필요 ' + P.last.rent[0] + ', 가진 돈 ' + P.c + ')' : '') + '. ' + P.ri + '번까지는 버텼어요.', stats };
    }
    const winners = st.filter((x) => x.sc === top).map((x) => x.i);
    return { winners, title: won ? '계약 만료' : '가장 오래 버틴 사람', text: won ? won + '명이 마지막 집세까지 냈어요. 순위는 버틴 기간, 같으면 총 수입으로 가려요.' : '모두 언젠가는 집세를 못 냈어요. 낸 집세 수, 같으면 총 수입으로 가려요.', stats };
  }
  function hint(s, seat) {
    const P = s.P[seat >= 0 ? seat : 0]; if (!P) return null;
    usePool(s);
    const amt = rentAmt(s, P), tw = twistOf(s, P.ri);
    const head = P.ph === 'dead' ? '집세를 못 내서 이번 판은 끝났어요.' : P.ph === 'won' ? '계약 만료. 집세를 모두 냈어요.' :
      '집세 ' + amt + ' — 앞으로 ' + P.due + '번 돌린 뒤 내요. 지금 ' + P.c + '.';
    const o = [head];
    if (P.ph === 'spin') o.push('「돌리기」: 가방의 기호가 칸에 무작위로 놓이고, 이웃한 기호끼리 효과를 주고받아요.');
    if (P.ph === 'pick') o.push('기호 하나를 가방에 넣거나 건너뛰어요. 가방이 20개를 넘으면 매번 일부만 칸에 올라가요.', '빼기권 ' + P.rm + '장 · 재추첨권 ' + P.rr + '장.');
    if (P.ph === 'item') o.push('집세를 냈어요. 유물 하나를 골라요 — 판이 끝날 때까지 계속 효과가 있어요.');
    if (tw) { const T = TWISTS[TWK[tw]]; o.push('집주인의 변덕: ' + T.n + ' — ' + T.d); }
    o.push('칸을 누르면 그 기호의 효과가 보여요.');
    return o;
  }
  /* 이 조각은 종착역 걸이 TH(data.js mkHooks)에 새 효과 처리를 등록만 해요. 기본 묶음은 걸이가 없어 여기 코드를 하나도 안 부름.
     등록:  TH.on(단계, '효과 키', (C, i, f) => …)   단계 = act · link · give · pay(더할 값을 돌려줌) · end
            TH.step(단계, (C) => …)                 단계 = order · place · act · link · give · cell · pay · end · post · kill  (인자는 engine.js spinCore 머리 주석)
            TH.step('x', (s, P, X, h) => …)         회전마다 X에 판 밖 값(전체 회전 번호 · 기간 첫/막 회전 등)을 넣음 — 실제 회전과 AI 모의 둘 다 부름
            TH.step('after' | 'rent' | 'init' | 'player', …) · TH.key('키') — 판 단위로 처리하는 키를 「준비됨」으로
            글: FXT['키'] = (f, H, u) => '…'(u = { kw, T, Tj, nm, nj, area }) · FXK['키'] = (f) => [[키워드 id, 수치]] · KW에 새 키워드
     쓸 수 있는 것(같은 클로저): ADJ · ROWC · COLC · LINEC · AREAC(i, a) · CORNER · GW · GH · NC · match(S, t) · SY · K · newSlot(k) · rng · hsh · mods(P)
     가방 칸(종착역): [기호, 시간, 영구 보탬, 상태, 기간 누적, 예약] — C.bag[C.cb[i]]
     머리글: 이 조각의 함수 · 상수 이름은 ta_로 시작(engine_term_b는 tb_) — 조각끼리 이름이 겹치지 않게.

     2단계 a(이 조각이 처리하는 효과 — 정의는 pool_term_a.js의 fx):
       lset{t, n, v, d}  d = 'row' · 'col' · 'x'(줄과 기둥 둘 다) — 그 줄에 t가 n개 이상(자신 포함)이면 +v                       (pay)
       edge{d, v}        판 가장자리 d('l' · 'r' · 't' · 'b')에 놓이면 +v                                                     (pay)
       chain{t, v, g}    편성: 같은 가로줄에서 양옆으로 끊김 없이 이어진 t 하나당 자신 +v, 그 차량 값 +g. 기관차 둘이 한 편성을 나누면 각자 셈  (link → pay)
       tail{v}           어느 편성의 바깥 끝 차량이면 +v                                                                       (pay, chain 결과)
       sched{n, v}       정시: 전체 회전 번호 (spinNo + 1)가 n의 배수인 회전에 +v. sched{n, t, a, pv}면 그 회전에 범위 a의 t 하나당 +pv  (pay)
                         간격 = n + 유물 M.sched(철도 표준 시계 −1) + 변덕 delay(+1), 최소 2. sync 범위 안의 대상은 매 회전이 정시
       sync{t, a}        범위 a 안의 t(시계)는 sched가 매 회전 참                                                               (판 단위 키)
       run{v}            누적: 이번 집세 기간에 판에 놓인 횟수(이번 포함) × v — 가방 칸 [4], 집세를 내면 0                       (pay · end · rent)
       first{v} · last{v} 집세 기간 첫 회전 / 집세를 내기 직전 회전에 +v(유물 M.fl 배수)                                        (pay, X.ta_f · X.ta_l)
       pair{t, v}        짝: 칸 순서대로 주변의 짝 없는 t와 짝 → 둘 다 +v(서로를 가리키는 짝 효과가 둘 다면 합침, 유물 M.pair 더함). 기호마다 짝 하나  (link)
       lone{t, v}        주변에서 짝 없는 t 하나당 +v                                                                          (pay)
