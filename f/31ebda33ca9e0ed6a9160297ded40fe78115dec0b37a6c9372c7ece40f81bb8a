  Object.assign(KW, {
    chain: { n: '편성', s: () => '기관차 양옆으로 이어진 차량 줄', d: () => '기관차와 같은 가로줄에서 양옆으로 끊김 없이 이어진 차량들이에요. 기관차 둘이 한 편성을 나누면 각자 세요.' },
    tail: { n: '끝 칸', f: '+N', s: (n) => '편성의 바깥 끝 차량이면 +' + n, d: (n) => '어느 기관차 편성의 맨 바깥 차량(바깥쪽 이웃이 차량이 아님)이면 ' + n + '만큼 더 벌어요.' },
    sched: { n: '정시', f: 'N', s: (n) => '전체 회전 번호가 ' + n + '의 배수인 회전에 발동', d: (n) => '판 처음부터 센 회전 번호가 ' + n + '의 배수인 회전에만 효과가 나요(같은 판이면 모두 같은 회전). 집세 기간과는 따로 세요.' },
    run: { n: '누적', f: 'N', s: (n) => '이번 기간에 놓인 횟수 × ' + n, d: (n) => '이번 집세 기간에 판에 놓인 횟수(이번 포함)마다 ' + n + '씩 벌어요. 집세를 내면 처음부터 다시 세요.' },
    first: { n: '첫차', s: () => '집세 기간의 첫 회전', d: () => '판 처음, 또는 집세를 낸 뒤 첫 번째 회전이에요.' },
    last: { n: '막차', s: () => '집세를 내기 직전 회전', d: () => '집세를 내는 바로 그 회전이에요. 이 회전의 수입까지 집세에 보태져요.' },
    pair: { n: '짝', s: () => '주변의 짝 없는 대상과 짝 → 둘 다 값 +', d: () => '칸 순서대로 주변에서 아직 짝이 없는 대상 하나와 짝을 지어 둘 다 값이 올라요. 기호마다 짝은 하나, 서로를 가리키는 짝 효과가 둘 다 있으면 보너스를 합쳐 둘 다 받아요.' },
    lone: { n: '짝 없는', s: () => '이번 회전에 짝을 못 지은 기호', d: () => '이번 회전에 누구와도 짝을 짓지 않은 기호예요.' },
  });
  const ta_EDGE = { l: '왼쪽 끝 기둥', r: '오른쪽 끝 기둥', t: '맨 윗줄', b: '맨 아랫줄' };
  const ta_ar = (a) => AREA[a] || 'adj';
  FXT.lset = (f, H, u) => (f.d === 'x' ? u.kw('row') + '과 ' + u.kw('col') + ' 모두 ' + u.T + ' ' + f.n + '개 이상(자신 포함): +' + f.v
    : f.d === 'col' && f.n >= GH ? '자신과 ' + u.kw('col') + '이 모두 ' + u.T + ': +' + f.v
    : u.kw(f.d) + ' ' + u.T + ' ' + f.n + '개 이상(자신 포함): +' + f.v);
  FXK.lset = (f) => (f.d === 'x' ? [['row'], ['col']] : [[f.d]]);
  FXT.edge = (f) => ta_EDGE[f.d] + '에 놓이면 +' + f.v;
  FXT.chain = (f, H, u) => u.kw('chain') + ' ' + u.T + ' 하나당 +' + f.v + (f.g ? ' · 그 ' + u.T + ' 값 +' + f.g : '');
  FXK.chain = () => [['chain']];
  FXT.tail = (f, H, u) => u.kw('tail', f.v);
  FXK.tail = (f) => [['tail', f.v], ['chain']];
  FXT.sched = (f, H, u) => u.kw('sched', f.n) + (f.pv != null ? ' (' + u.kw(ta_ar(f.a)) + ' ' + u.T + ' 하나당 +' + f.pv + ')' : ' (+' + f.v + ')');
  FXK.sched = (f) => (f.pv != null ? [['sched', f.n], [ta_ar(f.a)]] : [['sched', f.n]]);
  FXT.sync = (f, H, u) => u.kw(ta_ar(f.a)) + ' ' + u.Tj('은', '는') + ' 매 회전 ' + u.kw('sched');
  FXK.sync = (f) => [[ta_ar(f.a)], ['sched']];
  FXT.run = (f, H, u) => u.kw('run', f.v);
  FXK.run = (f) => [['run', f.v]];
  FXT.first = (f, H, u) => u.kw('first') + ' +' + f.v;
  FXK.first = () => [['first']];
  FXT.last = (f, H, u) => u.kw('last') + ' +' + f.v;
  FXK.last = () => [['last']];
  FXT.pair = (f, H, u) => u.kw('pair') + ': ' + u.T + ' — 둘 다 +' + f.v;
  FXK.pair = () => [['pair']];
  FXT.lone = (f, H, u) => u.kw('adj') + ' ' + u.kw('lone') + ' ' + u.T + ' 하나당 +' + f.v;
  FXK.lone = () => [['adj'], ['lone'], ['pair']];
  FXT.pc = (f, H, u) => u.kw(ta_ar(f.a)) + ' ' + u.kw('pair') + ' 지은 기호 하나당 +' + f.v;
  FXK.pc = (f) => [[ta_ar(f.a)], ['pair']];
  /* 등록 방법 · 쓸 수 있는 것은 engine_term_a.js 머리 주석과 같아요. 이 조각의 함수 · 상수 이름은 tb_ · TB_로 시작.
     맡은 효과(문서 3절): feed · revive(두 방식) · scrapc · wset · wvote · wdual · wx · mkt · sell · perm · mper · mfloor · mtop · stat · clean · pst · rumorx
     판 규칙: 계절(init · x) · 날씨 정하기(place) · 시세표(시드 · 회전 번호로 계산, 상태에 안 둠 — x로 X에 실음) · 상태 값(cell) · 옮기기(post) · 예약 배치(order) ·
       부서진 기록 P.dz · P.dl(post에서 C.st에 적고 after에서 P에 반영) · 변신 · 바꾸기 때 영구 보탬 · 상태 이어 주기(tb_sync) · 한 칸 곱하기 상한 ×4(cell — 마지막 cell 걸이)
     유물 m 키(처리 · 등록 모두 여기): wxv · rumor · soot · stamp · mfloor · revive · sell(곱하기) · lostback. 변덕: crash · monsoon · smog · purge · gag.

     화면 · AI가 읽을 값(c 작업자용 — docs/RENTSLOT_POOL2.md 「구현 메모 — 2단계 b」에도 적음):
       s.season0(0~3, 봄 여름 가을 겨울) · 지금 계절 tb_season(s, P) = (s.season0 + P.ri) % 4 · 이름 TB_SEAN · 계절 날씨 TB_WX[계절] · 날씨 이름 TB_WXN
       시세: 칸 번호(0~5) → 배수 TB_MKV[칸], 무리 순서 TB_GRP(곡물 · 석탄 · 목재 · 직물). tb_mkAt(seed, n) = 회전 n(P.sp 기준, 0부터)의 무리별 칸 [4].
         보이는 시세 tb_mkSeen(s, P) = 지난 회전 것(처음엔 모두 1배) · 지난 변화 화살표는 tb_mkAt(seed, P.sp - 2)와 비교. 다음 회전 시세는 안 보임(AI 모의도 보이는 시세로).
       회전 결과: P.last.wx(그 회전 날씨 목록, 한랭 전선이면 둘) · P.last.mk(그 회전 무리별 칸) · P.last.sea(계절) · P.last.sx(상태 바뀜 [어디서(-1 = 변덕), 칸, 상태] — 상태 0 지움 · 1 소문 · 2 그을음 · 3 검인 · 4 예약)
       가방 칸: [2] 영구 보탬 · [3] 상태(0 없음 · 1 소문 · 2 그을음 · 3 검인) · [5] 예약(1이면 다음 회전에 먼저 오름). 상태 값 tb_stv(M, tw, 상태, 호외?) · 이름 TB_STN.
       P.dz 이번 판 부서진 수 · P.dl 최근 부서진 기호 8개(기호 번호, 마지막이 가장 최근). */
  const TB_CAP = 4;                                    // 한 칸 곱하기 상한(종착역만) — 늘리는 곱하기(곱하기 기호 · 유물 · 1배 넘는 시세)의 곱을 ×4까지, 깎는 곱하기는 그대로
  const TB_MKV = [0.5, 0.75, 1, 1.25, 1.5, 2];         // 시세 여섯 단계(판 시작은 칸 2 = 1배)
  const TB_GRP = ['grain', 'coal', 'timber', 'cloth']; // 화물 무리 넷
  const TB_WX = ['rain', 'clear', 'fog', 'snow'];      // 계절(봄 · 여름 · 가을 · 겨울) 순서의 기본 날씨
  const TB_SEAN = ['봄', '여름', '가을', '겨울'];
  const TB_WXN = { rain: '비', clear: '맑음', fog: '안개', snow: '눈', next: '다음 계절 날씨' };
  const TB_ST = { rumor: 1, soot: 2, stamp: 3 }, TB_STN = ['', '소문', '그을음', '검인', '예약'];
  const TB_P_RUMOR = 0.5, TB_P_SOOT = 0.2;             // 상태 옮는 확률(소문은 승객에게만 — 호외가 있으면 100% · 아무 기호에나)

  /* ---------------- 시세표: (시드, 회전 번호)로만 정해짐 → 같은 시드 상대들은 같은 회전에 같은 시세 ---------------- */
  const tb_mkCache = new Map();
  function tb_mkAt(seed, n) {
    seed = seed >>> 0; n = Math.max(0, n | 0);
    let a = tb_mkCache.get(seed);
    if (!a) { a = [[2, 2, 2, 2]]; tb_mkCache.set(seed, a); if (tb_mkCache.size > 48) tb_mkCache.delete(tb_mkCache.keys().next().value); }
    while (a.length <= n) {
      const m = a.length, p = a[m - 1];
      a.push(p.map((x, g) => {
        const u = hsh(seed, 0x6d6b74, m, g) / 4294967296;
        let d = u < 0.35 ? 1 : u < 0.65 ? 0 : -1;    // 오름 35% · 그대로 30% · 내림 35%
        if (x + d > 5 || x + d < 0) d = -d;            // 양 끝에서는 되돌아옴
        return x + d;
      }));
    }
    return a[n];
  }
  const tb_mkSeen = (s, P) => tb_mkAt(s.seed, (P.sp || 0) - 1);
  const tb_season = (s, P) => ((s.season0 || 0) + (P.ri || 0)) % 4;
  const tb_grp = (S) => { for (let g = 0; g < 4; g++) if (S.m.has(TB_GRP[g])) return g; return -1; };
  const tb_has = (S, o) => S.fx.some((f) => f.o === o);
  /* 상태 값: 소문 +1(호외 +1 · 신문 구독권 +N, 소문 단속 중엔 0) · 그을음 −1(방진 마스크면 0) · 검인 +2(붉은 인주 +N) */
  function tb_stv(M, tw, st, rx) {
    if (st === 1) return tw === 'gag' ? 0 : 1 + (rx ? 1 : 0) + (M.rumor || 0);
    if (st === 2) return 'soot' in M ? 0 : -1;
    if (st === 3) return 2 + (M.stamp || 0);
    return 0;
  }
  /* 변신 · 바꾸기로 칸이 새로 만들어졌으면 영구 보탬 · 상태를 이어 줌(검인은 새 기호가 화물일 때만) — 배치 때 기억한 칸과 비교 */
  function tb_sync(C) {
    const sl = C.st.tbSl; if (!sl) return;
    for (let i = 0; i < NC; i++) {
      const o = sl[i]; if (!o || C.cb[i] < 0) continue;
      const b = C.bag[C.cb[i]]; if (b === o) continue;
      b[2] = (b[2] || 0) + (o[2] || 0);
      if (!b[3]) b[3] = o[3] === 3 && !match(SY[b[0]], 'cargo') ? 0 : o[3] || 0;
      sl[i] = b;
    }
  }
  /* 칸의 시세 배수: 자기 무리 시세(거래소면 가장 높은 것, 시세 폭락이면 1배까지) → 하한(선물 계약서 주변 1배 · 시세 수첩 0.75배) */
  function tb_mkOf(C, i) {
    const S = SY[C.kd(i)], g = tb_grp(S); if (g < 0) return 1;
    let x = C.st.tbMv ? C.st.tbMv[g] : 1, fl = C.M.mfloor || 0;
    for (const j of ADJ[i]) if (C.live(j)) for (const f of SY[C.kd(j)].fx) if (f.o === 'mfloor' && f.x > fl) fl = f.x;
    return Math.max(x, fl);
  }
  /* 팔기 때 화물 값(기본 + 영구 + 상태 + 유물 보탬 — 다른 기호의 보태기는 아직 전이라 안 듦) */
  function tb_val(C, j) {
    const S = SY[C.kd(j)], b = C.bag[C.cb[j]];
    let v = S.v + (b[2] || 0) + tb_stv(C.M, C.tw, b[3] || 0, C.st.tbRx);
    for (const t in C.M.add) if (match(S, t)) v += C.M.add[t];
    return Math.max(0, v);
  }
  const tb_wxOn = (C, w) => !!(C.st.tbW && C.st.tbW.includes(w));

  /* ---------------- 판 밖: 계절 · 시세 · 부서진 기록을 회전 X에 ---------------- */
  TH.step('init', (s) => { s.season0 = hsh(s.seed, 0x5ea5) % 4; });
  TH.step('player', (P) => { P.dz = 0; P.dl = []; });
  TH.step('x', (s, P, X) => {
    const real = P.ph === 'spin';   // 실제 회전(doSpin은 고르기 전 'spin' 단계에서 부름). AI 모의(고르기 단계)는 다음 시세를 모르는 채 보이는 시세로
    X.tbSea = tb_season(s, P);
    X.tbMk = real ? tb_mkAt(s.seed, P.sp) : tb_mkSeen(s, P);
    X.tbDz = P.dz || 0;
    X.tbDl = X.tw === 'purge' ? [] : (P.dl || []).slice();
  });
  TH.step('after', (s, P, r) => {
    const st = r.st || {};
    P.dz = (P.dz || 0) + (st.tbKz || 0);
    P.dl = twistOf(s, P.ri) === 'purge' ? [] : (st.tbDl || P.dl || []);
    if (P.last) { P.last.wx = st.tbW || null; P.last.mk = st.tbMk || null; P.last.sea = st.tbSea; P.last.sx = st.tbSx || []; }
  });
  TH.step('rent', (s, P) => {   // 새 집세 기간: 소문 단속이면 소문을 모두 지움 · 분실물 정리면 부서진 목록 비움
    const tw = twistOf(s, P.ri);
    if (tw === 'gag') for (const b of P.b) if (b[3] === 1) b[3] = 0;
    if (tw === 'purge') P.dl = [];
  });

  /* ---------------- 회전 안 ---------------- */
  /* 1 배치: 예약 표시 기호 먼저 */
  TH.step('order', (bag, ord) => {
    if (!bag.some((b) => b[5])) return ord;
    return ord.filter((j) => bag[j][5]).concat(ord.filter((j) => !bag[j][5]));
  });
  /* 2 배치 직후: 예약 지우기 · 칸 기억 · 날씨 정하기 · 시세 */
  TH.step('place', (C) => {
    const { bag, cb, X, st } = C;
    st.tbSl = cb.map((b) => (b < 0 ? null : bag[b]));
    for (const b of st.tbSl) if (b) b[5] = 0;
    const sea = X.tbSea || 0, w0 = TB_WX[sea], wn = TB_WX[(sea + 1) % 4];
    const vote = { rain: 0, clear: 0, fog: 0, snow: 0 };
    let dual = 0, rx = 0, top = 0;
    for (let i = 0; i < NC; i++) {
      if (cb[i] < 0) continue;
      for (const f of SY[C.kd(i)].fx) {
        if (f.o === 'wset') vote[f.w === 'next' ? wn : f.w]++;
        else if (f.o === 'wvote') vote[w0] += f.n;
        else if (f.o === 'wdual') dual = 1;
        else if (f.o === 'rumorx') rx = 1;
        else if (f.o === 'mtop') top = 1;
      }
    }
    let ws;
    if (C.tw === 'monsoon') ws = ['rain'];
    else {
      /* 표 많은 순 — 동률이면 계절 날씨, 그다음 계절 순서상 먼저 오는 것(계절 날씨부터 도는 순서로 세워 두고 안정 정렬) */
      const rank = [0, 1, 2, 3].map((d) => TB_WX[(sea + d) % 4]).filter((w) => vote[w] > 0).sort((a, b) => vote[b] - vote[a]);
      ws = [rank.length ? rank[0] : w0];
      if (dual) { const w2 = rank.length > 1 ? rank[1] : w0; if (!ws.includes(w2)) ws.push(w2); }
    }
    let mv = (X.tbMk || [2, 2, 2, 2]).map((x) => TB_MKV[x]);
    if (top) { const mx = Math.max(...mv); mv = mv.map(() => mx); }
    if (C.tw === 'crash') mv = mv.map((x) => Math.min(1, x));
    Object.assign(st, { tbW: ws, tbRx: rx, tbSea: sea, tbMk: X.tbMk || [2, 2, 2, 2], tbMv: mv, tbSx: [] });
  });
  /* 5 행동: 태우기 · 팔기 · 그을음 지우기 */
  TH.on('act', 'feed', (C, i, f) => {
    tb_sync(C);
    const me = C.bag[C.cb[i]];
    for (const j of ADJ[i]) if (C.live(j) && match(SY[C.kd(j)], f.t) && C.kill(j, i, 'e')) me[2] += f.v;
  });
  TH.on('act', 'sell', (C, i, f) => {
    tb_sync(C);
    for (const j of ADJ[i]) {
      if (!C.live(j) || !match(SY[C.kd(j)], f.t)) continue;
      const x = tb_mkOf(C, j); if (x < (f.min || 0)) continue;
      const v = tb_val(C, j);
      if (C.kill(j, i, 'e')) C.gain[i] += Math.round(v * x * f.x * (C.M.sell || 1));
    }
  });
  TH.on('act', 'clean', (C, i, f) => {
    tb_sync(C);
    const s = TB_ST[f.s];
    for (const j of ADJ[i]) { if (!C.live(j)) continue; const b = C.bag[C.cb[j]]; if (b[3] === s) { b[3] = 0; C.gain[i] += f.v; C.st.tbSx.push([i, j, 0]); } }
  });
  TH.step('act', tb_sync);
  /* 7 보태기: 날씨 조건 보태기(wx 안쪽 give) */
  TH.on('give', 'wx', (C, i, f) => {
    const g = f.fx; if (!g || g.o !== 'give' || !tb_wxOn(C, f.w)) return;
    for (const j of AREAC(i, g.a === 'all' ? 'adj' : g.a)) if (C.live(j) && match(SY[C.kd(j)], g.t)) { C.giv[j] += g.v; if (C.ev) C.ev.push(['g', i, j, g.v]); }
  });
  /* 7~8 칸 값: 영구 보탬 · 상태 값 · 시세 곱하기 → 곱하기 상한 ×4 (이 걸이는 마지막 cell — engine_term_a보다 뒤에 등록됨) */
  TH.step('cell', (C, i, S, b, o) => {
    if (!tb_has(S, 'grow') && !tb_has(S, 'bank')) o.base += b[2] || 0;
    o.base += tb_stv(C.M, C.tw, b[3] || 0, C.st.tbRx);
    let up = o.m >= 1 ? o.m : 1, dn = o.m < 1 ? o.m : 1;
    if (tb_has(S, 'mkt')) { const x = tb_mkOf(C, i); if (x >= 1) up *= x; else dn *= x; }
    o.m = Math.min(TB_CAP, up) * dn;
