  function init(players, opts) {
    const len = opts && String(opts.len) === '8' ? 8 : 12;
    const seed = (opts && opts.seed) ? (opts.seed >>> 0) : ((Math.random() * 4294967295) >>> 0);
    const pid = poolPick(opts, seed); usePool(pid);
    const s = { v: 1, seed, len, pool: pid, tws: new Array(len).fill(-1), P: players.map(() => newPlayer()) };
    const rnd = rng(hsh(seed, 4)), pool = shuf(TWISTS.map((_, i) => i).filter((i) => TWISTS[i].ok), rnd);
    (TW_AT[len] || []).forEach((ri, j) => { s.tws[ri] = pool[j] != null ? pool[j] : -1; });
    if (HK) for (const fn of HK.at.init) fn(s);
