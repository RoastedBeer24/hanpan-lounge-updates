    const tick = new Array(NC).fill(0);
    for (let i = 0; i < NC; i++) if (cb[i] >= 0) for (const f of SY[kd(i)].fx) if (f.o === 'tick') for (const j of ADJ[i]) tick[j] += f.v;
    for (let i = 0; i < NC; i++) if (cb[i] >= 0) bag[cb[i]][1] += 1 + M.age + tick[i];
