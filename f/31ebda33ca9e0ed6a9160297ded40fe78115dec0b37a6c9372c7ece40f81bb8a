  /* ---------------- ③ 시간표 ---------------- */
  /* 기간 첫 회전 · 막차 회전: P.due = 이번 기간에 남은 회전(이번 포함). AI 모의의 h번째 앞 회전도 같은 셈(기간을 넘으면 다음 기간 표로) */
  TH.step('x', (s, P, X, h) => {
