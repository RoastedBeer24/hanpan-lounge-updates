  TH.step('cell', (C, i, S, b, o) => { if (C.ta && C.ta.bn[i]) o.base += C.ta.bn[i]; });
  /* 연출용 편성 · 짝 목록을 마지막 회전 기록에 */
  TH.step('after', (s, P, r) => { const st = r.st; if (st && (st.ta_tr || st.ta_pr)) P.last.ta = { tr: st.ta_tr || [], pr: st.ta_pr || [] }; });

