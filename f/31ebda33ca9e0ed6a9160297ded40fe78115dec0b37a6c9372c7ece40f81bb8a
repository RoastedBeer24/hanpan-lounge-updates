  TH.key('sync');
  TH.on('pay', 'run', (C, i, f) => (C.bag[C.cb[i]][4] + 1) * f.v);
  TH.on('end', 'run', (C, i) => { C.bag[C.cb[i]][4]++; });
  TH.step('rent', (s, P) => { for (const b of P.b) if (b.length > 4) b[4] = 0; });
  TH.on('pay', 'first', (C, i, f) => (C.X.ta_f ? f.v * (C.M.fl || 1) : 0));
  TH.on('pay', 'last', (C, i, f) => (C.X.ta_l ? f.v * (C.M.fl || 1) : 0));

  /* ---------------- ④ 동행: 짝 ---------------- */
  TH.on('link', 'pair', (C, i, f) => {
    const T = ta_C(C); if (T.pr[i] >= 0) return;
    const Si = ta_S(C, i);
    for (const j of ADJ[i]) {
      if (!C.live(j) || T.pr[j] >= 0) continue;
      const Sj = ta_S(C, j); if (!match(Sj, f.t)) continue;
      let v = f.v;
      for (const g of Sj.fx) if (g.o === 'pair' && match(Si, g.t)) { v += g.v; break; }   // 서로를 가리키는 짝 → 합침
