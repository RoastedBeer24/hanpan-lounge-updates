        const ii = P.io[a.i]; if (ii == null) throw new Error('bad item');
        P.it.push(ii);
        const m = ITEMS[ii].m;
        if (m.now) { P.c += m.now.c || 0; P.rm += m.now.rm || 0; P.rr += m.now.rr || 0; }
        if (m.spins) P.due += m.spins;
      }
      P.io = null; P.ph = 'spin'; return s;
    }
