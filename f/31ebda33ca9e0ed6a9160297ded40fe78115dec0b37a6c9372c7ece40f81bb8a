    /* 변신 */
    for (let i = 0; i < NC; i++) {
      const b = cb[i]; if (b < 0) continue;
      for (const f of SY[bag[b][0]].fx) if (f.o === 'age' && bag[b][1] >= f.n) { bag[b] = newSlot(K[f.into]); if (ev) ev.push(['x', i, i, K[f.into]]); break; }
    }
    const dead = new Array(NC).fill(0), gone = new Array(NC).fill(0), gain = new Array(NC).fill(0), dieP = new Array(NC).fill(0);
