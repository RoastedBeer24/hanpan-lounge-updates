  /* ---------------- init · actor · apply · result ---------------- */
  function newPlayer() { return { c: 1, b: START.map((k) => newSlot(K[k])), sp: 0, ri: 0, due: 0, ph: 'spin', of: null, io: null, it: [], rm: 1, rr: 1, rrn: 0, pi: 0, last: null, tot: 0, best: 0, got: 0 }; }
  /* 기호 묶음 옵션: base(기본) · term(종착역) · rand(무작위 — 열린 묶음 중 시드로). 종착역은 열기 전엔 무작위에 안 들고, 'term'을 직접 줄 때(시험)만 */
