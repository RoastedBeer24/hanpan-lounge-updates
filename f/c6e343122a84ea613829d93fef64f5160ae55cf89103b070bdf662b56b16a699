      ord.forEach((i, r) => {
        const f = F[i], p = s.P[i], T = TITLES[f.tt[0]], J = p.j >= 0 ? JOBS[p.j] : null, dp = dreamProg(s, p);
        const big = p.tl.filter((x) => 'WJGRKH!U'.indexOf(x[1]) >= 0 || x[1] === 'F').slice(-4);
        h += '<div class="fc" style="--c:' + colOf(i) + ';animation-delay:' + (r * 0.12) + 's"><div class="top"><span class="rk r' + (r + 1) + '">' + (r + 1) + '</span><span class="nm"><i></i>' + esc(nameOf(i)) + '</span><span class="tot"><b>' + f.tot + '</b>점</span></div>' +
          '<div class="tt">' + svgIc('laurel') + esc(T[0]) + '</div><div class="ts">' + esc(T[1]) + (f.tt.length > 1 ? ' · 그 밖에 ' + f.tt.slice(1).map((k) => '「' + esc(TITLES[k][0]) + '」').join(' ') : '') + '</div>' +
          scoreBar(f, max) +
          '<div class="mt">' + (J ? esc(J.n) : '무직') + ' · 순자산 ' + money(f.nw) + (dp ? ' · 꿈 「' + esc(dp.D.n) + '」 ' + (dp.ok ? '이룸' : '못 이룸') : '') + '</div>' +
          (big.length ? '<div class="lf">' + big.map((x) => { const [ic, col] = icOf(x[1]); return '<span><i style="background:' + col + '">' + svgIc(ic) + '</i>' + x[0] + '세 ' + esc(x[2]) + '</span>'; }).join('') + '</div>' : '') + '</div>';
      });
      h += '</div>';
      finEl.innerHTML = h;
      const go = E('button', 'btn primary wide', '결과 보기');
      let done = false;
      const fin = () => { if (done) return; done = true; if (finEl) { finEl.remove(); finEl = null; } api.setBusy(false); };
      go.onclick = fin;
      const ft = E('div', 'ff'); ft.append(go); finEl.append(ft);
      root.append(finEl);
      api.sfx('win');
      if (!api.players.some((q, i) => !q.ai && api.canAct(i))) setTimeout(fin, 5000 / SPD());
    }

    /* ── 키보드·패드 ── */
    const offKeys = api.input ? api.input.on((t, id) => { if (t === 'down' && id === 'spin' && !bSpin.disabled) bSpin.click(); }) : null;

    return {
      update(s, prev) {
        if (destroyed) return;
        if (!vs || !prev || !s.bd || s.bd.id !== vs.bd.id || !s.last || (vs.last && s.last.id === vs.last.id) || s.last.id < (vs.last ? vs.last.id : 0)) {
          if (!pumping) { vs = s; ensureLayout(); const a = actor(s); if (a != null) focusSeat = a; renderAll(); if (sheet) refreshSheet(); if (s.ph === 'over') showFinal(s); }
          else queue.push(s);
          return;
