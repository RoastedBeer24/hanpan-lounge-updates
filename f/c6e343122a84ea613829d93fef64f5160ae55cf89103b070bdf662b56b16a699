        add(p.tl.slice().reverse().map((x) => { const [ic, col] = icOf(x[1]); return '<div class="tl"><span class="a">' + x[0] + '세</span><span class="c" style="background:' + col + '">' + svgIc(ic) + '</span><span>' + esc(x[2]) + '</span></div>'; }).join('') || '<p class="muted">아직 기록이 없어요</p>');
      }
    }
    /* 점수 막대(자산·행복·명성·건강·가족·은퇴·꿈) */
    const SC_PART = [['asset', '돈', '#e9b23d', 'coin'], ['h', '행복', '#ee819f', 'happy'], ['f', '명성', '#f2d04a', 'star'], ['e', '건강', '#46bf84', 'heart'], ['fam', '가족', '#8ab4ff', 'family'], ['ret', '은퇴', '#c9a8ff', 'retire'], ['dr', '꿈', '#ffb347', 'spark']];
    function scoreBar(f, max) {
      const tot = Math.max(1, SC_PART.reduce((t, x) => t + Math.max(0, f[x[0]]), 0)), M = max || tot;
      return '<div class="sbar"><div class="b" style="width:' + Math.round(Math.min(1, tot / M) * 100) + '%">' + SC_PART.map((x) => (f[x[0]] > 0 ? '<i style="background:' + x[2] + ';flex:' + f[x[0]] + '"></i>' : '')).join('') + '</div></div>' +
        '<div class="lg">' + SC_PART.map((x) => '<span style="--c:' + x[2] + '">' + svgIc(x[3]) + x[1] + ' <b>' + f[x[0]] + '</b></span>').join('') + '</div>';
    }

    /* ── 인생 결산 ── */
    let finShown = false;
    function showFinal(s) {
      if (finShown || !s.fin) return;
      finShown = true; closeSheet(); hideCard();
      api.setBusy(true);
      finEl = E('div', 'll-fin');
