  /* advance the cars simulated here by dt (fixed sub-steps). input(seat, car) → inp; local(seat) → simulate here? */
  function worldStep(W, dt, input, local, assist, aid) {   // aid(seat) = the brake assist level for people (AI: none)
    const T = W.T, n = Math.max(1, Math.round(dt / DT)), h = dt / n;
    for (let k = 0; k < n; k++) {
