      else if (wpn === 1) { g.moveTo(x - 10 * s, y - 30 * s); g.lineTo(x - 18 * s, y - 70 * s); }
      else { g.arc(x + 14 * s, y - 32 * s, 14 * s, -1.2, 1.2); }
