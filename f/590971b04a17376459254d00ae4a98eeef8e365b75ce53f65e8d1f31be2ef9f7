    g.fillStyle = sg; g.fillRect(0, 0, w, h);
    // 폭풍의 벽
    for (let i = 0; i < 2; i++) { const x0 = i ? w * 0.86 : w * 0.02, ww = w * 0.14; const sw = g.createLinearGradient(x0, 0, x0 + ww, 0); sw.addColorStop(i ? 0 : 1, 'rgba(160,40,60,0)'); sw.addColorStop(i ? 1 : 0, 'rgba(150,40,70,.65)'); g.fillStyle = sw; g.fillRect(x0, 0, ww, h); }
    // 먼 산
    g.fillStyle = '#2a1d1f'; g.beginPath(); g.moveTo(0, h * 0.7); for (let x = 0; x <= w; x += 20) g.lineTo(x, h * 0.62 - Math.sin(x * 0.013) * 22 - Math.sin(x * 0.041) * 9); g.lineTo(w, h); g.lineTo(0, h); g.fill();
    // 거인 실루엣
    g.fillStyle = '#120d10'; const gx = w * 0.62, gy = h * 0.74;
    g.beginPath(); g.moveTo(gx - 46, gy); g.lineTo(gx - 38, gy - 120); g.quadraticCurveTo(gx, gy - 150, gx + 38, gy - 120); g.lineTo(gx + 46, gy); g.fill();
    g.beginPath(); g.arc(gx, gy - 158, 17, 0, Math.PI * 2); g.fill();
    g.fillRect(gx + 34, gy - 132, 70, 12); g.fillRect(gx + 96, gy - 150, 26, 48);
    g.fillStyle = 'rgba(124,92,255,.85)'; g.fillRect(gx - 7, gy - 162, 4, 3); g.fillRect(gx + 3, gy - 162, 4, 3);
    // 땅
    g.fillStyle = '#15100e'; g.fillRect(0, h * 0.74, w, h * 0.26);
    // 세 원정자
    const fig = (x, s, wpn) => {
      g.fillStyle = '#0b0809'; const y = h * 0.86;
      g.beginPath(); g.moveTo(x - 9 * s, y); g.lineTo(x - 7 * s, y - 34 * s); g.lineTo(x + 7 * s, y - 34 * s); g.lineTo(x + 9 * s, y); g.fill();
