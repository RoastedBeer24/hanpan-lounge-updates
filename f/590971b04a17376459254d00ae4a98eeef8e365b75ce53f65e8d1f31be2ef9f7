    };
    fig(w * 0.24, 1.25, 0); fig(w * 0.32, 1.12, 1); fig(w * 0.4, 1.18, 2);
    g.fillStyle = 'rgba(10,7,8,.6)'; g.fillRect(0, h - 58, w, 58);
