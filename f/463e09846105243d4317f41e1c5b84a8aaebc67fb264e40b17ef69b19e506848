.fo-dexbtn svg{width:20px;height:20px;flex:none}
.fo-dex{position:absolute;inset:0;z-index:30;background:#17131f;display:flex;flex-direction:column;font-family:${FONT};color:#f2e9d8}
.fo-dex-h{flex:none;display:flex;align-items:center;gap:8px;padding:6px 6px 6px 14px;border-bottom:1px solid rgba(242,233,216,.1)}
.fo-dex-h h3{margin:0;font:400 21px ${DISP};flex:1 1 auto;min-width:0;white-space:nowrap}
.fo-dex-h h3 small{font:700 13px ${MONO};color:#e3ae45;margin-left:6px}
.fo-dex-x{min-width:44px;min-height:44px;flex:none}
.fo-dex-b{flex:1 1 auto;overflow-y:auto;padding:4px 12px 24px;touch-action:pan-y;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
