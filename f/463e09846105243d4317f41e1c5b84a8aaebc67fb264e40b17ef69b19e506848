.fo-card li i{flex:none;width:11px;height:11px;border-radius:3px;background:var(--c);transform:translateY(1px)}
.fo-tip{position:absolute;left:50%;transform:translate(-50%,6px);top:80px;z-index:5;width:max-content;max-width:calc(100% - 28px);box-sizing:border-box;padding:10px 14px;border-radius:14px;background:rgba(23,19,31,.96);border:1px solid rgba(227,174,69,.55);box-shadow:0 6px 20px rgba(0,0,0,.35);color:#f2e9d8;font:600 13px/1.45 ${FONT};text-align:center;word-break:keep-all;min-height:44px;cursor:pointer;pointer-events:auto;opacity:0;transition:opacity .4s,transform .4s}
.fo-tip i{display:block;font-style:normal;font-size:11px;opacity:.6;margin-top:2px}
