/* 사다리 타기 — a party tool for deciding things (벌칙, 순서, 당번 …). People only.
   Phase 'set': the setter (host / first person) writes the names on top and the results below (2–12 rows).
   Phase 'play': rungs come from a seed in the state and stay hidden under a cover; tapping a name traces
   its path with a glowing line and reveals where it lands. When everyone is revealed the cover lifts and a
   summary (copyable) opens. Online: everyone can open their own name (option) or only the host. */
(function () {
  'use strict';
  const L = window.Lounge, U = L.util;

  const MINN = 2, MAXN = 12, NAME_MAX = 10, RES_MAX = 12;
  const PAL = ['#ee6a55', '#5bb3e6', '#e8c04e', '#5fd3a0', '#b48cf0', '#f07fb8', '#f39a3d', '#4fd1c5', '#a3d65c', '#8794f7', '#e3708f', '#c9a27a'];
  const PENALTY = ['노래 한 소절', '애교 세 가지', '팔굽혀펴기 10개', '성대모사 하나', '음료 사 오기', '칭찬 세 마디', '설거지 당번',
    '엉덩이로 이름 쓰기', '개인기 하나', '30초 춤추기', '다음 판 심판', '어깨 주물러 주기', '혀 꼬이는 말 3번', '통과!'];
  const DENS = { 1: '적게', 2: '보통', 3: '많이' };

  /* ---------- pure helpers ---------- */
  function clean(t, n) {
    return [...String(t == null ? '' : t).normalize('NFC').replace(/[\u0000-\u001f\u007f]/g, '').replace(/\s+/g, ' ').trim()].slice(0, n).join('').trim();
  }
  function prng(seed) { let a = seed >>> 0; return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
  function seededShuffle(a, r) { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
  const defName = (k) => '참가자 ' + (k + 1);
  const DEF_RES = '꽝';

  /* rungs: rows[r][c] = 1 → a rung between rail c and c+1 in row r (never two touching in one row).
     jit[r][c] is a drawing offset (fraction of a row) so the ladder looks hand-drawn; it never changes the order. */
  function ladderOf(g, n, dn) {
    const r = prng((g ^ 0xA5F1523D) >>> 0);
    const d = DENS[dn] ? dn : 2;
    const R = [0, 6, 9, 13][d] + Math.floor(n / 4);
    const p = [0, 0.34, 0.46, 0.58][d];
    const rows = [];
    for (let i = 0; i < R; i++) {
      const row = new Array(n - 1).fill(0);
      for (let c = 0; c < n - 1; c++) { if (c && row[c - 1]) continue; if (r() < p) row[c] = 1; }
      rows.push(row);
    }
    for (let c = 0; c < n - 1; c++) { // every neighbouring pair is linked at least once
      let cnt = 0; rows.forEach((row) => { cnt += row[c]; });
      for (let tries = 0; cnt < 1 && tries < 40; tries++) {
        const row = rows[Math.floor(r() * rows.length)];
        if ((c && row[c - 1]) || row[c + 1]) continue;
        row[c] = 1; cnt++;
      }
      if (cnt < 1) { const row = new Array(n - 1).fill(0); row[c] = 1; rows.splice(Math.floor(r() * (rows.length + 1)), 0, row); }
    }
    const jit = rows.map((row) => row.map((x) => (x ? Math.round((r() - 0.5) * 56) / 100 : 0)));
    return { n, rows, jit };
  }
  /* path of top entry i: the rails it walks and the rungs it crosses */
  function traceOf(lad, i) {
    let c = i;
    const segs = [];
    lad.rows.forEach((row, r) => {
      if (c > 0 && row[c - 1]) { segs.push({ r, g: c - 1, from: c, to: c - 1 }); c--; }
      else if (c < lad.n - 1 && row[c]) { segs.push({ r, g: c, from: c, to: c + 1 }); c++; }
    });
    return { end: c, segs };
  }
  function permOf(lad) { return Array.from({ length: lad.n }, (_, i) => traceOf(lad, i).end); }

  function presetResults(kind, n, rnd) {
    rnd = rnd || Math.random;
    if (kind === 'one') return Array.from({ length: n }, (_, k) => (k === 0 ? '당첨' : DEF_RES));
    if (kind === 'order') return Array.from({ length: n }, (_, k) => (k + 1) + '번');
    if (kind === 'pen') {
      const pool = seededShuffle(PENALTY.slice(), rnd);
      return Array.from({ length: n }, (_, k) => pool[k % pool.length]);
    }
    return Array.from({ length: n }, () => '');
  }

  /* ---------- rules / state ---------- */
  const setterOf = (s) => (s.hm.length ? s.hm[0] : -1);
  function init(players, opts) {
    opts = opts || {};
    const hm = players.map((p, i) => (p.ai ? -1 : i)).filter((i) => i >= 0);
    const names = hm.map((i) => clean(players[i].name, NAME_MAX));
    const n = U.clamp(names.length, MINN, MAXN);
    const tp = Array.from({ length: n }, (_, k) => names[k] || defName(k));
    const ow = Array.from({ length: n }, (_, k) => (k < hm.length ? hm[k] : -1));
    const bo = presetResults('one', n);
    return { hm, ph: 'set', tp, bo, bt: bo.slice(), ow, dn: DENS[opts.rungs] ? opts.rungs : 2, who: opts.reveal === 'host' ? 'h' : 'e', g: 0, rv: [], seq: 0, last: null };
  }
  function start(s) {
    s.g = (Math.floor(Math.random() * 0x7fffffff) | 0) || 1;
    s.bt = s.bo.slice();
    seededShuffle(s.bt, prng((s.g ^ 0x2C1B3C6D) >>> 0)); // results are always shuffled (fair; not switchable)
    s.rv = []; s.ph = 'play';
    s.seq++; s.last = { id: s.seq, k: 'start' };
    return s;
  }
  function canReveal(s, seat, i) {
    if (seat === setterOf(s)) return true;
    if (s.who !== 'e') return false;
    const o = s.ow[i];
    return o == null || o < 0 || o === seat || !s.hm.includes(o);
  }
  const allDone = (s) => s.ph === 'play' && s.rv.length >= s.tp.length;
  function actor(s) {
    const se = setterOf(s);
    if (se < 0) return null;
    if (s.ph !== 'play' || allDone(s) || s.who !== 'e') return se;
    return s.hm.slice();
  }
  function apply(s, seat, a) {
    if (!a || typeof a !== 'object') throw new Error('bad action');
    const se = setterOf(s);
    if (a.type === 'setup') {
      if (s.ph !== 'set' || seat !== se) throw new Error('only the setter sets up');
      if (!Array.isArray(a.tp) || !Array.isArray(a.bt)) throw new Error('bad lists');
      const n = a.tp.length;
      if (n < MINN || n > MAXN || a.bt.length !== n) throw new Error('bad size');
      s.tp = a.tp.map((x, k) => clean(x, NAME_MAX) || defName(k));
      s.bo = a.bt.map((x) => clean(x, RES_MAX) || DEF_RES);
      const used = new Set();
      s.ow = Array.from({ length: n }, (_, k) => {
        const o = Array.isArray(a.ow) ? a.ow[k] : -1;
        if (Number.isInteger(o) && s.hm.includes(o) && !used.has(o)) { used.add(o); return o; }
        return -1;
      });
      return start(s);
    }
    if (a.type === 'rv') {
      const i = a.i;
      if (s.ph !== 'play' || !Number.isInteger(i) || i < 0 || i >= s.tp.length) throw new Error('bad entry');
      if (s.rv.includes(i)) throw new Error('already revealed');
      if (!canReveal(s, seat, i)) throw new Error('not yours');
      s.rv.push(i);
      s.seq++; s.last = { id: s.seq, k: 'rv', i, s: seat };
      return s;
    }
    if (a.type === 'all') {
      if (s.ph !== 'play' || seat !== se) throw new Error('only the setter');
      const rest = s.tp.map((_, i) => i).filter((i) => !s.rv.includes(i));
      if (!rest.length) throw new Error('nothing left');
      s.rv.push(...rest);
      s.seq++; s.last = { id: s.seq, k: 'all', l: rest, s: seat };
      return s;
    }
    if (a.type === 'again') {
      if (s.ph !== 'play' || seat !== se) throw new Error('only the setter');
      return start(s);
    }
    if (a.type === 'edit') {
      if (s.ph !== 'play' || seat !== se) throw new Error('only the setter');
      s.ph = 'set'; s.bt = s.bo.slice(); s.rv = [];
      s.seq++; s.last = { id: s.seq, k: 'edit' };
      return s;
    }
    throw new Error('bad action');
  }
  function result() { return null; } // a tool: it never "ends"; the summary lives inside the view

  /* ---------- view ---------- */
  const CSS = `
.ld-bg{position:absolute;inset:0;background:radial-gradient(120% 80% at 50% 25%,#2b2036,#120e18)}
.ld-wrap{word-break:keep-all;overflow-wrap:anywhere;position:absolute;inset:0;z-index:1;display:flex;flex-direction:column}
.ld-scroll{flex:1;min-height:0;overflow-y:auto;touch-action:pan-y;-webkit-overflow-scrolling:touch;padding:10px 12px 16px;scrollbar-width:none}
.ld-scroll::-webkit-scrollbar{display:none}
.ld-card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:14px 12px;display:flex;flex-direction:column;gap:12px;max-width:520px;margin:0 auto;box-shadow:0 18px 40px rgba(0,0,0,.4)}
.ld-head{display:flex;align-items:center;gap:10px}
.ld-head h3{margin:0;font-family:var(--f-display);font-weight:400;font-size:24px;line-height:1.1;flex:1;min-width:0}
.ld-step{display:inline-flex;align-items:center;gap:4px;flex:none}
.ld-step .btn{min-width:44px;padding:0;font-size:20px}
.ld-step .v{font-family:var(--f-mono);font-size:17px;min-width:3.2ch;text-align:center}
.ld-cols{display:grid;grid-template-columns:16px minmax(0,1fr) 14px minmax(0,1fr) 40px;gap:6px;align-items:center;font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.06em;padding:0 2px}
.ld-rows{display:flex;flex-direction:column;gap:6px}
.ld-row{display:grid;grid-template-columns:16px minmax(0,1fr) 14px minmax(0,1fr) 40px;gap:6px;align-items:center;animation:fade .18s}
.ld-row input{min-width:0;width:100%;height:44px;box-sizing:border-box;border-radius:11px;border:1px solid var(--line);background:var(--bg);padding:0 10px;font-size:16px;outline:none;color:var(--ink)}
.ld-row input:focus{border-color:var(--brass);box-shadow:0 0 0 3px rgba(227,174,69,.18)}
.ld-row input.res{background:#2a2333}
