.ld-sum{position:absolute;left:10px;right:10px;bottom:8px;max-height:calc(100% - 16px);z-index:5;background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:0 -10px 40px rgba(0,0,0,.55);display:flex;flex-direction:column;animation:ld-up .28s cubic-bezier(.2,1.2,.4,1)}
