.ld-sum .hd{display:flex;align-items:center;gap:8px;padding:12px 10px 6px 16px}
.ld-sum .hd h3{margin:0;flex:1;font-family:var(--f-display);font-weight:400;font-size:22px}
.ld-sum .hd .x{appearance:none;border:0;background:transparent;width:44px;height:44px;border-radius:12px;font-size:18px;color:var(--muted);cursor:pointer}
.ld-list{overflow-y:auto;touch-action:pan-y;padding:0 12px;display:flex;flex-direction:column;gap:4px;min-height:0}
.ld-li{display:grid;grid-template-columns:14px minmax(0,1fr) 18px minmax(0,1.2fr);gap:8px;align-items:center;min-height:38px;padding:4px 10px;border-radius:10px;background:var(--bg)}
.ld-li .n{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ld-li .a{color:var(--muted);text-align:center}
.ld-li .r{font-weight:700;color:var(--brass);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ld-li.hide .r{color:var(--muted);font-weight:500}
.ld-sum .ld-btns .btn{white-space:nowrap;font-size:14px;padding:8px 4px}
.ld-sum .ft{display:flex;flex-direction:column;gap:8px;padding:10px 12px 12px}
`;

  function mount(root, api) {
    const h = L.h;
    const styleEl = h('style', { text: CSS });
    const bgEl = h('div', { class: 'ld-bg' });
    const wrap = h('div', { class: 'ld-wrap' });
    root.append(styleEl, bgEl, wrap);
    const spd = () => L.debug.speed || 1;

    let st = null, viewMode = '', lad = null, ladKey = '', perm = [];
    let draft = null, draftKey = '';
    let cv = null, board = null, bot = null, sum = null, sumOpen = false, sumAuto = '';
    let botSig = '', lastSeq = -1, pending = 0;
    const shown = new Set();      // entries whose path is fully drawn on this device
    let queue = [], cur = null, coverA = 1, coverTo = 1, banner = null, parts = [], flash = {}, dirty = true;
    let tapStart = null, stopLoop = null, armT = 0, armedKey = '';
    const offs = [];

    const me = () => { const m = api.mySeats(); return m.length ? m[0] : -1; };
    const setter = () => (st ? setterOf(st) : -1);
    const iAmSetter = () => setter() >= 0 && api.canAct(setter());
    const actSeat = () => (api.online ? me() : setter());
    const colorOf = (i) => PAL[i % PAL.length];
    const pname = (seat) => (api.players[seat] ? api.players[seat].name : '?');
    const dot = (c, px) => h('span', { class: 'dot', style: Object.assign({ '--c': c }, px ? { width: px + 'px', height: px + 'px' } : {}) });

    function arm(key, el, label, fn) {
      if (armedKey === key) { clearTimeout(armT); armedKey = ''; fn(); return; }
      clearTimeout(armT); armedKey = key;
      const old = el.textContent; el.classList.add('arm'); el.textContent = label; api.buzz(10);
      armT = setTimeout(() => { armedKey = ''; if (el.isConnected) { el.classList.remove('arm'); el.textContent = old; } }, 2600);
    }

    /* =============== setup (setter) =============== */
    function playerRows() {
      return st.hm.map((seat) => ({ n: clean(pname(seat), NAME_MAX), r: '', o: seat }));
    }
    function makeDraft() {
      draft = { rows: st.tp.map((n, k) => ({ n, r: st.bo[k], o: st.ow[k] })), pre: st.seq === 0 ? 'one' : null };
    }
    function fixPreset() { if (draft.pre) { const r = presetResults(draft.pre, draft.rows.length); draft.rows.forEach((row, k) => { row.r = r[k]; }); } }
    let rowsBox = null, countV = null, startBtn = null, addBtn = null, scrollEl = null, presetBox = null;
    function buildSetup() {
      wrap.innerHTML = '';
      const minus = h('button', { class: 'btn sm', type: 'button', text: '−', 'aria-label': '한 줄 빼기', onclick() { if (draft.rows.length > MINN) { draft.rows.pop(); fixPreset(); api.sfx('click'); drawRows(); } } });
      const plus = h('button', { class: 'btn sm', type: 'button', text: '+', 'aria-label': '한 줄 더하기', onclick: addRow });
      countV = h('span', { class: 'v' });
      rowsBox = h('div', { class: 'ld-rows' });
      addBtn = h('button', { class: 'btn ld-add', type: 'button', text: '+ 한 줄 추가', onclick: addRow });
      presetBox = h('div', { class: 'ld-chips' });
      const saved = U.store.get('ladder.last', null);
      const nameChips = h('div', { class: 'ld-chips' },
        h('button', { class: 'btn sm', type: 'button', text: '플레이어 이름', onclick() {
          const pr = playerRows();
          if (!pr.length) { api.toast('불러올 이름이 없어요'); return; }
          while (draft.rows.length < Math.min(MAXN, pr.length)) draft.rows.push({ n: '', r: '', o: -1 });
          pr.forEach((p, k) => { if (draft.rows[k]) { draft.rows[k].n = p.n; draft.rows[k].o = p.o; } });
          draft.rows.forEach((row, k) => { if (k >= pr.length && pr.some((p) => p.o === row.o)) row.o = -1; });
          fixPreset(); api.sfx('card'); drawRows();
        } }),
        saved && Array.isArray(saved.tp) && saved.tp.length >= MINN ? h('button', { class: 'btn sm', type: 'button', text: '지난 설정 (' + saved.tp.length + '줄)', onclick() {
          const n = U.clamp(saved.tp.length, MINN, MAXN);
          const pr = playerRows();
          draft.rows = Array.from({ length: n }, (_, k) => {
            const nm = clean(saved.tp[k], NAME_MAX), hit = pr.find((p) => p.n === nm);
            return { n: nm, r: clean(saved.bt && saved.bt[k], RES_MAX), o: hit ? hit.o : -1 };
          });
          draft.pre = null;
          api.sfx('card'); drawRows();
        } }) : null);
      const card = h('div', { class: 'ld-card' },
        h('div', { class: 'ld-head' }, h('h3', { text: '사다리 만들기' }), h('div', { class: 'ld-step' }, minus, countV, plus)),
        h('div', { class: 'ld-cols' }, h('span'), h('span', { text: '이름 (위)' }), h('span'), h('span', { text: '결과 (아래)' }), h('span')),
        rowsBox, addBtn,
        h('div', { class: 'ld-sec' }, h('span', { class: 'label', text: '결과 빠르게 채우기' }), presetBox),
        h('div', { class: 'ld-sec' }, h('span', { class: 'label', text: '이름 불러오기' }), nameChips),
        h('div', { class: 'ld-meta', html: '가로줄 <b>' + DENS[st.dn] + '</b>' + (api.online ? ' · 공개 <b>' + (st.who === 'e' ? '각자 자기 이름' : '방장만') + '</b>' : '') + ' <span>(게임 설정에서 바꿔요)</span><br>결과는 적은 순서와 상관없이 <b>항상 무작위로 섞여</b> 아래에 놓여요.' }));
      scrollEl = h('div', { class: 'ld-scroll' }, card);
      startBtn = h('button', { class: 'btn primary', 'data-action': 'start', type: 'button', onclick: submitSetup });
      bot = h('div', { class: 'ld-bot' }, h('div', { class: 'ld-btns' }, startBtn));
      wrap.append(scrollEl, bot);
      drawRows();
    }
    function drawPresets() {
      if (!presetBox) return;
      presetBox.innerHTML = '';
      [['one', '당첨 1명'], ['order', '순서 정하기 1~' + draft.rows.length], ['pen', '벌칙 모음']].forEach(([k, t]) => {
        presetBox.append(h('button', { class: 'btn sm' + (draft.pre === k ? ' on' : ''), type: 'button', text: t, onclick() {
          draft.pre = k; fixPreset(); api.sfx(k === 'pen' ? 'card' : 'click'); api.buzz(8); drawRows();
        } }));
      });
    }
    function addRow() {
      if (draft.rows.length >= MAXN) { api.toast('최대 ' + MAXN + '줄까지예요'); return; }
      draft.rows.push({ n: '', r: '', o: -1 }); fixPreset(); api.sfx('click');
      drawRows();
      const ins = rowsBox.querySelectorAll('input.nm');
      const last = ins[ins.length - 1];
      if (last) { try { last.focus({ preventScroll: true }); } catch (e) { last.focus(); } keepVisible(last); }
    }
    function drawRows() {
      rowsBox.innerHTML = '';
