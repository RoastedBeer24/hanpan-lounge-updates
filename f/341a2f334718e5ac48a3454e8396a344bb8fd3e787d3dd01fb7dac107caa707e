.ld-pair .r{color:var(--brass)}
@keyframes ld-in{from{transform:scale(.6);opacity:0}to{transform:none;opacity:1}}
.ld-wait{margin:auto;text-align:center;display:flex;flex-direction:column;gap:10px;align-items:center;padding:24px}
