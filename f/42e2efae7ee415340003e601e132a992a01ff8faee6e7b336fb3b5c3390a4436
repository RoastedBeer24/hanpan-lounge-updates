          return;
        }
      }
    }
    function move(ev) {
      if (!drag) return;
      const { x, y } = cv.local(ev);
      const prev = drag.gh;
      drag.x = x; drag.y = y; drag.gh = ghostFor(x, y);
      if (drag.gh && drag.gh.ok && (!prev || prev.r !== drag.gh.r || prev.c !== drag.gh.c)) api.buzz(4);
    }
    function up() {
      if (!drag) return;
      const g = drag.gh, i = drag.i; drag = null;
      if (g && g.ok && canPlay()) { api.act({ t: 'put', i, r: g.r, c: g.c }); }
      else if (g) api.sfx('thud');
    }
    cv.cv.addEventListener('pointerdown', down);
    cv.cv.addEventListener('pointermove', move);
    cv.cv.addEventListener('pointerup', up);
    cv.cv.addEventListener('pointercancel', () => { drag = null; });

    function onEvent(last) {
      if (!last) return;
      if (last.t === 'new') { scoreShown = 0; popIn = { t0: performance.now(), all: true }; api.sfx('whoosh'); return; }
      const now = performance.now();
      popIn = { t0: now, cells: SH[last.sh].map(([dr, dc]) => [last.r + dr, last.c + dc]) };
      const L2 = last.rows.length + last.cols.length;
      api.sfx(L2 ? 'pop' : 'chip');
      if (!L2) return;
      api.buzz(L2 > 1 ? 30 : 15);
      shake = Math.min(10, 3 + L2 * 2);
      const prevB = (prevBoard || st.b);
      // 지워진 칸: 놓은 직후의 판에서 색을 가져온다
      const a = prevB.split('');
      for (const [dr, dc] of SH[last.sh]) a[(last.r + dr) * N + last.c + dc] = String(last.col);
      const done = {};
      const add = (r, c, delay) => {
        const k = r * N + c; if (done[k]) return; done[k] = 1;
        const col = +a[k]; if (isNaN(col)) return;
        fx.push({ k: 'cell', r, c, col, t0: now + delay / sp(), d: 380 });
        for (let q = 0; q < 3; q++) fx.push({ k: 'bit', col, x: G.bx + (c + 0.5) * G.cell, y: G.by + (r + 0.5) * G.cell, vx: (Math.random() - 0.5) * 0.5, vy: -Math.random() * 0.5 - 0.1, t0: now + delay / sp(), d: 650, s: G.cell * (0.15 + Math.random() * 0.15) });
      };
      last.rows.forEach((r) => { for (let c = 0; c < N; c++) add(r, c, Math.abs(c - last.c) * 22); });
      last.cols.forEach((c) => { for (let r = 0; r < N; r++) add(r, c, Math.abs(r - last.r) * 22); });
      last.mono.forEach((m) => fx.push({ k: 'band', o: m[0], i: m[1], col: m[2], t0: now, d: 700 }));
      const cx = G.bx + (last.c + 1) * G.cell, cy = G.by + (last.r + 0.5) * G.cell;
      fx.push({ k: 'txt', text: '+' + last.pts, x: cx, y: cy, t0: now, d: 900, sz: 26, color: '#fff3d6' });
      let line2 = L2 >= 2 ? `${L2}줄 동시!` : '';
      if (last.cb >= 2) line2 = (line2 ? line2 + ' ' : '') + `콤보 ×${last.mult}`;
      if (line2) fx.push({ k: 'txt', text: line2, x: G.w / 2, y: G.by + G.size * 0.42, t0: now + 80, d: 1100, sz: 30, color: '#e3ae45' });
      if (last.mono.length) fx.push({ k: 'txt', text: last.mono.length > 1 ? `단색 줄 ×${last.mono.length}!` : '단색 줄!', x: G.w / 2, y: G.by + G.size * 0.58, t0: now + 160, d: 1100, sz: 26, color: COLS[last.mono[0][2]] });
      if (last.mono.length || L2 >= 3) api.sfx('win');
      busyUntil = now + 450 / sp();
      api.setBusy(true);
    }
    let prevBoard = null;

    function draw(now) {
      if (!G || !st) return;
      ctx.clearRect(0, 0, G.w, G.h);
      const bgr = ctx.createLinearGradient(0, 0, 0, G.h);
      bgr.addColorStop(0, '#1d1729'); bgr.addColorStop(1, '#120f19');
      ctx.fillStyle = bgr; ctx.fillRect(0, 0, G.w, G.h);
      // 머리글: 점수·목표
      const tgtScore = st.sc;
      scoreShown += (tgtScore - scoreShown) * Math.min(1, 0.2 * sp());
      if (Math.abs(tgtScore - scoreShown) < 1) scoreShown = tgtScore;
      ctx.textBaseline = 'middle';
      ctx.fillStyle = '#ab9fb8'; ctx.font = '600 13px "IBM Plex Sans KR", sans-serif'; ctx.textAlign = 'left';
      if (st.m === 'inf') {
        ctx.fillText('점수', 14, 18);
        ctx.textAlign = 'right'; ctx.fillText('최고 ' + Math.max(st.best, st.sc), G.w - 14, 18);
        ctx.textAlign = 'left'; ctx.fillStyle = '#f2e9d8'; ctx.font = '700 32px "IBM Plex Mono", monospace';
        ctx.fillText(String(Math.round(scoreShown)), 14, 46);
        if (st.cb >= 2) { ctx.textAlign = 'right'; ctx.fillStyle = '#e3ae45'; ctx.font = '700 18px "IBM Plex Sans KR", sans-serif'; ctx.fillText(`콤보 ${st.cb}`, G.w - 14, 46); }
      } else {
        ctx.fillText(`${st.m === 'day' ? '📅 오늘 ' + DAILY.md(st.dy) : st.n + '단계'} · ${goalText(st.g)}`, 14, 16);
        ctx.textAlign = 'right'; ctx.fillText(`남은 조각 ${Math.max(0, st.g.p - st.used)}`, G.w - 14, 16);
        // 진행 막대
        const bw = G.w - 28, y = 32, f = st.g.t ? st.gp / st.g.t : 0;
        ctx.fillStyle = '#2e2640'; rrect(ctx, 14, y, bw, 14, 7); ctx.fill();
        ctx.fillStyle = st.g.c != null ? COLS[st.g.c] : '#e3ae45'; if (f > 0) { rrect(ctx, 14, y, Math.max(14, bw * f), 14, 7); ctx.fill(); }
        ctx.fillStyle = '#f2e9d8'; ctx.textAlign = 'center'; ctx.font = '700 12px "IBM Plex Mono", monospace'; ctx.fillText(`${st.gp} / ${st.g.t}`, 14 + bw / 2, y + 7.5);
        ctx.textAlign = 'left'; ctx.font = '700 15px "IBM Plex Mono", monospace'; ctx.fillStyle = '#f2e9d8'; ctx.fillText(`${Math.round(scoreShown)}점`, 14, 60);
        if (st.cb >= 2) { ctx.textAlign = 'right'; ctx.fillStyle = '#e3ae45'; ctx.fillText(`콤보 ${st.cb}`, G.w - 14, 60); }
      }
      // 판
      let ox = 0, oy = 0;
      if (shake > 0.2) { ox = (Math.random() - 0.5) * shake * L.fx(); oy = (Math.random() - 0.5) * shake * L.fx(); shake *= 0.85; } else shake = 0;
      ctx.save(); ctx.translate(ox, oy);
      const { bx, by, size, cell } = G;
      ctx.fillStyle = '#3a2a1e'; rrect(ctx, bx - 8, by - 8, size + 16, size + 16, 14); ctx.fill();
      ctx.fillStyle = '#0f2f26'; rrect(ctx, bx - 3, by - 3, size + 6, size + 6, 9); ctx.fill();
      for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) {
        ctx.fillStyle = (r + c) % 2 ? '#174a3b' : '#1a5242';
        rrect(ctx, bx + c * cell + 1.5, by + r * cell + 1.5, cell - 3, cell - 3, cell * 0.16); ctx.fill();
      }
      const gh = drag && drag.gh;
      const clr = {};
      if (gh && gh.ok) { gh.res.rows.forEach((r) => { for (let c = 0; c < N; c++) clr[r * N + c] = 1; }); gh.res.cols.forEach((c) => { for (let r = 0; r < N; r++) clr[r * N + c] = 1; }); }
      const pulse = 0.5 + 0.5 * Math.sin(now / 110);
      let popT = popIn ? (now - popIn.t0) * sp() / 220 : 2;
      for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) {
        const v = st.b[r * N + c]; if (v === '.') continue;
        let sc = 1;
        if (popT < 1 && (popIn.all || popIn.cells.some(([a, b]) => a === r && b === c))) sc = 0.6 + 0.4 * easeBack(popT);
        drawCell(+v, bx + c * cell, by + r * cell, cell, 1, sc);
        if (clr[r * N + c]) { ctx.fillStyle = `rgba(255,244,214,${0.25 + 0.25 * pulse})`; rrect(ctx, bx + c * cell + 2, by + r * cell + 2, cell - 4, cell - 4, cell * 0.18); ctx.fill(); }
      }
      if (gh) {
        const p = st.tray[drag.i];
        for (const [dr, dc] of SH[p[0]]) {
          const x = bx + (gh.c + dc) * cell, y = by + (gh.r + dr) * cell;
          if (gh.ok) drawCell(p[1], x, y, cell, 0.42);
          else { ctx.strokeStyle = 'rgba(238,106,85,.7)'; ctx.lineWidth = 2; rrect(ctx, x + 3, y + 3, cell - 6, cell - 6, cell * 0.16); ctx.stroke(); }
        }
        if (gh.ok) { // 지워질 줄 미리 보기: 빈칸도 빛나게
          for (const k in clr) { const r = Math.floor(k / N), c = k % N; if (st.b[k] === '.') { ctx.fillStyle = `rgba(255,244,214,${0.18 + 0.2 * pulse})`; rrect(ctx, bx + c * cell + 2, by + r * cell + 2, cell - 4, cell - 4, cell * 0.18); ctx.fill(); } }
          if (gh.res.mono.length) { ctx.fillStyle = '#fff3d6'; ctx.font = '700 15px "IBM Plex Sans KR", sans-serif'; ctx.textAlign = 'center'; ctx.fillText('단색 줄 보너스!', G.w / 2, by - 20 > 64 ? by - 20 : by + 14); }
        }
      }
      // 효과
      for (let q = fx.length - 1; q >= 0; q--) {
        const e = fx[q], t = (now - e.t0) * sp() / e.d;
        if (t >= 1) { fx.splice(q, 1); continue; }
        if (t < 0) continue;
        if (e.k === 'cell') {
          const x = bx + e.c * cell, y = by + e.r * cell;
          drawCell(e.col, x, y, cell, 1 - t, 1 + t * 0.5);
          ctx.fillStyle = `rgba(255,255,255,${(1 - t) * 0.7})`; rrect(ctx, x + 2, y + 2, cell - 4, cell - 4, cell * 0.2); ctx.fill();
        } else if (e.k === 'band') {
