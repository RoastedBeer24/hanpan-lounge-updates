  /* ---------- 자동 플레이 (시험·AI 자리) ---------- */
  function evalBoard(b) {
    // 구멍(사방이 막힌 빈칸)·조각화 벌점, 큰 조각 자리 보너스
    let pen = 0;
    for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) {
      if (b[r * N + c] !== '.') continue;
      let block = 0;
      if (r === 0 || b[(r - 1) * N + c] !== '.') block++;
      if (r === N - 1 || b[(r + 1) * N + c] !== '.') block++;
      if (c === 0 || b[r * N + c - 1] !== '.') block++;
      if (c === N - 1 || b[r * N + c + 1] !== '.') block++;
      if (block === 4) pen += 6; else if (block === 3) pen += 2;
    }
    let bonus = 0;
    if (anyFit(b, SH.findIndex((x) => x.length === 9))) bonus += 8;
    for (let i = 0; i < N; i++) { // 거의 찬 줄은 좋음
      let fr = 0, fc = 0;
      for (let j = 0; j < N; j++) { if (b[i * N + j] !== '.') fr++; if (b[j * N + i] !== '.') fc++; }
      if (fr >= 6) bonus += 1; if (fc >= 6) bonus += 1;
    }
    let empty = 0; for (let k = 0; k < N * N; k++) if (b[k] === '.') empty++;
    return empty * 0.4 + bonus - pen;
  }
  function ai(s, seat, lv) {
    if (s.ph === 'clear') return { t: 'next' };
    if (s.ph === 'dclear') return { t: 'end' };
    const moves = [];
    s.tray.forEach((p, i) => {
      if (!p) return;
      const d = SD[p[0]];
      for (let r = 0; r + d.h <= N; r++) for (let c = 0; c + d.w <= N; c++) if (fits(s.b, p[0], r, c)) moves.push({ i, r, c, p });
    });
    if (!moves.length) return null;
    if (lv === 1 && Math.random() < 0.5) { const m = moves[Math.floor(Math.random() * moves.length)]; return { t: 'put', i: m.i, r: m.r, c: m.c }; }
    let best = null, bv = -1e9;
    for (const m of moves) {
      const res = simulate(s.b, m.p[0], m.p[1], m.r, m.c);
      const L2 = res.rows.length + res.cols.length;
      let v = L2 * 30 + res.mono.length * 20 + evalBoard(res.board);
      if (lv >= 3) { // 남은 조각이 들어갈 수 있는지
        s.tray.forEach((q, j) => { if (q && j !== m.i && !anyFit(res.board, q[0])) v -= 60; });
      }
      if (lv === 1) v += Math.random() * 25;
      if (v > bv) { bv = v; best = m; }
    }
    return { t: 'put', i: best.i, r: best.r, c: best.c };
  }
  function aiDelayFor(s, seat, lv) { return lv === 3 ? 350 : 550; }

  /* ---------- 화면 ---------- */
  function shade(hex, f) {
    const n = parseInt(hex.slice(1), 16);
    let r = n >> 16, g = (n >> 8) & 255, b = n & 255;
    if (f > 0) { r += (255 - r) * f; g += (255 - g) * f; b += (255 - b) * f; } else { r *= 1 + f; g *= 1 + f; b *= 1 + f; }
    return `rgb(${r | 0},${g | 0},${b | 0})`;
  }
  function goalText(g) {
    if (!g) return '';
    if (g.k === 'ln') return `줄 ${g.t}개 지우기`;
    if (g.k === 'sc') return `${g.t}점 만들기`;
    if (g.k === 'cc') return `${CNAME[g.c]} 칸 ${g.t}개 지우기`;
    return `${CNAME[g.c]} 단색 줄 ${g.t}개`;
  }

  function mount(root, api) {
    const cv = U.canvas(root), ctx = cv.ctx;
    let st = null, G = null;
    const sprites = {};
    let drag = null; // {i, x, y, ghost:{r,c,ok,res}}
    const fx = []; // 터지는 칸·파편·글자
    let shake = 0, scoreShown = 0, stop = null, busyUntil = 0, popIn = null;
    const sp = () => L.debug.speed || 1;

    const nextBtn = L.h('button', { 'data-action': 'next', class: 'btn primary cb-next', text: '다음 단계 ▶', style: { position: 'absolute', left: '50%', transform: 'translateX(-50%)', minHeight: '52px', minWidth: '180px', fontSize: '18px', display: 'none', zIndex: 3 }, onclick() { api.sfx('click'); api.act({ t: 'next' }); } });
    root.append(nextBtn);
    let dov = null;
    const closeD = () => { if (dov) { dov.remove(); dov = null; } };
    function dpanel(kids) {
      closeD();
      dov = L.h('div', { style: { position: 'absolute', inset: '0', zIndex: 6, display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '16px', background: 'rgba(10,8,15,.66)' } });
      const sh = L.h('div', { class: 'sheet', style: { gap: '12px', maxWidth: '380px', width: '100%' } });
      kids.forEach((k) => k && sh.append(k)); dov.append(sh); root.append(dov);
    }
    function dailyIntro() {
      if (!st || st.m !== 'day' || !api.canAct(0) || api.players[0].ai) return;
      dpanel([DAILY.card(() => { closeD(); api.sfx('click'); }, api, goalText(st.g)),
        L.h('p', { class: 'muted', style: { margin: 0, fontSize: '13px' }, text: `조각 ${st.g.p}개 안에 목표를 이루세요. 오늘은 누구나 같은 판·같은 조각 순서예요. 적은 조각으로 이룰수록 좋은 기록!` })]);
      const b = dov.querySelector('.btn.primary'); if (b) b.textContent = DAILY.score(st.dy) != null ? '다시 도전 ▶' : '시작 ▶';
    }
    function dailyClear() {
      const sc = DAILY.score(st.dy);
      dpanel([L.h('h2', { text: '오늘의 퍼즐 완료! 🎉' }),
        L.h('p', { style: { margin: 0, fontSize: '16px' }, text: `조각 ${st.used}개` + (sc != null ? ` · 오늘 최고 ${sc}조각` : '') + ` · 🔥 연속 ${DAILY.streak()}일` }),
        L.h('button', { class: 'btn primary', style: { minHeight: '52px', fontSize: '17px' }, text: '📋 결과 공유(복사)', onclick: () => DAILY.share(st.dy, api) }),
        L.h('button', { class: 'btn', style: { minHeight: '48px' }, text: '마치기', onclick: () => { closeD(); api.act({ t: 'end' }); } })]);
    }

    function layout() {
      const w = cv.w, h = cv.h;
      const head = 70, trayMin = 128;
      const cell = Math.floor(Math.min((w - 24) / N, (h - head - trayMin - 24) / N, 56));
      const size = cell * N;
      const bx = Math.round((w - size) / 2);
      const spare = h - head - size - trayMin - 24;
      const by = head + Math.max(0, Math.floor(spare * 0.35));
      const ty = by + size + 14;
      const th = Math.min(h - ty - 8, 170);
      G = { cell, size, bx, by, ty, th, w, h, tc: Math.max(14, Math.floor(Math.min(cell * 0.56, th / 5.4, (w - 24) / 3 / 5.4))) };
      for (const k in sprites) delete sprites[k];
      nextBtn.style.top = (by + size / 2 + 40) + 'px';
    }
    function sprite(col, sz) {
      const key = col + ':' + sz;
      if (sprites[key]) return sprites[key];
      const d = cv.dpr || 1, c = document.createElement('canvas');
      c.width = c.height = Math.ceil(sz * d);
      const g = c.getContext('2d'); g.scale(d, d);
      const m = Math.max(1, sz * 0.05), rr = sz * 0.2, x = m, y = m, s2 = sz - m * 2;
      const base = COLS[col];
      g.fillStyle = shade(base, -0.38); rrect(g, x, y + s2 * 0.06, s2, s2 * 0.94, rr); g.fill();
      const gr = g.createLinearGradient(0, y, 0, y + s2);
      gr.addColorStop(0, shade(base, 0.25)); gr.addColorStop(1, base);
      g.fillStyle = gr; rrect(g, x, y, s2, s2 * 0.9, rr); g.fill();
      g.fillStyle = 'rgba(255,255,255,0.32)'; rrect(g, x + s2 * 0.16, y + s2 * 0.1, s2 * 0.68, s2 * 0.22, rr * 0.6); g.fill();
      g.strokeStyle = shade(base, 0.45); g.lineWidth = Math.max(1, sz * 0.03); rrect(g, x + 0.5, y + 0.5, s2 - 1, s2 * 0.9 - 1, rr); g.stroke();
      sprites[key] = c; return c;
    }
    function rrect(g, x, y, w, h, r) { g.beginPath(); g.moveTo(x + r, y); g.arcTo(x + w, y, x + w, y + h, r); g.arcTo(x + w, y + h, x, y + h, r); g.arcTo(x, y + h, x, y, r); g.arcTo(x, y, x + w, y, r); g.closePath(); }
    function drawCell(col, x, y, sz, alpha, scale) {
      const im = sprite(col, Math.round(sz));
      ctx.globalAlpha = alpha == null ? 1 : alpha;
      const s2 = sz * (scale || 1);
      ctx.drawImage(im, x + (sz - s2) / 2, y + (sz - s2) / 2, s2, s2);
      ctx.globalAlpha = 1;
    }
    function slotRect(i) { const sw = (G.w - 16) / 3; return { x: 8 + sw * i, y: G.ty, w: sw, h: G.th }; }
    function trayPos(i, sh) {
      const r = slotRect(i), d = SD[sh], t = Math.floor(Math.min(G.cell * 0.62, (r.w - 22) / Math.max(3, d.w), (r.h - 22) / Math.max(3, d.h)));
      return { x: r.x + (r.w - d.w * t) / 2, y: r.y + (r.h - d.h * t) / 2, t };
    }

    function ghostFor(px, py) {
      const p = st.tray[drag.i]; if (!p) return null;
      const d = SD[p[0]], c = G.cell;
      const lift = Math.max(70, c * 1.9);
      const x0 = px - (d.w * c) / 2, y0 = py - lift - (d.h * c) / 2;
      drag.dx = x0; drag.dy = y0;
      const col = Math.round((x0 - G.bx) / c), row = Math.round((y0 - G.by) / c);
      if (row < -1 || col < -1 || row + d.h > N + 1 || col + d.w > N + 1) return null;
      const rr = U.clamp(row, 0, N - d.h), cc = U.clamp(col, 0, N - d.w);
      if (!fits(st.b, p[0], rr, cc)) return { r: rr, c: cc, ok: false };
      return { r: rr, c: cc, ok: true, res: simulate(st.b, p[0], p[1], rr, cc) };
    }
    const canPlay = () => st && st.ph === 'play' && !st.over && api.canAct(0) && performance.now() > busyUntil - 200;
    function down(ev) {
      if (!canPlay()) return;
      const { x, y } = cv.local(ev);
      if (y < G.ty - 10) return;
      for (let i = 0; i < 3; i++) {
        const r = slotRect(i);
        if (st.tray[i] && x >= r.x && x <= r.x + r.w) {
          drag = { i, x, y }; drag.gh = ghostFor(x, y);
          api.sfx('tick'); api.buzz(8);
