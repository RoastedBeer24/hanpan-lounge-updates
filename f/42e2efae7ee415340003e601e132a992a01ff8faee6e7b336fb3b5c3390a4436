          const x = e.x + e.vx * ms, y = e.y + e.vy * ms + 0.0009 * ms * ms;
          ctx.globalAlpha = 1 - t; ctx.fillStyle = COLS[e.col]; ctx.fillRect(x - e.s / 2, y - e.s / 2, e.s, e.s); ctx.globalAlpha = 1;
