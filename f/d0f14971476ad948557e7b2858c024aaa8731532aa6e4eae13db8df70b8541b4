.vb-root .vi{width:1em;height:1em;vertical-align:-0.14em;flex:none}
.vflag{flex:none;border-radius:2px;display:inline-block;vertical-align:middle}
.vb-root button{-webkit-tap-highlight-color:transparent}
/* ── 세로(기본): 위 칩 · 아래 막대 ── */
.vb-top{position:absolute;left:6px;right:54px;top:6px;display:flex;gap:4px;z-index:6;overflow-x:auto;scrollbar-width:none}
.vb-top::-webkit-scrollbar{display:none}
.vb-chip{flex:1 1 0;min-width:50px;max-width:120px;height:44px;border-radius:10px;background:linear-gradient(#fbf2dc,#ecdab2);border:1.5px solid rgba(58,36,20,.4);box-shadow:0 2px 6px rgba(40,20,0,.28);display:flex;flex-direction:column;justify-content:center;padding:2px 6px;position:relative;cursor:pointer;font-family:inherit;color:#2a1a0c;text-align:left}
.vb-chip .r1{display:flex;align-items:center;gap:4px;font-size:11px;font-weight:600;white-space:nowrap;overflow:hidden}
.vb-chip .r1 .nm{overflow:hidden;text-overflow:ellipsis}
.vb-chip .r2{display:flex;align-items:center;gap:3px;font:600 14px/1 var(--f-mono);color:#6b3e10;white-space:nowrap}
.vb-chip .r2 .vi{color:#b8860b;width:14px;height:14px}
.vb-chip .r2 .mo{display:none;margin-left:auto;font-size:11px;color:#5a3c1e;gap:2px;align-items:center}
.vb-chip .r2 .mo .vi{width:12px;height:12px;color:#8a6a20}
.vb-chip.cur{border-color:#b8241d;box-shadow:0 0 0 2px rgba(184,36,29,.45),0 2px 6px rgba(40,20,0,.3)}
.vb-chip .bar{position:absolute;left:0;bottom:0;height:3px;border-radius:0 0 8px 8px;background:var(--c)}
.vb-chip .gl{position:absolute;right:0;bottom:3px;height:2px;background:#b8860b;opacity:.8}
.vb-info{position:absolute;left:8px;top:56px;z-index:5;display:flex;gap:5px;align-items:center;pointer-events:none;flex-wrap:wrap;max-width:calc(100% - 64px)}
.vb-pill{background:rgba(42,26,12,.74);color:#f6ead0;border-radius:999px;padding:3px 9px;font-size:11.5px;display:inline-flex;gap:4px;align-items:center;white-space:nowrap}
.vb-pill .vi{width:13px;height:13px}
.vb-pill.war{background:rgba(150,30,20,.82)}
.vb-pill.win{background:rgba(30,60,96,.8)}
.vb-pill.sum{background:rgba(120,72,14,.8)}
.vb-rose{width:15px;height:15px;flex:none}
.vb-news{position:absolute;left:50%;transform:translateX(-50%);top:84px;z-index:7;display:flex;flex-direction:column;gap:4px;align-items:center;pointer-events:none;width:min(94%,400px)}
.vb-ni{background:rgba(246,236,212,.82);border:1px solid rgba(58,36,20,.3);border-left:4px solid var(--c);border-radius:8px;padding:3px 9px;font-size:12px;display:flex;gap:6px;align-items:center;box-shadow:0 2px 8px rgba(40,20,0,.2);transition:opacity .3s,transform .3s;max-width:100%;pointer-events:auto;cursor:pointer}
.vb-ni .tx{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.vb-ni.out{opacity:0;transform:translateY(-6px);pointer-events:none}
.vb-ch{display:inline-flex;align-items:center;gap:2px;border-radius:999px;padding:1px 6px;font:600 11.5px/1.5 var(--f-mono);white-space:nowrap}
.vb-ch.p{background:#d8efd3;color:#1d5e2a}.vb-ch.n{background:#f6d3cc;color:#8c2216}.vb-ch.o{background:#efe3c8;color:#5a3c1e}
.vb-bot{position:absolute;left:0;right:0;bottom:0;z-index:8;background:linear-gradient(#f3e6c8,#e6d3a8);border-top:2px solid #6b4a24;box-shadow:0 -4px 14px rgba(40,20,0,.35);padding:6px 8px calc(8px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:6px}
.vb-fl{display:flex;align-items:center;gap:6px;min-height:30px;font-size:12px}
.vb-fl .hd{display:none}
.vb-fl .shp{display:flex;gap:2px;align-items:flex-end}
.vb-fl .shp canvas{width:34px;height:26px}
.vb-fl .st{display:flex;gap:6px;flex-wrap:wrap;align-items:center;flex:1;justify-content:flex-end}
.vb-fl .st span{display:inline-flex;align-items:center;gap:2px;font:600 12.5px/1 var(--f-mono);white-space:nowrap}
.vb-fl .st .vi{width:14px;height:14px;color:#6b4a24}
.vb-fl .ofs{display:flex;gap:3px}
.vb-fl .ofs span{width:22px;height:22px;border-radius:50%;background:#3a2414;color:#f3e2b0;display:inline-flex;align-items:center;justify-content:center}
.vb-fl .ofs .vi{width:14px;height:14px}
.vb-hpb{width:46px;height:7px;border-radius:4px;background:rgba(0,0,0,.18);overflow:hidden;display:inline-block}
.vb-hpb i{display:block;height:100%;background:linear-gradient(90deg,#c0392b,#e9a23b 50%,#4a9a4a);background-size:46px 100%}
.vb-btns{display:flex;gap:6px}
.vb-btn{min-height:46px;border-radius:12px;border:2px solid #5a3c1e;background:linear-gradient(#fbf3e2,#efe0bf);color:#3a2414;font:600 15px var(--f-body);display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:0 12px;cursor:pointer;flex:1;box-shadow:0 2px 0 #5a3c1e}
.vb-btn:active{transform:translateY(2px);box-shadow:none}
.vb-btn .vi{width:20px;height:20px}
.vb-btn.go{background:linear-gradient(#c94236,#962d22);color:#fff6e0;border-color:#5e1a12;box-shadow:0 2px 0 #5e1a12,inset 0 1px 0 rgba(255,220,200,.35)}
.vb-btn.gold{background:linear-gradient(#efce7a,#c8962a);color:#2a1a0c;border-color:#6b4a14;box-shadow:0 2px 0 #6b4a14,inset 0 1px 0 rgba(255,250,220,.5)}
.vb-btn:disabled{opacity:.45;pointer-events:none}
.vb-btn.sm{flex:0 0 auto;min-width:46px;padding:0 10px;font-size:13px}
.vb-wait{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;min-height:46px;font-size:14px;color:#5a3c1e;text-align:center}
.vb-hint{font-size:12.5px;color:#5a3c1e;text-align:center;min-height:16px;line-height:1.35}
.vb-hint b{color:#962d22}
.vb-sheet{position:absolute;left:0;right:0;bottom:0;z-index:20;max-height:74%;display:flex;flex-direction:column;background:linear-gradient(#f6ead0,#ead7ae);border-top:3px solid #6b4a24;border-radius:16px 16px 0 0;box-shadow:0 -8px 24px rgba(30,15,0,.45);transform:translateY(0);transition:transform .22s;overflow:hidden}
.vb-sheet.hide{transform:translateY(105%)}
.vb-sh-h{display:flex;align-items:center;gap:8px;padding:8px 10px 6px;font:20px ${FONT};color:#3a2414}
.vb-sh-h .t{flex:1;display:flex;align-items:center;gap:6px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vb-x{width:44px;height:44px;border-radius:10px;border:1.5px solid rgba(58,36,20,.45);background:rgba(255,248,230,.7);color:#3a2414;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;flex:none}
.vb-x .vi{width:20px;height:20px}
.vb-ban{position:relative;height:clamp(64px,19vh,128px);flex:none;background:#c8b48a center 55%/cover no-repeat;border-bottom:2px solid #6b4a24;display:flex;align-items:flex-end;justify-content:space-between;padding:6px 8px;gap:8px}
.vb-ban:before{content:"";position:absolute;inset:0;background:linear-gradient(rgba(40,24,10,0) 30%,rgba(40,24,10,.55))}
.vb-ban .pn{position:relative;display:flex;align-items:center;gap:6px;background:rgba(250,240,214,.92);border:1.5px solid #5a3c1e;border-radius:10px;padding:3px 10px;font:22px ${FONT};color:#2a1a0c;box-shadow:0 2px 8px rgba(0,0,0,.35);min-width:0;white-space:nowrap;overflow:hidden}
.vb-ban .pn small{font:600 11.5px var(--f-body);color:#7a5a30;margin-left:2px}
.vb-ban .sp{position:relative;display:flex;gap:3px;flex-wrap:wrap;justify-content:flex-end}
.vb-ban .sp span{display:inline-flex;align-items:center;gap:3px;background:rgba(250,240,214,.9);border-radius:999px;padding:2px 7px;font:600 11.5px var(--f-body);border:1px solid rgba(58,36,20,.4)}
.vb-ban .vb-x{position:absolute;right:6px;top:6px;z-index:2}
.vb-ban .mon{position:absolute;left:8px;top:8px;background:rgba(30,18,8,.72);color:#ffe6a8;border-radius:999px;padding:3px 9px;font:600 13px var(--f-mono);display:inline-flex;gap:3px;align-items:center}
.vb-tabs{display:flex;gap:4px;padding:6px 8px;overflow-x:auto;scrollbar-width:none;flex:none}
.vb-tab{flex:1 0 auto;min-height:44px;border-radius:10px;border:1.5px solid rgba(58,36,20,.35);background:rgba(255,250,236,.6);font:600 13px var(--f-body);color:#5a3c1e;display:inline-flex;gap:4px;align-items:center;justify-content:center;padding:0 8px;cursor:pointer}
.vb-tab.on{background:#3a2414;color:#f6ead0;border-color:#3a2414}
.vb-tab .vi{width:16px;height:16px}
.vb-sh-b{overflow-y:auto;padding:4px 10px 10px;flex:1;-webkit-overflow-scrolling:touch;min-height:0}
.vb-sh-f{padding:8px 10px calc(10px + env(safe-area-inset-bottom));display:flex;gap:6px;border-top:1px solid rgba(58,36,20,.25);flex:none}
.vb-row{display:flex;align-items:center;gap:8px;padding:6px 4px;border-bottom:1px dashed rgba(58,36,20,.25);min-height:48px}
.vb-row .ic{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;background:radial-gradient(#fffaf0,#efe0bb);border:1.5px solid rgba(58,36,20,.45);box-shadow:inset 0 -2px 3px rgba(90,60,30,.2)}
.vb-row .ic .vi{width:24px;height:24px}
.vb-row .mid{flex:1;min-width:0}
.vb-row .mid b{display:block;font-size:14px}
.vb-row .mid small{display:block;font-size:11.5px;color:#6b5030;line-height:1.3}
.vb-row .pr{font:600 14px var(--f-mono);text-align:right;white-space:nowrap;display:flex;flex-direction:column;align-items:flex-end;gap:2px}
.vb-row .acts{display:flex;gap:4px;flex:none}
.vb-mini{min-width:52px;min-height:44px;border-radius:10px;border:1.5px solid #5a3c1e;background:#fbf3e0;font:600 12.5px var(--f-body);color:#3a2414;cursor:pointer;padding:0 6px;line-height:1.1}
.vb-mini.sell{background:#e3f1dc;border-color:#2e6b34;color:#1d4e22}
.vb-mini.buy{background:#f8e1c2;border-color:#8c5a12;color:#5a3a08}
.vb-mini:disabled{opacity:.4;pointer-events:none}
.vb-tr{display:inline-flex;align-items:center;gap:2px;font:700 11px var(--f-mono)}
.vb-tr.up{color:#1d6e2a}.vb-tr.dn{color:#a8301e}.vb-tr.fl{color:#8a7a5a}
.vb-meter{display:inline-block;width:42px;height:6px;border-radius:3px;background:linear-gradient(90deg,#c0392b,#e9c46a 50%,#4a9a4a);position:relative;vertical-align:middle;margin-left:4px;opacity:.85}
.vb-meter i{position:absolute;top:-3px;width:3px;height:12px;border-radius:2px;background:#2a1a0c;margin-left:-1.5px}
.vb-where{display:block;font-size:11px;color:#2f5a3a;margin-top:1px}
.vb-note{font-size:12px;color:#6b5030;padding:4px 2px;line-height:1.4}
.vb-note.warn{color:#962d22;font-weight:600}
.vb-ptab{display:flex;flex-wrap:wrap;gap:4px}
.vb-ptab span{display:inline-flex;align-items:center;gap:3px;background:rgba(255,250,236,.7);border:1px solid rgba(58,36,20,.25);border-radius:8px;padding:2px 6px;font:600 12px var(--f-mono)}
.vb-card{position:absolute;left:calc((var(--lw) + 100% - var(--rw)) / 2);top:46%;transform:translate(-50%,-50%) scale(.9) rotate(-1deg);z-index:25;width:min(84%,300px);max-height:94%;overflow:auto;background:linear-gradient(#fbf3df,#ecd9ae);border:2px solid #5a3c1e;border-radius:14px;box-shadow:0 10px 30px rgba(20,10,0,.55),inset 0 0 0 4px rgba(250,240,214,.8),inset 0 0 0 5px rgba(90,60,30,.4);padding:10px 12px;text-align:center;opacity:0;transition:opacity .2s,transform .25s;pointer-events:none}
.vb-card.on{opacity:1;transform:translate(-50%,-50%) scale(1) rotate(0)}
.vb-card.int{pointer-events:auto}
.vb-card .art{height:96px;margin:2px 0 4px;border-radius:8px;background:#f1e3c2 center/contain no-repeat;border:1px solid rgba(90,60,30,.35);position:relative}
.vb-card .art .ci{position:absolute;right:-4px;bottom:-8px;width:40px;height:40px;margin:0}
.vb-card .ci{width:56px;height:56px;margin:0 auto 4px;border-radius:50%;background:radial-gradient(#fff8e6,#e2cc9c);border:2px solid #5a3c1e;display:flex;align-items:center;justify-content:center}
.vb-card .ci .vi{width:60%;height:60%}
.vb-card h3{margin:2px 0 3px;font:21px ${FONT};color:#3a2414}
.vb-card p{margin:0 0 6px;font-size:13px;color:#4a3018;line-height:1.38}
.vb-card .chs{display:flex;gap:4px;justify-content:center;flex-wrap:wrap;margin-bottom:6px}
.vb-card .opts{display:flex;flex-direction:column;gap:6px}
.vb-card .opts .vb-btn{font-size:14px;flex-wrap:wrap;padding:4px 10px}
.vb-card .tag{font-size:11px;letter-spacing:.1em;color:#8a6a40}
.vb-fight{position:absolute;inset:0;z-index:30;background:rgba(18,12,6,.6);display:flex;align-items:center;justify-content:center}
.vb-fbox{width:min(96%,440px);max-height:96%;overflow:auto;background:linear-gradient(#f6ead0,#e3cd9c);border:2px solid #4a2c10;border-radius:16px;box-shadow:0 14px 40px rgba(0,0,0,.6);display:flex;flex-direction:column}
.vb-fbox h3{margin:0;padding:6px 12px 2px;font:20px ${FONT};display:flex;justify-content:space-between;align-items:center;gap:8px}
.vb-fbox h3 small{font:600 12px var(--f-body);color:#7a5a30}
.vb-fsc{position:relative}
.vb-fcv{width:100%;height:180px;display:block}
.vb-fside{display:flex;justify-content:space-between;gap:6px;padding:0 10px;font-size:12px}
.vb-fside>div{flex:1;background:rgba(255,248,230,.8);border-radius:10px;padding:4px 7px;border:1px solid rgba(58,36,20,.25);min-width:0}
.vb-fside .nm{font-weight:700;font-size:13px;display:flex;gap:4px;align-items:center;white-space:nowrap;overflow:hidden}
.vb-fside .ln{display:flex;gap:7px;flex-wrap:wrap;font:600 12px var(--f-mono);margin-top:2px}
.vb-fside .ln span{display:inline-flex;gap:2px;align-items:center}
.vb-fside .vi{width:13px;height:13px;color:#5a3c1e}
.vb-fside .hb{height:5px;border-radius:3px;background:rgba(0,0,0,.15);overflow:hidden;margin-top:3px}
.vb-fside .hb i{display:block;height:100%;background:linear-gradient(90deg,#c0392b,#e9a23b,#4a9a4a);transition:width .4s}
.vb-fres{min-height:36px;padding:4px 12px;font-size:13px;text-align:center;color:#3a2414;line-height:1.35}
.vb-fres b{color:#962d22}
.vb-fopts{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;padding:6px 10px 10px}
.vb-fo{min-height:58px;border-radius:12px;border:2px solid #4a2c10;background:linear-gradient(#fffaf0,#f1e2c0);font:600 13px var(--f-body);color:#2a1a0c;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;cursor:pointer;padding:3px 2px;box-shadow:0 2px 0 #4a2c10}
.vb-fo:active{transform:translateY(2px);box-shadow:none}
.vb-fo .vi{width:22px;height:22px}
.vb-fo small{font:500 10.5px var(--f-body);color:#6b5030;line-height:1.15;text-align:center}
.vb-fo.red{background:linear-gradient(#fbe2dc,#f0c8bf)}
.vb-fo:disabled{opacity:.4;pointer-events:none}
.vb-fwait{grid-column:1/-1;text-align:center;padding:12px;font-size:13px;color:#5a3c1e}
.vb-sel{position:absolute;left:8px;right:8px;z-index:9;background:rgba(246,236,212,.97);border:2px solid #5a3c1e;border-radius:12px;padding:6px 8px;display:flex;gap:8px;align-items:center;box-shadow:0 4px 16px rgba(30,15,0,.4)}
.vb-sel .ic{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;border:1.5px solid #5a3c1e}
.vb-sel .ic .vi{width:22px;height:22px}
.vb-sel .mid{flex:1;min-width:0;font-size:12px;color:#5a3c1e;line-height:1.3;max-height:62px;overflow:hidden}
.vb-sel .mid b{display:block;font-size:14px;color:#2a1a0c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vb-sel .vb-btn{flex:0 0 auto;min-width:84px}
.vb-round{position:absolute;z-index:6;width:44px;height:44px;border-radius:50%;border:2px solid #5a3c1e;background:rgba(246,236,212,.92);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 6px rgba(40,20,0,.3);color:#3a2414}
.vb-round .vi{width:22px;height:22px}
.vb-ff{position:absolute;z-index:6;left:8px;height:44px;border-radius:999px;border:1.5px solid #5a3c1e;background:rgba(246,236,212,.92);font:600 12px var(--f-body);color:#3a2414;padding:0 12px;display:flex;gap:5px;align-items:center;cursor:pointer}
.vb-ff .vi{width:18px;height:18px}
.vb-ff.on{background:#3a2414;color:#f6ead0}
.vb-shipcard{border:1.5px solid rgba(58,36,20,.4);border-radius:12px;background:rgba(255,250,236,.75);padding:6px 8px;margin:6px 0;display:flex;gap:8px;align-items:flex-start}
.vb-shipcard canvas{width:84px;height:62px;flex:none}
.vb-shipcard .mid{flex:1;min-width:0}
.vb-shipcard b{font:17px ${FONT}}
.vb-shipcard .stt{display:flex;flex-wrap:wrap;gap:6px;font:600 12px var(--f-mono);margin:2px 0}
.vb-shipcard .stt span{display:inline-flex;gap:2px;align-items:center}
.vb-shipcard .stt .vi{width:13px;height:13px;color:#6b4a24}
.vb-tm{display:flex;flex-wrap:wrap;gap:4px;margin:2px 0}
.vb-tm span{display:inline-flex;align-items:center;gap:2px;border-radius:6px;padding:1px 5px;font:700 11.5px var(--f-mono);border:1px solid rgba(58,36,20,.3)}
.vb-tm .vi{width:13px;height:13px}
.vb-tm .g{background:#d8efd3;color:#1d5e2a}.vb-tm .b{background:#f6d3cc;color:#8c2216}.vb-tm .x{background:#3a2414;color:#f6ead0}
.vb-slots{display:flex;gap:4px;flex-wrap:wrap;margin-top:3px}
.vb-slot{min-width:40px;height:28px;border-radius:6px;border:1.5px dashed rgba(58,36,20,.45);display:inline-flex;align-items:center;justify-content:center;gap:2px;font-size:11px;padding:0 4px;color:#6b5030}
.vb-slot.f{border-style:solid;background:#efe0bb;color:#3a2414}
.vb-slot .vi{width:14px;height:14px}
.vb-cm{border:1.5px solid rgba(58,36,20,.4);border-radius:10px;background:linear-gradient(#fff8e6,#f1e1bb);padding:6px 8px;margin:5px 0;display:flex;gap:8px;align-items:center}
.vb-cm .ic{width:34px;height:34px;border-radius:50%;background:#7a2a1a;color:#f6e3b0;display:flex;align-items:center;justify-content:center;flex:none}
.vb-cm .ic .vi{width:22px;height:22px}
.vb-cm .mid{flex:1;min-width:0;font-size:13px}
.vb-cm .mid small{display:block;font-size:11px;color:#7a5a30}
.vb-of{display:flex;gap:8px;align-items:center;border:1.5px solid rgba(58,36,20,.4);border-radius:12px;background:linear-gradient(#fff8e6,#efdcb2);padding:6px 8px;margin:6px 0}
.vb-of .ic{width:44px;height:44px;border-radius:50%;background:radial-gradient(#4a2e18,#2a1a0c);color:#f3dfa8;display:flex;align-items:center;justify-content:center;flex:none;border:2px solid #b8860b}
.vb-of .ic .vi{width:26px;height:26px}
.vb-of .mid{flex:1;min-width:0}
.vb-of .mid b{font:17px ${FONT}}
.vb-of .mid small{display:block;font-size:12px;color:#5a3c1e}
.vb-fin{position:absolute;inset:0;z-index:40;background:rgba(20,12,4,.62);display:flex;align-items:center;justify-content:center}
.vb-finbox{width:min(94%,460px);max-height:92%;overflow:auto;background:linear-gradient(#f8eed6,#e6d1a2);border:2px solid #4a2c10;border-radius:16px;padding:10px 12px;box-shadow:0 14px 40px rgba(0,0,0,.6)}
.vb-finbox h2{margin:0 0 6px;text-align:center;font:26px ${FONT}}
.vb-frow{display:flex;align-items:center;gap:8px;padding:6px 4px;border-bottom:1px dashed rgba(58,36,20,.3)}
.vb-frow .rk{font:22px ${FONT};width:26px;text-align:center}
