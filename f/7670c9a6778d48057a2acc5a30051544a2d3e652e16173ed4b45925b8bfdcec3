<!doctype html>
<html lang="ko"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icons/favicon.png">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="apple-mobile-web-app-title" content="한판 라운지">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<style>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);box-sizing:border-box;height:100%}*,*::before,*::after{box-sizing:border-box}body{margin:0;font:14px system-ui}img{max-width:100%}[hidden]{display:none!important}</style>
<title>한판 라운지</title>
<meta name="theme-color" content="#17131f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<link rel="stylesheet" href="fonts/fonts.css">
<style>
/* Layout: one-screen app — fixed top bar, game stage fills the rest; home is a scrolling list of game "stubs" on a dark parlor ground.
   Single dark world by choice: a late-night game parlor (plum ink, brass, felt). */
:root{
  --bg:#17131f; --surface:#221c2e; --surface-2:#2e2640; --line:rgba(242,233,216,.13);
  --ink:#f2e9d8; --muted:#ab9fb8; --brass:#e3ae45; --brass-ink:#2a1d05; --coral:#ee6a55;
  --felt:#1c6650; --felt-deep:#114536; --ok:#5fd3a0; --bad:#ee6a55;
  --f-display:"Black Han Sans","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  --f-body:"IBM Plex Sans KR","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  --r:14px; color-scheme:dark;
  /* 라운드 29 화면 테마 토큰 (다크 기본값) */
  --scrim:rgba(10,8,15,.72); --scrim-2:rgba(10,8,15,.55); --shadow:rgba(0,0,0,.35); --shadow-2:rgba(0,0,0,.5);
  --danger-ink:#2b0c06; --hair:rgba(255,255,255,.08); --tut-glass:rgba(34,28,46,.88);
  --kp-rt:#ffab84; --kp-bg:rgba(0,0,0,.32); --kp-rt-tile:#ffc3a6; --kp-co-tile:#9ef0c8;
  --best-bg:rgba(227,174,69,.10); --best-line:rgba(227,174,69,.3); --best-chip:rgba(0,0,0,.18); --best-ink:#f0c060;
  --tint-amt:100%; --tint-base:var(--surface); --bw:1px; --focus:2px; --sheen:rgba(255,255,255,.14);
}
/* 라이트: 밝은 종이 위 잉크. 게임 tint는 바탕과 섞어 옅게 */
:root[data-theme="light"]{
  --bg:#f4efe6; --surface:#fffbf3; --surface-2:#e9e1d3; --line:rgba(42,30,56,.18);
  --ink:#231a2d; --muted:#625770; --brass:#9a6400; --brass-ink:#fff; --coral:#c23b27;
  --felt:#1c6650; --felt-deep:#114536; --ok:#17784f; --bad:#c23b27; color-scheme:light;
  --scrim:rgba(40,32,50,.45); --scrim-2:rgba(40,32,50,.4); --shadow:rgba(60,40,20,.18); --shadow-2:rgba(60,40,20,.25);
  --danger-ink:#fff; --hair:rgba(0,0,0,.1); --tut-glass:rgba(255,251,243,.94);
  --kp-rt:#b5461c; --kp-bg:rgba(255,255,255,.6); --kp-rt-tile:#a33d12; --kp-co-tile:#13704a;
  --best-bg:rgba(154,100,0,.08); --best-line:rgba(154,100,0,.35); --best-chip:rgba(255,255,255,.7); --best-ink:#8a5a00;
  --tint-amt:24%; --tint-base:#fffbf3; --sheen:rgba(255,255,255,.3);
}
/* 고대비: 순검정 바탕·흰 글자·굵은 테두리·노란 강조 */
:root[data-theme="hc"]{
  --bg:#000; --surface:#000; --surface-2:#1c1c1c; --line:#fff;
  --ink:#fff; --muted:#e6e6e6; --brass:#ffd60a; --brass-ink:#000; --coral:#ff7a66;
  --felt:#0b5a40; --felt-deep:#063a29; --ok:#5cff9d; --bad:#ff7a66; color-scheme:dark;
  --scrim:rgba(0,0,0,.88); --scrim-2:rgba(0,0,0,.75); --shadow:rgba(0,0,0,.6); --shadow-2:rgba(0,0,0,.8);
  --danger-ink:#000; --hair:rgba(255,255,255,.4); --tut-glass:#000;
  --kp-rt:#ffb38a; --kp-bg:#000; --kp-rt-tile:#ffb38a; --kp-co-tile:#5cff9d;
  --best-bg:#000; --best-line:#ffd60a; --best-chip:#1c1c1c; --best-ink:#ffd60a;
  --tint-amt:45%; --tint-base:#000; --bw:2px; --focus:3px; --sheen:transparent;
}
/* 라이트에서도 게임 무대 안 DOM은 다크 토큰 그대로(캔버스가 어두우니까). def.themed=true면 게임도 테마를 따른다. core 시트는 다시 라이트. */
:root[data-theme="light"] .stage:not([data-themed]){
  --bg:#17131f; --surface:#221c2e; --surface-2:#2e2640; --line:rgba(242,233,216,.13);
  --ink:#f2e9d8; --muted:#ab9fb8; --brass:#e3ae45; --brass-ink:#2a1d05; --coral:#ee6a55;
  --felt:#1c6650; --felt-deep:#114536; --ok:#5fd3a0; --bad:#ee6a55;
  --scrim:rgba(10,8,15,.72); --scrim-2:rgba(10,8,15,.55); --shadow:rgba(0,0,0,.35); --shadow-2:rgba(0,0,0,.5);
  --danger-ink:#2b0c06; --hair:rgba(255,255,255,.08); --tut-glass:rgba(34,28,46,.88);
  --kp-rt:#ffab84; --kp-bg:rgba(0,0,0,.32); --kp-rt-tile:#ffc3a6; --kp-co-tile:#9ef0c8;
  --best-bg:rgba(227,174,69,.10); --best-line:rgba(227,174,69,.3); --best-chip:rgba(0,0,0,.18); --best-ink:#f0c060;
  --tint-amt:100%; --tint-base:#221c2e; --bw:1px; --focus:2px; --sheen:rgba(255,255,255,.14);
}
:root[data-theme="light"] .stage .overlay[data-core]{
  --bg:#f4efe6; --surface:#fffbf3; --surface-2:#e9e1d3; --line:rgba(42,30,56,.18);
  --ink:#231a2d; --muted:#625770; --brass:#9a6400; --brass-ink:#fff; --coral:#c23b27;
  --felt:#1c6650; --felt-deep:#114536; --ok:#17784f; --bad:#c23b27; color-scheme:light;
  --scrim:rgba(40,32,50,.45); --scrim-2:rgba(40,32,50,.4); --shadow:rgba(60,40,20,.18); --shadow-2:rgba(60,40,20,.25);
  --danger-ink:#fff; --hair:rgba(0,0,0,.1); --tut-glass:rgba(255,251,243,.94);
  --kp-rt:#b5461c; --kp-bg:rgba(255,255,255,.6); --kp-rt-tile:#a33d12; --kp-co-tile:#13704a;
  --best-bg:rgba(154,100,0,.08); --best-line:rgba(154,100,0,.35); --best-chip:rgba(255,255,255,.7); --best-ink:#8a5a00;
  --tint-amt:24%; --tint-base:#fffbf3; --sheen:rgba(255,255,255,.3);
}
:root[data-theme="hc"] .btn,:root[data-theme="hc"] .seg,:root[data-theme="hc"] .sheet,:root[data-theme="hc"] .seat,:root[data-theme="hc"] .field input,:root[data-theme="hc"] .home-search,:root[data-theme="hc"] .fb-panel,:root[data-theme="hc"] .lvchip,:root[data-theme="hc"] .person,:root[data-theme="hc"] .tag,:root[data-theme="hc"] .turn,:root[data-theme="hc"] .pv-facts span,:root[data-theme="hc"] .cx-row,:root[data-theme="hc"] kbd{border-width:2px;border-color:#fff}
:root[data-theme="hc"] .tile,:root[data-theme="hc"] .gamerow,:root[data-theme="hc"] .pick-item,:root[data-theme="hc"] .lobby-game{border:2px solid #fff}
:root[data-theme="hc"] .btn.primary,:root[data-theme="hc"] .chips .btn.on,:root[data-theme="hc"] .seg button.on{border:2px solid #ffd60a;box-shadow:0 0 0 2px #000 inset}
:root[data-theme="hc"] .muted,:root[data-theme="hc"] .note,:root[data-theme="hc"] .tile .tg,:root[data-theme="hc"] .pk-tg{opacity:1}
:root[data-theme="hc"] .btn[disabled]{opacity:.55;border-style:dashed}
:root[data-theme="hc"] *:focus-visible{outline:var(--focus) solid var(--brass)!important;outline-offset:3px!important;box-shadow:0 0 0 6px #000}
:root[data-theme="light"] .tile,:root[data-theme="light"] .pick-item,:root[data-theme="light"] .lobby-game{box-shadow:0 1px 0 var(--line),0 2px 8px var(--shadow)}
html,body{height:100%}
body{background:var(--bg);color:var(--ink);font:15px/1.5 var(--f-body);-webkit-tap-highlight-color:transparent;overscroll-behavior:none;overflow:hidden}
button,input{font:inherit;color:inherit}
#app{height:100%;display:flex;flex-direction:column;max-width:760px;margin:0 auto;position:relative}
.screen{flex:1;min-height:0;display:flex;flex-direction:column}
.scroll{flex:1;min-height:0;overflow-y:auto;padding-inline:16px;padding-block:8px 28px;-webkit-overflow-scrolling:touch}

/* buttons */
.btn{appearance:none;border:1px solid var(--line);background:var(--surface-2);border-radius:12px;padding:10px 16px;font-weight:700;cursor:pointer;touch-action:manipulation;transition:transform .08s,background .15s;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;user-select:none}
.btn:active{transform:scale(.96)}
.btn:focus-visible,.tile:focus-visible,input:focus-visible{outline:var(--focus) solid var(--brass);outline-offset:2px}
.btn.primary{background:var(--brass);color:var(--brass-ink);border-color:transparent}
.btn.danger{background:var(--coral);color:var(--danger-ink);border-color:transparent}
.btn.ghost{background:transparent}
.btn.sm{min-height:34px;padding:6px 12px;font-size:13px;border-radius:10px}
.btn[disabled]{opacity:.4;pointer-events:none}
.btn.block{width:100%}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.muted{color:var(--muted)}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.label{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700}

/* home */
.brand{padding-block:22px 6px;display:flex;flex-direction:column;gap:4px}
.brand h1{font-family:var(--f-display);font-weight:400;font-size:44px;line-height:1;margin:0;letter-spacing:-.01em;text-wrap:balance}
.brand h1 span{color:var(--brass)}
.brand p{margin:0;color:var(--muted)}
.online-bar{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-block:16px 22px}
.online-bar .btn{min-height:52px}
.tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
@media (min-width:560px){.tiles{grid-template-columns:repeat(4,minmax(0,1fr))}}
.tile{appearance:none;text-align:left;border:0;border-radius:var(--r);padding:12px 12px 12px;cursor:pointer;display:flex;flex-direction:column;gap:6px;min-height:150px;position:relative;overflow:hidden;color:var(--ink);background:color-mix(in srgb,var(--tint,var(--surface)) var(--tint-amt),var(--tint-base));touch-action:manipulation;transition:transform .1s}
.tile:active{transform:scale(.97)}
.tile .ico{width:56px;height:56px;color:var(--ink)}
.tile .nm{font-family:var(--f-display);font-size:22px;line-height:1.05;margin-top:auto}
.tile .tg{font-family:var(--f-mono);font-size:11px;opacity:.75}
.tile::after{content:"";position:absolute;right:-18px;top:50%;width:36px;height:36px;border-radius:50%;background:var(--bg);transform:translateY(-50%)}
.section-h{display:flex;justify-content:space-between;align-items:baseline;margin-block:4px 10px}

/* top bar */
.topbar{display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid var(--line);min-height:52px}
.topbar .title{font-family:var(--f-display);font-size:20px;flex:1 1 auto;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.topbar .grow{flex:1}
html.show-keys [data-kb]::after{content:attr(data-kb);position:absolute;right:2px;top:2px;bottom:auto;font:700 8px/11px var(--f-mono,monospace);padding:0 3px;border-radius:4px;background:rgba(20,16,28,.82);border:1px solid rgba(255,255,255,.18);color:#d8d2e6;pointer-events:none;white-space:nowrap;letter-spacing:0;z-index:3;box-shadow:0 1px 2px rgba(0,0,0,.4)}
.iconbtn{appearance:none;border:0;background:transparent;width:40px;height:40px;border-radius:10px;display:grid;place-items:center;cursor:pointer;font-size:20px;color:var(--ink)}
.iconbtn:active{background:var(--surface-2)}
.turn{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:4px 10px 4px 8px;flex:0 0 auto;max-width:56vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.turn.mine{border-color:var(--brass);color:var(--brass)}
.dot{width:10px;height:10px;border-radius:50%;flex:none;background:var(--c,var(--muted))}

/* stage for games */
.stage{position:relative;flex:1;min-height:0;overflow:hidden;touch-action:none}
.gcanvas{position:absolute;inset:0;width:100%;height:100%;display:block}
/* 라운드 55: 게임 중 위쪽 막대 숨김 — Esc/☰ 게임 메뉴, 차례 알약은 판 오른쪽 위 */
.gscreen>.topbar{display:none!important}
.gcorner{position:absolute;top:max(2px,env(safe-area-inset-top));right:max(2px,env(safe-area-inset-right));z-index:19;display:flex;align-items:center;gap:2px;pointer-events:none;max-width:calc(100% - 4px);zoom:var(--ui,1)}
.gcorner.at-tl{right:auto;left:max(2px,env(safe-area-inset-left))}.gcorner.at-bl,.gcorner.at-br{top:auto;bottom:max(2px,env(safe-area-inset-bottom))}.gcorner.at-bl{right:auto;left:max(2px,env(safe-area-inset-left))}.gcorner[hidden]{display:none}
.gcorner>*{pointer-events:auto}.gcorner [hidden]{display:none}
.gturn{position:absolute;left:50%;top:max(6px,env(safe-area-inset-top));z-index:19;pointer-events:none;transform:translate(-50%,-6px);opacity:0;transition:opacity .2s,transform .2s;max-width:60%;zoom:var(--ui,1);box-shadow:0 1px 6px rgba(0,0,0,.25);font-size:13px;padding:3px 10px 3px 8px}
.gturn.show{opacity:.88;transform:translate(-50%,0)}
.gturn{background:color-mix(in srgb,var(--surface) 55%,transparent);backdrop-filter:blur(2px);border-color:color-mix(in srgb,var(--line) 60%,transparent)}
.gcbtn{width:44px;height:44px;flex:none;display:grid;place-items:center;border:0;background:none;color:var(--ink);font-size:17px;line-height:1;cursor:pointer;opacity:.8;padding:0;-webkit-tap-highlight-color:transparent;position:relative}
.gcbtn::before{content:"";position:absolute;inset:9px;border-radius:8px;background:color-mix(in srgb,var(--surface) 70%,transparent);border:1px solid color-mix(in srgb,var(--line) 70%,transparent);z-index:-1}
.gcbtn:hover,.gcbtn:focus-visible,.gcbtn:active{opacity:1}
@media (hover:hover) and (pointer:fine){.gcbtn{opacity:.62}}
.hud{position:absolute;left:0;right:0;padding:10px 12px;display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap;pointer-events:none}
.hud>*{pointer-events:auto}
.hud.bottom{bottom:0}
.hud.top{top:0}
.panel{background:color-mix(in srgb,var(--surface) 92%,transparent);border:1px solid var(--line);border-radius:12px;padding:8px 12px;backdrop-filter:blur(6px)}

/* overlays */
.overlay{position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:16px;background:var(--scrim);backdrop-filter:blur(3px);animation:fade .18s ease-out}
.sheet{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px;width:min(420px,100%);max-height:100%;overflow-y:auto;display:flex;flex-direction:column;gap:14px}
.sheet h2{font-family:var(--f-display);font-weight:400;font-size:28px;margin:0;line-height:1.1;text-wrap:balance}
.curtain{background:var(--bg);flex-direction:column;gap:14px;text-align:center;cursor:pointer}
.curtain .big{font-family:var(--f-display);font-size:36px}
@keyframes fade{from{opacity:0}to{opacity:1}}
.hint-list{margin:4px 0 12px;padding-left:18px;display:flex;flex-direction:column;gap:8px;font-size:15px;line-height:1.45}
.hint-list li.first{font-weight:700}
html.contrast .toast{box-shadow:0 0 0 2px var(--bg),0 2px 8px rgba(0,0,0,.6)}
html.contrast .hud,html.contrast .turn,html.contrast .overlay.result h2,html.contrast .overlay.result .sheet,html.contrast .gscreen>.topbar,html.contrast .tut-card{text-shadow:0 0 2px rgba(0,0,0,.95),0 1px 3px rgba(0,0,0,.9),1px 0 0 rgba(0,0,0,.6),-1px 0 0 rgba(0,0,0,.6)}
html.contrast[data-theme="light"] .hud,html.contrast[data-theme="light"] .turn,html.contrast[data-theme="light"] .overlay.result .sheet,html.contrast[data-theme="light"] .gscreen>.topbar{text-shadow:0 0 2px #fff,0 1px 3px rgba(255,255,255,.95)}
.toast{opacity:.92;position:absolute;left:50%;top:64px;transform:translateX(-50%);z-index:30;background:var(--ink);color:var(--bg);padding:8px 14px;border-radius:999px;font-weight:700;font-size:13px;white-space:nowrap;animation:fade .15s;pointer-events:none;max-width:90%;overflow:hidden;text-overflow:ellipsis}

/* setup */
.seat{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}
.seat input{flex:1;min-width:0;background:transparent;border:0;border-bottom:1px solid var(--line);padding:6px 2px;outline:none}
.seat .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;flex:none}
.seg button{appearance:none;border:0;background:transparent;padding:6px 10px;font-size:13px;font-weight:700;cursor:pointer;color:var(--muted)}
.seg button.on{background:var(--brass);color:var(--brass-ink)}
.stepper{display:inline-flex;align-items:center;gap:10px}
.stepper .v{font-family:var(--f-mono);font-size:18px;min-width:2ch;text-align:center}
.field{display:flex;flex-direction:column;gap:6px}
.field input{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px 14px;outline:none;font-size:16px}
.code{font-family:var(--f-mono);font-weight:600;font-size:46px;letter-spacing:.18em;color:var(--brass);line-height:1}
.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
.chips .btn{flex:none}
.chips .btn.on{background:var(--brass);color:var(--brass-ink);border-color:transparent}
.tag{font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;border:1px solid var(--line);color:var(--muted);flex:none}
.tag.me{color:var(--brass);border-color:var(--brass)}
.note{font-size:13px;color:var(--muted);line-height:1.5}
.online-bar.lan{margin-top:-12px}
.online-bar.lan .btn{min-height:44px}
.online-bar.lan .note{grid-column:1/-1;margin:0}
.codebox{display:flex;flex-direction:column;gap:10px;align-items:center}
.qr{background:#fff;padding:8px;border-radius:12px;width:min(78vw,300px);aspect-ratio:1;max-width:100%}
.qr svg{width:100%;height:100%;display:block}
.codebox details{width:100%;font-size:13px;color:var(--muted)}
.codebox summary{cursor:pointer;padding-block:4px}
.codetext{width:100%;font-size:11px;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:8px;color:var(--ink);resize:none;margin-block:6px;word-break:break-all}
.scanwrap{position:relative;width:100%;aspect-ratio:1;border-radius:14px;overflow:hidden;background:#000;max-width:100%}
.scanvid{width:100%;height:100%;object-fit:cover;display:block}
.scanframe{position:absolute;inset:14%;border:3px solid var(--brass);border-radius:12px;box-shadow:0 0 0 999px var(--shadow)}
#paste-code{flex:1;min-width:0;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:8px 10px;color:var(--ink);font-size:13px}
.home-find{position:sticky;top:-8px;z-index:3;display:flex;flex-direction:column;gap:8px;margin:0 -16px 12px;padding:8px 16px 8px;background:var(--bg)}.home-find::after{content:"";position:absolute;left:0;right:0;top:100%;height:12px;background:linear-gradient(var(--bg),transparent);pointer-events:none}
.home-search{width:100%;min-height:44px;border-radius:12px;border:1px solid var(--surface-2);background:var(--surface);color:var(--ink);font:inherit;font-size:16px;padding:0 14px}
.home-search::placeholder{color:var(--muted)}
.home-chips .btn{min-height:44px}
.home-chips{padding-bottom:0}
.badge-new{position:absolute;top:10px;right:10px;font-family:var(--f-mono);font-size:11px;font-weight:700;letter-spacing:.06em;padding:3px 6px;border-radius:6px;background:var(--brass);color:var(--brass-ink)}
.badge-fav{position:absolute;bottom:10px;right:14px;color:var(--brass);font-size:16px;line-height:1}
