/* 빙고 — party word bingo (people only).
   The players agree on a topic out loud (e.g. "과일"); the app only holds each player's own board.
   Phase 'fill': everyone types words into their own board (array actors). Online each phone edits
   locally and sends the whole board on 완료; on one phone the boards are filled one by one behind a
   pass-the-phone card. Phase 'call': players take turns calling one word; every board holding it is
   marked; whoever reaches the target number of lines first wins (several on the same call = shared win).
   Words are hidden info: the state keeps every board lightly scrambled, the view shows only the
   viewer's own board (everything is revealed at the end). */
(function () {
  'use strict';
  const L = window.Lounge, U = L.util;

  const MAXW = 10;            // characters per cell
  const TOPIC_MAX = 16;
  const WORDS_BUDGET = 1500;  // cost of all boards' words together (see checkBoard; keeps the state < 2500 chars / ~3 KB)
  const MISS_KEEP = 6;        // texts of calls nobody had (public), newest kept
  const MISS = 'zz';          // call-log code for a call nobody had
  const AUTO = { 3: 1, 4: 2, 5: 3 };
  const SVGNS = 'http://www.w3.org/2000/svg';

  /* ---------- text ---------- */
  function clean(t) { return String(t == null ? '' : t).normalize('NFC').replace(/[|\u0000-\u001f\u007f]/g, '').replace(/\s+/g, ' ').trim(); }
  function cut(t, n) { return [...clean(t)].slice(0, n || MAXW).join(''); }
  /* matching: ignore spaces and letter case only — any other difference makes it a different word */
  function norm(t) { return String(t == null ? '' : t).normalize('NFC').replace(/\s+/g, '').toLowerCase(); }
  function utf8Len(str) { let n = 0; for (const ch of str) { const c = ch.codePointAt(0); n += c < 0x80 ? 1 : c < 0x800 ? 2 : c < 0x10000 ? 3 : 4; } return n; }
  function checkBoard(words, N, bud) {
    const w = Array.from({ length: N }, (_, i) => cut(words && words[i]));
    const empty = [], dup = [], seen = {}, dupWords = [];
    w.forEach((x, i) => { const k = norm(x); if (!k) { empty.push(i); return; } (seen[k] = seen[k] || []).push(i); });
    Object.keys(seen).forEach((k) => { if (seen[k].length > 1) { dup.push(...seen[k]); dupWords.push(w[seen[k][0]]); } });
    const j = w.join('|'), bytes = Math.max(Math.ceil(utf8Len(j) * 0.75), j.length); // Hangul costs 2.25, ASCII 1
    return { w, empty, dup, dupWords, bytes, over: bytes > bud, ok: !empty.length && !dup.length && bytes <= bud };
  }

  /* ---------- light scrambling (keeps words out of plain sight; same byte size as the plain text) ---------- */
  function prng(seed) { let a = seed >>> 0; return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
  const mod = (a, n) => ((a % n) + n) % n;
  function keyFor(s, seat) { return (s.g ^ Math.imul(seat + 7, 0x9E3779B1)) >>> 0; }
  function scramble(str, key, dir) {
    const r = prng(key); let out = '';
    for (const ch of str) {
      const c = ch.codePointAt(0), k = (r() * 65536) | 0;
      if (c >= 0xAC00 && c <= 0xD7A3) out += String.fromCharCode(0xAC00 + mod(c - 0xAC00 + dir * k, 11172));
      else if (c >= 97 && c <= 122) out += String.fromCharCode(97 + mod(c - 97 + dir * k, 26));
      else if (c >= 65 && c <= 90) out += String.fromCharCode(65 + mod(c - 65 + dir * k, 26));
      else if (c >= 48 && c <= 57) out += String.fromCharCode(48 + mod(c - 48 + dir * k, 10));
      else out += ch;
    }
    return out;
  }
  const cellsOf = (s) => s.sz * s.sz;
  const fullMask = (sz) => (1 << (sz * sz)) - 1;
  function maskKey(s, seat) { return (keyFor(s, seat ^ 0x55) & fullMask(s.sz)) >>> 0; }
  function marksOf(s, seat) { return ((s.m[seat] ^ maskKey(s, seat)) & fullMask(s.sz)) >>> 0; }
  function setMarks(s, seat, mask) { s.m[seat] = ((mask ^ maskKey(s, seat)) & fullMask(s.sz)) >>> 0; }
  function posOff(s, seat) { return keyFor(s, seat + 31) % cellsOf(s); }
  function encBoard(s, seat, words) { return scramble(words.join('|'), keyFor(s, seat), 1); }
  function decBoard(s, seat) { const str = s.b[seat]; if (!str) return null; return scramble(str, keyFor(s, seat), -1).split('|'); }

  /* ---------- lines ---------- */
  const LM = {};
  function lineMasks(sz) {
    if (LM[sz]) return LM[sz];
    const out = [];
    for (let r = 0; r < sz; r++) { let m = 0; for (let c = 0; c < sz; c++) m |= 1 << (r * sz + c); out.push(m); }
    for (let c = 0; c < sz; c++) { let m = 0; for (let r = 0; r < sz; r++) m |= 1 << (r * sz + c); out.push(m); }
    let d = 0, a = 0;
    for (let i = 0; i < sz; i++) { d |= 1 << (i * sz + i); a |= 1 << (i * sz + (sz - 1 - i)); }
    out.push(d, a);
    return (LM[sz] = out);
  }
  function lineIdx(mask, sz) { const out = []; lineMasks(sz).forEach((m, i) => { if ((mask & m) === m) out.push(i); }); return out; }
  const countLines = (mask, sz) => lineIdx(mask, sz).length;

  /* ---------- called words ---------- */
  function calledList(s) {
    const out = [], N = cellsOf(s), cache = {};
    const codes = s.cl.match(/../g) || [];
    let mi = 0;
    codes.forEach((code) => {
      if (code === MISS) { out.push({ w: s.ms[mi++] || null, hit: false }); return; }
      const ref = parseInt(code, 36), seat = Math.floor(ref / N), pos = ref % N;
      const words = cache[seat] || (cache[seat] = decBoard(s, seat) || []);
      out.push({ w: words[mod(pos - posOff(s, seat), N)] || '?', hit: true });
    });
    return out;
  }
  function calledNorms(s) { return new Set(calledList(s).filter((c) => c.w != null).map((c) => norm(c.w))); }

  /* ---------- rules / state ---------- */
  function init(players, opts) {
    opts = opts || {};
    const n = players.length;
    const sz = [3, 4, 5].includes(opts.size) ? opts.size : 5;
    const tl = [1, 2, 3, 5].includes(opts.lines) ? opts.lines : AUTO[sz];
    const hm = players.map((p, i) => (p.ai ? -1 : i)).filter((i) => i >= 0);
    const s = { n, nm: players.map((p) => String(p.name || '').slice(0, 10)), hm, sz, tl, tp: '', ph: 'fill', g: Math.floor(Math.random() * 2e9),
      bud: Math.floor(WORDS_BUDGET / Math.max(2, hm.length)), b: players.map(() => ''), dn: players.map(() => 0), m: [],
      cu: -1, nc: 0, cl: '', ms: [], wn: [], why: '', seq: 0, last: null };
    s.m = players.map((_, i) => maskKey(s, i));
    if (hm.length < 2) s.ph = 'x';
    return s;
  }
  function nextSeat(s, seat) { const i = s.hm.indexOf(seat); return s.hm[(i + 1) % s.hm.length]; }
  function startCall(s) {
    s.ph = 'call'; s.cu = s.hm[U.rand(s.hm.length)];
    s.seq++; s.last = { id: s.seq, k: 'start', s: s.cu };
    return s;
  }
  function dropSeat(s, seat) {
    if (!s.hm.includes(seat) || (s.ph !== 'fill' && s.ph !== 'call')) return null;
    if (s.ph === 'call' && s.cu === seat) s.cu = nextSeat(s, seat);
    s.hm = s.hm.filter((x) => x !== seat);
    s.seq++; s.last = { id: s.seq, k: 'drop', s: seat };
    if (s.hm.length < 2) { s.ph = 'end'; s.wn = []; s.why = 'left'; s.cu = -1; }
    else if (s.ph === 'fill' && s.hm.every((i) => s.dn[i])) startCall(s);
    return s;
  }
  function actor(s) {
    if (s.ph === 'fill') return s.hm.slice();
    if (s.ph === 'call') return s.cu;
    return null;
  }
  function apply(s, seat, a) {
    if (!a || typeof a !== 'object') throw new Error('bad action');
    if (a.type === 'drop') { const r = dropSeat(s, seat); if (!r) throw new Error('cannot drop'); return r; }
    if (a.type === 'topic') {
      if (s.ph !== 'fill' || seat !== s.hm[0]) throw new Error('only the host writes the topic');
      s.tp = cut(a.t, TOPIC_MAX);
      return s;
    }
    if (a.type === 'board') {
      if (s.ph !== 'fill' || !s.hm.includes(seat)) throw new Error('not filling');
      if (!Array.isArray(a.w) || a.w.length !== cellsOf(s)) throw new Error('bad board');
      const chk = checkBoard(a.w, cellsOf(s), s.bud);
      if (!chk.ok) throw new Error('board not ready');
      s.b[seat] = encBoard(s, seat, chk.w); s.dn[seat] = 1;
      if (s.hm.every((i) => s.dn[i])) return startCall(s);
      s.seq++; s.last = { id: s.seq, k: 'done', s: seat };
      return s;
    }
    if (a.type === 'edit') {
      if (s.ph !== 'fill' || !s.hm.includes(seat)) throw new Error('not filling');
      s.dn[seat] = 0;
      return s;
    }
    if (a.type === 'call') {
      if (s.ph !== 'call' || seat !== s.cu) throw new Error('not your call');
      const w = cut(a.t), k = norm(w);
      if (!k) throw new Error('empty');
      if (calledNorms(s).has(k)) throw new Error('already called');
      const N = cellsOf(s), before = {};
      let ref = -1, hits = 0;
      s.hm.forEach((i) => {
        const words = decBoard(s, i) || [];
        const mk = marksOf(s, i); before[i] = countLines(mk, s.sz);
        const idx = words.findIndex((x) => norm(x) === k);
        if (idx >= 0 && !(mk & (1 << idx))) {
          setMarks(s, i, mk | (1 << idx)); hits++;
          if (ref < 0) ref = i * N + mod(idx + posOff(s, i), N);
        }
      });
      if (ref >= 0) s.cl += ref.toString(36).padStart(2, '0');
      else {
        s.cl += MISS; s.ms.push(w);
        while (s.ms.length > MISS_KEEP) { s.ms.shift(); const codes = s.cl.match(/../g); codes.splice(codes.indexOf(MISS), 1); s.cl = codes.join(''); }
      }
      s.nc++;
      const gl = s.hm.filter((i) => countLines(marksOf(s, i), s.sz) > before[i]);
      const win = s.hm.filter((i) => countLines(marksOf(s, i), s.sz) >= s.tl);
      s.seq++; s.last = { id: s.seq, k: 'call', s: seat, w, h: hits, gl };
      if (win.length) { s.ph = 'end'; s.wn = win; s.cu = -1; }
      else s.cu = nextSeat(s, seat);
      return s;
    }
    throw new Error('bad action');
  }
  function boardSeats(s) { return s.nm.map((_, i) => i).filter((i) => s.b[i]); }
  function result(s) {
    if (s.ph === 'x') return { winners: [], title: '빙고는 사람끼리만 할 수 있어요', text: '각자 판에 단어를 직접 채워야 해서 AI는 함께할 수 없어요.\n사람이 2명 이상 있어야 시작돼요.' };
    if (s.ph !== 'end') return null;
    const rows = boardSeats(s).map((i) => [i, countLines(marksOf(s, i), s.sz)]).sort((a, b) => b[1] - a[1]);
    const txt = rows.map(([i, l]) => s.nm[i] + ' ' + l + '줄' + (s.hm.includes(i) ? '' : ' (나감)')).join('\n');
    if (s.why === 'left') return { winners: [], title: '사람이 모자라 끝났어요', text: '사람이 2명보다 적어져서 게임을 끝냈어요.' + (txt ? '\n' + txt : '') };
    const head = (s.tp ? '주제 ‘' + s.tp + '’ · ' : '') + '목표 ' + s.tl + '줄 · ' + s.nc + '번 불렀어요';
    const has = (i) => !!s.b[i], pc = (m) => { let c = 0; for (; m; m >>>= 1) c += m & 1; return c; };
    const stats = [{ label: '완성 줄', values: s.nm.map((_, i) => (has(i) ? String(countLines(marksOf(s, i), s.sz)) : '—')) },
      { label: '지운 칸', values: s.nm.map((_, i) => (has(i) ? pc(marksOf(s, i)) + '/' + s.sz * s.sz : '—')) }];
    return { winners: s.wn.slice(), stats, title: s.wn.length === 1 ? s.nm[s.wn[0]] + ' 빙고!' : '공동 빙고! (' + s.wn.length + '명)', text: head + '\n' + txt };
  }

  /* ---------- view ---------- */
  const CSS = `
