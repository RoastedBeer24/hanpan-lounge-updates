      logp(ns, '오늘 · ' + e.nm + ' — ' + e.d);
      if (e.tax) { const t = Math.max(10, Math.round(Math.max(0, ns.money) * e.tax)); ns.money -= t; ns.tot.cost += t; logp(ns, '세금 은화 ' + t + ' 냄'); }
      if (e.frost) { const live = ns.plots.map((p, i) => (p && p.g < CR[p.c].days ? i : -1)).filter((i) => i >= 0); if (live.length) { const i = live[Math.floor(Math.random() * live.length)]; logp(ns, '서리로 ' + CR[ns.plots[i].c].nm + ' 이랑이 상함'); ns.plots[i] = null; } }
    }
    ns.lab = labMax(ns); ns.rdy = Array(ns.n).fill(0); ns.ph = 'morn'; ns.seq++;
    logp(ns, ns.day + '일째 아침 · ' + S.nm);
    return ns;
  }

  /* ======================= 관리 AI (아침 · 밤 계획) =======================
     계획은 순수 함수: 상태 복사본에 mg를 차례로 해 보며 성공한 행동만 모은다. lv 1 쉬움(어림 · 엉뚱한 고르기) · 2 보통 · 3 어려움(수요 · 숙성 · 손익을 꼼꼼히). */
  function habitsOf(seed, s) { const R = prng((seed ^ Math.imul(s + 1, 2654435761)) >>> 0); return { bar: R(), kit: R(), cln: R(), brave: R(), spend: R(), thrift: R(), nz: R() }; }
  function demandMix(st) {
    // 오늘 손님 종류 기대 비율로 술 · 요리 선호 가중
    const lv = lvOf(st.xp), ss = ssnOf(st), e = EV[st.ev], dr = {}, fd = {};
    for (const g of GUEST) {
      if (g.rep > lv && !(e && e.mix && e.mix[g.id])) continue;
      const w = g.sw[ss] * (e && e.mix && e.mix[g.id] ? 1 + e.mix[g.id] : 1);
      let s = 0; for (const k in g.dr) s += g.dr[k];
      for (const k in g.dr) dr[k] = (dr[k] || 0) + w * g.pd * g.dr[k] / s;
      s = 0; for (const k in g.fd) s += g.fd[k];
      for (const k in g.fd) fd[k] = (fd[k] || 0) + w * g.pf * g.fd[k] / s;
    }
    return { dr, fd };
  }
  function plan(st, lv, R, hab) {
    R = R || Math.random; hab = hab || { spend: 0.5, thrift: 0.5, nz: 0.5 };
    const s = JSON.parse(JSON.stringify(st)), acts = [];
    const tryA = (a) => { try { mg(s, -1, a); acts.push(a); return true; } catch (e) { return false; } };
    const noise = lv === 1 ? 0.6 : lv === 2 ? 0.2 : 0.05;
    const jit = () => 1 + (R() - 0.5) * 2 * noise;
    const reserve = () => 12 + (lv === 3 ? 10 : 0);
    const buyFor = (need, mult) => {
      for (const it in need) { const lack = need[it] * (mult || 1) - (s.inv[it] || 0); if (lack > 0) { const c = price(s, it) * lack; if (s.money - c < reserve()) return false; if (!tryA({ k: 'buy', it, n: lack })) return false; } }
      return true;
    };
    if (s.ph === 'morn') {
      // 1) 거두기
      s.plots.forEach((p, i) => { if (p && p.g >= CR[p.c].days) tryA({ k: 'harvest', i }); });
      // 2) 청소
      if (s.clean < (lv === 1 ? 40 : lv === 2 ? 62 : 72) && s.lab >= 2 + Math.min(3, s.n)) tryA({ k: 'clean' });
      const E = expGuests(s), mix = demandMix(s);
      // 3) 술: 빈 통 채우기
      const onTap = () => s.ck.reduce((a, c) => a + (cReady(c) ? c.sv : 0), 0);
      const soon = () => s.ck.reduce((a, c) => a + (c && !cReady(c) && DR[c.r].days - c.d <= 1 ? c.sv : 0), 0);
      if (lv >= 2) s.ck.forEach((c, i) => { if (cReady(c) && c.sv <= (lv === 3 ? 3 : 2) && s.ck.filter((x) => !x).length === 0) tryA({ k: 'dump', i }); });
      for (let i = 0; i < s.ck.length && s.lab > 0; i++) {
        if (s.ck[i]) continue;
        const cand = unlockedD(s).map((D) => {
          const have = s.ck.filter((c) => c && c.r === D.id).length;
          let sc = (mix.dr[D.id] || 0.05) * D.p * D.sv / (1 + have * 0.9) - needCost(s, D.need) * 0.6 - D.days * (lv === 3 ? 2.5 : 1.2);
          if (s.day + D.days > s.days + (lv === 3 ? 0 : 1)) sc -= 60;   // 판이 끝나기 전에 익지 않음
          return { D, sc: sc * jit() };
        }).sort((a, b) => b.sc - a.sc);
        let pick = cand[0];
        if (lv === 1 && R() < 0.3) pick = cand[Math.floor(R() * cand.length)];
        if (!pick || pick.sc < -40) break;
        const D = pick.D;
        if (!hasNeed(s, D.need) && !buyFor(D.need)) continue;
        tryA({ k: 'brew', i, r: D.id });
      }
      // 맥아 미리 말리기(보리가 싸면)
      if (s.lab > 1 && s.kiln === 0 && lv >= 2 && s.day < s.days - 1) {
        const want = Math.min(kilnCap(s), 8);
        const lack = want - (s.inv.barley || 0);
        if ((s.inv.malt || 0) < 7 && (lack <= 0 || s.money - lack * price(s, 'barley') > reserve() + 40)) { if (lack > 0) tryA({ k: 'buy', it: 'barley', n: lack }); tryA({ k: 'malt', n: want }); }
      } else if (lv === 1 && s.inv.barley >= 4 && s.lab > 2 && R() < 0.5) tryA({ k: 'malt' });
      // 4) 요리: 예상 요리 수요만큼
      let foodNeed = Math.round(E * (lv === 1 ? 0.55 + R() * 0.4 : 0.78) * jit());
      let stock = DISH.reduce((a, d) => a + dishStock(s, d.id), 0);
      let guard = 0;
      while (stock < foodNeed && s.lab > (lv === 3 ? 1 : 0) && guard++ < 6) {
        const cand = unlockedF(s).map((D) => {
          const have = dishStock(s, D.id);
          const sc = (mix.fd[D.id] || 0.05) * D.p * D.n / (1 + have / D.n) - needCost(s, D.need) * 0.8;
          return { D, sc: sc * jit() };
        }).sort((a, b) => b.sc - a.sc);
        let pick = cand[0];
        if (lv === 1 && R() < 0.3) pick = cand[Math.floor(R() * cand.length)];
        if (!pick) break;
        const D = pick.D;
        if (!hasNeed(s, D.need) && !buyFor(D.need)) { if (cand.length < 2) break; const alt = cand.find((c) => hasNeed(s, c.D.need)); if (!alt || !tryA({ k: 'prep', r: alt.D.id })) break; stock = DISH.reduce((a, d) => a + dishStock(s, d.id), 0); continue; }
        if (!tryA({ k: 'prep', r: D.id })) break;
        stock = DISH.reduce((a, d) => a + dishStock(s, d.id), 0);
      }
      // 5) 텃밭
      if (SEASONS[ssnOf(s)].grow > 0) {
        for (let i = 0; i < s.plots.length && s.lab > 0; i++) {
          if (s.plots[i]) continue;
          const left = s.days - s.day;
          const opts = CROP.filter((C) => C.days / SEASONS[ssnOf(s)].grow <= left).map((C) => {
            let sc = C.y * (ING[C.id] ? ING[C.id].p : 2) - C.seed;
            if (C.id === 'barley' || C.id === 'hops') sc *= 1.25;
            return { C, sc: sc * jit() };
          }).sort((a, b) => b.sc - a.sc);
          if (!opts.length) break;
          if (s.money - opts[0].C.seed < reserve()) break;
          tryA({ k: 'plant', i, c: opts[0].C.id });
        }
      }
      void onTap; void soon;
    } else if (s.ph === 'night') {
      const lvl = lvOf(s.xp), rpt = s.rpt || {};
      const left = s.days - s.day;
      const keep = 50 + (lv === 3 ? 20 : 0) + hab.thrift * 30;
      const opts = [];
      const upNext = (id) => { const U = UP[id], l = upLv(s, id); return U.lv[l] && (U.lv[l].rep || 1) <= lvl ? U.lv[l] : null; };
      const add = (k, id, p, val) => { if (p != null) opts.push({ a: { k, id }, p, v: val * jit() }); };
      if (left > 0) {
        let u;
        if ((u = upNext('cask'))) add('up', 'cask', u.p, 70 + (s.ck.every((c) => c) ? 40 : 0));
        if ((u = upNext('tray'))) add('up', 'tray', u.p, 60);
        if ((u = upNext('hall'))) add('up', 'hall', u.p, 55 + (rpt.lost || 0) * 8);
        if ((u = upNext('ware'))) add('up', 'ware', u.p, 30 + (rpt.served > 18 ? 25 : 0));
        if ((u = upNext('beds'))) add('up', 'beds', u.p, 20 + Math.max(0, (rpt.req || 0) - (rpt.beds || 2)) * 18);
        if ((u = upNext('linen'))) add('up', 'linen', u.p, 18 + bedCap(s) * 6);
        if ((u = upNext('oven'))) add('up', 'oven', u.p, 25);
        if ((u = upNext('kettle'))) add('up', 'kettle', u.p, 30);
        if ((u = upNext('plots')) && left > 5) add('up', 'plots', u.p, 15);
        if ((u = upNext('kiln')) && left > 4) add('up', 'kiln', u.p, 10);
        for (const D of DECO) if (!s.deco.includes(D.id) && D.rep <= lvl) add('deco', D.id, D.p, (D.c * 9 + D.a * 8) * (1 + Math.min(1, left / 6)) - D.p * 0.15);
        if (!s.staff.includes('scullion') && left > 1) opts.push({ a: { k: 'hire', id: 'scullion' }, p: 0, v: (s.n <= 2 ? 40 : 20) * jit(), wage: 5 });
        if (!s.staff.includes('hand') && left > 1 && lvl >= 2) opts.push({ a: { k: 'hire', id: 'hand' }, p: 0, v: 30 * jit(), wage: 7 });
        if (!s.staff.includes('bouncer') && left > 1 && lvl >= 2 && (rpt.brawl || 0) > 0) opts.push({ a: { k: 'hire', id: 'bouncer' }, p: 0, v: 45 * jit(), wage: 9 });
        if (!s.staff.includes('cookhand') && left > 1 && lvl >= 3) opts.push({ a: { k: 'hire', id: 'cookhand' }, p: 0, v: 25 * jit(), wage: 8 });
      }
      opts.sort((a, b) => b.v / Math.max(30, b.p || 30) - a.v / Math.max(30, a.p || 30));
      let n = 0;
      for (const o of opts) {
        if (n >= (lv === 1 ? 2 : 4)) break;
        if (o.v <= 0) continue;
        if (o.wage) { if (s.money < keep + o.wage * 3) continue; }
        else if (s.money - o.p < keep) continue;
        if (lv === 1 && R() < 0.35) continue;
        if (tryA(o.a)) n++;
      }
    }
    return acts;
  }

  /* ======================= 결과 · 도움말 ======================= */
  function result(s) {
    if (!s || s.ph !== 'done') return null;
    const lv = lvOf(s.xp), ok = lv >= s.goal, T = s.tot;
    const all = [...Array(s.n).keys()];
    const net = T.inc + T.tip + T.room - T.cost;
    const best = s.hist.reduce((b, h) => (h[1] > b[1] ? h : b), [0, 0]);
    return {
      winners: ok ? all : [],
      title: ok ? '목표 달성 · ' + LEVELS[lv - 1].nm : '영업 마감 · ' + LEVELS[lv - 1].nm,
      text: s.days + '일 영업 · 목표 명성 ' + s.goal + '단계(' + LEVELS[s.goal - 1].nm + ')' + (ok ? ' 달성' : ' 미달') + '\n남은 은화 ' + s.money + ' · 받은 손님 ' + T.g + '명 · 놓친 손님 ' + T.lost + '명',
      highlights: [
        '명성 ' + lv + '단계 「' + LEVELS[lv - 1].nm + '」 · 명성 점수 ' + s.xp,
        '가장 잘된 날 · ' + best[0] + '일째 수입 ' + best[1],
        '꾸민 것 ' + s.deco.length + '가지 · 일꾼 ' + s.staff.length + '명 · 침대 ' + bedCap(s) + '개',
        T.brawl ? '싸움 ' + T.brawl + '번' : '싸움 없이 마감',
      ],
      stats: [
        { label: '내준 술 · 음식', values: T.srv.map((v) => String(v)) },
        { label: '영업 매출', value: String(T.inc) }, { label: '팁', value: String(T.tip) }, { label: '방값', value: String(T.room) },
        { label: '쓴 돈', value: String(T.cost) }, { label: '순이익', value: String(net) },
      ],
    };
  }
  const PH_NM = { morn: '아침 준비', svc: '저녁 영업', night: '밤 결산', done: '마감' };
  function hint(st, seat) {
    if (!st) return null;
    const lv = lvOf(st.xp), out = [st.day + '일째 · ' + SEASONS[ssnOf(st)].nm + ' · ' + PH_NM[st.ph] + ' · 명성 ' + lv + '단계(' + LEVELS[lv - 1].nm + ')'];
    if (st.ev && EV[st.ev]) out.push('오늘 사건: ' + EV[st.ev].nm + ' — ' + EV[st.ev].d);
    if (st.ph === 'morn') {
      out.push('남은 일손 ' + st.lab + ' · 은화 ' + st.money + ' · 예상 손님 약 ' + expGuests(st) + '명');
      const tap = st.ck.filter(cReady).map((c) => DR[c.r].nm + ' ' + c.sv + '잔').join(' · ');
      out.push('꼭지 단 술: ' + (tap || '없음 — 오늘 밤 팔 술이 없음'));
      out.push('요리 몫: ' + (DISH.filter((d) => dishStock(st, d.id)).map((d) => d.nm + ' ' + dishStock(st, d.id)).join(' · ') || '없음 — 주방에서 밑준비'));
      out.push('다 되면 「영업 시작」. 막히면 「맡기기」가 오늘 준비를 대신 짜 줌.');
    } else if (st.ph === 'svc') {
      out.push('술통에서 따르고(잔 필요) · 솥/찬장에서 담고 · 화덕에 굽고(접시 필요) · 손님 자리에 내주기.');
      out.push('떠난 자리의 빈 그릇은 설거지통으로 · 쏟은 술은 닦기 · 붉은 표시 손님은 달래기.');
      out.push('조작: 왼쪽 아래 이동 막대(또는 눌러서 걷기) · 오른쪽 아래 버튼(E) 쓰기 · 버리기(Q).');
    } else if (st.ph === 'night') {
      const r = st.rpt; if (r) out.push('오늘 손님 ' + r.served + '명 · 순이익 ' + r.net + ' · 객실 ' + r.rooms + '/' + r.req);
      out.push('확장 · 꾸미기 · 일꾼을 들인 뒤 「다음 날로」.');
      if (st.evN && EV[st.evN]) out.push('내일 사건: ' + EV[st.evN].nm);
    }
    void seat;
    return out.slice(0, 6);
  }
  const saveLabel = (s) => s.day + '일째 ' + PH_NM[s.ph] + ' · 은화 ' + s.money + ' · ' + LEVELS[lvOf(s.xp) - 1].nm;

  /* ======================= 아이콘 (SVG, 이모지 없음) ======================= */
