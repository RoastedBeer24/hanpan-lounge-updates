  function preview(cv) {
    const g = cv.getContext('2d'), w = cv.width, h = cv.height;
    const bg = g.createLinearGradient(0, 0, 0, h); bg.addColorStop(0, '#1d140e'); bg.addColorStop(1, '#3a2616'); g.fillStyle = bg; g.fillRect(0, 0, w, h);
    // 뒷벽 돌
    g.fillStyle = '#2c2420'; g.fillRect(0, 0, w, h * 0.55);
    for (let y = 0; y < h * 0.55; y += 22) for (let x = (y / 22) % 2 ? -20 : 0; x < w; x += 46) { g.fillStyle = 'rgba(255,230,200,' + (0.03 + ((x * 7 + y * 3) % 5) * 0.008) + ')'; g.fillRect(x + 2, y + 2, 42, 18); }
    // 난로 불빛
    const fx = w * 0.22, fy = h * 0.45;
    const gl = g.createRadialGradient(fx, fy, 6, fx, fy, w * 0.5); gl.addColorStop(0, 'rgba(255,170,80,.75)'); gl.addColorStop(0.3, 'rgba(230,110,40,.25)'); gl.addColorStop(1, 'rgba(0,0,0,0)');
    g.fillStyle = '#1a120c'; g.fillRect(fx - 70, fy - 70, 140, 100); g.fillStyle = '#4a3a30'; g.fillRect(fx - 84, fy - 86, 168, 18);
    g.fillStyle = '#ffb347'; g.beginPath(); g.moveTo(fx - 30, fy + 28); g.quadraticCurveTo(fx - 18, fy - 30, fx, fy - 46); g.quadraticCurveTo(fx + 20, fy - 26, fx + 30, fy + 28); g.fill();
    g.fillStyle = '#ffe2a0'; g.beginPath(); g.moveTo(fx - 14, fy + 28); g.quadraticCurveTo(fx - 4, fy - 6, fx + 2, fy - 22); g.quadraticCurveTo(fx + 10, fy - 4, fx + 14, fy + 28); g.fill();
    g.fillStyle = gl; g.fillRect(0, 0, w, h);
    // 바닥
    g.fillStyle = '#4a3220'; g.fillRect(0, h * 0.55, w, h * 0.45);
    for (let x = -40; x < w + 40; x += 34) { g.strokeStyle = 'rgba(0,0,0,.25)'; g.beginPath(); g.moveTo(x, h * 0.55); g.lineTo(x - 60, h); g.stroke(); }
    // 술통
    for (let i = 0; i < 3; i++) { const x = w * 0.62 + i * 64, y = h * 0.36; g.fillStyle = '#6b4424'; g.beginPath(); g.ellipse(x, y, 28, 34, 0, 0, Math.PI * 2); g.fill(); g.strokeStyle = '#2a2a2a'; g.lineWidth = 4; g.beginPath(); g.ellipse(x, y, 28, 34, 0, 0, Math.PI * 2); g.stroke(); g.beginPath(); g.moveTo(x - 27, y - 12); g.lineTo(x + 27, y - 12); g.moveTo(x - 27, y + 12); g.lineTo(x + 27, y + 12); g.stroke(); }
    // 식탁 · 잔 · 촛불
    g.fillStyle = '#5c3a20'; g.fillRect(w * 0.36, h * 0.68, w * 0.4, 20); g.fillStyle = '#3e2714'; g.fillRect(w * 0.38, h * 0.68 + 20, 12, 60); g.fillRect(w * 0.73, h * 0.68 + 20, 12, 60);
    for (let i = 0; i < 3; i++) { const x = w * 0.42 + i * 70, y = h * 0.6; g.fillStyle = '#6b4a2c'; g.fillRect(x, y, 26, 34); g.fillStyle = '#e6dcc4'; g.fillRect(x - 1, y - 4, 28, 7); g.strokeStyle = '#6b4a2c'; g.lineWidth = 4; g.beginPath(); g.arc(x + 28, y + 16, 8, -1.2, 1.2); g.stroke(); }
    const cx = w * 0.58, cy = h * 0.6; g.fillStyle = '#efe4c6'; g.fillRect(cx - 4, cy - 20, 8, 22); g.fillStyle = '#ffcf6a'; g.beginPath(); g.ellipse(cx, cy - 26, 4, 8, 0, 0, Math.PI * 2); g.fill();
    const cg = g.createRadialGradient(cx, cy - 24, 2, cx, cy - 24, 90); cg.addColorStop(0, 'rgba(255,200,110,.45)'); cg.addColorStop(1, 'rgba(0,0,0,0)'); g.fillStyle = cg; g.fillRect(0, 0, w, h);
    // 제목
    g.fillStyle = 'rgba(15,10,6,.55)'; g.fillRect(0, h - 64, w, 64);
    g.fillStyle = '#f0e2c0'; g.font = '30px "Nanum Myeongjo","Noto Serif KR",Batang,serif'; g.textBaseline = 'middle'; g.fillText('여관 주인', 24, h - 32);
    g.font = '14px "IBM Plex Sans KR",sans-serif'; g.fillStyle = 'rgba(240,226,192,.75)'; g.fillText('양조 · 요리 · 저녁 영업 · 객실 — 1~4명 협동', 170, h - 30);
  }

