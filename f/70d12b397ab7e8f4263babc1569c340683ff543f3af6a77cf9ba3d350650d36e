  const ING_COL = { barley: '#c8a85a', malt: '#9a6b30', hops: '#7c9a3a', honey: '#e0a52e', apple: '#b8432e', potato: '#a68350', onion: '#c9a173', meat: '#b55a4a', fish: '#7f95a0', flour: '#e9e1cc', cheese: '#e3c25a', herb: '#5f8a3a' };
  /* 그림 아이콘: 이 PC에서 생성(sd_xl_base_1.0)해 배경을 지운 96px webp — assets/tavern/icons/<키>.webp. 그림이 없는 키는 위 SVG로 그린다. */
