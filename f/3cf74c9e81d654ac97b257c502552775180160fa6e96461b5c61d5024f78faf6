  /* ---------------- init · actor · apply · result ---------------- */
  const START = ['coin', 'coin', 'cherry', 'flower', 'shell'];
  function newPlayer() { return { c: 1, b: START.map((k) => [K[k], 0, 0]), sp: 0, ri: 0, due: 0, ph: 'spin', of: null, io: null, it: [], rm: 1, rr: 1, rrn: 0, pi: 0, last: null, tot: 0, best: 0, got: 0 }; }
  function init(players, opts) {
