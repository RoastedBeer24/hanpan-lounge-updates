      b.fillStyle = RED; b.beginPath(); b.arc(o, o, R_BULL * k, 0, 7); b.fill();
      // sisal texture
      b.save(); b.beginPath(); b.arc(o, o, R_DOUT * k, 0, 7); b.clip();
      for (let i = 0; i < 900; i++) {
        const a = Math.random() * 7, rr_ = Math.sqrt(Math.random()) * R_DOUT * k;
        b.fillStyle = Math.random() < 0.5 ? 'rgba(255,255,255,.05)' : 'rgba(0,0,0,.08)';
        b.fillRect(o + Math.cos(a) * rr_, o + Math.sin(a) * rr_, 1, 1);
      }
      b.restore();
      // wires
      const wire = (w) => { b.strokeStyle = '#c9ccd2'; b.lineWidth = w; };
      wire(Math.max(0.7, k * 1.1));
      for (let i = 0; i < 20; i++) {
        const a = (-90 + i * 18 - 9) * DEG;
        b.beginPath(); b.moveTo(o + Math.cos(a) * R_OBULL * k, o + Math.sin(a) * R_OBULL * k);
        b.lineTo(o + Math.cos(a) * R_DOUT * k, o + Math.sin(a) * R_DOUT * k); b.stroke();
      }
      for (const r of [R_BULL, R_OBULL, R_TIN, R_TOUT, R_DIN, R_DOUT]) { b.beginPath(); b.arc(o, o, r * k, 0, 7); b.stroke(); }
      // number ring wire
      wire(Math.max(1, k * 1.6)); b.beginPath(); b.arc(o, o, (R_DOUT + 6) * k, 0, 7); b.stroke();
      // numbers
      b.fillStyle = '#f3ead6'; b.textAlign = 'center'; b.textBaseline = 'middle';
      b.font = '700 ' + Math.max(9, Math.round(k * 21)) + 'px "IBM Plex Sans KR", "IBM Plex Mono", system-ui, sans-serif';
      for (let i = 0; i < 20; i++) {
        const a = (-90 + i * 18) * DEG;
        b.fillText(String(SECT[i]), o + Math.cos(a) * R_NUM * k, o + Math.sin(a) * R_NUM * k + 0.5);
      }
      // subtle top-left sheen
      const sh = b.createRadialGradient(o - R_DOUT * k * 0.5, o - R_DOUT * k * 0.6, 0, o, o, R_SURR * k);
      sh.addColorStop(0, 'rgba(255,255,255,.08)'); sh.addColorStop(0.6, 'rgba(255,255,255,0)');
      b.fillStyle = sh; b.beginPath(); b.arc(o, o, R_SURR * k, 0, 7); b.fill();
      boardImg = { c, size, o };
    }
    function rr(c, x, y, w, h, r) { c.beginPath(); if (c.roundRect) c.roundRect(x, y, w, h, r); else c.rect(x, y, w, h); }

    /* ---- dart sprite: tip at (x,y), body angled toward the viewer ---- */
    function drawDart(x, y, s, col, shadow) {
      const dx = 0.42, dy = 1; const len = 30 * s;
      const n = Math.hypot(dx, dy), ux = dx / n, uy = dy / n, nx = -uy, ny = ux;
      ctx.save();
      ctx.lineCap = 'round';
      if (shadow) { ctx.strokeStyle = 'rgba(0,0,0,.4)'; ctx.lineWidth = 3 * s; ctx.beginPath(); ctx.moveTo(x + 1, y + 2); ctx.lineTo(x + 1 + ux * len * 0.85 + 6 * s, y + 2 + uy * len * 0.55); ctx.stroke(); }
      const p = (t, o2) => [x + ux * len * t + nx * o2, y + uy * len * t + ny * o2];
      // point
      ctx.strokeStyle = '#d9dde3'; ctx.lineWidth = 1.2 * s;
      ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(...p(0.22, 0)); ctx.stroke();
      // barrel
      ctx.strokeStyle = '#7c838d'; ctx.lineWidth = 3.6 * s;
      ctx.beginPath(); ctx.moveTo(...p(0.22, 0)); ctx.lineTo(...p(0.52, 0)); ctx.stroke();
      ctx.strokeStyle = '#c8ced6'; ctx.lineWidth = 1.2 * s;
      ctx.beginPath(); ctx.moveTo(...p(0.24, -0.8 * s)); ctx.lineTo(...p(0.5, -0.8 * s)); ctx.stroke();
      // shaft
      ctx.strokeStyle = '#1e1a24'; ctx.lineWidth = 2 * s;
      ctx.beginPath(); ctx.moveTo(...p(0.52, 0)); ctx.lineTo(...p(0.78, 0)); ctx.stroke();
      // flights
      ctx.fillStyle = col; ctx.strokeStyle = 'rgba(0,0,0,.5)'; ctx.lineWidth = 0.8;
      for (const sd of [-1, 1]) {
        ctx.beginPath(); ctx.moveTo(...p(0.66, 0)); ctx.lineTo(...p(0.8, sd * 6.5 * s)); ctx.lineTo(...p(1, sd * 6.5 * s)); ctx.lineTo(...p(1, 0)); ctx.closePath(); ctx.fill(); ctx.stroke();
      }
      ctx.beginPath(); ctx.moveTo(...p(0.7, 0)); ctx.lineTo(...p(1.02, 0)); ctx.strokeStyle = col; ctx.lineWidth = 2.2 * s; ctx.stroke();
      ctx.restore();
    }

    function swayAt(t) {
      // hand gets shaky after holding too long
      const held = ptr ? (t - ptr.t0) : 0;
      const A = AIM.swayA * U.clamp((held - AIM.swayAfter) / (AIM.swayFull - AIM.swayAfter), 0, 1);
      if (!A) return { x: 0, y: 0, a: 0 };
      return { x: A * (0.75 * Math.sin(1.3 * t) + 0.25 * Math.sin(3.1 * t + 0.7)), y: A * (0.75 * Math.sin(1.9 * t + 0.4) + 0.25 * Math.sin(2.7 * t + 2.1)), a: A };
    }
    function humanTurn() {
      const a = st ? actor(st) : null;
      if (a == null || !api.canAct(a) || anim) return false;
      return !(st.seq === waitSeq && performance.now() < waitUntil);
    }
    /* current aim (mm) for the active pull, or null if the pull is in the cancel zone */
    function curAim() {
      if (!ptr) return null;
      if (Math.hypot(ptr.x - ptr.ax, ptr.y - ptr.ay) < AIM.lmin) return null; // finger back on the dart: cancel
      const a = aimFromPull(ptr.vx, ptr.vy, G.span);
      if (!a) return null;
      const sw = swayAt(time);
      return { x: a.x + sw.x, y: a.y + sw.y, f: a.f, shaky: sw.a > 0.5 };
    }

    /* ---- drawing ---- */
    function draw() {
      cv.clear();
      if (!G || !boardImg) return;
      const { W, H } = G;
      const bg = ctx.createLinearGradient(0, 0, 0, H);
      bg.addColorStop(0, '#1d1727'); bg.addColorStop(1, '#120e18');
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
      // board
      ctx.drawImage(boardImg.c, G.cx - boardImg.o, G.cy - boardImg.o, boardImg.size, boardImg.size);
      // stuck darts
      for (const d of disp) drawDart(px(d.x), py(d.y), 1, d.c, true);
      const human = humanTurn();
      drawZone(human);
      if (human && ptr) drawAim();
      // flying dart
      if (anim && anim.phase === 'fly') {
        const p = Math.min(1, anim.t / anim.dur);
        const q = arcPt(anim.A, { x: px(anim.x), y: py(anim.y) }, p);
        drawDart(q.x, q.y, q.s, anim.c, false);
      }
      // popups
      for (const pp of pops) {
        const a = pp.t < 0.15 ? pp.t / 0.15 : pp.t > pp.life - 0.3 ? Math.max(0, (pp.life - pp.t) / 0.3) : 1;
        const rise = Math.min(1, pp.t / 0.25) * 18;
        const x = U.clamp(U.lerp(W / 2, pp.x, 0.35), 90, W - 90), y = G.zoneTop + 84 - rise;
        ctx.save(); ctx.globalAlpha = a;
        ctx.font = '400 22px "Black Han Sans", "IBM Plex Sans KR", sans-serif';
        const tw = ctx.measureText(pp.text).width;
        ctx.font = '700 13px "IBM Plex Sans KR", sans-serif';
        const sw2 = pp.sub ? ctx.measureText(pp.sub).width : 0;
        const bw = Math.max(tw, sw2) + 24, bh = pp.sub ? 50 : 34;
        ctx.fillStyle = 'rgba(18,14,24,.6)'; rr(ctx, x - bw / 2, y - bh / 2, bw, bh, 12); ctx.fill();
        ctx.strokeStyle = pp.col; ctx.lineWidth = 2; ctx.stroke();
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillStyle = pp.col; ctx.font = '400 22px "Black Han Sans", "IBM Plex Sans KR", sans-serif';
        ctx.fillText(pp.text, x, y - (pp.sub ? 8 : 0) + 1);
        if (pp.sub) { ctx.fillStyle = '#ab9fb8'; ctx.font = '700 13px "IBM Plex Sans KR", sans-serif'; ctx.fillText(pp.sub, x, y + 16); }
        ctx.restore();
      }
    }

    function drawAim() {
      const seat = actor(st), col = api.players[seat].color;
      const an = { x: ptr.ax, y: ptr.ay };
      const aim = curAim();
      const A = aim ? { x: an.x + ptr.vx, y: an.y + ptr.vy } : { x: ptr.x, y: ptr.y };
      // anchor + cancel ring
      ctx.save();
      ctx.setLineDash([3, 4]); ctx.lineWidth = 1.5;
      ctx.strokeStyle = aim ? 'rgba(171,159,184,.45)' : 'rgba(238,106,85,.9)';
      ctx.beginPath(); ctx.arc(an.x, an.y, AIM.lmin, 0, 7); ctx.stroke();
      ctx.setLineDash([]);
      // elastic band
      ctx.strokeStyle = 'rgba(227,174,69,.55)'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(an.x - 14, an.y); ctx.lineTo(A.x, A.y); ctx.lineTo(an.x + 14, an.y); ctx.stroke();
      ctx.restore();
      if (aim) {
        const B = { x: px(aim.x), y: py(aim.y) };
        // dotted parabola
        const N = 26;
        for (let i = 1; i <= N; i++) {
          const t = i / N, q = arcPt(A, B, t);
          ctx.fillStyle = 'rgba(255,233,176,' + (0.9 - 0.45 * t).toFixed(2) + ')';
          ctx.beginPath(); ctx.arc(q.x, q.y, U.lerp(3.2, 1.4, t), 0, 7); ctx.fill();
        }
        // uncertainty circle (≈86% of throws land inside: radius 2σ)
        const rc = 2 * AIM.sig * G.k;
        ctx.fillStyle = aim.shaky ? 'rgba(238,106,85,.18)' : 'rgba(255,233,176,.16)'; ctx.beginPath(); ctx.arc(B.x, B.y, rc, 0, 7); ctx.fill();
        ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(0,0,0,.55)'; ctx.beginPath(); ctx.arc(B.x, B.y, rc, 0, 7); ctx.stroke();
        ctx.lineWidth = 1.5; ctx.strokeStyle = aim.shaky ? '#ee6a55' : '#ffe9b0'; ctx.beginPath(); ctx.arc(B.x, B.y, rc, 0, 7); ctx.stroke();
        ctx.lineWidth = 1.2; ctx.beginPath(); ctx.moveTo(B.x - 4, B.y); ctx.lineTo(B.x + 4, B.y); ctx.moveTo(B.x, B.y - 4); ctx.lineTo(B.x, B.y + 4); ctx.stroke();
        // predicted bed chip
        const sc = score(aim.x, aim.y);
        const lab = sc.m === 3 ? 'T' + sc.n : sc.m === 2 ? (sc.p === 50 ? '불' : 'D' + sc.n) : sc.p === 0 ? '빗나감' : String(sc.p);
        ctx.font = '700 13px "IBM Plex Mono", "IBM Plex Sans KR", monospace';
        const tw = ctx.measureText(lab).width + 14;
        let lx = B.x + rc + 8, ly = B.y - 11;
        if (lx + tw > G.W - 4) lx = B.x - rc - 8 - tw;
        ly = U.clamp(ly, G.topH + 2, G.zoneTop - 24);
        ctx.fillStyle = 'rgba(18,14,24,.88)'; rr(ctx, lx, ly, tw, 22, 8); ctx.fill();
        ctx.strokeStyle = 'rgba(227,174,69,.7)'; ctx.lineWidth = 1; ctx.stroke();
        ctx.fillStyle = '#ffe9b0'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(lab, lx + tw / 2, ly + 11.5);
      }
      drawDart(A.x, A.y, 1.9, col, false);
    }

    function drawZone(human) {
      const { W, zoneTop, zoneH } = G;
      // oche ledge
      const lg = ctx.createLinearGradient(0, zoneTop, 0, zoneTop + zoneH);
      lg.addColorStop(0, '#2a2236'); lg.addColorStop(1, '#1a1522');
      ctx.fillStyle = lg; ctx.fillRect(0, zoneTop, W, zoneH);
      ctx.fillStyle = 'rgba(227,174,69,.55)'; ctx.fillRect(0, zoneTop, W, 2);
      ctx.fillStyle = 'rgba(0,0,0,.3)'; ctx.fillRect(0, zoneTop + 2, W, 3);
      if (!st || !hudSt) return;
      const hs = hudSt, cur = actor(hs);
      // status line: round (left) · checkout (centre) · this visit (right)
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'left'; ctx.fillStyle = '#ab9fb8'; ctx.font = '700 12px "IBM Plex Sans KR", sans-serif';
      ctx.fillText('R', 14, zoneTop + 20);
      ctx.fillStyle = '#f2e9d8'; ctx.font = '600 14px "IBM Plex Mono", monospace';
      ctx.fillText(hs.r + '/' + ROUNDS, 26, zoneTop + 20);
      if (cur != null) {
        const visit = hs.st - hs.rem[cur];
        ctx.textAlign = 'right'; ctx.fillStyle = '#f2e9d8'; ctx.font = '600 14px "IBM Plex Mono", monospace';
        const vt = '+' + visit;
        ctx.fillText(vt, W - 14, zoneTop + 20);
        const vw = ctx.measureText(vt).width;
        ctx.fillStyle = '#ab9fb8'; ctx.font = '700 12px "IBM Plex Sans KR", sans-serif';
        if (W >= 380) ctx.fillText('이번 차례', W - 18 - vw, zoneTop + 20);
        const co = checkout(hs.rem[cur], 3 - hs.d);
        if (co) {
          const t = co.join(' · ');
          ctx.font = '700 12px "IBM Plex Sans KR", sans-serif';
          const w1 = ctx.measureText('체크아웃 ').width;
          ctx.font = '600 13px "IBM Plex Mono", monospace';
          const w2 = ctx.measureText(t).width;
          const tw = w1 + w2 + 22;
          const x0 = W / 2 - tw / 2;
          ctx.fillStyle = 'rgba(227,174,69,.16)'; rr(ctx, x0, zoneTop + 8, tw, 25, 13); ctx.fill();
          ctx.strokeStyle = 'rgba(227,174,69,.7)'; ctx.lineWidth = 1; ctx.stroke();
          ctx.textAlign = 'left';
          ctx.fillStyle = '#ab9fb8'; ctx.font = '700 12px "IBM Plex Sans KR", sans-serif'; ctx.fillText('체크아웃 ', x0 + 11, zoneTop + 21);
          ctx.fillStyle = '#e3ae45'; ctx.font = '600 13px "IBM Plex Mono", monospace'; ctx.fillText(t, x0 + 11 + w1, zoneTop + 21);
        } else if (hs.rem[cur] <= 170 && hs.rem[cur] > 1 && hs.rem[cur] > 0) {
          const md = minDarts(hs.rem[cur]);
          if (md > 3 || md > 3 - hs.d) {
            ctx.textAlign = 'center'; ctx.fillStyle = 'rgba(171,159,184,.8)'; ctx.font = '700 12px "IBM Plex Sans KR", sans-serif';
            ctx.fillText(md > 3 ? '이 점수는 3개로 못 끝내요' : '이번엔 마무리 불가 · 세팅', W / 2, zoneTop + 21);
          }
        }
      }
      const restY = G.rest.y;
      if (human) {
        if (!ptr) {
          drawDart(G.rest.x - 12, restY, 1.9, api.players[actor(st)].color, false);
          // pull-down chevrons
          ctx.strokeStyle = 'rgba(227,174,69,' + (0.35 + 0.3 * Math.sin(time * 4)) + ')'; ctx.lineWidth = 2.5; ctx.lineCap = 'round';
          for (let i = 0; i < 2; i++) { const yy = restY + 12 + i * 9 + Math.sin(time * 4) * 2; ctx.beginPath(); ctx.moveTo(G.rest.x + 34, yy); ctx.lineTo(G.rest.x + 42, yy + 6); ctx.lineTo(G.rest.x + 50, yy); ctx.stroke(); }
        }
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.font = '700 12px "IBM Plex Sans KR", sans-serif';
        let hint, colr = '#ab9fb8';
        if (!ptr) { hint = hintFlash > 0 ? '다트를 잡고 아래로 당겼다 놓으세요' : '다트를 잡고 아래로 당겨 조준 · 놓으면 던지기'; if (hintFlash > 0) colr = '#ee6a55'; }
        else if (!curAim()) { hint = '여기서 놓으면 취소'; colr = '#ee6a55'; }
        else if (swayAt(time).a > 0.5) { hint = '손이 떨려요 · 빨리 놓으세요'; colr = '#ee6a55'; }
        else hint = '천천히 = 미세 조정 · 길이 = 높이';
        ctx.fillStyle = colr;
        if (!ptr) ctx.fillText(hint, W / 2, G.H - 14);
        else { // thumb covers the bottom while pulling: put the hint up beside the dart
          ctx.textAlign = 'left';
          const words = hint.split(' · ');
          words.forEach((w, i) => ctx.fillText(w, 14, zoneTop + 46 + i * 16));
        }
      } else if (cur != null && !st.fin && !st.over && !pops.length) {
        const p = api.players[actor(st)];
        if (p) {
          ctx.textAlign = 'center'; ctx.fillStyle = '#ab9fb8'; ctx.font = '700 14px "IBM Plex Sans KR", sans-serif';
          ctx.fillText(p.name + (p.ai ? ' 조준 중…' : ' 차례'), W / 2, zoneTop + zoneH / 2 + 18);
        }
      }
    }

    /* ---- HUD ---- */
    function renderTop() {
      top.innerHTML = '';
      const s = hudSt;
      if (!s) return;
      const cur = actor(s);
      for (let i = 0; i < s.n; i++) {
        const p = api.players[i], on = cur === i;
        let sub;
        if (on) sub = L.h('div', { class: 'mono', style: { fontSize: '13px', letterSpacing: '2px', color: p.color, lineHeight: 1 }, text: '●'.repeat(3 - s.d) + '○'.repeat(s.d), 'aria-label': '남은 다트 ' + (3 - s.d) });
        else sub = L.h('div', { class: 'muted', style: { fontSize: '11px', lineHeight: 1, whiteSpace: 'nowrap' }, text: s.lv[i] == null ? '대기' : s.lv[i] < 0 ? '직전 버스트' : '직전 ' + s.lv[i] });
        top.append(L.h('div', { class: 'panel', style: { flex: '1 1 0', minWidth: 0, padding: '6px 8px', display: 'flex', flexDirection: 'column', gap: '3px', opacity: on || cur == null ? 1 : 0.62, borderColor: on ? p.color : '', boxShadow: on ? '0 0 0 1px ' + p.color + ' inset' : '' } },
          L.h('div', { style: { display: 'flex', alignItems: 'center', gap: '5px', fontSize: '12px', fontWeight: 700, minWidth: 0 } },
            L.h('span', { class: 'dot', style: { '--c': p.color, flex: 'none' } }),
            L.h('span', { style: { overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }, text: p.name })),
          L.h('div', { class: 'mono', style: { fontSize: s.n > 3 ? '24px' : '28px', fontWeight: 600, lineHeight: 1, color: s.rem[i] === 0 ? 'var(--brass)' : 'var(--ink)' }, text: String(s.rem[i]) }),
          sub));
      }
    }

    /* ---- animation ---- */
    const BUST_WHY = ['', '0 아래로 내려감', '1점이 남음', '더블로 끝내야 해요'];
    function startAnim(last, prev) {
      const col = api.players[last.s] ? api.players[last.s].color : '#e3ae45';
      const all = last.vd || st.v || [];
      disp = all.slice(0, -1).map((v) => ({ x: v[0], y: v[1], c: col }));
      hudSt = prev || st;
      const A = myLaunch || { x: G.rest.x + (Math.random() - 0.5) * 24, y: G.rest.y + 40 };
      myLaunch = null;
      anim = { phase: 'fly', t: 0, dur: 0.42 / L.debug.speed, x: last.x, y: last.y, A, c: col, last };
      setBusy(true);
      api.sfx('whoosh');
      clearTimeout(animTimer);
      animTimer = setTimeout(() => { if (anim && anim.last === last) finishAnim(); }, (0.42 + 1.0) / L.debug.speed * 1000 + 1500);
    }
    function land() {
      const l = anim.last;
      disp.push({ x: l.x, y: l.y, c: anim.c });
      hudSt = st; renderTop();
      api.sfx('thud'); api.buzz(18);
      let text = l.l, sub = null, col = '#f2e9d8';
      if (l.p === 0) col = '#ab9fb8';
      else if (l.p >= 50 || l.l[0] === 'T') col = '#e3ae45';
      if (l.e === 2) { sub = l.l + ' · ' + (BUST_WHY[l.b || 1]); text = '버스트!'; col = '#ee6a55'; setTimeout(() => api.sfx('lose'), 120); }
      else if (l.e === 3) { sub = l.l; text = '더블 아웃!'; col = '#e3ae45'; setTimeout(() => api.sfx('win'), 120); }
      else if (is180(l)) { text = '180!'; sub = '한 차례 최고점'; col = '#f2c230'; setTimeout(() => { api.sfx('win'); api.sfx('pop'); }, 100); api.haptic('win', [30, 50, 30, 50, 70]); }
      else if (l.p === 50) { text = '불!'; sub = '정중앙 50'; col = '#f2c230'; setTimeout(() => { api.sfx('pop'); api.sfx('chip'); }, 80); api.haptic('hit', [25, 40, 40]); }
      else if (l.l[0] === 'T' || l.p >= 50) setTimeout(() => api.sfx('pop'), 80);
      if (l.e === 3) api.haptic('win', [40, 60, 80]);
      pops = [{ text, sub, col, x: px(l.x), y: py(l.y), t: 0, life: (l.e ? 1.3 : 0.95) / Math.sqrt(L.debug.speed) }];
      anim.phase = 'hold'; anim.t = 0; anim.dur = (l.e ? 1.0 : 0.4) / L.debug.speed;
    }
    function finishAnim() {
      if (!anim) return;
      if (anim.phase === 'fly') land();
      anim = null; clearTimeout(animTimer);
      disp = (st.v || []).map((v) => ({ x: v[0], y: v[1], c: api.players[st.t] ? api.players[st.t].color : '#fff' }));
      hudSt = st; renderTop();
      setBusy(false);
    }

    const stopLoop = U.loop((dt) => {
      time += dt;
      if (hintFlash > 0) hintFlash -= dt;
      if (anim) {
        // slow-mo on the final approach of a bull / 180-closing dart (view only; result already in state)
        const big = anim.phase === 'fly' && anim.last && (anim.last.p === 50 || is180(anim.last)) && anim.t > anim.dur * 0.55;
        anim.t += big ? dt * 0.3 : dt;
        if (anim.t >= anim.dur) { if (anim.phase === 'fly') land(); else finishAnim(); }
      }
      for (const p of pops) p.t += dt;
      pops = pops.filter((p) => p.t < p.life);
      draw();
    });

    /* ---- input: slingshot pull ---- */
    const el = cv.cv;
    let wasAiming = false;
    function onDown(ev) {
      // a new primary pointer always starts a fresh gesture (a lost pointerup can't wedge input); extra fingers are ignored
      if (!G || !ev.isPrimary || !humanTurn()) return;
      const p = cv.local(ev);
      // grab the dart (generous radius) — anything else just shows the hint
      if (Math.hypot(p.x - G.rest.x, p.y - (G.rest.y + 14)) > AIM.grab) { if (p.y >= G.zoneTop) { hintFlash = 1.6; api.sfx('click'); } return; }
