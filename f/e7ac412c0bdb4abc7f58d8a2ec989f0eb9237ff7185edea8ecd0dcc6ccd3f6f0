        try { if (document.pointerLockElement) document.exitPointerLock(); } catch (e) {}
        ambStop(); try { if (AC) AC.close(); } catch (e) {}
        try { R.dispose(); R.forceContextLoss(); } catch (e) {}
        wrap.remove();
      },
    };
  };
  window.PH_VIEW = V;
})();
