        if (ph === D.PH.HIDE && W.ht - W.t < 3.2 && W.ht - W.t > 0) { const s2 = Math.ceil(W.ht - W.t); if (s2 !== lastTick) { lastTick = s2; snd('tick', null); } }
      }
      if (!isHost() || sentSeq === st.seq + 1000) return;
      if (st.ph === 'intro' && phaseT > 5.5 && ready && W) { sentSeq = st.seq + 1000; api.setState(Object.assign({}, st, { ph: 'play', seq: st.seq + 1 })); }
      else if (st.ph === 'res' && phaseT > 6) { sentSeq = st.seq + 1000; api.setState(D.afterRes(st)); }
    }
    let lastTick = -1;
    function lampTick(t) {
      for (const L2 of lampFx) {
        let k = 1;
        if (L2.kind === 'fire') k = 0.8 + Math.sin(t * 7 + L2.ph) * 0.08 + Math.sin(t * 13.1 + L2.ph * 2) * 0.06;
        else if (L2.kind === 'flick') { const w = clamp((Math.sin(t * 0.7 + L2.ph) - 0.6) / 0.2, 0, 1); k = 1 - w * (0.16 + 0.12 * Math.sin(t * 9 + L2.ph) + 0.06 * Math.sin(t * 5.3 + L2.ph * 2)); }   // 고장 난 등: 가끔 얕게 어두워짐(빠른 점멸은 눈이 아픔)
        L2.spr.material.opacity = k; L2.pool.material.opacity = 0.22 * k; if (L2.light) L2.light.intensity = L2.base * k;
      }
      if (dust) { const pa = dust.geometry.attributes.position.array; for (let i = 0; i < pa.length / 3; i++) { const b = i * 4, ph = dustBase[b + 3]; pa[i * 3] = dustBase[b] + Math.sin(t * 0.13 + ph) * 0.25; pa[i * 3 + 1] = dustBase[b + 1] + Math.sin(t * 0.09 + ph * 1.7) * 0.18; pa[i * 3 + 2] = dustBase[b + 2] + Math.cos(t * 0.11 + ph) * 0.25; } dust.geometry.attributes.position.needsUpdate = true; }
      matShaft.uniforms.t.value = t;
    }

    /* ======================= 프레임 ======================= */
    let wallT = 0;
    function frame(now) {
      if (dead) return;
      raf = requestAnimationFrame(frame);
      const rdt = Math.min(0.1 * Math.max(1, SPD()), (now - (last || now)) / 1000); last = now;
      if (!ready || !st) return;
      FL.tick(Math.min(0.1, rdt));
      const dt = rdt * SPD();
      if (!paused) {
        if (W && st.ph === 'play') simTick(dt);
        pollNet(); if (api.online && W) smoothRemote(rdt);
        publish(rdt);
        phaseTick(rdt);
      }
      if (!W) return;
      wallT += rdt;
      poseTick();
      camTick(rdt);
      aimTick();
      fxTick();
      visTick(rdt); tickProps(); tickHunters(rdt); pTick(rdt); tracerTick(rdt); lampTick(wallT);
      updListener(); ambLoop(rdt);
      hudTk -= rdt; if (hudTk <= 0) { hudTk = 1 / 8; hudTick(); }
      if (noteT > 0) { noteT -= rdt; if (noteT <= 0) noteEl.style.opacity = '0'; }
      const me = ME(), blindNow = st.ph === 'play' && me >= 0 && W.chars[me] && W.chars[me].hun && W.dyn.al[me] && D.phaseOf(W) === D.PH.HIDE && humanHere(me);
      R.clear();
      if (!blindNow) R.render(scene, cam);
      if (firstPerson() && !blindNow) {
        recoil = ease(recoil, 0, 12, rdt);
        const mv = W.chars[me] ? Math.hypot(W.chars[me].vx, W.chars[me].vz) : 0;
        gunG.position.set(0.19 + Math.cos(bob) * 0.006 * Math.min(1, mv), -0.17 + Math.abs(Math.sin(bob)) * 0.008 * Math.min(1, mv) + recoil * 0.01, -0.42 + recoil * 0.05);
        gunG.rotation.set(recoil * 0.12, 0.04, 0);
        if (flashT > 0) { flashT -= rdt; flash.visible = true; flash.material.rotation = Math.random() * TAU; } else flash.visible = false;
        R.clearDepth(); R.render(wscene, wcam);
      }
      draw2d(rdt);
    }
    let hudTk = 0;

    /* ======================= 시작 ======================= */
    const onResize = () => layout();
    window.addEventListener('resize', onResize);
    layout();
    async function start() {
      if (loading || ready) return;
      loading = true;
      try {
        await loadAssets(st.map);
        if (dead) return;
        hooks.progress(0.9, '건물 짓는 중');
        M = D.genMap(st.map, st.rs);
        const env = M.def.env; sunOff.set(env.sunDir[0], env.sunDir[1], env.sunDir[2]).normalize();
        buildArch();
        if (env.glass) for (const r of M.rooms) if (r.wall === 'glass') glassRoof(r);
        mapBuilt = st.map;
        ready = true;
        ensureWorld();
        camTick(0.016);
        hooks.progress(0.96, '그래픽 준비 중');
        try { if (R.compileAsync && R.extensions.has('KHR_parallel_shader_compile')) await R.compileAsync(scene, cam); else R.compile(scene, cam); } catch (e) {}
        if (dead) return;
        hooks.ready();
        ambStart();
        if (!L.debug.noTut && ME() >= 0 && D.store.get('tip', '') !== '1') { D.store.set('tip', '1'); note(touch ? '왼쪽 끌기 이동 · 오른쪽 끌기 시점' : '마우스: 시점 · WASD 이동 · Esc: 마우스 풀기'); }
      } catch (e) { console.warn(e); hooks.progress(1, '자료를 불러오지 못함. (' + (e && e.message || e) + ')'); }
    }
    raf = requestAnimationFrame(frame);

    return {
      update(s) {
        if (!s) return;
        st = s;
        if (!ready) { start(); return; }
        ensureWorld();
      },
      pause() { paused = true; FL.exit(); if (AC) AC.suspend().catch(() => {}); }, resume() { paused = false; last = 0; FL.kick(); if (AC) AC.resume().catch(() => {}); },
