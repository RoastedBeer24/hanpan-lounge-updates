      const col = (x, y, rot) => '<g transform="' + (rot ? 'rotate(180 50 70) ' : '') + '"><text x="' + x + '" y="' + y + '" font-family="' + SERIF + '" font-size="10.5" fill="' + gold + '" text-anchor="middle">' + 'JOKER'.split('').map((ch, i) => '<tspan x="' + x + '" dy="' + (i ? 11 : 0) + '">' + ch + '</tspan>').join('') + '</text></g>';
