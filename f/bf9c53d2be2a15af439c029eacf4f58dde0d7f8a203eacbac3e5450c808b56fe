    if (s.o.mk) stats.push({ label: '도시 추방', values: s.acc.mk.slice(), best: false });
    const hl = [];
    const dmax = Math.max(...s.acc.dai);
    if (dmax >= 2) hl.push('대부호 ' + dmax + '번 — ' + order.filter((i) => s.acc.dai[i] === dmax).map(nm).join(', '));
    const rv = s.acc.rev.reduce((a, b) => a + b, 0);
    if (rv) hl.push('혁명 ' + rv + '번');
    const mk = s.acc.mk.reduce((a, b) => a + b, 0);
    if (mk) hl.push('도시 추방 ' + mk + '번');
    return {
      winners: [w],
