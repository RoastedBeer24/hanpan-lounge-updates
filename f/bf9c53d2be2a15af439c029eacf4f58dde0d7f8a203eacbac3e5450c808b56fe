    'M0 -46A21 21 0 1 1 -1 -46ZM-24 -6A21 21 0 1 1 -25 -6ZM24 -6A21 21 0 1 1 23 -6ZM-6 6C-6 28 -12 42 -22 50L22 50C12 42 6 28 6 6Z',
