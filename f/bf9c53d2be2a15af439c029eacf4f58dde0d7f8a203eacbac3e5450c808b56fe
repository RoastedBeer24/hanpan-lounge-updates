  }
  const hasRank = (m, r) => (m.k === 's' ? !m.jk && m.r === r : m.r <= r && r <= m.r + m.n - 1);
  function beats(tb, m, inv, s3On) {
    if (!tb) return true;
    if (tb.k !== m.k || tb.n !== m.n) return false;
    if (tb.jk) return !!(s3On && m.s3 && tb.n === 1);
    return pw(m, inv) > pw(tb, inv);
  }
  const invOf = (s) => (s.rev ^ s.jbk) ? true : false;
  /* 이 고르기로 지금 낼 수 있는 해석(가장 강한 것), 없으면 null */
  function legalOf(s, ids, hint) {
    const inv = invOf(s);
    let list = interps(ids, s.o.seq).filter((m) => beats(s.tb, m, inv, s.o.s3));
    if (!list.length) return null;
    if (hint && hint.k) { const hm = list.find((m) => m.k === hint.k && m.r === hint.r); if (hm) return hm; }
    if (!s.tb) { const st = list.find((m) => m.k === 's'); if (st) return st; }
    list.sort((a, b) => pw(b, inv) - pw(a, inv));
    return list[0];
  }
  /* 패 이름: 「7 두 장」「조커」「계단 ♠5–7」 */
  function descM(m, ids) {
    if (!m) return '';
    if (m.k === 's') {
      if (m.jk) return m.n === 1 ? '조커' : '조커 ' + CNT[m.n];
      const jn = ids ? ids.filter(isJ).length : 0;
