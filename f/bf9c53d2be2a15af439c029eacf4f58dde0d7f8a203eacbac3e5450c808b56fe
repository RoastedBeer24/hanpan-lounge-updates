  /* ---------- 패 해석 ---------- */
  /* 고른 카드들 → 가능한 해석 목록. {k:'s'(같은 숫자)|'q'(계단), n, r(숫자 또는 계단 맨 아래), jk(조커만), s3(♠3 낱장), su(계단 무늬)} */
  function interps(ids, seqOn) {
