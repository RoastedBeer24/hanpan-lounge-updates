  const su = (c) => (c / 13) | 0;
  const zeros = (n) => Array(n).fill(0);
  const titleOf = (n, place) => (TITLES[n] || TITLES[6])[clamp(place, 1, n) - 1];
  /* 카드 하나의 세기(교환·정렬용): 보통 서열이면 3=0 … 2=12, 조커 13. 역순이면 숫자만 뒤집힘 */
  const cardPow = (c, inv) => (isJ(c) ? 13 : inv ? 12 - rk(c) : rk(c));
