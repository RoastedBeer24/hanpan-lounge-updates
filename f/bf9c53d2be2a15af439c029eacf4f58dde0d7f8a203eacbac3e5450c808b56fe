    }
    if (seqOn && n >= 3 && nat.every((c) => su(c) === su(nat[0]))) {
      const rs = nat.map(rk).sort((a, b) => a - b);
      let dup = false; for (let i = 1; i < rs.length; i++) if (rs[i] === rs[i - 1]) dup = true;
      if (!dup) {
        const mn = rs[0], mx = rs[rs.length - 1];
        if (mx - mn + 1 <= n) {
