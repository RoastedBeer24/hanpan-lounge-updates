`;

  /* ======================= 뷰 ======================= */
  function mount(root, api) {
    const h = L.h;
    if (!document.getElementById('df-css')) document.head.append(h('style', { id: 'df-css', text: CSS }));
    const wrap = h('div', { class: 'df' });
    const top = h('div', { class: 'df-top' });
    const opps = h('div', { class: 'df-opps' });
    const felt = h('div', { class: 'df-felt' });
    const tbl = h('div', { class: 'df-tbl' });
    const pile = h('div', { class: 'df-pile' });
    const lg = h('div', { class: 'df-lg' });
    const tools = h('div', { class: 'df-tools' },
      h('button', { class: 'df-tool', type: 'button', 'aria-label': '이번 판 기록', title: '기록 (R)', 'data-action': 'log', html: TOOL.log, onclick: () => openLog() }),
      h('button', { class: 'df-tool', type: 'button', 'aria-label': '점수표', title: '점수표', html: TOOL.score, onclick: () => openScore() }));
    felt.append(tbl, pile, lg, tools);
    const me = h('div', { class: 'df-me' });
    const tip = h('div', { class: 'df-tip', role: 'status' });
    const hand = h('div', { class: 'df-hand' });
    const act = h('div', { class: 'df-act' });
    wrap.append(top, opps, felt, me, tip, hand, act);
    root.append(wrap);

    let st = null, shownId = -1, dead = false, animating = false, sheet = null, curRes = null, skipping = false;
    let sel = [], lastBot = -1, vp = [], dealFx = false, sentAt = 0, drag = null;
    const Q = [];
    const NM = (i) => (api.players[i] && api.players[i].name) || (st && st.nm[i]) || ('자리 ' + (i + 1));
    const COL = (i) => (api.players[i] && api.players[i].color) || '#c9a45c';
    const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const SP = () => Math.max(0.2, (L.debug.speed || 1) * (L.speed ? L.speed() : 1));
    const wait = (ms) => (skipping || dead ? Promise.resolve() : new Promise((r) => { const t = setTimeout(() => { curRes = null; r(); }, ms / SP()); curRes = () => { clearTimeout(t); curRes = null; r(); }; }));

    function paintFelt() {
      let f = null; try { f = L.ui.felt && L.ui.felt(); } catch (e) { f = null; }
      const c = f && f.c ? f.c : ['#24806a', '#1c6650', '#0c3528'];
      tbl.style.background = 'radial-gradient(ellipse 70% 62% at 50% 46%,' + c[0] + ' 0%,' + c[1] + ' 45%,' + c[2] + ' 100%)';
      tbl.style.filter = 'brightness(.82) saturate(.85)';
    }
    paintFelt();
    let backCSS = null;
    function readBack() { try { backCSS = L.ui.cardBackCSS ? L.ui.cardBackCSS() : null; } catch (e) { backCSS = null; } }
    readBack();
    function backEl(w) {
      const el = h('div', { class: 'df-c bk', style: { '--w': w + 'px' } });
      el.style.background = backCSS ? backCSS.background : '#2a3550';
      el.style.border = backCSS ? backCSS.border : '2px solid #c9a45c';
      return el;
    }
    function cardEl(c, w) { const el = h('div', { class: 'df-c', html: faceSVG(c), style: { '--w': w + 'px' } }); el.dataset.id = c; return el; }

    /* 이 화면에서 아래(내 자리)에 둘 자리와, 그 패를 보여 줘도 되는지 */
    const spectateOpen = () => !api.online && api.mySeats().length === 0;
    function botSeat() {
      const v = api.viewer();
      if (v >= 0) { lastBot = v; return v; }
      const mine = api.mySeats();
      if (mine.includes(lastBot)) return lastBot;
      if (mine.length) return mine[0];
      return 0;
    }
    const canSee = (seat) => seat === api.viewer() || spectateOpen();
    const myTurn = (s, seat) => s && s.ph === 'play' && s.turn === seat && api.canAct(seat) && canSee(seat) && !animating;
    const myGive = (s, seat) => s && s.ph === 'xchg' && s.xq.length && s.xq[0].s === seat && api.canAct(seat) && canSee(seat) && !animating;
    const titleNow = (s, seat) => (s.prev ? E.titleOf(s.n, s.prev[seat]) : '');
    function rbEl(t) { return t ? h('span', { class: 'df-rb ' + (E.TKEY[t] || 'k3'), text: t }) : null; }

    /* ---------- 배치 ---------- */
    let HL = { cw: 56, rows: 1, per: 1, step: 0, rs: 0, hh: 90 };
    function handLayout(N) {
      const W = Math.max(280, (hand.clientWidth || wrap.clientWidth - 16));
      const H = wrap.clientHeight || 640;
      let cw = Math.round(clamp(Math.min(W / 4.9, (H - 330) / 3.2), 44, 84));
      let rows = 1, per = N, step = 0;
      for (rows = 1; rows <= 3; rows++) {
        per = Math.ceil(Math.max(1, N) / rows);
        step = per > 1 ? Math.min(cw + 6, (W - cw) / (per - 1)) : 0;
        if (per <= 1 || step >= 44) break;
      }
      if (rows > 3) { rows = 3; per = Math.ceil(N / 3); step = per > 1 ? (W - cw) / (per - 1) : 0; }
      const rs = rows > 1 ? Math.max(46, Math.round(cw * 0.62)) : 0;
      HL = { cw, rows, per, step, rs, hh: Math.round(cw * 1.4 + (rows - 1) * rs + 14), W };
      return HL;
    }
    function feltDims() {
      const W = felt.clientWidth || 340, H = felt.clientHeight || 220;
      const pcw = Math.round(clamp(Math.min(W * 0.18, (H - 70) / 1.4 / 1.25), 36, 78));
      return { W, H, pcw };
    }

    /* ---------- 그리기 ---------- */
    function renderTop(s) {
      top.innerHTML = '';
      top.append(h('span', { html: '제<b>' + s.hn + '</b>판 / ' + s.o.H }));
      top.append(h('span', { class: 'df-pill' + (s.rev ? ' rv' : ''), text: s.rev ? '혁명 — 역순' : '서열 보통' }));
      if (s.jbk) top.append(h('span', { class: 'df-pill rv', text: 'J 역순' }));
      tbl.classList.toggle('rv', !!(s.rev ^ s.jbk));
    }
    function statusOf(s, seat) {
      if (s.pl[seat]) {
        const ex = s.log.some((x) => x[0] === -3 && x[1] === seat);
        return { t: ex ? '도시 추방 · ' + E.titleOf(s.n, s.pl[seat]) : s.pl[seat] + '위 · ' + E.titleOf(s.n, s.pl[seat]), c: '' };
      }
      if (s.ph === 'xchg') {
        const q = s.xq[0];
        if (q && q.s === seat) return { t: '돌려줄 패 고르는 중', c: 'tn' };
        if (q && q.to === seat) return { t: '교환 기다림', c: '' };
        return { t: '', c: '' };
      }
      if (s.ps[seat]) return { t: '패스', c: 'ps' };
      if (s.turn === seat) return { t: api.players[seat] && api.players[seat].ai ? '생각 중' : '차례', c: 'tn' };
      return { t: '', c: '' };
    }
    function renderOpps(s, bot) {
      opps.innerHTML = '';
      const i0 = s.ord.indexOf(bot);
      for (let k = 1; k < s.n; k++) {
        const seat = s.ord[(i0 + k) % s.n];
        const stt = statusOf(s, seat);
        const turn = (s.ph === 'play' && s.turn === seat) || (s.ph === 'xchg' && s.xq[0] && s.xq[0].s === seat);
        const mb = h('span', { class: 'df-mb' });
        if (backCSS) { mb.style.background = backCSS.background; mb.style.border = '1px solid ' + (backCSS.border.split(' ').pop() || '#c9a45c'); }
        const el = h('div', { class: 'df-op' + (turn ? ' cur' : '') + (s.pl[seat] ? ' done' : ''), 'data-seat': seat },
          h('div', { class: 'nm' }, h('i', { class: 'df-dot', style: { '--c': COL(seat) } }), h('span', { text: NM(seat) })),
          h('div', { class: 'df-orow' }, mb, h('b', { class: 'cnt', text: String(s.h[seat].length) }), rbEl(titleNow(s, seat))),
          h('div', { class: 'st ' + stt.c, text: stt.t }));
        opps.append(el);
      }
    }
    function renderMe(s, bot) {
      me.innerHTML = '';
      const stt = statusOf(s, bot);
      me.append(h('i', { class: 'df-dot', style: { '--c': COL(bot) } }), h('span', { class: 'nm', text: NM(bot) }));
      const rb = rbEl(titleNow(s, bot)); if (rb) me.append(rb);
      if (stt.t && stt.c !== 'tn') me.append(h('span', { text: stt.t }));
      me.append(h('span', { class: 'sc', html: s.scores[bot] + '<small>점</small>' }));
    }
    function pileFromLog(s) {
      const out = [];
      for (let i = s.log.length - 1; i >= 0; i--) {
        const x = s.log[i];
        if (x[0] === -1) break;
        if (x[0] >= 0 && x[1]) out.unshift(logPlay(x));
      }
      return out;
    }
    function logPlay(x) {
      const ids = x[1], nat = ids.filter((c) => !isJ(c));
      const m = x[2] ? { k: 'q', n: ids.length, r: x[3], su: nat.length ? su(nat[0]) : 0 } : (nat.length ? { k: 's', n: ids.length, r: x[3] } : { k: 's', n: ids.length, r: 13, jk: 1 });
      return { s: x[0], ids, m };
    }
    function groupPos(n, pcw, idx, total, fd) {
      const step = Math.round(n > 1 ? Math.min(pcw * 0.46, (fd.W * 0.68 - pcw) / (n - 1)) : 0);
      const w = pcw + (n - 1) * step;
      const age = total - 1 - idx;
      const cx = fd.W / 2 - age * 12, cy = fd.H * 0.42 - age * 16;
      return { left: Math.round(cx - w / 2), top: Math.round(cy - pcw * 0.7), step, w };
    }
    function drawPile() {
      pile.innerHTML = '';
      const fd = feltDims();
      const show = vp.slice(-3);
      if (!show.length) {
        if (st && (st.ph === 'play' || st.ph === 'xchg')) pile.append(h('div', { class: 'df-empty', text: st.ph === 'xchg' ? '카드 교환 중' : '바닥이 비어 있음' }));
        return;
      }
      show.forEach((g, i) => {
        const p = groupPos(g.ids.length, fd.pcw, i, show.length, fd);
        const el = h('div', { class: 'df-grp' + (i < show.length - 1 ? ' old' : ''), style: { left: p.left + 'px', top: p.top + 'px', width: p.w + 'px', height: Math.round(fd.pcw * 1.4) + 'px' } });
        g.ids.forEach((c, j) => { const ce = cardEl(c, fd.pcw); ce.style.left = (j * p.step) + 'px'; el.append(ce); });
        pile.append(el);
        if (i === show.length - 1) {
          pile.append(h('div', { class: 'df-plb', style: { top: (p.top + Math.round(fd.pcw * 1.4) + 6) + 'px' }, html: esc(NM(g.s)) + '<i>' + esc(E.descM(g.m, g.ids)) + '</i>' }));
        }
      });
    }
    function renderLog(s) {
      lg.innerHTML = '';
