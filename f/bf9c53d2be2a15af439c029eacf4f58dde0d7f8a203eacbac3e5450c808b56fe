    }
    return '계단 ' + SUN[m.su] + ' ' + RK[m.r] + '–' + RK[m.r + m.n - 1];
  }

  /* ---------- 시작 · 나누기 ---------- */
  function init(players, opts) {
    opts = opts || {};
    const n = clamp(players.length, 3, 6);
    const o = {
      H: [3, 5, 8].includes(+opts.hands) ? +opts.hands : 5,
      jk: +opts.jokers === 2 ? 2 : 1,
      seq: opts.seq !== 'off', e8: opts.eight !== 'off', s3: opts.s3 !== 'off',
      jb: opts.jback === 'on', mk: opts.miyako !== 'off',
    };
    const s = {
      v: 1, n, o, sd: (Math.random() * 1e9) | 0, eid: 0, hn: 0, ph: 'play',
      nm: players.map((p, i) => String((p && p.name) || ('자리 ' + (i + 1))).slice(0, 14)),
      h: [], ord: [], turn: -1, tb: null, lb: -1, ps: zeros(n), rev: 0, jbk: 0,
      pl: zeros(n), top: 0, bot: 0, dai: -1, gone: [], log: [], xq: [], rc: {}, prev: null,
      scores: zeros(n), hist: [],
      acc: { dai: zeros(n), hin: zeros(n), rev: zeros(n), cut: zeros(n), mk: zeros(n) },
      last: null,
    };
    const ev = [];
    deal(s, ev);
    s.last = { id: 0, ev };
    return s;
  }

  function deal(s, ev) {
    const n = s.n;
    s.hn++;
    const deck = [];
    for (let c = 0; c < 52; c++) deck.push(c);
    for (let j = 0; j < s.o.jk; j++) deck.push(52 + j);
    U.shuffle(deck);
    const prev = s.prev;
    s.ord = prev ? Array.from({ length: n }, (_, i) => i).sort((a, b) => prev[a] - prev[b]) : Array.from({ length: n }, (_, i) => i);
    s.h = Array.from({ length: n }, () => []);
    const off = (Math.random() * n) | 0;   // 남는 카드가 늘 같은 자리로 가지 않게, 나누기 시작 자리는 무작위
    deck.forEach((c, i) => s.h[s.ord[(i + off) % n]].push(c));
    s.h.forEach((a) => sortHand(a, false));
    s.pl = zeros(n); s.top = 0; s.bot = 0; s.tb = null; s.lb = -1; s.ps = zeros(n); s.rev = 0; s.jbk = 0;
    s.gone = []; s.log = []; s.rc = {}; s.xq = [];
    if (prev) {
      s.dai = prev.indexOf(1);
      const lead = prev.indexOf(n);
      const pairs = [[1, n, 2]];
      if (n >= 4) pairs.push([2, n - 1, 1]);
      for (const [a, b, k] of pairs) {
        const rich = prev.indexOf(a), poor = prev.indexOf(b);
        const best = s.h[poor].slice().sort((x, y) => cardPow(y, false) - cardPow(x, false) || y - x).slice(0, k);
        s.h[poor] = s.h[poor].filter((c) => !best.includes(c));
        s.h[rich].push(...best); sortHand(s.h[rich], false);
        s.rc[rich] = best.slice();
        s.xq.push({ s: rich, to: poor, k });
        ev.push({ t: 'trib', f: poor, to: rich, ids: best.slice(), k });
