    const cw = 92, chh = 129;
    cards.forEach((c, i) => {
      ctx.save();
      const a = (i - 3) * 0.12;
      ctx.translate(W / 2 + (i - 3) * 62, H * 0.62 + Math.abs(i - 3) * 10);
      ctx.rotate(a);
