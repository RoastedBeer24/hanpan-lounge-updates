    const w = order[0];
    const nm = (i) => s.nm[i] || ('자리 ' + (i + 1));
    const stats = [
      { label: '총점', values: s.scores.slice(), unit: '점' },
      { label: '대부호', values: s.acc.dai.slice(), unit: '번' },
      { label: '대빈민', values: s.acc.hin.slice(), unit: '번', low: true },
      { label: '혁명', values: s.acc.rev.slice(), best: false },
