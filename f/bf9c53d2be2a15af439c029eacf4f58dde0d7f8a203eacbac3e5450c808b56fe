  }

  /* ======================= AI ======================= */
  /* 손패 → 낼 수 있는 모든 패(같은 숫자 묶음·계단). tb가 있으면 그걸 이기는 것만 */
  function genMoves(s, hand, tb) {
    const inv = invOf(s);
    const out = [];
    const J = hand.filter(isJ);
    const byR = Array.from({ length: 13 }, () => []);
    hand.forEach((c) => { if (!isJ(c)) byR[rk(c)].push(c); });
    const want = tb ? tb.n : 0;
    const push = (ids, m) => { if (!tb || beats(tb, m, inv, s.o.s3)) out.push({ ids, m }); };
    if (!tb || tb.k === 's') {
      for (let r = 0; r < 13; r++) {
        const nat = byR[r]; if (!nat.length) continue;
        for (let k = 1; k <= nat.length + J.length; k++) {
          if (want && k !== want) continue;
          if (k > 6) break;
          const ids = k <= nat.length ? nat.slice(0, k) : nat.concat(J.slice(0, k - nat.length));
          const m = { k: 's', n: k, r };
          if (k === 1 && ids[0] === S3) m.s3 = 1;
          push(ids, m);
        }
      }
      for (let k = 1; k <= J.length; k++) { if (want && k !== want) continue; push(J.slice(0, k), { k: 's', n: k, r: 13, jk: 1 }); }
    }
    if (s.o.seq && (!tb || tb.k === 'q')) {
      for (let q = 0; q < 4; q++) {
        const has = Array(13).fill(-1);
        hand.forEach((c) => { if (!isJ(c) && su(c) === q) has[rk(c)] = c; });
        for (let lo = 0; lo <= 10; lo++) {
          let gaps = 0, nat = 0;
          for (let len = 1; lo + len <= 13; len++) {
            if (has[lo + len - 1] < 0) gaps++; else nat++;
            if (gaps > J.length) break;
            if (len < 3 || !nat) continue;
            if (want && len !== want) continue;
            if (has[lo] < 0 && has[lo + len - 1] < 0 && gaps === len - nat) { /* 양 끝이 모두 조커인 계단은 같은 패의 다른 해석 — 그대로 둔다 */ }
            const ids = [];
            let jUsed = 0;
            for (let r = lo; r < lo + len; r++) { if (has[r] >= 0) ids.push(has[r]); else ids.push(J[jUsed++]); }
            push(ids, { k: 'q', n: len, r: lo, su: q });
          }
        }
      }
    }
    return out;
  }

  /* 남은 카드(내 손패·나온 카드 제외) 개수 — 어려움 AI의 카드 세기 */
  function unseenOf(s, seat) {
    const cnt = zeros(13); let jk = s.o.jk;
    const known = new Set(s.h[seat].concat(s.gone));
    for (let c = 0; c < 52; c++) if (!known.has(c)) cnt[rk(c)]++;
    for (let j = 0; j < s.o.jk; j++) if (known.has(52 + j)) jk--;
    return { cnt, jk };
  }
  function habits(s, seat) {
    return { hoard: hash(s.sd, seat, 21), rush: hash(s.sd, seat, 22), revl: hash(s.sd, seat, 23), split: hash(s.sd, seat, 24) };
  }
  const styleOf = (seat) => { try { return (L.aiStyle && L.aiStyle(seat)) || 'bal'; } catch (e) { return 'bal'; } };

  /* 이 묶음이 「주도권 카드」인가(이기면 다시 내 차례가 될 가능성이 큰 패) */
  function isCtl(g, inv, ctx) {
    if (g.jk) return true;
    if (ctx.e8 && hasRank(g, R8)) return true;
    const p = pw(g, inv);
    if (g.k === 'q') return ctx.lv >= 2 ? (g.n >= 5 || p >= 9 - Math.min(2, g.n - 3)) : p >= 10;
    if (ctx.lv <= 1) return p >= 12;
    if (ctx.lv === 2) return g.n >= 3 ? p >= 9 : p >= 11 && !(g.n === 1 && p === 11 && ctx.unJ > 0 && ctx.n > 3);
    // 어려움: 남은 카드로 이걸 이길 수 있는 조합이 있는지 센다
    const un = ctx.un;
    if (g.n === 1 && un.jk > 0) return false;
    for (let r = 0; r < 13; r++) {
      const pr = inv ? 12 - r : r;
      if (pr <= p) continue;
      if (un.cnt[r] + un.jk >= g.n && un.cnt[r] >= 1) return false;
    }
    return true;
  }
  /* 손패를 묶음으로 나누기(같은 숫자 · 계단) — 몇 번 만에 손을 비울 수 있나 */
  function groupsOf(hand, seqOn, splitRuns) {
    const J = hand.filter(isJ).length;
    const cnt = zeros(13);
    const bySu = Array.from({ length: 4 }, () => Array(13).fill(false));
    hand.forEach((c) => { if (!isJ(c)) { cnt[rk(c)]++; bySu[su(c)][rk(c)] = true; } });
    const gs = [];
    if (seqOn && splitRuns) {
      for (let q = 0; q < 4; q++) {
        let r = 0;
        while (r < 13) {
          if (!bySu[q][r]) { r++; continue; }
          let e = r; while (e + 1 < 13 && bySu[q][e + 1]) e++;
          const len = e - r + 1;
          if (len >= 3) {
            let singles = 0; for (let x = r; x <= e; x++) if (cnt[x] === 1) singles++;
            if (singles >= len - 1) { gs.push({ k: 'q', n: len, r }); for (let x = r; x <= e; x++) cnt[x]--; }
          }
          r = e + 1;
        }
      }
    }
    for (let r = 0; r < 13; r++) if (cnt[r] > 0) gs.push({ k: 's', n: cnt[r], r });
    for (let j = 0; j < J; j++) gs.push({ k: 's', n: 1, r: 13, jk: 1 });
    return gs;
  }
  function scoreGroups(gs, inv, ctx) {
    let ctl = 0, lose = 0, weak = 0;
    for (const g of gs) {
      if (isCtl(g, inv, ctx)) ctl++;
      else { lose++; weak += 1 - clamp(pw(g, inv), 0, 12) / 12; }
    }
    let v = -8 * lose + ctx.cw * ctl - 4 * weak;
    if (ctx.lv >= 2 && lose <= ctl + 1) v += ctx.lv >= 3 ? 12 : 7;   // 이대로면 끝낼 수 있다
    return v;
  }
  function evalHand(hand, inv, ctx) {
    if (!hand.length) return 1000;
    const a = scoreGroups(groupsOf(hand, ctx.seq, false), inv, ctx);
    if (!ctx.seq) return a;
    return Math.max(a, scoreGroups(groupsOf(hand, ctx.seq, true), inv, ctx));
  }
  function mkCtx(s, seat, lv) {
    const hb = habits(s, seat), st = styleOf(seat);
    const un = lv >= 3 ? unseenOf(s, seat) : null;
    return {
      lv, seq: s.o.seq, e8: s.o.e8, n: s.n, un, unJ: un ? un.jk : s.o.jk, hb, st,
      cw: 4 + hb.hoard * 2.5 + (st === 'def' ? 1.5 : st === 'agg' ? -1 : 0) + (lv >= 3 ? 1 : 0),
    };
  }

  function ai(s, seat, lv) {
    lv = lv || 2;
    if (s.ph === 'xchg') {
      const q = s.xq[0]; if (!q || q.s !== seat) return null;
      return { t: 'give', ids: chooseGive(s, seat, lv, q.k) };
    }
    if (s.ph !== 'play' || s.turn !== seat) return null;
    const hand = s.h[seat];
    const moves = genMoves(s, hand, s.tb);
    if (!moves.length) return { t: 'pass' };
    const fin = moves.find((x) => x.ids.length === hand.length);
    if (fin) return { t: 'play', ids: fin.ids, as: { k: fin.m.k, r: fin.m.r } };
    const ctx = mkCtx(s, seat, lv);
    const inv = invOf(s);
    const opp = s.ord.filter((c) => c !== seat && active(s, c));
    const minOpp = Math.min(...opp.map((c) => s.h[c].length));
    const noise = lv <= 1 ? 6 : lv === 2 ? 2.2 : 0.7;
    const hb = ctx.hb;
    // 쉬움: 가끔 생각 없이 가장 약한 패를 낸다
    if (lv <= 1 && Math.random() < 0.25) {
      moves.sort((a, b) => pw(a.m, inv) - pw(b.m, inv));
      if (s.tb && Math.random() < 0.15) return { t: 'pass' };
      const x = moves[0];
      return { t: 'play', ids: x.ids, as: { k: x.m.k, r: x.m.r } };
    }
    const base = evalHand(hand, s.rev ? true : false, ctx);
    let best = null, bestV = -1e9;
    for (const x of moves) {
      const after = hand.filter((c) => !x.ids.includes(c));
      const revFlip = x.m.k === 's' && !x.m.jk && x.m.n >= 4;
      let futInv = !!(s.rev ^ (revFlip ? 1 : 0));
      if (lv <= 1 && revFlip && Math.random() < 0.5) futInv = !!s.rev;   // 쉬움은 혁명의 득실을 잘 못 따진다
      let v = evalHand(after, futInv, ctx);
      v += x.ids.length * 0.9;
      // 다시 선을 잡는 패(8 정리 · 이길 수 없는 패)
      const cutting = (s.o.e8 && hasRank(x.m, R8)) || (s.tb && s.tb.jk && x.m.s3);
      const ctlNow = cutting || isCtl(x.m, inv, ctx);
      if (ctlNow) v += cutting ? 7 : lv >= 3 ? 6 : 4;
      // 조커를 낱장 말고 묶음 채우기로 쓰는 건 아깝다
      const jUsed = x.ids.filter(isJ).length;
      if (jUsed && !x.m.jk) v -= (lv >= 2 ? 3.5 : 1) * jUsed;
      // 같은 숫자 묶음을 깨기
      if (x.m.k === 's' && !x.m.jk) {
        const have = hand.filter((c) => !isJ(c) && rk(c) === x.m.r).length;
        const used = x.ids.filter((c) => !isJ(c)).length;
        if (used < have) v -= (lv >= 2 ? 2.2 : 0.8) * (0.6 + hb.split);
      }
      // 거의 다 비운 상대가 있을 때
      if (lv >= 2 && minOpp <= 2) {
        if (!s.tb && x.m.n <= minOpp && !ctlNow) v -= lv >= 3 ? 7 : 4;
        if (s.tb) v += 3;
      }
      // 혁명 성향
      if (revFlip) v += (hb.revl - 0.5) * 3 + (ctx.st === 'gamble' ? 2 : 0);
      v += (Math.random() * 2 - 1) * noise;
      if (v > bestV) { bestV = v; best = x; }
    }
    if (s.tb) {
      // 패스: 손패는 그대로, 대신 다른 사람이 선을 잡는다
      let passCost = 2.5 + hb.rush * 2 + (ctx.st === 'agg' ? 1.5 : ctx.st === 'def' ? -0.8 : 0);
      if (lv >= 2 && minOpp <= 2) passCost += 5;
      if (lv >= 2 && s.tb.by >= 0 && active(s, s.tb.by) && s.h[s.tb.by].length <= 2) passCost += 3;
      const vp = base - passCost + (Math.random() * 2 - 1) * noise;
      if (vp > bestV) return { t: 'pass' };
    }
    return { t: 'play', ids: best.ids, as: { k: best.m.k, r: best.m.r } };
  }

  /* 교환: 받은 쪽(부자)이 돌려줄 카드 */
  function chooseGive(s, seat, lv, k) {
    const hand = s.h[seat].slice();
    const weakFirst = hand.slice().sort((a, b) => cardPow(a, false) - cardPow(b, false) || a - b);
    if (lv <= 1) return weakFirst.slice(0, k);
    const ctx = mkCtx(s, seat, lv);
    const pool = weakFirst.filter((c) => !isJ(c)).slice(0, 7);
    let best = pool.slice(0, k), bestV = -1e9;
    const combos = [];
    if (k === 1) pool.forEach((c) => combos.push([c]));
    else for (let i = 0; i < pool.length; i++) for (let j = i + 1; j < pool.length; j++) combos.push([pool[i], pool[j]]);
    for (const cb of combos) {
      const after = hand.filter((c) => !cb.includes(c));
      let v = evalHand(after, false, ctx) + (Math.random() * 2 - 1) * (lv === 2 ? 1 : 0.3);
      if (s.o.e8 && cb.some((c) => rk(c) === R8)) v -= 3;
      if (v > bestV) { bestV = v; best = cb; }
    }
    return best;
  }

  function aiDelayFor(s, seat, lv) {
    if (s.ph === 'over') return -1;
    if (s.ph === 'xchg') return 900 + Math.random() * 500;
    if (s.ph !== 'play' || s.turn !== seat) return -1;
    const any = genMoves(s, s.h[seat], s.tb).length > 0;
    if (!any) return 420 + Math.random() * 200;
    return 600 + Math.random() * 520 + (lv <= 1 ? 150 : 0);
  }

  /* ---------- 상황 도움말 ---------- */
  function tableText(s) {
    if (!s.tb) return '바닥이 비어 있습니다 — 선은 어떤 패든 낼 수 있습니다.';
    const m = s.tb;
    if (m.jk && m.n === 1) return '바닥: 조커' + (s.o.s3 ? ' — 스페이드 3 낱장만 이길 수 있습니다.' : ' — 이길 수 있는 패가 없습니다.');
    return '바닥: ' + descM(m, m.ids) + ' — ' + (m.k === 'q' ? '같은 길이의 계단으로' : '같은 장수로') + ' 더 ' + (invOf(s) ? '낮은' : '높은') + ' 패.';
  }
  function hint(s, seat) {
    if (s.ph === 'over') return null;
    const out = [];
    out.push('제' + s.hn + '판 / ' + s.o.H + '판' + (s.rev ? ' · 혁명 중' : '') + (s.jbk ? ' · J 역순' : ''));
    if (s.ph === 'xchg') {
      const q = s.xq[0];
      if (q && q.s === seat) out.push(titleOf(s.n, s.prev[seat]) + ' — ' + s.nm[q.to] + '에게 돌려줄 ' + CNT[q.k] + '을 고릅니다. 아무 카드나 됩니다.');
      else out.push('교환 중입니다. 낮은 계급은 가장 센 카드를, 높은 계급은 고른 카드를 줍니다.');
      return out;
    }
    out.push(tableText(s));
    if (s.rev) out.push('혁명 중에는 서열이 뒤집혀 3이 가장 강하고 2가 가장 약합니다. 조커는 그대로 가장 강합니다.');
    if (seat >= 0 && s.h[seat]) {
      if (!active(s, seat)) out.push(s.pl[seat] + '위로 이미 끝냈습니다.');
      else {
        const mv = s.turn === seat ? genMoves(s, s.h[seat], s.tb) : null;
        if (mv) out.push(mv.length ? '지금 낼 수 있는 조합: ' + mv.length + '가지' + (s.tb ? ' · 패스도 할 수 있습니다.' : '') : '낼 수 있는 패가 없습니다 — 패스.');
        if (s.ps[seat]) out.push('패스했으므로 바닥이 정리될 때까지 낼 수 없습니다.');
        if (s.prev) out.push('지난 판 계급: ' + titleOf(s.n, s.prev[seat]) + (s.o.mk && s.dai === seat ? ' — 1등을 놓치면 도시 추방으로 대빈민이 됩니다.' : ''));
      }
    }
    if (s.o.e8) out.push('8이 들어간 패를 내면 바닥이 정리되고 낸 사람이 다시 냅니다.');
    return out.slice(0, 6);
  }

  const E = {
    init, actor, apply, ai, result, aiDelayFor, hint, interps, legalOf, beats, pw, genMoves, descM, titleOf, invOf, cardPow, sortHand,
    tableText, standings, RK, SUN, TITLES, TKEY, CNT, isJ, rk, su, active, deal,
  };

  /* ======================= 그림(직접 그린 SVG, CC0) ======================= */
  const SERIF = "Georgia, 'Times New Roman', 'Noto Serif', 'Nanum Myeongjo', serif";
  const SUIT_D = [
    'M0 -48C18 -24 48 -8 48 14C48 34 26 42 8 30C10 42 14 48 22 50L-22 50C-14 48 -10 42 -8 30C-26 42 -48 34 -48 14C-48 -8 -18 -24 0 -48Z',
    'M0 46C-18 26 -48 8 -48 -16C-48 -36 -30 -46 -16 -46C-6 -46 0 -38 0 -30C0 -38 6 -46 16 -46C30 -46 48 -36 48 -16C48 8 18 26 0 46Z',
