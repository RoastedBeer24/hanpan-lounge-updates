  function suitG(s, x, y, k, fill) { return '<path transform="translate(' + x + ' ' + y + ') scale(' + k + ')" d="' + SUIT_D[s] + '" fill="' + fill + '"/>'; }
  const FACE_CACHE = {};
  function faceSVG(c) {
