  const TKEY = { 대부호: 'k1', 부호: 'k2', 평민: 'k3', 빈민: 'k4', 대빈민: 'k5' };
  const CNT = ['', '한 장', '두 장', '세 장', '네 장', '다섯 장', '여섯 장'];

  /* ---------- 작은 도우미 ---------- */
  function hash() {
