      s.turn = lead;
      s.ph = 'xchg';
      ev.unshift({ t: 'deal', hn: s.hn, lead });
    } else {
      s.dai = -1;
      s.turn = s.h.findIndex((a) => a.includes(D3));
      s.ph = 'play';
      ev.push({ t: 'deal', hn: s.hn, lead: s.turn });
    }
  }

  /* ---------- 차례 ---------- */
  function actor(s) {
    if (s.ph === 'over') return null;
    if (s.ph === 'xchg') return s.xq.length ? s.xq[0].s : null;
    return s.turn >= 0 ? s.turn : null;
  }
  const active = (s, c) => s.pl[c] === 0;
  const activeCount = (s) => s.pl.filter((p) => p === 0).length;
  function nextActive(s, x) {
    const n = s.n, i0 = s.ord.indexOf(x);
    for (let k = 1; k <= n; k++) { const c = s.ord[(i0 + k) % n]; if (active(s, c)) return c; }
    return -1;
  }
  function clearTrick(s, ev, why) {
    s.tb = null; s.lb = -1; s.ps = zeros(s.n); s.jbk = 0;
    s.log.push([-1, why || 0]);
    ev.push({ t: 'clr', why: why || 0 });
  }
  function advance(s, from, ev) {
    const n = s.n, i0 = s.ord.indexOf(from);
    for (let k = 1; k <= n; k++) {
      const c = s.ord[(i0 + k) % n];
      if (!active(s, c)) continue;
      if (c === s.lb) { clearTrick(s, ev, 0); s.turn = c; return; }
