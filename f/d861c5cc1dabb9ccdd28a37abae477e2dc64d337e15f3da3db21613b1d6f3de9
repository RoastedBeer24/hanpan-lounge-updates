  }

  /* ───────── AI: 자리마다 다른 버릇(판 시드) + 상황 점수. 지난 시세와 나온 뉴스의 글(ai 칸)만 본다 ───────── */
  const HAB = new Map();
  function habits(seed, seat, lv) {
    const key = seed + ':' + seat + ':' + lv;
    if (HAB.has(key)) return HAB.get(key);
    const R = rng(mix(seed, 9000 + seat * 131 + lv)), r = (a, b) => a + (b - a) * R();
    const hb = {
      react: lv >= 3 ? 4 + Math.floor(R() * 3) : lv === 2 ? 7 + Math.floor(R() * 5) : 13 + Math.floor(R() * 9),   // 뉴스를 읽고 움직이기까지
      read: lv >= 3 ? r(0.8, 0.93) : lv === 2 ? r(0.4, 0.65) : r(0.05, 0.25),      // 규모 · 예상치를 제대로 읽을 확률
      trust: r(0.25, 0.9),                                                           // 소문을 믿는 버릇
      src: lv >= 3 ? r(0.8, 1) : lv === 2 ? r(0.3, 0.7) : r(0, 0.25),                // 출처를 따지는 정도
      chase: lv >= 3 ? r(-0.15, 0.12) : lv === 2 ? r(0.1, 0.45) : r(0.55, 1.1),      // 오르는 걸 따라 사는 버릇
      stop: lv >= 3 ? r(0.02, 0.035) : lv === 2 ? r(0.03, 0.06) : r(0.07, 0.14),     // 손절 기준
      inTh: lv === 1 ? r(0.005, 0.009) : r(0.007, 0.012),
      outTh: lv >= 3 ? 0.0015 : lv === 2 ? r(-0.001, 0.001) : r(-0.006, -0.002),     // 낮을수록 버팀
      shortOK: lv >= 3 ? true : lv === 2 ? R() < 0.6 : R() < 0.2,
      spill: lv >= 3 ? true : lv === 2 ? R() < 0.5 : false,                          // 뒤늦은 파급을 미리 삼
      fade: lv >= 3 ? true : lv === 2 ? R() < 0.4 : false,                           // 이유 없는 급등락을 거꾸로 탐
      hype: lv >= 3 ? true : lv === 2 ? R() < 0.7 : R() < 0.3,                       // 발표 전 기대에 올라탐
      early: lv >= 3 ? true : lv === 2 ? R() < 0.35 : false,                         // 발표 직전에 정리
      night: R() < (lv >= 3 ? 0.6 : 0.35),                                           // 마감 전에 비움
      hunch: lv >= 3 ? 0.001 : lv === 2 ? 0.005 : 0.012,                             // 근거 없는 감
      cd: lv >= 3 ? 3 : lv === 2 ? 4 : 6,
    };
    if (HAB.size > 200) HAB.clear();
    HAB.set(key, hb);
    return hb;
  }
  function botAct(s, seat, lv) {
    if (s.ph !== 'open' || s.k < 2 || s.k >= s.N) return null;
    lv = lv || 2;
    const hb = habits(s.seed, seat, lv), day = genDay(s.seed, s.d, s.N), H = ensure(s), k = s.k, pl = s.pl[seat], log = s.log;
    let last = -99; const lastOn = [-99, -99, -99];
    for (let i = log.length - 1; i >= 0; i--) if (log[i][1] === seat) { if (last < 0) last = log[i][0]; if (lastOn[log[i][2]] < 0) lastOn[log[i][2]] = log[i][0]; }
    if (k - last < hb.cd) return null;
    const E = equity(s, seat); if (E <= 0) return null;
    const lp = (j, t) => Math.log(H.px[j][Math.max(0, t)]);
    const edge = [0, 0, 0];
    const add = (j, e, t0, W, flat) => {
      const age = k - t0; if (age > W || !e) return;
