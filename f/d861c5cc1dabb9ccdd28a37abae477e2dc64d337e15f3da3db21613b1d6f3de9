  }
  function apply(s, seat, a) {
    if (!a || !s.pl[seat]) throw new Error('잘못된 행동');
    if (a.t === 'r') { if (s.ph !== 'recap' || s.pl[seat].rdy) throw new Error('지금은 안 됨'); s.pl[seat].rdy = 1; return s; }
    if (a.t !== 'b' && a.t !== 's') throw new Error('알 수 없는 행동');
    if (s.ph !== 'open') throw new Error('장이 열려 있지 않음');
    const j = a.j | 0, f = +a.f;
    if (!(j >= 0 && j < NS) || !(f > 0 && f <= 1)) throw new Error('잘못된 주문');
    return exec(s, seat, j, a.t === 'b' ? 1 : -1, f, false);
  }
  /* 호스트가 0.4초마다 부름. info = { bots: [{seat, lv}], humans: [seat] } */
  function tick(s, info) {
    const bots = (info && info.bots) || [], humans = (info && info.humans) || [];
    if (s.ph === 'end') return s;
    if (s.ph === 'pre') { if (--s.c <= 0) { s.ph = 'open'; s.k = 0; s.c = 0; } return s; }
    if (s.ph === 'open') {
      s.k++; reprice(s); refresh(s);
      for (let i = 0; i < s.pl.length; i++) {          // 공매도 강제 청산 · 파산 방지
        const pl = s.pl[i];
        for (let j = 0; j < NS; j++) if (pl.sh[j] < 0 && s.p[j] >= pl.av[j] * (1 + LIQ)) exec(s, i, j, 1, 1, true);
        if (pl.eq <= 0) { for (let j = 0; j < NS; j++) { if (pl.sh[j] > 0) exec(s, i, j, -1, 1, true); else if (pl.sh[j] < 0) exec(s, i, j, 1, 1, true); } if (pl.cash < 0) pl.cash = 0; refresh(s); }
      }
      if (s.k < s.N) {
        for (const b of bots) {
          let a = null;
          try { a = botAct(s, b.seat, b.lv); if (a) exec(s, b.seat, a.j, a.t === 'b' ? 1 : -1, a.f, false); } catch (e) { /* 수량 0 등은 넘어감 */ }
        }
      } else {
