      if (s.d + 1 >= s.D) { s.ph = 'end'; s.c = 0; return s; }
      const G = rng(mix(s.seed, 333 + s.d * 13));
      for (const p of s.pl) { p.e0 = p.eq; p.rdy = 0; }
      s.op = s.p.map((p) => r10(p * Math.exp((G() - 0.5) * 0.02)));
      s.d++; s.log = []; s.k = 0; s.p = s.op.slice(); s.ph = 'pre'; s.c = PRE;
