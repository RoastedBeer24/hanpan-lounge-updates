      seed, N, D, d: 0, ph: 'pre', k: 0, c: PRE1, op, p: op.slice(), log: [], hi: [],
      pl: players.map(() => ({ cash: E0, sh: [0, 0, 0], av: [0, 0, 0], eq: E0, e0: E0, tr: 0, lq: 0, rz: 0, bw: 0, rdy: 0 })),
