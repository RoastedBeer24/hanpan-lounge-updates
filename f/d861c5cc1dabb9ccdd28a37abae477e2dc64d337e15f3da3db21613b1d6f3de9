  }

  /* ───────── 결과 ───────── */
  const man = (n) => { const v = Math.round(n / 10000); return (v < 0 ? '−' : '') + String(Math.abs(v)).replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '만'; };
