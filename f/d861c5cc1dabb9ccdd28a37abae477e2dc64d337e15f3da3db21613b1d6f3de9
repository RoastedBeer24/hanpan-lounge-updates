    else if (q.kind === 'short') { pl.av[j] = Math.round((pl.av[j] * -sh + xp * qty) / (-sh + qty)); pl.sh[j] = sh - qty; pl.cash += xp * qty; }
    else {
      const gain = q.kind === 'sell' ? (xp - pl.av[j]) * qty : (pl.av[j] - xp) * qty;
      pl.cash += q.kind === 'sell' ? xp * qty : -xp * qty;
      pl.sh[j] = q.kind === 'sell' ? sh - qty : sh + qty;
      if (pl.sh[j] === 0) pl.av[j] = 0;
      pl.rz += gain; if (gain > pl.bw) pl.bw = gain;
    }
    pl.tr++;
    if (forced) pl.lq++;
    s.log.push([s.k, seat, j, side * qty, xp, Math.round(q.imp * 1e5), forced ? 1 : 0]);
    reprice(s); refresh(s);
    return s;
  }

  /* ───────── 진행 ───────── */
  function init(players, opts) {
    opts = opts || {};
    const D = [3, 5, 7].includes(+opts.days) ? +opts.days : 5;
    const len = [45, 60, 90].includes(+opts.len) ? +opts.len : 60;
    const N = Math.round(len * 1000 / TICK_MS);
    const seed = Math.floor(Math.random() * 0x7fffffff) + 1, R = rng(mix(seed, 3));
    const op = STOCKS.map((S) => r10(S.base * (0.8 + R() * 0.4)));
