    for (let j = 0; j < NS; j++) {
      const sh = pl.sh[j]; if (!sh) continue;
      const dir = sign(sh), pnl = dir > 0 ? s.p[j] / pl.av[j] - 1 : 1 - s.p[j] / pl.av[j];
      if (pnl <= -hb.stop && edge[j] * dir < hb.inTh * 2) return close(j);
      if (edge[j] * dir < hb.outTh && k - lastOn[j] >= 3) return close(j);
    }
    /* 2) 새로 들어가기 — 기대가 큰 종목부터 */
    const ord = [0, 1, 2].sort((a, b) => Math.abs(edge[b]) - Math.abs(edge[a]));
    const room = Math.max(0, E - gross(s, seat));
    for (const j of ord) {
      const e = edge[j], dir = sign(e);
      if (Math.abs(e) < hb.inTh) break;
      if (dir < 0 && !hb.shortOK) continue;
      if (pl.sh[j] * dir < 0) return close(j);
      const strong = Math.abs(e) >= hb.inTh * 2.2;
      if (room / E < 0.12) {
