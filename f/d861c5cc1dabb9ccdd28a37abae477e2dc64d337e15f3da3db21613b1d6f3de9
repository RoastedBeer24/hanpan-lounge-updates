    for (const n of day.news) {
      if (n.t > k) break;
      if (n.t + hb.react > k) continue;
      const a = n.ai, j = n.j, mis = rng(mix(s.seed, seat * 977 + s.d * 61 + n.i * 13 + 5))() > hb.read;
      if (a.k === 'A') {
        if (mis) add(j, a.dir * 0.04, n.t, MOVE + 2);
