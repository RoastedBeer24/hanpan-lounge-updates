      }
    }
    for (let j = 0; j < NS; j++) {
      edge[j] += hb.chase * (lp(j, k) - lp(j, k - 8)) * 0.7;
      edge[j] += (rng(mix(s.seed, seat * 31 + s.d * 17 + Math.floor(k / 25) * 7 + j + 400))() - 0.5) * 2 * hb.hunch;
    }
    const close = (j) => ({ t: pl.sh[j] > 0 ? 's' : 'b', j, f: 1 });
